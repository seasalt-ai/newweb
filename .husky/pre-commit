#!/usr/bin/env bash
set -o pipefail
. "$(dirname "$0")/_/husky.sh"

echo "🔍 Validating JSON files..."

# Find all staged JSON files
STAGED_JSON_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.json$')

if [ -z "$STAGED_JSON_FILES" ]; then
  echo "✅ No JSON files to validate"
  exit 0
fi

# Validate each JSON file - use while loop to safely handle filenames with spaces
echo "$STAGED_JSON_FILES" | (while IFS= read -r file; do
  # Skip empty lines
  [ -z "$file" ] && continue
  
  echo "Validating: $file"
  
  # Basic JSON syntax validation
  if ! jq empty "$file" >/dev/null 2>&1; then
    echo "❌ Invalid JSON syntax in: $file"
    exit 1
  fi
  
  # Run custom validation if it's a translation file
  if [[ "$file" == *"/locales/"* ]]; then
    if ! node scripts/validate-json.js "$file"; then
      echo "❌ Translation validation failed for: $file"
      exit 1
    fi
  fi
done) || exit 1

echo "✅ All JSON files are valid"
