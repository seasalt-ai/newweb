# Zapier API Authentication
# Option 1: Client ID and Secret (for OAuth flow)
ZAPIER_CLIENT_ID=your_client_id_here
ZAPIER_CLIENT_SECRET=your_client_secret_here

ZAPIER_API_VERSION="v2" # v1 

# Option 2: OAuth Tokens (obtained from OAuth flow)
# ZAPIER_OAUTH_TOKEN=your_oauth_token_here
# ZAPIER_REFRESH_TOKEN=your_refresh_token_here

# Rate limiting (seconds between requests)
REQUEST_DELAY=1.0
