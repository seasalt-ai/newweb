---
// /pricing 重定向頁面 - 自動導向用戶語言的 pricing 頁面
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pricing - SeaSalt.ai</title>
    <meta name="description" content="Choose the right plan for your business. Transparent pricing for AI-powered contact center solutions with no hidden fees.">
    
    <!-- Canonical URL -->
    <link rel="canonical" href="https://seasalt.ai/en/pricing">
    
    <!-- 預加載最可能的語言頁面 -->
    <link rel="preload" href="/en/pricing" as="document">
    
    <!-- Hreflang 標籤 -->
    <link rel="alternate" hreflang="en" href="https://seasalt.ai/en/pricing">
    <link rel="alternate" hreflang="zh-tw" href="https://seasalt.ai/zh-tw/pricing">
    <link rel="alternate" hreflang="zh-cn" href="https://seasalt.ai/zh-cn/pricing">
    <link rel="alternate" hreflang="ja" href="https://seasalt.ai/ja/pricing">
    <link rel="alternate" hreflang="ko" href="https://seasalt.ai/ko/pricing">
    <link rel="alternate" hreflang="es" href="https://seasalt.ai/es/pricing">
    <link rel="alternate" hreflang="fr" href="https://seasalt.ai/fr/pricing">
    <link rel="alternate" hreflang="de" href="https://seasalt.ai/de/pricing">
    <link rel="alternate" hreflang="x-default" href="https://seasalt.ai/en/pricing">
    
    <!-- 立即重定向腳本 -->
    <script>
        (function() {
            // 支援的語言列表
            const supportedLocales = [
                'en', 'es', 'zh-tw', 'zh-cn', 'ja', 'ko', 'fr', 'de', 'ar', 'fa',
                'fil', 'hi', 'id', 'ms', 'pl', 'pt', 'ru', 'ta', 'th', 'vi'
            ];
            
            // 語言映射表
            const languageMap = {
                'zh-Hans': 'zh-cn',
                'zh-Hant': 'zh-tw',
                'zh-HK': 'zh-tw',
                'zh-MO': 'zh-tw',
                'zh-SG': 'zh-cn',
                'zh': 'zh-tw',
                'fil-PH': 'fil',
                'tl': 'fil',
                'fa-IR': 'fa',
                'ms-MY': 'ms',
                'ta-IN': 'ta',
                'hi-IN': 'hi',
                'id-ID': 'id',
                'th-TH': 'th',
                'vi-VN': 'vi'
            };
            
            function detectLanguage() {
                // 1. 檢查 URL 參數
                const urlParams = new URLSearchParams(window.location.search);
                const urlLang = urlParams.get('lang');
                if (urlLang && supportedLocales.includes(urlLang)) {
                    return urlLang;
                }
                
                // 2. 檢查 localStorage 中保存的語言偏好
                try {
                    const savedLang = localStorage.getItem('seasalt-preferred-language');
                    if (savedLang && supportedLocales.includes(savedLang)) {
                        return savedLang;
                    }
                } catch (e) {
                    // 忽略 localStorage 錯誤
                }
                
                // 3. 檢查瀏覽器語言
                const browserLangs = navigator.languages || [navigator.language || navigator.userLanguage];
                
                for (const browserLang of browserLangs) {
                    const normalizedLang = browserLang.toLowerCase();
                    
                    // 直接匹配
                    if (supportedLocales.includes(normalizedLang)) {
                        return normalizedLang;
                    }
                    
                    // 映射表匹配
                    if (languageMap[browserLang]) {
                        return languageMap[browserLang];
                    }
                    
                    // 前綴匹配
                    const langPrefix = normalizedLang.split('-')[0];
                    if (supportedLocales.includes(langPrefix)) {
                        return langPrefix;
                    }
                    
                    // 特殊處理中文
                    if (langPrefix === 'zh') {
                        return normalizedLang.includes('cn') || normalizedLang.includes('hans') ? 'zh-cn' : 'zh-tw';
                    }
                }
                
                // 4. 默認英文
                return 'en';
            }
            
            // 執行重定向到 pricing 頁面
            const detectedLang = detectLanguage();
            const newUrl = '/' + detectedLang + '/pricing' + window.location.search + window.location.hash;
            
            // 保存語言偏好
            try {
                localStorage.setItem('seasalt-preferred-language', detectedLang);
            } catch (e) {
                // 忽略 localStorage 錯誤
            }
            
            // 執行重定向
            window.location.replace(newUrl);
        })();
    </script>
    
    <!-- SEO 友好的 noscript 回退 -->
    <noscript>
        <meta http-equiv="refresh" content="0; url=/en/pricing">
    </noscript>
</head>
<body>
    <!-- 載入指示器 -->
    <div style="
        position: fixed; 
        top: 50%; 
        left: 50%; 
        transform: translate(-50%, -50%);
        text-align: center;
        font-family: system-ui, -apple-system, sans-serif;
        color: #4B5563;
    ">
        <div style="
            width: 32px; 
            height: 32px; 
            border: 3px solid #E5E7EB; 
            border-top: 3px solid #3B82F6; 
            border-radius: 50%; 
            animation: spin 1s linear infinite;
            margin: 0 auto 16px;
        "></div>
        <p>Redirecting to pricing page...</p>
        <p style="font-size: 14px; opacity: 0.7;">正在重定向到定價頁面...</p>
    </div>
    
    <style>
        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }
        body {
            margin: 0;
            padding: 0;
            background-color: #F9FAFB;
        }
    </style>
</body>
</html>