---
import IndustryPageTemplate from '../../../components/IndustryPageTemplate.astro';
import { getTranslationHelpers, type SupportedLanguage } from '../../../i18n/helpers';

export async function getStaticPaths() {
  const supportedLocales = ['en', 'es', 'zh-tw', 'zh-cn', 'ja', 'ko', 'fr', 'de', 'ar', 'fa', 'fil', 'hi', 'id', 'ms', 'pl', 'pt', 'ru', 'ta', 'th', 'vi'];
  return supportedLocales.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const currentLang = (lang as SupportedLanguage) || 'en';
const { t } = await getTranslationHelpers(currentLang);

const industryData = {
  title: t('industriesData.restaurants.title'),
  headline: t('industriesData.restaurants.headline'),
  benefits: [
    t('industriesData.restaurants.benefits.0'),
    t('industriesData.restaurants.benefits.1'),
    t('industriesData.restaurants.benefits.2'),
    t('industriesData.restaurants.benefits.3')
  ],
  color: 'text-orange-600',
  bgColor: 'bg-orange-50',
  borderColor: 'border-orange-200',
  iconName: 'utensils',
  slug: 'restaurants-hospitality'
};
---

<IndustryPageTemplate
  title={industryData.title}
  headline={industryData.headline}
  benefits={industryData.benefits}
  color={industryData.color}
  bgColor={industryData.bgColor}
  borderColor={industryData.borderColor}
  iconName={industryData.iconName}
  slug={industryData.slug}
  lang={currentLang}
/>
