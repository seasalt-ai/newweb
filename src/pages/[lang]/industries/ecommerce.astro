---
import IndustryPageTemplate from '../../../components/IndustryPageTemplate.astro';
import { getTranslationHelpers, supportedLocales, type SupportedLanguage } from '../../../i18n/helpers';

// 為所有支持的語言生成靜態路徑
export async function getStaticPaths() {
  return supportedLocales.map((lang) => ({
    params: { lang }
  }));
}

// 取得動態語言參數
const { lang } = Astro.params;
const currentLang = (lang as SupportedLanguage) || 'en';
const { t } = await getTranslationHelpers(currentLang);

const industryData = {
  title: t('industriesData.ecommerce.title'),
  headline: t('industriesData.ecommerce.headline'),
  benefits: [
    t('industriesData.ecommerce.benefits.0'),
    t('industriesData.ecommerce.benefits.1'),
    t('industriesData.ecommerce.benefits.2'),
    t('industriesData.ecommerce.benefits.3')
  ],
  color: 'text-blue-600',
  bgColor: 'bg-blue-50',
  borderColor: 'border-blue-200',
  iconName: 'shopping-cart',
  slug: 'ecommerce'
};
---

<IndustryPageTemplate
  title={industryData.title}
  headline={industryData.headline}
  benefits={industryData.benefits}
  color={industryData.color}
  bgColor={industryData.bgColor}
  borderColor={industryData.borderColor}
  iconName={industryData.iconName}
  slug={industryData.slug}
  lang={currentLang}
/>
