---
import IndustryPageTemplate from '../../../components/IndustryPageTemplate.astro';
import { getTranslationHelpers, type SupportedLanguage, supportedLocales } from '../../../i18n/helpers';

export async function getStaticPaths() {
  return supportedLocales.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const currentLang = (lang as SupportedLanguage) || 'en';
const { t } = await getTranslationHelpers(currentLang);

const industryData = {
  title: t('industriesData.healthcare.title'),
  headline: t('industriesData.healthcare.headline'),
  benefits: [
    t('industriesData.healthcare.benefits.0'),
    t('industriesData.healthcare.benefits.1'),
    t('industriesData.healthcare.benefits.2'),
    t('industriesData.healthcare.benefits.3')
  ],
  color: 'text-green-600',
  bgColor: 'bg-green-50',
  borderColor: 'border-green-200',
  iconName: 'heart',
  slug: 'healthcare',
  showSeaHealthLink: true
};
---

<IndustryPageTemplate
  title={industryData.title}
  headline={industryData.headline}
  benefits={industryData.benefits}
  color={industryData.color}
  bgColor={industryData.bgColor}
  borderColor={industryData.borderColor}
  iconName={industryData.iconName}
  slug={industryData.slug}
  showSeaHealthLink={industryData.showSeaHealthLink}
  lang={currentLang}
/>
