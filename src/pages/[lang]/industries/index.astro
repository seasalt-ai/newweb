---
import Layout from '../../../layouts/Layout.astro';
import Industries from '../../../components/Industries.astro';
import { getTranslationHelpers, type SupportedLanguage } from '../../../i18n/helpers';

export async function getStaticPaths() {
  const supportedLocales = ['en', 'es', 'zh-tw', 'zh-cn', 'ja', 'ko', 'fr', 'de', 'ar', 'fa', 'fil', 'hi', 'id', 'ms', 'pl', 'pt', 'ru', 'ta', 'th', 'vi'];
  return supportedLocales.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const currentLang = (lang as SupportedLanguage) || 'en';
const { t } = await getTranslationHelpers(currentLang);

// SEO data
const seoData = {
  title: `${t('industries.title')} - Seasalt.ai`,
  description: t('industries.description'),
  canonicalUrl: `https://seasalt.ai/${currentLang}/industries`,
  ogType: 'website'
};
---

<Layout title={seoData.title} description={seoData.description} lang={currentLang}>
  <main class="pt-16">
    <!-- Hero Section -->
    <section class="py-20 bg-gradient-to-r from-blue-600 to-indigo-600 text-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h1 class="text-4xl lg:text-6xl font-bold text-white mb-6">
          {t('industries.title')}
        </h1>
        <p class="text-xl text-white opacity-90 mb-8 max-w-3xl mx-auto">
          {t('industries.description')}
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="https://seax.seasalt.ai/signup"
            class="bg-white text-blue-600 hover:bg-gray-50 px-8 py-4 rounded-lg text-lg font-semibold transition-all duration-200"
          >
            {t('industries.cta.signUp')}
          </a>
          <a
            href={`/${currentLang}/contact-sales`}
            class="border-2 border-white text-white hover:bg-white hover:text-blue-600 px-8 py-4 rounded-lg text-lg font-semibold transition-all duration-200"
          >
            {t('industries.cta.bookDemo')}
          </a>
        </div>
      </div>
    </section>

    <!-- Industries Grid Component -->
    <Industries lang={currentLang} />

    <!-- Additional Benefits Section -->
    <section class="py-20 bg-gray-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="text-3xl lg:text-4xl font-bold text-gray-900 mb-4">
            Why Businesses Choose Seasalt.ai
          </h2>
          <p class="text-xl text-gray-600 max-w-3xl mx-auto">
            Regardless of your industry, our platform delivers the tools you need to succeed
          </p>
        </div>

        <div class="grid md:grid-cols-3 gap-8">
          <div class="bg-white p-8 rounded-2xl shadow-lg text-center">
            <div class="bg-blue-100 p-4 rounded-2xl w-fit mx-auto mb-6">
              <div class="text-blue-600 h-8 w-8 mx-auto" data-icon="unified"></div>
            </div>
            <h3 class="text-xl font-semibold text-gray-900 mb-4">
              Unified Communication
            </h3>
            <p class="text-gray-600">
              Manage all customer conversations from one platform - WhatsApp, SMS, phone calls, and chat
            </p>
          </div>

          <div class="bg-white p-8 rounded-2xl shadow-lg text-center">
            <div class="bg-green-100 p-4 rounded-2xl w-fit mx-auto mb-6">
              <div class="text-green-600 h-8 w-8 mx-auto" data-icon="ai"></div>
            </div>
            <h3 class="text-xl font-semibold text-gray-900 mb-4">
              AI-Powered Automation
            </h3>
            <p class="text-gray-600">
              Handle routine queries automatically while seamlessly handing off complex issues to your team
            </p>
          </div>

          <div class="bg-white p-8 rounded-2xl shadow-lg text-center">
            <div class="bg-purple-100 p-4 rounded-2xl w-fit mx-auto mb-6">
              <div class="text-purple-600 h-8 w-8 mx-auto" data-icon="analytics"></div>
            </div>
            <h3 class="text-xl font-semibold text-gray-900 mb-4">
              Performance Analytics
            </h3>
            <p class="text-gray-600">
              Track key metrics and gain insights to optimize your customer communication strategy
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Final CTA Section -->
    <section class="py-20 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-3xl lg:text-4xl font-bold text-gray-900 mb-6">
          {t('industries.cta.title')}
        </h2>
        <p class="text-xl text-gray-600 mb-8 max-w-2xl mx-auto">
          {t('industries.cta.description')}
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="https://seax.seasalt.ai/signup"
            class="bg-blue-600 hover:bg-blue-700 text-white px-8 py-4 rounded-lg text-lg font-semibold transition-all duration-200"
          >
            {t('industries.cta.signUp')}
          </a>
          <a
            href={`/${currentLang}/contact-sales`}
            class="border-2 border-blue-600 text-blue-600 hover:bg-blue-600 hover:text-white px-8 py-4 rounded-lg text-lg font-semibold transition-all duration-200"
          >
            {t('industries.cta.bookDemo')}
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
/* Additional icon styles */
[data-icon="unified"]:before {
  content: "🔗";
  font-size: 2rem;
}

[data-icon="ai"]:before {
  content: "🤖";
  font-size: 2rem;
}

[data-icon="analytics"]:before {
  content: "📊";
  font-size: 2rem;
}

@media (max-width: 640px) {
  [data-icon]:before {
    font-size: 1.5rem;
  }
}
</style>
