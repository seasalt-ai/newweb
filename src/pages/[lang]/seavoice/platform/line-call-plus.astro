---
// Generate static paths for all supported languages
export async function getStaticPaths() {
  const supportedLocales = [
    'en', 'es', 'zh-tw', 'zh-cn', 'ja', 'ko', 'fr', 'de', 'ar', 'fa',
    'fil', 'hi', 'id', 'ms', 'pl', 'pt', 'ru', 'ta', 'th', 'vi'
  ];
  
  return supportedLocales.map((lang) => ({
    params: { lang }
  }));
}

import Layout from '../../../../layouts/Layout.astro';
import { getTranslationHelpers, type SupportedLanguage } from '../../../../i18n/helpers';

const { lang } = Astro.params;
const currentLang = (lang as SupportedLanguage) || 'en';
const { t } = await getTranslationHelpers(currentLang);

// SEO配置
const seoData = {
  title: t('seavoice.platform.lineCallPlus.hero.title') || 'LINE Call Plus for Businesses - SeaVoice',
  description: t('seavoice.platform.lineCallPlus.hero.description') || 'Transform your LINE Business account with AI-powered voice calling. Connect with customers across Asia-Pacific markets through their preferred messaging platform.',
  canonical: `/${currentLang}/seavoice/platform/line-call-plus`,
};

// 市場數據
const marketStats = [
  { country: 'Japan', users: '95M+', penetration: '75%' },
  { country: 'Thailand', users: '52M+', penetration: '76%' },
  { country: 'Taiwan', users: '21M+', penetration: '90%' },
  { country: 'South Korea', users: '33M+', penetration: '64%' }
];

// 功能特色
const features = [
  {
    icon: 'message-circle',
    title: t('seavoice.platform.lineCallPlus.features.nativeIntegration.title') || 'Native LINE Integration',
    description: t('seavoice.platform.lineCallPlus.features.nativeIntegration.description') || 'Seamlessly integrate voice calling directly within the LINE messaging platform.',
    benefits: [
      t('seavoice.platform.lineCallPlus.features.nativeIntegration.benefit1') || 'One-tap calling from chat',
      t('seavoice.platform.lineCallPlus.features.nativeIntegration.benefit2') || 'Unified conversation history',
      t('seavoice.platform.lineCallPlus.features.nativeIntegration.benefit3') || 'Rich media support'
    ]
  },
  {
    icon: 'users',
    title: t('seavoice.platform.lineCallPlus.features.businessAccount.title') || 'Business Account Support',
    description: t('seavoice.platform.lineCallPlus.features.businessAccount.description') || 'Full support for LINE Business accounts with advanced features and analytics.',
    benefits: [
      t('seavoice.platform.lineCallPlus.features.businessAccount.benefit1') || 'Verified business profiles',
      t('seavoice.platform.lineCallPlus.features.businessAccount.benefit2') || 'Custom branding options',
      t('seavoice.platform.lineCallPlus.features.businessAccount.benefit3') || 'Advanced user management'
    ]
  },
  {
    icon: 'globe',
    title: t('seavoice.platform.lineCallPlus.features.asiaPacific.title') || 'Asia-Pacific Focus',
    description: t('seavoice.platform.lineCallPlus.features.asiaPacific.description') || 'Optimized for key Asian markets where LINE dominates business communications.',
    benefits: [
      t('seavoice.platform.lineCallPlus.features.asiaPacific.benefit1') || 'Local language support',
      t('seavoice.platform.lineCallPlus.features.asiaPacific.benefit2') || 'Regional compliance',
      t('seavoice.platform.lineCallPlus.features.asiaPacific.benefit3') || 'Cultural customization'
    ]
  }
];

// 使用案例
const useCases = [
  {
    title: t('seavoice.platform.lineCallPlus.useCases.customerSupport.title') || 'Customer Support',
    description: t('seavoice.platform.lineCallPlus.useCases.customerSupport.description') || 'Provide instant voice support directly within LINE conversations.',
    metrics: [
      t('seavoice.platform.lineCallPlus.useCases.customerSupport.metric1') || '50% faster resolution',
      t('seavoice.platform.lineCallPlus.useCases.customerSupport.metric2') || '90% customer satisfaction',
      t('seavoice.platform.lineCallPlus.useCases.customerSupport.metric3') || '24/7 availability'
    ]
  },
  {
    title: t('seavoice.platform.lineCallPlus.useCases.salesConsultations.title') || 'Sales Consultations',
    description: t('seavoice.platform.lineCallPlus.useCases.salesConsultations.description') || 'Convert chat inquiries to voice calls for personalized sales experiences.',
    metrics: [
      t('seavoice.platform.lineCallPlus.useCases.salesConsultations.metric1') || '3x higher conversion',
      t('seavoice.platform.lineCallPlus.useCases.salesConsultations.metric2') || 'Personalized recommendations',
      t('seavoice.platform.lineCallPlus.useCases.salesConsultations.metric3') || 'Trust building'
    ]
  },
  {
    title: t('seavoice.platform.lineCallPlus.useCases.appointmentBooking.title') || 'Appointment Booking',
    description: t('seavoice.platform.lineCallPlus.useCases.appointmentBooking.description') || 'Enable voice-based appointment scheduling within LINE Business accounts.',
    metrics: [
      t('seavoice.platform.lineCallPlus.useCases.appointmentBooking.metric1') || 'Instant confirmations',
      t('seavoice.platform.lineCallPlus.useCases.appointmentBooking.metric2') || 'Calendar integration',
      t('seavoice.platform.lineCallPlus.useCases.appointmentBooking.metric3') || 'Automated reminders'
    ]
  }
];

// 圖示組件
function getIconSvg(iconName: string) {
  const icons = {
    'message-circle': '<svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path></svg>',
    'users': '<svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197m13.5-9a2.5 2.5 0 11-5 0 2.5 2.5 0 015 0z"></path></svg>',
    'globe': '<svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9 3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"></path></svg>',
    'check-circle': '<svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>',
    'bar-chart': '<svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path></svg>'
  };
  return icons[iconName as keyof typeof icons] || icons['message-circle'];
}
---

<Layout seo={seoData} lang={currentLang}>
  <!-- Hero Section -->
  <section class="bg-gradient-to-br from-emerald-50 via-white to-green-50 py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <h1 class="text-5xl font-bold text-gray-900 mb-6">
          {t('seavoice.platform.lineCallPlus.hero.title') || 'LINE Call Plus for Businesses'}
        </h1>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto mb-8">
          {t('seavoice.platform.lineCallPlus.hero.description') || 'Transform your LINE Business account with AI-powered voice calling. Connect with customers across Asia-Pacific markets through their preferred messaging platform.'}
        </p>
        <a
          href="https://chat.seasalt.ai/gpt/signup"
          target="_blank"
          rel="noopener noreferrer"
          class="bg-green-600 text-white px-8 py-4 rounded-lg text-lg font-semibold hover:bg-green-700 transition-colors"
        >
          {t('seavoice.platform.lineCallPlus.hero.cta') || 'Start LINE Integration'}
        </a>
      </div>
    </div>
  </section>

  <!-- Market Reach Section -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-4xl font-bold text-gray-900 mb-6">
          {t('seavoice.platform.lineCallPlus.marketReach.title') || 'Reach Millions Across Asia-Pacific'}
        </h2>
        <p class="text-xl text-gray-600">
          {t('seavoice.platform.lineCallPlus.marketReach.subtitle') || 'LINE dominates business communications in key Asian markets'}
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        {marketStats.map((stat) => (
          <div class="bg-gradient-to-br from-green-50 to-emerald-50 rounded-xl p-8 text-center border border-green-200">
            <h3 class="text-2xl font-bold text-gray-900 mb-2">{stat.country}</h3>
            <div class="mb-4">
              <p class="text-3xl font-bold text-green-600">{stat.users}</p>
              <p class="text-sm text-gray-600">{t('seavoice.platform.lineCallPlus.marketReach.activeUsers') || 'Active Users'}</p>
            </div>
            <div>
              <p class="text-2xl font-bold text-emerald-600">{stat.penetration}</p>
              <p class="text-sm text-gray-600">{t('seavoice.platform.lineCallPlus.marketReach.marketPenetration') || 'Market Penetration'}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Features Section -->
  <section class="py-20 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-4xl font-bold text-gray-900 mb-6">
          {t('seavoice.platform.lineCallPlus.features.title') || 'Powerful LINE Business Features'}
        </h2>
        <p class="text-xl text-gray-600">
          {t('seavoice.platform.lineCallPlus.features.subtitle') || 'Everything you need to provide exceptional voice experiences on LINE'}
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        {features.map((feature) => (
          <div class="bg-white rounded-xl p-8 shadow-lg border border-gray-200 hover:shadow-xl transition-shadow">
            <div class="flex items-center mb-6">
              <div class="w-12 h-12 bg-gradient-to-r from-green-600 to-emerald-600 rounded-lg flex items-center justify-center mr-4">
                <Fragment set:html={getIconSvg(feature.icon)} />
              </div>
              <h3 class="text-xl font-bold text-gray-900">{feature.title}</h3>
            </div>
            <p class="text-gray-600 mb-6 leading-relaxed">{feature.description}</p>
            <ul class="space-y-3">
              {feature.benefits.map((benefit) => (
                <li class="flex items-center text-gray-700">
                  <Fragment set:html={getIconSvg('check-circle')} />
                  <span class="ml-3">{benefit}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Use Cases Section -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-4xl font-bold text-gray-900 mb-6">
          {t('seavoice.platform.lineCallPlus.useCases.title') || 'Transform Customer Interactions'}
        </h2>
        <p class="text-xl text-gray-600">
          {t('seavoice.platform.lineCallPlus.useCases.subtitle') || 'See how businesses use LINE Call Plus to enhance customer relationships'}
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        {useCases.map((useCase) => (
          <div class="bg-gradient-to-br from-gray-50 to-white rounded-xl p-8 border border-gray-200 hover:border-green-300 transition-colors">
            <div class="mb-6">
              <Fragment set:html={getIconSvg('bar-chart')} />
            </div>
            <h3 class="text-xl font-bold text-gray-900 mb-4">{useCase.title}</h3>
            <p class="text-gray-600 mb-6">{useCase.description}</p>
            <div class="space-y-2">
              {useCase.metrics.map((metric) => (
                <div class="flex items-center">
                  <div class="w-2 h-2 bg-green-600 rounded-full mr-3"></div>
                  <span class="text-sm text-gray-700">{metric}</span>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Integration Steps Section -->
  <section class="py-20 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-4xl font-bold text-gray-900 mb-6">
          {t('seavoice.platform.lineCallPlus.integration.title') || 'Simple Integration Process'}
        </h2>
        <p class="text-xl text-gray-600">
          {t('seavoice.platform.lineCallPlus.integration.subtitle') || 'Get started with LINE Call Plus in just a few steps'}
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="text-center">
          <div class="w-16 h-16 bg-green-600 text-white rounded-full flex items-center justify-center text-2xl font-bold mx-auto mb-6">1</div>
          <h3 class="text-xl font-bold text-gray-900 mb-4">
            {t('seavoice.platform.lineCallPlus.integration.step1.title') || 'Connect LINE Business'}
          </h3>
          <p class="text-gray-600">
            {t('seavoice.platform.lineCallPlus.integration.step1.description') || 'Link your existing LINE Business account or create a new one with our guided setup.'}
          </p>
        </div>
        
        <div class="text-center">
          <div class="w-16 h-16 bg-green-600 text-white rounded-full flex items-center justify-center text-2xl font-bold mx-auto mb-6">2</div>
          <h3 class="text-xl font-bold text-gray-900 mb-4">
            {t('seavoice.platform.lineCallPlus.integration.step2.title') || 'Configure Voice Agents'}
          </h3>
          <p class="text-gray-600">
            {t('seavoice.platform.lineCallPlus.integration.step2.description') || 'Set up your AI voice agents with custom scripts, voices, and business logic.'}
          </p>
        </div>
        
        <div class="text-center">
          <div class="w-16 h-16 bg-green-600 text-white rounded-full flex items-center justify-center text-2xl font-bold mx-auto mb-6">3</div>
          <h3 class="text-xl font-bold text-gray-900 mb-4">
            {t('seavoice.platform.lineCallPlus.integration.step3.title') || 'Go Live'}
          </h3>
          <p class="text-gray-600">
            {t('seavoice.platform.lineCallPlus.integration.step3.description') || 'Launch your voice-enabled LINE Business account and start engaging customers.'}
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Analytics Section -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <h2 class="text-4xl font-bold text-gray-900 mb-6">
            {t('seavoice.platform.lineCallPlus.analytics.title') || 'Comprehensive Analytics'}
          </h2>
          <p class="text-xl text-gray-600 mb-8">
            {t('seavoice.platform.lineCallPlus.analytics.description') || 'Track performance, understand customer behavior, and optimize your LINE voice interactions with detailed analytics and reporting.'}
          </p>

          <div class="space-y-6">
            <div class="flex items-start">
              <Fragment set:html={getIconSvg('bar-chart')} />
              <div class="ml-4">
                <h3 class="text-lg font-semibold text-gray-900 mb-2">
                  {t('seavoice.platform.lineCallPlus.analytics.callAnalytics.title') || 'Call Analytics'}
                </h3>
                <p class="text-gray-600">
                  {t('seavoice.platform.lineCallPlus.analytics.callAnalytics.description') || 'Track call volume, duration, and success rates'}
                </p>
              </div>
            </div>

            <div class="flex items-start">
              <Fragment set:html={getIconSvg('users')} />
              <div class="ml-4">
                <h3 class="text-lg font-semibold text-gray-900 mb-2">
                  {t('seavoice.platform.lineCallPlus.analytics.userEngagement.title') || 'User Engagement'}
                </h3>
                <p class="text-gray-600">
                  {t('seavoice.platform.lineCallPlus.analytics.userEngagement.description') || 'Monitor user interactions and satisfaction scores'}
                </p>
              </div>
            </div>

            <div class="flex items-start">
              <Fragment set:html={getIconSvg('globe')} />
              <div class="ml-4">
                <h3 class="text-lg font-semibold text-gray-900 mb-2">
                  {t('seavoice.platform.lineCallPlus.analytics.platformInsights.title') || 'Platform Insights'}
                </h3>
                <p class="text-gray-600">
                  {t('seavoice.platform.lineCallPlus.analytics.platformInsights.description') || 'LINE-specific metrics and performance data'}
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- Analytics Dashboard Mockup -->
        <div class="bg-gray-900 rounded-xl p-6 text-white">
          <div class="flex items-center justify-between mb-6">
            <h3 class="text-lg font-semibold">
              {t('seavoice.platform.lineCallPlus.analytics.dashboard.title') || 'LINE Call Analytics'}
            </h3>
            <span class="bg-green-500 text-green-100 px-2 py-1 rounded text-xs">
              {t('seavoice.platform.lineCallPlus.analytics.dashboard.live') || 'Live'}
            </span>
          </div>
          
          <div class="grid grid-cols-2 gap-4 mb-6">
            <div class="bg-gray-800 rounded-lg p-4">
              <p class="text-gray-400 text-sm">{t('seavoice.platform.lineCallPlus.analytics.dashboard.activeCalls') || 'Active Calls'}</p>
              <p class="text-2xl font-bold">247</p>
            </div>
            <div class="bg-gray-800 rounded-lg p-4">
              <p class="text-gray-400 text-sm">{t('seavoice.platform.lineCallPlus.analytics.dashboard.responseRate') || 'Response Rate'}</p>
              <p class="text-2xl font-bold text-green-400">94%</p>
            </div>
            <div class="bg-gray-800 rounded-lg p-4">
              <p class="text-gray-400 text-sm">{t('seavoice.platform.lineCallPlus.analytics.dashboard.avgCallDuration') || 'Avg. Call Duration'}</p>
              <p class="text-2xl font-bold">3:24</p>
            </div>
            <div class="bg-gray-800 rounded-lg p-4">
              <p class="text-gray-400 text-sm">{t('seavoice.platform.lineCallPlus.analytics.dashboard.customerSatisfaction') || 'Customer Satisfaction'}</p>
              <p class="text-2xl font-bold text-blue-400">4.8/5</p>
            </div>
          </div>
          
          <div class="bg-gray-800 rounded-lg p-4">
            <p class="text-gray-400 text-sm mb-2">{t('seavoice.platform.lineCallPlus.analytics.dashboard.sampleResponse') || 'Japanese voice agent responding to customer'}</p>
            <p class="text-sm">こんにちは！お手伝いできることがありましたら、遠慮なくお声がけください。</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-20 bg-gradient-to-br from-green-600 to-emerald-700 text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-4xl font-bold mb-6">
        {t('seavoice.platform.lineCallPlus.cta.title') || 'Ready to Expand in Asia-Pacific?'}
      </h2>
      <p class="text-xl mb-8 max-w-2xl mx-auto">
        {t('seavoice.platform.lineCallPlus.cta.description') || 'Connect with millions of LINE users and transform your customer engagement across key Asian markets'}
      </p>
      <a
        href="https://chat.seasalt.ai/gpt/signup"
        target="_blank"
        rel="noopener noreferrer"
        class="bg-white text-green-600 px-8 py-4 rounded-lg text-lg font-semibold hover:bg-gray-100 transition-colors"
      >
        {t('seavoice.platform.lineCallPlus.cta.button') || 'Start LINE Integration'}
      </a>
    </div>
  </section>
</Layout>