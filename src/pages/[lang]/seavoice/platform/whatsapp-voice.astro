---
import Layout from '../../../../layouts/Layout.astro';
import { getTranslationHelpers, type SupportedLanguage } from '../../../../i18n/helpers';

export async function getStaticPaths() {
  const supportedLanguages = [
    'en', 'es', 'zh-tw', 'zh-cn', 'ja', 'ko', 'fr', 'de', 'ar', 'fa', 
    'fil', 'hi', 'id', 'ms', 'pl', 'pt', 'ru', 'ta', 'th', 'vi'
  ];
  
  return supportedLanguages.map((lang) => ({
    params: { lang }
  }));
}

const { lang } = Astro.params;
const currentLang = (lang as SupportedLanguage) || 'en';

// 獲取翻譯
const { t, translations } = await getTranslationHelpers(currentLang);

// SEO 資料
const seoData = {
  title: t('seavoice.platform.whatsAppVoice.hero.title'),
  description: t('seavoice.platform.whatsAppVoice.hero.subtitle'),
  canonical: `https://seasalt.ai/${currentLang}/seavoice/platform/whatsapp-voice`,
  keywords: 'WhatsApp Voice API, WhatsApp Business, Voice Calling, AI Voice Assistant, Business Communication',
  lang: currentLang,
  type: 'website'
};

// Schema.org JSON-LD
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": seoData.title,
  "description": seoData.description,
  "url": `https://seasalt.ai/${currentLang}/seavoice/platform/whatsapp-voice`,
  "inLanguage": currentLang,
  "publisher": {
    "@type": "Organization",
    "name": "Seasalt.ai",
    "logo": {
      "@type": "ImageObject",
      "url": "https://seasalt.ai/images/seasalt-logo.png"
    }
  },
  "mainEntity": {
    "@type": "Service",
    "name": "WhatsApp Voice API for Businesses",
    "description": seoData.description,
    "provider": {
      "@type": "Organization",
      "name": "Seasalt.ai"
    },
    "serviceType": "WhatsApp Business Communication Platform"
  }
};
