---
// Generate static paths for all supported languages
export async function getStaticPaths() {
  const supportedLocales = [
    'en', 'es', 'zh-tw', 'zh-cn', 'ja', 'ko', 'fr', 'de', 'ar', 'fa',
    'fil', 'hi', 'id', 'ms', 'pl', 'pt', 'ru', 'ta', 'th', 'vi'
  ];
  
  return supportedLocales.map((lang) => ({
    params: { lang }
  }));
}

import Layout from '../../../../layouts/Layout.astro';
import { getTranslationHelpers, type SupportedLanguage } from '../../../../i18n/helpers';

// 語言處理
const { lang } = Astro.params;
const currentLang = (lang as SupportedLanguage) || 'en';
const { t } = await getTranslationHelpers(currentLang);

// SEO 設定（沿用舊版語意與鍵，不改動翻譯檔）
const seoData = {
  title: t('seavoice.platform.landlineMobile.hero.title') || 'Landline & Mobile Voice Solutions',
  description: t('seavoice.platform.landlineMobile.hero.subtitle') || 'AI-powered voice agents integrated with PSTN and mobile networks to serve customers globally.',
  canonical: `/${currentLang}/seavoice/platform/landline-mobile`,
};

// Features 區塊資料（使用既有鍵）
const features = [
  {
    icon: 'phone',
    title: t('seavoice.platform.landlineMobile.features.0.title') || 'Legacy Landline Integration',
    description: t('seavoice.platform.landlineMobile.features.0.description') || 'Seamlessly connect AI voice with your existing PSTN infrastructure.',
    bullets: [
      t('seavoice.platform.landlineMobile.features.0.benefits.0') || 'Keep your existing numbers',
      t('seavoice.platform.landlineMobile.features.0.benefits.1') || 'No hardware replacement',
      t('seavoice.platform.landlineMobile.features.0.benefits.2') || 'Instant AI backup when lines are busy',
    ]
  },
  {
    icon: 'smartphone',
    title: t('seavoice.platform.landlineMobile.features.1.title') || 'Mobile Network Connectivity',
    description: t('seavoice.platform.landlineMobile.features.1.description') || 'Direct carrier integrations for outbound and customer engagement.',
    bullets: [
      t('seavoice.platform.landlineMobile.features.1.benefits.0') || 'Reach customers on mobile',
      t('seavoice.platform.landlineMobile.features.1.benefits.1') || 'High connection rates',
      t('seavoice.platform.landlineMobile.features.1.benefits.2') || 'SMS fallback options',
    ]
  },
  {
    icon: 'globe',
    title: t('seavoice.platform.landlineMobile.features.2.title') || 'Global Coverage',
    description: t('seavoice.platform.landlineMobile.features.2.description') || 'Connect with customers worldwide via our carrier partner network.',
    bullets: [
      t('seavoice.platform.landlineMobile.features.2.benefits.0') || '200+ countries supported',
      t('seavoice.platform.landlineMobile.features.2.benefits.1') || 'Local number presentation',
      t('seavoice.platform.landlineMobile.features.2.benefits.2') || 'Competitive international rates',
    ]
  }
];

// Use Cases 區塊
const useCases = [
  {
    title: t('seavoice.platform.landlineMobile.useCases.0.title') || 'Appointment Reminders',
    description: t('seavoice.platform.landlineMobile.useCases.0.description') || 'Automatically call to confirm upcoming appointments.',
    metrics: [
      t('seavoice.platform.landlineMobile.useCases.0.metrics.0') || 'Reduce no-show by 40%+',
      t('seavoice.platform.landlineMobile.useCases.0.metrics.1') || '95% connection rate',
      t('seavoice.platform.landlineMobile.useCases.0.metrics.2') || '24/7 automated dialing',
    ]
  },
  {
    title: t('seavoice.platform.landlineMobile.useCases.1.title') || 'Emergency Notifications',
    description: t('seavoice.platform.landlineMobile.useCases.1.description') || 'Rapidly notify groups during emergencies or important updates.',
    metrics: [
      t('seavoice.platform.landlineMobile.useCases.1.metrics.0') || '1000+ calls per minute',
      t('seavoice.platform.landlineMobile.useCases.1.metrics.1') || 'Multi-language support',
      t('seavoice.platform.landlineMobile.useCases.1.metrics.2') || 'Delivery confirmations',
    ]
  },
  {
    title: t('seavoice.platform.landlineMobile.useCases.2.title') || 'Customer Surveys',
    description: t('seavoice.platform.landlineMobile.useCases.2.description') || 'Post-service surveys to collect valuable feedback.',
    metrics: [
      t('seavoice.platform.landlineMobile.useCases.2.metrics.0') || '3x higher response rate',
      t('seavoice.platform.landlineMobile.useCases.2.metrics.1') || 'Real-time sentiment',
      t('seavoice.platform.landlineMobile.useCases.2.metrics.2') || 'Automated reporting',
    ]
  }
];

// 企業級規格區塊（鍵已存在）
const specs = {
  title: t('seavoice.platform.landlineMobile.specs.title') || 'Enterprise-grade Reliability',
  subtitle: t('seavoice.platform.landlineMobile.specs.subtitle') || 'Built for mission-critical communications with carrier-grade infrastructure and 99.99% uptime.',
  items: [
    {
      title: t('seavoice.platform.landlineMobile.specs.security.title') || 'Security & Compliance',
      description: t('seavoice.platform.landlineMobile.specs.security.description') || 'SOC2, HIPAA, and PCI-compliant infrastructure'
    },
    {
      title: t('seavoice.platform.landlineMobile.specs.monitoring.title') || '24/7 Monitoring',
      description: t('seavoice.platform.landlineMobile.specs.monitoring.description') || 'Real-time system monitoring and instant failover'
    },
    {
      title: t('seavoice.platform.landlineMobile.specs.infrastructure.title') || 'Global Infrastructure',
      description: t('seavoice.platform.landlineMobile.specs.infrastructure.description') || 'Redundant data centers across multiple regions'
    }
  ],
  technical: {
    title: t('seavoice.platform.landlineMobile.specs.technical.title') || 'Technical Specifications',
    rows: [
      {
        label: t('seavoice.platform.landlineMobile.specs.technical.concurrentCalls.label') || 'Concurrent Calls',
        value: t('seavoice.platform.landlineMobile.specs.technical.concurrentCalls.value') || 'Unlimited'
      },
      {
        label: t('seavoice.platform.landlineMobile.specs.technical.audioQuality.label') || 'Audio Quality',
        value: t('seavoice.platform.landlineMobile.specs.technical.audioQuality.value') || 'HD Voice (G.722)'
      },
      {
        label: t('seavoice.platform.landlineMobile.specs.technical.latency.label') || 'Latency',
        value: t('seavoice.platform.landlineMobile.specs.technical.latency.value') || '< 150ms'
      },
      {
        label: t('seavoice.platform.landlineMobile.specs.technical.uptimeSLA.label') || 'Uptime SLA',
        value: t('seavoice.platform.landlineMobile.specs.technical.uptimeSLA.value') || '99.99%'
      },
      {
        label: t('seavoice.platform.landlineMobile.specs.technical.globalCoverage.label') || 'Global Coverage',
        value: t('seavoice.platform.landlineMobile.specs.technical.globalCoverage.value') || '200+ countries'
      }
    ]
  }
};

// CTA 區塊
const cta = {
  title: t('seavoice.platform.landlineMobile.cta.title') || 'Ready to modernize your phone system?',
  subtitle: t('seavoice.platform.landlineMobile.cta.subtitle') || 'Connect your landline and mobile infrastructure to AI voice agents in minutes.',
  button: t('seavoice.platform.landlineMobile.cta.button') || 'Schedule Integration Call',
  href: 'https://meetings.hubspot.com/seasalt-ai/seasalt-demo'
};

// SVG 圖示（避免增加依賴，維持與舊版語意一致）
function getIconSvg(icon) {
  const icons = {
    phone: '<svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>',
    smartphone: '<svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><rect x="7" y="2" width="10" height="20" rx="2" ry="2"/><path d="M11 18h2"/></svg>',
    globe: '<svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"></path></svg>'
  };
  return icons[icon] || icons.phone;
}
---

<Layout seo={seoData} lang={currentLang}>
  <!-- Hero Section -->
  <section class="bg-gradient-to-br from-blue-50 via-white to-teal-50 py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <h1 class="text-4xl sm:text-5xl font-bold text-gray-900 mb-4">
          {t('seavoice.platform.landlineMobile.hero.title') || 'Landline & Mobile Voice Solutions'}
        </h1>
        <p class="text-lg sm:text-xl text-gray-600 max-w-3xl mx-auto mb-8">
          {t('seavoice.platform.landlineMobile.hero.subtitle') || 'AI-powered voice agents integrated with PSTN and mobile networks to serve customers globally.'}
        </p>
        <a href={cta.href} target="_blank" rel="noopener noreferrer" class="inline-block bg-blue-600 text-white px-8 py-4 rounded-lg text-lg font-semibold hover:bg-blue-700 transition-colors">
          {t('seavoice.platform.landlineMobile.hero.cta') || 'Sign Up Free'}
        </a>
      </div>
    </div>
  </section>

  <!-- Features Section -->
  <section class="py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl sm:text-4xl font-bold text-gray-900">
          {t('seavoice.platform.landlineMobile.features.title') || 'Universal Voice Connectivity'}
        </h2>
        <p class="text-gray-600 mt-3">
          {t('seavoice.platform.landlineMobile.features.subtitle') || 'Connect with any phone system worldwide'}
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {features.map((f) => (
          <div class="bg-white rounded-xl p-8 shadow-lg border border-gray-200 hover:shadow-xl transition-shadow">
            <div class="flex items-center mb-6">
              <div class="w-12 h-12 bg-gradient-to-r from-blue-600 to-teal-600 rounded-lg flex items-center justify-center mr-4">
                <Fragment set:html={getIconSvg(f.icon)} />
              </div>
              <h3 class="text-xl font-bold text-gray-900">{f.title}</h3>
            </div>
            <p class="text-gray-600 mb-6 leading-relaxed">{f.description}</p>
            <ul class="space-y-2">
              {f.bullets.map((b) => (
                <li class="flex items-center text-gray-700">
                  <div class="w-2 h-2 bg-blue-600 rounded-full mr-3"></div>
                  {b}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Use Cases Section -->
  <section class="py-16 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl sm:text-4xl font-bold text-gray-900">
          {t('seavoice.platform.landlineMobile.useCases.title') || 'Popular Use Cases'}
        </h2>
        <p class="text-gray-600 mt-3">
          {t('seavoice.platform.landlineMobile.useCases.subtitle') || 'See how businesses automate with landline and mobile voice'}
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {useCases.map((uc) => (
          <div class="bg-white rounded-xl p-8 shadow-lg border border-gray-200">
            <h3 class="text-xl font-bold text-gray-900 mb-2">{uc.title}</h3>
            <p class="text-gray-600 mb-4">{uc.description}</p>
            <ul class="space-y-2">
              {uc.metrics.map((m) => (
                <li class="flex items-center text-gray-700">
                  <div class="w-2 h-2 bg-blue-600 rounded-full mr-3"></div>
                  {m}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Specs Section -->
  <section class="py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl sm:text-4xl font-bold text-gray-900">{specs.title}</h2>
        <p class="text-gray-600 mt-3">{specs.subtitle}</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-10">
        {specs.items.map((item) => (
          <div class="bg-white rounded-xl p-6 shadow border border-gray-200">
            <h3 class="text-lg font-semibold text-gray-900 mb-2">{item.title}</h3>
            <p class="text-gray-600">{item.description}</p>
          </div>
        ))}
      </div>

      <div class="bg-white rounded-xl p-6 shadow border border-gray-200">
        <h3 class="text-xl font-bold text-gray-900 mb-4">{specs.technical.title}</h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {specs.technical.rows.map((row) => (
            <div class="flex items-center justify-between p-3 bg-gray-50 rounded border border-gray-100">
              <span class="text-gray-600">{row.label}</span>
              <span class="text-gray-900 font-medium">{row.value}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-16 bg-gradient-to-br from-teal-50 via-white to-blue-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-4">
        {t('seavoice.platform.landlineMobile.cta.title') || cta.title}
      </h2>
      <p class="text-gray-600 mb-8">
        {t('seavoice.platform.landlineMobile.cta.subtitle') || cta.subtitle}
      </p>
      <a href={cta.href} target="_blank" rel="noopener noreferrer" class="inline-block bg-blue-600 text-white px-8 py-4 rounded-lg text-lg font-semibold hover:bg-blue-700 transition-colors">
        {t('seavoice.platform.landlineMobile.cta.button') || cta.button}
      </a>
    </div>
  </section>
</Layout>
