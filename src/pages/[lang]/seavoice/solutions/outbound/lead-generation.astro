---
import Layout from '../../../../../layouts/Layout.astro';
import { getTranslationHelpers, type SupportedLanguage } from '../../../../../i18n/helpers';
import LeadGenerationInteractive from '../../../../../components/react/seavoice/LeadGenerationInteractive.tsx';

export async function getStaticPaths() {
  const supportedLocales: SupportedLanguage[] = [
    'en', 'es', 'zh-tw', 'zh-cn', 'ja', 'ko', 'fr', 'de', 'ar', 'fa', 
    'fil', 'hi', 'id', 'ms', 'pl', 'pt', 'ru', 'ta', 'th', 'vi'
  ];
  
  return supportedLocales.map((lang) => ({
    params: { lang }
  }));
}

const { lang } = Astro.params;
const currentLang = (lang as SupportedLanguage) || 'en';

const { t, translations } = await getTranslationHelpers(currentLang);

// SEO metadata - 使用現有的翻譯鍵或提供 fallback
const title = t('seavoice.home.useCases.outbound.leadGeneration.title') || 'Lead Generation & Qualification - SeaVoice';
const description = t('seavoice.home.useCases.outbound.leadGeneration.description') || 'Transform your sales pipeline with AI-powered lead generation that identifies and qualifies prospects automatically. Generate more qualified leads with intelligent voice conversations.';
const canonicalUrl = `${Astro.site}${currentLang}/seavoice/solutions/outbound/lead-generation`;

// Page data structures - 使用現有的翻譯鍵結構或提供 fallback 內容
const namespace = 'seavoice.pages.solutions.outbound.leadGeneration';

const features = [
  {
    title: t(`${namespace}.features.intelligentQualification.title`) || 'Intelligent Lead Qualification',
    description: t(`${namespace}.features.intelligentQualification.description`) || 'AI-powered qualification process that automatically scores leads and identifies high-value prospects.',
    benefits: [
      t(`${namespace}.features.intelligentQualification.benefits.automatedScoring`) || 'Automated lead scoring',
      t(`${namespace}.features.intelligentQualification.benefits.intentDetection`) || 'Intent detection',
      t(`${namespace}.features.intelligentQualification.benefits.demographicProfiling`) || 'Demographic profiling'
    ],
    icon: 'Target'
  },
  {
    title: t(`${namespace}.features.personalizedOutreach.title`) || 'Personalized Voice Outreach',
    description: t(`${namespace}.features.personalizedOutreach.description`) || 'Custom voice conversations tailored to each prospect\'s profile and interests.',
    benefits: [
      t(`${namespace}.features.personalizedOutreach.benefits.customMessaging`) || 'Custom messaging',
      t(`${namespace}.features.personalizedOutreach.benefits.behavioralTriggers`) || 'Behavioral triggers',
      t(`${namespace}.features.personalizedOutreach.benefits.contextualResponses`) || 'Contextual responses'
    ],
    icon: 'Phone'
  },
  {
    title: t(`${namespace}.features.realTimeAnalytics.title`) || 'Real-Time Analytics',
    description: t(`${namespace}.features.realTimeAnalytics.description`) || 'Track campaign performance and lead quality in real-time with comprehensive analytics.',
    benefits: [
      t(`${namespace}.features.realTimeAnalytics.benefits.conversionTracking`) || 'Conversion tracking',
      t(`${namespace}.features.realTimeAnalytics.benefits.qualityMetrics`) || 'Quality metrics',
      t(`${namespace}.features.realTimeAnalytics.benefits.roiAnalysis`) || 'ROI analysis'
    ],
    icon: 'BarChart3'
  }
];

const qualificationProcess = [
  {
    step: 1,
    title: t(`${namespace}.process.steps.initialContact.title`) || 'Initial Contact',
    description: t(`${namespace}.process.steps.initialContact.description`) || 'AI initiates personalized conversations with potential leads',
    outcome: t(`${namespace}.process.steps.initialContact.outcome`) || 'Contact established with 85% success rate'
  },
  {
    step: 2,
    title: t(`${namespace}.process.steps.needsAssessment.title`) || 'Needs Assessment', 
    description: t(`${namespace}.process.steps.needsAssessment.description`) || 'AI discovers customer pain points and requirements',
    outcome: t(`${namespace}.process.steps.needsAssessment.outcome`) || 'Qualified leads identified with 92% accuracy'
  },
  {
    step: 3,
    title: t(`${namespace}.process.steps.interestScoring.title`) || 'Interest Scoring',
    description: t(`${namespace}.process.steps.interestScoring.description`) || 'AI scores leads based on engagement and interest level',
    outcome: t(`${namespace}.process.steps.interestScoring.outcome`) || 'Priority leads ranked and categorized'
  },
  {
    step: 4,
    title: t(`${namespace}.process.steps.handoffToSales.title`) || 'Sales Handoff',
    description: t(`${namespace}.process.steps.handoffToSales.description`) || 'Qualified leads transferred to sales team with full context',
    outcome: t(`${namespace}.process.steps.handoffToSales.outcome`) || '3x higher close rate with warm leads'
  }
];

const benefits = [
  { 
    metric: t(`${namespace}.results.qualifiedLeads.metric`) || '350%',
    description: t(`${namespace}.results.qualifiedLeads.description`) || 'More qualified leads generated'
  },
  { 
    metric: t(`${namespace}.results.costReduction.metric`) || '60%',
    description: t(`${namespace}.results.costReduction.description`) || 'Reduction in cost per lead'
  },
  { 
    metric: t(`${namespace}.results.accuracy.metric`) || '92%',
    description: t(`${namespace}.results.accuracy.description`) || 'Lead qualification accuracy'
  },
  { 
    metric: t(`${namespace}.results.conversion.metric`) || '45%',
    description: t(`${namespace}.results.conversion.description`) || 'Increase in sales conversion'
  }
];

const industries = [
  {
    name: t(`${namespace}.industries.realEstate.name`) || 'Real Estate',
    description: t(`${namespace}.industries.realEstate.description`) || 'Generate qualified buyer and seller leads with property-specific conversations.',
    results: [
      t(`${namespace}.industries.realEstate.results.moreLeads`) || '40% more qualified leads',
      t(`${namespace}.industries.realEstate.results.fasterCycle`) || '25% faster sales cycle'
    ]
  },
  {
    name: t(`${namespace}.industries.insurance.name`) || 'Insurance',
    description: t(`${namespace}.industries.insurance.description`) || 'Identify prospects needing insurance coverage and qualify their requirements.',
    results: [
      t(`${namespace}.industries.insurance.results.increaseSales`) || '55% increase in sales',
      t(`${namespace}.industries.insurance.results.costReduction`) || '45% cost reduction'
    ]
  },
  {
    name: t(`${namespace}.industries.softwareSaas.name`) || 'Software & SaaS',
    description: t(`${namespace}.industries.softwareSaas.description`) || 'Generate demo requests and qualify software prospects effectively.',
    results: [
      t(`${namespace}.industries.softwareSaas.results.demoBookings`) || '3x more demo bookings',
      t(`${namespace}.industries.softwareSaas.results.closeRate`) || '60% higher close rate'
    ]
  }
];
---

<Layout 
  title={title}
  description={description}
  lang={currentLang}
  canonicalUrl={canonicalUrl}
>
  <div class="min-h-screen bg-white">
    <!-- Hero Section -->
    <section class="bg-gradient-to-br from-purple-50 via-white to-blue-50 py-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center animate-fade-in-up">
          <div class="flex items-center justify-center mb-6">
            <svg class="w-16 h-16 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
            </svg>
          </div>
          <h1 class="text-5xl font-bold text-gray-900 mb-6">
            {t(`${namespace}.hero.title`) || 'AI-Powered Lead Generation'}
          </h1>
          <p class="text-xl text-gray-600 max-w-3xl mx-auto mb-8">
            {t(`${namespace}.hero.subtitle`) || 'Transform your sales pipeline with intelligent voice conversations that identify, qualify, and nurture high-value prospects automatically.'}
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a
              href="https://meetings.hubspot.com/seasalt-ai/demo"
              target="_blank"
              rel="noopener noreferrer"
              class="bg-purple-600 text-white px-8 py-4 rounded-lg text-lg font-semibold hover:bg-purple-700 transition-colors inline-flex items-center justify-center space-x-2"
            >
              <span>{t(`${namespace}.hero.cta`) || 'Start Generating Leads'}</span>
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
              </svg>
            </a>
            <a
              href={`/${currentLang}/seavoice/pricing`}
              class="border-2 border-purple-600 text-purple-600 px-8 py-4 rounded-lg text-lg font-semibold hover:bg-purple-50 transition-colors"
            >
              {t('common.viewPricing') || 'View Pricing'}
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Features Section -->
    <section class="py-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16 animate-fade-in-up">
          <h2 class="text-4xl font-bold text-gray-900 mb-6">
            {t(`${namespace}.features.title`) || 'Advanced Lead Generation Features'}
          </h2>
          <p class="text-xl text-gray-600">
            {t(`${namespace}.features.subtitle`) || 'AI-powered tools that turn prospects into qualified leads'}
          </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
          {features.map((feature, index) => (
            <div class="bg-white rounded-xl p-8 shadow-lg border border-gray-200 hover:shadow-xl transition-shadow animate-fade-in-up-delay">
              <div class="w-12 h-12 bg-gradient-to-r from-purple-600 to-blue-600 rounded-lg flex items-center justify-center mb-6">
                {feature.icon === 'Target' && (
                  <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"></path>
                  </svg>
                )}
                {feature.icon === 'Phone' && (
                  <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
                  </svg>
                )}
                {feature.icon === 'BarChart3' && (
                  <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v4a2 2 0 01-2 2h-2a2 2 0 00-2 2z"></path>
                  </svg>
                )}
              </div>
              <h3 class="text-2xl font-bold text-gray-900 mb-4">{feature.title}</h3>
              <p class="text-gray-600 mb-6 leading-relaxed">{feature.description}</p>
              <div class="space-y-2">
                {feature.benefits.map((benefit, benefitIndex) => (
                  <div key={benefitIndex} class="flex items-center">
                    <svg class="w-4 h-4 text-green-500 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                    </svg>
                    <span class="text-sm text-gray-700">{benefit}</span>
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Interactive Qualification Process Section -->
    <LeadGenerationInteractive 
      client:only="react"
      lang={currentLang}
      translations={translations}
      qualificationProcess={qualificationProcess}
    />

    <!-- Benefits Metrics Section -->
    <section class="py-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16 animate-fade-in-up">
          <h2 class="text-4xl font-bold text-gray-900 mb-6">
            {t(`${namespace}.results.title`) || 'Proven Lead Generation Results'}
          </h2>
          <p class="text-xl text-gray-600">
            {t(`${namespace}.results.subtitle`) || 'See the impact of AI-powered lead generation on your business'}
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
          {benefits.map((benefit, index) => (
            <div class="bg-white rounded-xl p-8 shadow-lg text-center border border-gray-200 animate-fade-in-up-delay">
              <div class="text-4xl font-bold text-purple-600 mb-4">{benefit.metric}</div>
              <p class="text-gray-600">{benefit.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Industry Applications Section -->
    <section class="py-20 bg-gray-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16 animate-fade-in-up">
          <h2 class="text-4xl font-bold text-gray-900 mb-6">
            {t(`${namespace}.industries.title`) || 'Industry Success Stories'}
          </h2>
          <p class="text-xl text-gray-600">
            {t(`${namespace}.industries.subtitle`) || 'See how different industries benefit from AI lead generation'}
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {industries.map((industry, index) => (
            <div class="bg-white rounded-xl p-8 shadow-lg border border-gray-200 animate-fade-in-up-delay">
              <h3 class="text-xl font-bold text-gray-900 mb-4">{industry.name}</h3>
              <p class="text-gray-600 mb-6">{industry.description}</p>
              <div class="space-y-2">
                {industry.results.map((result, resultIndex) => (
                  <div key={resultIndex} class="flex items-center">
                    <svg class="w-4 h-4 text-green-500 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path>
                    </svg>
                    <span class="text-sm text-gray-700">{result}</span>
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="py-20 bg-gradient-to-r from-purple-600 to-blue-600 text-white">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <div class="animate-fade-in-up">
          <h2 class="text-4xl font-bold mb-6">
            {t(`${namespace}.cta.title`) || 'Ready to Transform Your Lead Generation?'}
          </h2>
          <p class="text-xl mb-8 opacity-90">
            {t(`${namespace}.cta.subtitle`) || 'Join thousands of businesses using AI to generate more qualified leads and grow their sales pipeline.'}
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a
              href="https://meetings.hubspot.com/seasalt-ai/demo"
              target="_blank"
              rel="noopener noreferrer"
              class="bg-white text-purple-600 px-8 py-4 rounded-lg text-lg font-semibold hover:bg-gray-100 transition-colors inline-flex items-center justify-center space-x-2"
            >
              <span>{t(`${namespace}.cta.startTrial`) || 'Start Free Trial'}</span>
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
              </svg>
            </a>
            <a
              href="https://meetings.hubspot.com/seasalt-ai/demo"
              target="_blank"
              rel="noopener noreferrer"
              class="border-2 border-white text-white px-8 py-4 rounded-lg text-lg font-semibold hover:bg-white hover:text-purple-600 transition-colors"
            >
              {t(`${namespace}.cta.scheduleDemo`) || 'Schedule Demo'}
            </a>
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>