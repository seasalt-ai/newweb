---
import Layout from '../../../../../layouts/Layout.astro';
import { getTranslationHelpers, type SupportedLanguage, supportedLocales } from '../../../../../i18n/helpers';

// Generate static paths for all supported languages
export async function getStaticPaths() {
  return supportedLocales.map((lang) => ({
    params: { lang }
  }));
}

const { lang } = Astro.params;
const currentLang = (lang as SupportedLanguage) || 'en';
const { t } = await getTranslationHelpers(currentLang);

// SEO配置
const seoData = {
  title: t('seavoice.pages.solutions.outbound.fraudAlerts.hero.title') || 'Fraud Alert System - SeaVoice',
  description: t('seavoice.pages.solutions.outbound.fraudAlerts.hero.description') || 'Protect your customers with instant fraud alerts. Our AI-powered system detects suspicious activities and automatically contacts customers to verify transactions.',
  canonical: `/${currentLang}/seavoice/solutions/outbound/fraud-alerts`,
};

// Breadcrumbs
const breadcrumbs = [
  { name: 'Home', url: `/${currentLang}/` },
  { name: 'SeaVoice', url: `/${currentLang}/seavoice/` },
  { name: 'Solutions', url: `/${currentLang}/seavoice/solutions/` },
  { name: 'Outbound', url: `/${currentLang}/seavoice/solutions/outbound/` },
  { name: t('seavoice.pages.solutions.outbound.fraudAlerts.breadcrumb') || 'Fraud Alerts' }
];

// FAQs
const faqs = [
  {
    question: t('seavoice.pages.solutions.outbound.fraudAlerts.faq.q1') || 'How quickly are customers contacted after detection?',
    answer: t('seavoice.pages.solutions.outbound.fraudAlerts.faq.a1') || 'Typically within 2 minutes. The system prioritizes high-risk events for immediate outreach.'
  },
  {
    question: t('seavoice.pages.solutions.outbound.fraudAlerts.faq.q2') || 'Can alerts be customized per risk level?',
    answer: t('seavoice.pages.solutions.outbound.fraudAlerts.faq.a2') || 'Yes. Alert scripts, channels, and thresholds can be tailored by segment and risk category.'
  }
];

// 功能配置
const features = [
  {
    icon: 'alert-triangle',
    title: t('seavoice.pages.solutions.outbound.fraudAlerts.features.realTimeDetection.title') || 'Real-time Detection',
    description: t('seavoice.pages.solutions.outbound.fraudAlerts.features.realTimeDetection.description') || 'Monitor transactions 24/7 and detect suspicious patterns instantly using advanced AI algorithms.'
  },
  {
    icon: 'phone',
    title: t('seavoice.pages.solutions.outbound.fraudAlerts.features.instantAlerts.title') || 'Instant Alerts',
    description: t('seavoice.pages.solutions.outbound.fraudAlerts.features.instantAlerts.description') || 'Automatically call customers within minutes of detecting suspicious activity to verify transactions.'
  },
  {
    icon: 'bar-chart-3',
    title: t('seavoice.pages.solutions.outbound.fraudAlerts.features.detailedAnalytics.title') || 'Detailed Analytics',
    description: t('seavoice.pages.solutions.outbound.fraudAlerts.features.detailedAnalytics.description') || 'Track fraud prevention metrics and customer response rates with comprehensive reporting.'
  }
];

// 工作流程配置
const workflowSteps = [
  {
    step: 1,
    title: t('seavoice.pages.solutions.outbound.fraudAlerts.howItWorks.step1.title') || 'Fraud Detection',
    description: t('seavoice.pages.solutions.outbound.fraudAlerts.howItWorks.step1.description') || 'System identifies suspicious transaction patterns',
    color: 'red'
  },
  {
    step: 2,
    title: t('seavoice.pages.solutions.outbound.fraudAlerts.howItWorks.step2.title') || 'Immediate Alert',
    description: t('seavoice.pages.solutions.outbound.fraudAlerts.howItWorks.step2.description') || 'AI agent calls customer within 2 minutes',
    color: 'orange'
  },
  {
    step: 3,
    title: t('seavoice.pages.solutions.outbound.fraudAlerts.howItWorks.step3.title') || 'Verification',
    description: t('seavoice.pages.solutions.outbound.fraudAlerts.howItWorks.step3.description') || 'Customer confirms or denies the transaction',
    color: 'blue'
  },
  {
    step: 4,
    title: t('seavoice.pages.solutions.outbound.fraudAlerts.howItWorks.step4.title') || 'Action Taken',
    description: t('seavoice.pages.solutions.outbound.fraudAlerts.howItWorks.step4.description') || 'Transaction approved or security measures activated',
    color: 'green'
  }
];

// 效益配置
const benefits = [
  {
    icon: 'shield',
    title: t('seavoice.pages.solutions.outbound.fraudAlerts.benefits.fraudPrevention.title') || 'Fraud Prevention',
    description: t('seavoice.pages.solutions.outbound.fraudAlerts.benefits.fraudPrevention.description') || 'Reduce fraudulent transactions by up to 85%',
    color: 'red'
  },
  {
    icon: 'clock',
    title: t('seavoice.pages.solutions.outbound.fraudAlerts.benefits.instantResponse.title') || 'Instant Response',
    description: t('seavoice.pages.solutions.outbound.fraudAlerts.benefits.instantResponse.description') || 'Alert customers within 2 minutes of detection',
    color: 'blue'
  },
  {
    icon: 'check-circle',
    title: t('seavoice.pages.solutions.outbound.fraudAlerts.benefits.customerTrust.title') || 'Customer Trust',
    description: t('seavoice.pages.solutions.outbound.fraudAlerts.benefits.customerTrust.description') || 'Build confidence with proactive protection',
    color: 'green'
  },
  {
    icon: 'bar-chart-3',
    title: t('seavoice.pages.solutions.outbound.fraudAlerts.benefits.smartAnalytics.title') || 'Smart Analytics',
    description: t('seavoice.pages.solutions.outbound.fraudAlerts.benefits.smartAnalytics.description') || 'Detailed insights on fraud patterns and trends',
    color: 'purple'
  }
];

// 使用案例配置
const useCases = [
  {
    title: t('seavoice.pages.solutions.outbound.fraudAlerts.useCases.banking.title') || 'Banking & Financial Services',
    items: [
      t('seavoice.pages.solutions.outbound.fraudAlerts.useCases.banking.item1') || 'Credit card fraud detection',
      t('seavoice.pages.solutions.outbound.fraudAlerts.useCases.banking.item2') || 'Unusual spending pattern alerts',
      t('seavoice.pages.solutions.outbound.fraudAlerts.useCases.banking.item3') || 'Account takeover prevention',
      t('seavoice.pages.solutions.outbound.fraudAlerts.useCases.banking.item4') || 'Large transaction verification'
    ]
  },
  {
    title: t('seavoice.pages.solutions.outbound.fraudAlerts.useCases.ecommerce.title') || 'E-commerce & Retail',
    items: [
      t('seavoice.pages.solutions.outbound.fraudAlerts.useCases.ecommerce.item1') || 'Suspicious purchase patterns',
      t('seavoice.pages.solutions.outbound.fraudAlerts.useCases.ecommerce.item2') || 'High-value order verification',
      t('seavoice.pages.solutions.outbound.fraudAlerts.useCases.ecommerce.item3') || 'Identity theft protection',
      t('seavoice.pages.solutions.outbound.fraudAlerts.useCases.ecommerce.item4') || 'Payment method changes'
    ]
  }
];

// 圖示組件映射
function getIconSvg(iconName: string) {
  const icons = {
    'shield': '<svg class="w-12 h-12 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>',
    'alert-triangle': '<svg class="w-12 h-12 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.268 16.5c-.77.833.192 2.5 1.732 2.5z"></path></svg>',
    'phone': '<svg class="w-12 h-12 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>',
    'bar-chart-3': '<svg class="w-12 h-12 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path></svg>',
    'clock': '<svg class="w-8 h-8 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>',
    'check-circle': '<svg class="w-8 h-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>',
    'check-small': '<svg class="w-5 h-5 text-green-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path></svg>'
  };
  return icons[iconName as keyof typeof icons] || icons.shield;
}

function getBenefitIcon(iconName: string, color: string) {
  const colorClasses = {
    red: 'bg-red-100 text-red-600',
    blue: 'bg-blue-100 text-blue-600',
    green: 'bg-green-100 text-green-600',
    purple: 'bg-purple-100 text-purple-600'
  };
  
  const icons = {
    'shield': `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>`,
    'clock': `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>`,
    'check-circle': `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>`,
    'bar-chart-3': `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path></svg>`
  };
  
  return `<div class="w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-4 ${colorClasses[color as keyof typeof colorClasses] || colorClasses.red}">${icons[iconName as keyof typeof icons] || icons.shield}</div>`;
}

function getStepColor(color: string) {
  const colors = {
    red: 'bg-red-100 text-red-600',
    orange: 'bg-orange-100 text-orange-600',
    blue: 'bg-blue-100 text-blue-600',
    green: 'bg-green-100 text-green-600'
  };
  return colors[color as keyof typeof colors] || colors.red;
}
---

<Layout seo={seoData} lang={currentLang} breadcrumbs={breadcrumbs} faqs={faqs}>
  <!-- Hero Section -->
  <section class="bg-gradient-to-r from-red-600 to-orange-600 text-white py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <Fragment set:html={getIconSvg('shield')} />
        <h1 class="text-4xl font-bold mb-6">
          {t('seavoice.pages.solutions.outbound.fraudAlerts.hero.title') || 'Fraud Alert System'}
        </h1>
        <p class="text-xl mb-8 max-w-3xl mx-auto">
          {t('seavoice.pages.solutions.outbound.fraudAlerts.hero.description') || 'Protect your customers with instant fraud alerts. Our AI-powered system detects suspicious activities and automatically contacts customers to verify transactions.'}
        </p>
      </div>
    </div>
  </section>

  <!-- Features Section -->
  <section class="py-20 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl font-bold text-gray-900 mb-4">
          {t('seavoice.pages.solutions.outbound.fraudAlerts.features.title') || 'Advanced Fraud Detection'}
        </h2>
        <p class="text-xl text-gray-600">
          {t('seavoice.pages.solutions.outbound.fraudAlerts.features.subtitle') || 'Real-time monitoring and intelligent alerting to protect your customers'}
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        {features.map((feature) => (
          <div class="bg-white p-8 rounded-xl shadow-lg">
            <Fragment set:html={getIconSvg(feature.icon)} />
            <h3 class="text-xl font-semibold mb-4">{feature.title}</h3>
            <p class="text-gray-600">{feature.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- How It Works Section -->
  <section class="py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold text-center mb-16">
        {t('seavoice.pages.solutions.outbound.fraudAlerts.howItWorks.title') || 'How Fraud Alerts Work'}
      </h2>
      
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div>
          <div class="space-y-8">
            {workflowSteps.map((step) => (
              <div class="flex items-start space-x-4">
                <div class={`p-2 rounded-lg ${getStepColor(step.color)}`}>
                  <span class="font-bold">{step.step}</span>
                </div>
                <div>
                  <h3 class="font-semibold mb-2">{step.title}</h3>
                  <p class="text-gray-600">{step.description}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <div class="bg-gradient-to-r from-red-50 to-orange-50 p-8 rounded-xl">
          <h3 class="text-xl font-semibold mb-4">
            {t('seavoice.pages.solutions.outbound.fraudAlerts.howItWorks.sampleCall.title') || 'Sample Alert Call'}
          </h3>
          <div class="bg-white p-4 rounded-lg shadow-sm">
            <p class="text-gray-700 italic">
              {t('seavoice.pages.solutions.outbound.fraudAlerts.howItWorks.sampleCall.message') || 'Hello, this is a security alert from [Bank Name]. We\'ve detected unusual activity on your account. A transaction of $500 at Amazon was just attempted. Did you authorize this purchase? Please press 1 to confirm or 2 if this was not you.'}
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Benefits Section -->
  <section class="py-20 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold text-center mb-16">
        {t('seavoice.pages.solutions.outbound.fraudAlerts.benefits.title') || 'Key Benefits'}
      </h2>
      
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
        {benefits.map((benefit) => (
          <div class="text-center">
            <Fragment set:html={getBenefitIcon(benefit.icon, benefit.color)} />
            <h3 class="font-semibold mb-2">{benefit.title}</h3>
            <p class="text-gray-600">{benefit.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Use Cases Section -->
  <section class="py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold text-center mb-16">
        {t('seavoice.pages.solutions.outbound.fraudAlerts.useCases.title') || 'Common Use Cases'}
      </h2>
      
      <div class="grid md:grid-cols-2 gap-8">
        {useCases.map((useCase) => (
          <div class="bg-white p-8 rounded-xl shadow-lg border">
            <h3 class="text-xl font-semibold mb-4">{useCase.title}</h3>
            <ul class="space-y-3 text-gray-600">
              {useCase.items.map((item) => (
                <li class="flex items-start">
                  <Fragment set:html={getIconSvg('check-small')} />
                  <span class="ml-2 mt-0.5 flex-shrink-0">{item}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-20 bg-gradient-to-r from-red-600 to-orange-600 text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-bold mb-4">
        {t('seavoice.pages.solutions.outbound.fraudAlerts.cta.title') || 'Protect Your Customers Today'}
      </h2>
      <p class="text-xl mb-8 max-w-3xl mx-auto">
        {t('seavoice.pages.solutions.outbound.fraudAlerts.cta.description') || 'Implement advanced fraud detection with automated customer alerts to reduce losses and build trust.'}
      </p>
      <a
        href="https://chat.seasalt.ai/gpt/signup"
        target="_blank"
        rel="noopener noreferrer"
        class="bg-white text-red-600 px-8 py-3 rounded-lg font-semibold hover:bg-gray-100 transition-colors inline-block"
      >
        {t('seavoice.pages.solutions.outbound.fraudAlerts.cta.button') || 'Get Started with Fraud Alerts'}
      </a>
    </div>
  </section>
</Layout>