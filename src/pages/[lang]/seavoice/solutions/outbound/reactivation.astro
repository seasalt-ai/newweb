---
// Generate static paths for all supported languages
export async function getStaticPaths() {
  const supportedLocales = [
    'en', 'es', 'zh-tw', 'zh-cn', 'ja', 'ko', 'fr', 'de', 'ar', 'fa',
    'fil', 'hi', 'id', 'ms', 'pl', 'pt', 'ru', 'ta', 'th', 'vi'
  ];
  
  return supportedLocales.map((lang) => ({
    params: { lang }
  }));
}

import Layout from '../../../../../layouts/Layout.astro';
import { getTranslationHelpers, type SupportedLanguage } from '../../../../../i18n/helpers';

const { lang } = Astro.params;
const currentLang = (lang as SupportedLanguage) || 'en';
const { t } = await getTranslationHelpers(currentLang);

// SEO配置
const seoData = {
  title: t('seo.seavoice.reactivation.title') || 'Customer Reactivation Campaigns - SeaVoice AI',
  description: t('seo.seavoice.reactivation.description') || 'Win back inactive customers with personalized AI-powered outreach campaigns. Re-engage past customers with compelling offers and rebuild valuable relationships that drive recurring revenue.',
  canonical: `/${currentLang}/seavoice/solutions/outbound/reactivation`,
  keywords: t('seo.seavoice.reactivation.keywords') || 'customer reactivation, win-back campaigns, AI outreach, personalized marketing, customer retention, SeaVoice',
};

// Breadcrumbs
const breadcrumbs = [
  { name: 'Home', url: `/${currentLang}/` },
  { name: 'SeaVoice', url: `/${currentLang}/seavoice/` },
  { name: 'Solutions', url: `/${currentLang}/seavoice/solutions/` },
  { name: 'Outbound', url: `/${currentLang}/seavoice/solutions/outbound/` },
  { name: t('seavoice.pages.solutions.outbound.customerReactivation.breadcrumb') || 'Customer Reactivation' }
];

// FAQs
const faqs = [
  {
    question: t('seavoice.pages.solutions.outbound.customerReactivation.faq.q1') || 'How do you segment inactive customers?',
    answer: t('seavoice.pages.solutions.outbound.customerReactivation.faq.a1') || 'AI groups customers by recency, frequency, and monetary value with behavior signals to tailor messages.'
  },
  {
    question: t('seavoice.pages.solutions.outbound.customerReactivation.faq.q2') || 'What incentives work best for reactivation?',
    answer: t('seavoice.pages.solutions.outbound.customerReactivation.faq.a2') || 'Common tactics include exclusive discounts, loyalty rewards, and product update invitations.'
  }
];

// 功能配置
const features = [
  {
    icon: 'target',
    title: t('seavoice.pages.solutions.outbound.customerReactivation.features.personalizedOutreach.title') || 'Personalized Outreach',
    description: t('seavoice.pages.solutions.outbound.customerReactivation.features.personalizedOutreach.description') || 'AI-powered conversations tailored to each customer\'s history and preferences.',
    benefits: [
      t('seavoice.pages.solutions.outbound.customerReactivation.features.personalizedOutreach.benefits.customMessaging') || 'Custom messaging',
      t('seavoice.pages.solutions.outbound.customerReactivation.features.personalizedOutreach.benefits.historicalContext') || 'Historical context',
      t('seavoice.pages.solutions.outbound.customerReactivation.features.personalizedOutreach.benefits.behavioralInsights') || 'Behavioral insights'
    ]
  },
  {
    icon: 'heart',
    title: t('seavoice.pages.solutions.outbound.customerReactivation.features.winBackCampaigns.title') || 'Win-Back Campaigns',
    description: t('seavoice.pages.solutions.outbound.customerReactivation.features.winBackCampaigns.description') || 'Strategic campaigns designed to re-engage inactive customers with compelling offers.',
    benefits: [
      t('seavoice.pages.solutions.outbound.customerReactivation.features.winBackCampaigns.benefits.specialPromotions') || 'Special promotions',
      t('seavoice.pages.solutions.outbound.customerReactivation.features.winBackCampaigns.benefits.loyaltyRewards') || 'Loyalty rewards',
      t('seavoice.pages.solutions.outbound.customerReactivation.features.winBackCampaigns.benefits.exclusiveAccess') || 'Exclusive access'
    ]
  },
  {
    icon: 'bar-chart',
    title: t('seavoice.pages.solutions.outbound.customerReactivation.features.performanceAnalytics.title') || 'Performance Analytics',
    description: t('seavoice.pages.solutions.outbound.customerReactivation.features.performanceAnalytics.description') || 'Track reactivation success rates and optimize campaigns for better results.',
    benefits: [
      t('seavoice.pages.solutions.outbound.customerReactivation.features.performanceAnalytics.benefits.conversionTracking') || 'Conversion tracking',
      t('seavoice.pages.solutions.outbound.customerReactivation.features.performanceAnalytics.benefits.abTesting') || 'A/B testing',
      t('seavoice.pages.solutions.outbound.customerReactivation.features.performanceAnalytics.benefits.roiAnalysis') || 'ROI analysis'
    ]
  }
];

// 重新激活流程配置
const reactivationProcess = [
  {
    step: 1,
    title: t('seavoice.pages.solutions.outbound.customerReactivation.process.steps.customerSegmentation.title') || 'Customer Segmentation',
    description: t('seavoice.pages.solutions.outbound.customerReactivation.process.steps.customerSegmentation.description') || 'Identify and categorize inactive customers based on their history and value',
    outcome: t('seavoice.pages.solutions.outbound.customerReactivation.process.steps.customerSegmentation.outcome') || 'Targeted approach: 3x higher response rate'
  },
  {
    step: 2,
    title: t('seavoice.pages.solutions.outbound.customerReactivation.process.steps.personalizedOutreach.title') || 'Personalized Outreach',
    description: t('seavoice.pages.solutions.outbound.customerReactivation.process.steps.personalizedOutreach.description') || 'AI crafts personalized messages based on customer preferences and history',
    outcome: t('seavoice.pages.solutions.outbound.customerReactivation.process.steps.personalizedOutreach.outcome') || 'Engagement rate: 45% vs 12% generic'
  },
  {
    step: 3,
    title: t('seavoice.pages.solutions.outbound.customerReactivation.process.steps.offerPresentation.title') || 'Offer Presentation',
    description: t('seavoice.pages.solutions.outbound.customerReactivation.process.steps.offerPresentation.description') || 'Present compelling win-back offers tailored to customer value and interests',
    outcome: t('seavoice.pages.solutions.outbound.customerReactivation.process.steps.offerPresentation.outcome') || 'Conversion rate: 25% with personalized offers'
  },
  {
    step: 4,
    title: t('seavoice.pages.solutions.outbound.customerReactivation.process.steps.followUpNurturing.title') || 'Follow-up & Nurturing',
    description: t('seavoice.pages.solutions.outbound.customerReactivation.process.steps.followUpNurturing.description') || 'Automated follow-up sequences to nurture interested customers back to active status',
    outcome: t('seavoice.pages.solutions.outbound.customerReactivation.process.steps.followUpNurturing.outcome') || 'Retention rate: 80% of reactivated customers'
  }
];

// 效益指標配置
const benefits = [
  { 
    metric: t('seavoice.pages.solutions.outbound.customerReactivation.results.reactivationRate.metric') || '35%', 
    description: t('seavoice.pages.solutions.outbound.customerReactivation.results.reactivationRate.description') || 'Customer reactivation rate'
  },
  { 
    metric: t('seavoice.pages.solutions.outbound.customerReactivation.results.costReduction.metric') || '60%', 
    description: t('seavoice.pages.solutions.outbound.customerReactivation.results.costReduction.description') || 'Cost reduction vs traditional methods'
  },
  { 
    metric: t('seavoice.pages.solutions.outbound.customerReactivation.results.responseRate.metric') || '3x', 
    description: t('seavoice.pages.solutions.outbound.customerReactivation.results.responseRate.description') || 'Higher response rate than generic campaigns'
  },
  { 
    metric: t('seavoice.pages.solutions.outbound.customerReactivation.results.retentionRate.metric') || '80%', 
    description: t('seavoice.pages.solutions.outbound.customerReactivation.results.retentionRate.description') || 'Retention rate of reactivated customers'
  }
];

// 行銷活動類型配置
const campaignTypes = [
  {
    type: t('seavoice.pages.solutions.outbound.customerReactivation.campaigns.winBackOffers.title') || 'Win-Back Offers',
    description: t('seavoice.pages.solutions.outbound.customerReactivation.campaigns.winBackOffers.description') || 'Special discounts and promotions to entice customers back',
    tactics: [
      t('seavoice.pages.solutions.outbound.customerReactivation.campaigns.winBackOffers.tactics.exclusiveDiscounts') || 'Exclusive discounts',
      t('seavoice.pages.solutions.outbound.customerReactivation.campaigns.winBackOffers.tactics.limitedTimeOffers') || 'Limited-time offers',
      t('seavoice.pages.solutions.outbound.customerReactivation.campaigns.winBackOffers.tactics.freeTrials') || 'Free trials'
    ]
  },
  {
    type: t('seavoice.pages.solutions.outbound.customerReactivation.campaigns.feedbackCollection.title') || 'Feedback Collection',
    description: t('seavoice.pages.solutions.outbound.customerReactivation.campaigns.feedbackCollection.description') || 'Understand why customers left and address their concerns',
    tactics: [
      t('seavoice.pages.solutions.outbound.customerReactivation.campaigns.feedbackCollection.tactics.exitSurveys') || 'Exit surveys',
      t('seavoice.pages.solutions.outbound.customerReactivation.campaigns.feedbackCollection.tactics.concernResolution') || 'Concern resolution',
      t('seavoice.pages.solutions.outbound.customerReactivation.campaigns.feedbackCollection.tactics.serviceImprovements') || 'Service improvements'
    ]
  },
  {
    type: t('seavoice.pages.solutions.outbound.customerReactivation.campaigns.productUpdates.title') || 'Product Updates',
    description: t('seavoice.pages.solutions.outbound.customerReactivation.campaigns.productUpdates.description') || 'Inform customers about new features or improvements',
    tactics: [
      t('seavoice.pages.solutions.outbound.customerReactivation.campaigns.productUpdates.tactics.featureAnnouncements') || 'Feature announcements',
      t('seavoice.pages.solutions.outbound.customerReactivation.campaigns.productUpdates.tactics.benefitExplanations') || 'Benefit explanations',
      t('seavoice.pages.solutions.outbound.customerReactivation.campaigns.productUpdates.tactics.demoInvitations') || 'Demo invitations'
    ]
  },
  {
    type: t('seavoice.pages.solutions.outbound.customerReactivation.campaigns.loyaltyRewards.title') || 'Loyalty Rewards',
    description: t('seavoice.pages.solutions.outbound.customerReactivation.campaigns.loyaltyRewards.description') || 'Recognize past loyalty and offer special treatment',
    tactics: [
      t('seavoice.pages.solutions.outbound.customerReactivation.campaigns.loyaltyRewards.tactics.vipStatus') || 'VIP status',
      t('seavoice.pages.solutions.outbound.customerReactivation.campaigns.loyaltyRewards.tactics.loyaltyPoints') || 'Loyalty points',
      t('seavoice.pages.solutions.outbound.customerReactivation.campaigns.loyaltyRewards.tactics.exclusiveAccess') || 'Exclusive access'
    ]
  }
];

// 圖示組件映射
function getIconSvg(iconName: string) {
  const icons = {
    'target': '<svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>',
    'heart': '<svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path></svg>',
    'bar-chart': '<svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path></svg>',
    'check-circle': '<svg class="w-4 h-4 text-green-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path></svg>',
    'user-plus': '<svg class="w-16 h-16 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path></svg>'
  };
  return icons[iconName as keyof typeof icons] || icons.target;
}
---

<Layout seo={seoData} lang={currentLang} breadcrumbs={breadcrumbs} faqs={faqs}>
  <!-- Hero Section -->
  <section class="bg-gradient-to-br from-orange-50 via-white to-red-50 py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <div class="flex items-center justify-center mb-6">
          <Fragment set:html={getIconSvg('user-plus')} />
        </div>
        <h1 class="text-5xl font-bold text-gray-900 mb-6">
          {t('seavoice.pages.solutions.outbound.customerReactivation.hero.title') || 'Customer Reactivation Campaigns'}
        </h1>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto mb-8">
          {t('seavoice.pages.solutions.outbound.customerReactivation.hero.subtitle') || 'Win back inactive customers with personalized AI-powered outreach campaigns. Re-engage past customers with compelling offers and rebuild valuable relationships that drive recurring revenue.'}
        </p>
        <a
          href="https://chat.seasalt.ai/gpt/signup"
          target="_blank"
          rel="noopener noreferrer"
          class="bg-orange-600 text-white px-8 py-4 rounded-lg text-lg font-semibold hover:bg-orange-700 transition-colors inline-block"
        >
          {t('seavoice.pages.solutions.outbound.customerReactivation.hero.cta') || 'Start Reactivation Campaign'}
        </a>
      </div>
    </div>
  </section>

  <!-- Features Section -->
  <section class="py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-4xl font-bold text-gray-900 mb-6">
          {t('seavoice.pages.solutions.outbound.customerReactivation.features.title') || 'Smart Reactivation Features'}
        </h2>
        <p class="text-xl text-gray-600">
          {t('seavoice.pages.solutions.outbound.customerReactivation.features.subtitle') || 'AI-powered campaigns that understand customer behavior and preferences'}
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        {features.map((feature, index) => (
          <div class="bg-white rounded-xl p-8 shadow-lg border border-gray-200 hover:shadow-xl transition-shadow">
            <div class="w-12 h-12 bg-gradient-to-r from-orange-600 to-red-600 rounded-lg flex items-center justify-center mb-6">
              <Fragment set:html={getIconSvg(feature.icon)} />
            </div>
            <h3 class="text-2xl font-bold text-gray-900 mb-4">{feature.title}</h3>
            <p class="text-gray-600 mb-6 leading-relaxed">{feature.description}</p>
            <div class="space-y-2">
              {feature.benefits.map((benefit, benefitIndex) => (
                <div class="flex items-center">
                  <Fragment set:html={getIconSvg('check-circle')} />
                  <span class="text-sm text-gray-700 ml-3">{benefit}</span>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Reactivation Process -->
  <section class="py-20 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-4xl font-bold text-gray-900 mb-6">
          {t('seavoice.pages.solutions.outbound.customerReactivation.process.title') || 'Reactivation Process'}
        </h2>
        <p class="text-xl text-gray-600">
          {t('seavoice.pages.solutions.outbound.customerReactivation.process.subtitle') || 'Strategic approach to winning back valuable customers'}
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        {reactivationProcess.map((process, index) => (
          <div class="text-center">
            <div class="w-16 h-16 bg-orange-600 text-white rounded-full flex items-center justify-center mx-auto mb-6 text-2xl font-bold">
              {process.step}
            </div>
            <h3 class="text-xl font-bold text-gray-900 mb-4">{process.title}</h3>
            <p class="text-gray-600 mb-4">{process.description}</p>
            <div class="p-3 bg-orange-50 rounded-lg">
              <p class="text-sm font-semibold text-orange-800">{process.outcome}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Campaign Types -->
  <section class="py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-4xl font-bold text-gray-900 mb-6">
          {t('seavoice.pages.solutions.outbound.customerReactivation.campaigns.title') || 'Reactivation Campaign Types'}
        </h2>
        <p class="text-xl text-gray-600">
          {t('seavoice.pages.solutions.outbound.customerReactivation.campaigns.subtitle') || 'Multiple strategies to re-engage different customer segments'}
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {campaignTypes.map((campaign, index) => (
          <div class="bg-white rounded-xl p-8 shadow-lg border border-gray-200">
            <h3 class="text-xl font-bold text-gray-900 mb-4">{campaign.type}</h3>
            <p class="text-gray-600 mb-6">{campaign.description}</p>
            <div class="space-y-2">
              {campaign.tactics.map((tactic, tacticIndex) => (
                <div class="flex items-center">
                  <div class="w-2 h-2 bg-orange-600 rounded-full mr-3"></div>
                  <span class="text-sm text-gray-700">{tactic}</span>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Benefits Metrics -->
  <section class="py-20 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-4xl font-bold text-gray-900 mb-6">
          {t('seavoice.pages.solutions.outbound.customerReactivation.results.title') || 'Reactivation Results'}
        </h2>
        <p class="text-xl text-gray-600">
          {t('seavoice.pages.solutions.outbound.customerReactivation.results.subtitle') || 'Proven success in winning back valuable customers'}
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        {benefits.map((benefit, index) => (
          <div class="bg-white rounded-xl p-8 shadow-lg text-center border border-gray-200">
            <div class="text-4xl font-bold text-orange-600 mb-4">{benefit.metric}</div>
            <p class="text-gray-600">{benefit.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-20 bg-gradient-to-r from-orange-600 to-red-600 text-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-4xl font-bold mb-6">
        {t('seavoice.pages.solutions.outbound.customerReactivation.cta.title') || 'Ready to Win Back Your Customers?'}
      </h2>
      <p class="text-xl mb-8 opacity-90">
        {t('seavoice.pages.solutions.outbound.customerReactivation.cta.subtitle') || 'Start personalized reactivation campaigns that rebuild valuable customer relationships'}
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="https://chat.seasalt.ai/gpt/signup"
          target="_blank"
          rel="noopener noreferrer"
          class="bg-white text-orange-600 px-8 py-4 rounded-lg text-lg font-semibold hover:bg-gray-100 transition-colors inline-block"
        >
          {t('seavoice.pages.solutions.outbound.customerReactivation.cta.startCampaign') || 'Start Campaign'}
        </a>
        <a
          href="https://seasalt.ai/case-studies"
          target="_blank"
          rel="noopener noreferrer"
          class="border-2 border-white text-white px-8 py-4 rounded-lg text-lg font-semibold hover:bg-white hover:text-orange-600 transition-colors inline-block"
        >
          {t('seavoice.pages.solutions.outbound.customerReactivation.cta.viewCaseStudies') || 'View Case Studies'}
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
/* 添加一些 CSS 動畫效果來模擬原 React 版本的 motion 效果 */
section {
  opacity: 0;
  transform: translateY(50px);
  animation: fadeInUp 0.8s ease-out forwards;
}

section:nth-child(2) {
  animation-delay: 0.2s;
}

section:nth-child(3) {
  animation-delay: 0.4s;
}

section:nth-child(4) {
  animation-delay: 0.6s;
}

section:nth-child(5) {
  animation-delay: 0.8s;
}

section:nth-child(6) {
  animation-delay: 1.0s;
}

@keyframes fadeInUp {
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.hover:shadow-xl {
  transition: box-shadow 0.3s ease;
}

.transition-colors {
  transition: color 0.3s ease, background-color 0.3s ease;
}

.transition-shadow {
  transition: box-shadow 0.3s ease;
}

/* 添加漸入效果給卡片 */
.bg-white {
  opacity: 0;
  transform: translateY(30px);
  animation: cardFadeIn 0.6s ease-out forwards;
}

.bg-white:nth-child(1) { animation-delay: 0.1s; }
.bg-white:nth-child(2) { animation-delay: 0.2s; }
.bg-white:nth-child(3) { animation-delay: 0.3s; }
.bg-white:nth-child(4) { animation-delay: 0.4s; }

@keyframes cardFadeIn {
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
</style>