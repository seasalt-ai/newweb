                <span class="text-xs bg-cyan-100 text-cyan-800 px-2 py-1 rounded">
                  {t('seavoice.pages.solutions.outbound.customerSurveys.surveyTypes.productDev.metrics.2') || 'Pain Points'}
                </span>
