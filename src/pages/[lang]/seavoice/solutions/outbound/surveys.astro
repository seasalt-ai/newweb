            {t('seavoice.pages.solutions.outbound.customerSurveys.sections.surveys.subtitle') || 'Tailored survey types for different business objectives and insights'}
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <!-- CSAT Survey -->
          <div class="bg-white rounded-xl p-8 shadow-lg border border-gray-200">
            <h3 class="text-xl font-bold text-gray-900 mb-4">
              {t('seavoice.pages.solutions.outbound.customerSurveys.surveyTypes.csat.title') || 'Customer Satisfaction (CSAT)'}
            </h3>
            <p class="text-gray-600 mb-6">
              {t('seavoice.pages.solutions.outbound.customerSurveys.surveyTypes.csat.description') || 'Measure overall satisfaction with products, services, or interactions'}
            </p>
            
            <div class="mb-6">
              <h4 class="font-semibold text-gray-900 text-sm mb-3">
                {t('seavoice.pages.solutions.outbound.customerSurveys.sections.sampleQuestions') || 'Sample Questions:'}
              </h4>
              <div class="space-y-2">
                <div class="flex items-start">
                  <div class="w-1.5 h-1.5 bg-cyan-600 rounded-full mr-2 mt-2"></div>
                  <span class="text-sm text-gray-700 italic">
                    "{t('seavoice.pages.solutions.outbound.customerSurveys.surveyTypes.csat.questions.0') || 'How satisfied are you with our service?'}"
                  </span>
                </div>
                <div class="flex items-start">
                  <div class="w-1.5 h-1.5 bg-cyan-600 rounded-full mr-2 mt-2"></div>
