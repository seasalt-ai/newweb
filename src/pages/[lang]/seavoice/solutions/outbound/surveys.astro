---
import Layout from '../../../../../layouts/Layout.astro';
import { getTranslationHelpers, type SupportedLanguage, supportedLocales } from '../../../../../i18n/helpers';
import CustomerSurveysHero from '../../../../../components/react/seavoice/CustomerSurveysHero';

// Generate static paths for all supported languages
export async function getStaticPaths() {
  return supportedLocales.map((lang) => ({
    params: { lang },
  }));
}

// Get language from URL parameters
const { lang } = Astro.params;
const currentLang = (lang as SupportedLanguage) || 'en';

// Get translation helpers for the current language
const { t, translations } = await getTranslationHelpers(currentLang);

// Generate SEO data
const seoData = {
  title: t('seo.seavoice.surveys.title') || 'Customer Survey Automation | SeaVoice AI Voice Solutions - Seasalt.ai',
  description: t('seo.seavoice.surveys.description') || 'Gather valuable customer feedback through natural voice conversations. Conduct automated surveys that feel personal and engaging, achieving higher response rates and more detailed insights than traditional methods.',
  keywords: t('seo.seavoice.surveys.keywords') || 'customer surveys, voice surveys, AI voice automation, feedback collection, CSAT surveys, post-purchase surveys, market research, SeaVoice',
  ogImage: '/images/og/seavoice-customer-surveys.jpg',
  canonicalUrl: `/${currentLang}/seavoice/solutions/outbound/surveys`
};

// Breadcrumbs
const breadcrumbs = [
  { name: 'Home', url: `/${currentLang}/` },
  { name: 'SeaVoice', url: `/${currentLang}/seavoice/` },
  { name: 'Solutions', url: `/${currentLang}/seavoice/solutions/` },
  { name: 'Outbound', url: `/${currentLang}/seavoice/solutions/outbound/` },
  { name: t('seavoice.pages.solutions.outbound.customerSurveys.breadcrumb') || 'Customer Surveys' }
];

// FAQs
const faqs = [
  {
    question: t('seavoice.pages.solutions.outbound.customerSurveys.faq.q1') || 'Do voice surveys get higher response rates?',
    answer: t('seavoice.pages.solutions.outbound.customerSurveys.faq.a1') || 'Yes. Conversational voice surveys often achieve higher completion rates and richer responses than forms.'
  },
  {
    question: t('seavoice.pages.solutions.outbound.customerSurveys.faq.q2') || 'Can results be exported to analytics tools?',
    answer: t('seavoice.pages.solutions.outbound.customerSurveys.faq.a2') || 'Yes. Responses and insights can be exported to BI tools or data warehouses.'
  }
];
---
<Layout seo={seoData} lang={currentLang} breadcrumbs={breadcrumbs} faqs={faqs}>
  <main>
    <!-- Hero Section -->
    <section class="bg-gradient-to-br from-cyan-50 via-white to-blue-50 py-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <CustomerSurveysHero 
          client:only="react"
          lang={currentLang}
          translations={translations}
        />
      </div>
    </section>

    <!-- Features Section -->
    <section class="py-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="text-4xl font-bold text-gray-900 mb-6">
            {t('seavoice.pages.solutions.outbound.customerSurveys.sections.features.title') || 'Intelligent Survey Features'}
          </h2>
          <p class="text-xl text-gray-600">
            {t('seavoice.pages.solutions.outbound.customerSurveys.sections.features.subtitle') || 'Advanced AI technology that makes surveys feel like natural conversations'}
          </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
          <!-- Conversational Surveys Feature -->
          <div class="bg-white rounded-xl p-8 shadow-lg border border-gray-200 hover:shadow-xl transition-shadow">
            <div class="w-12 h-12 bg-gradient-to-r from-cyan-600 to-blue-600 rounded-lg flex items-center justify-center mb-6">
              <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
              </svg>
            </div>
            <h3 class="text-2xl font-bold text-gray-900 mb-4">
              {t('seavoice.pages.solutions.outbound.customerSurveys.features.conversational.title') || 'Conversational Surveys'}
            </h3>
            <p class="text-gray-600 mb-6 leading-relaxed">
              {t('seavoice.pages.solutions.outbound.customerSurveys.features.conversational.description') || 'Natural voice conversations that feel like friendly discussions rather than formal surveys.'}
            </p>
            <div class="space-y-2">
              <div class="flex items-center">
                <svg class="w-4 h-4 text-green-500 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-sm text-gray-700">
                  {t('seavoice.pages.solutions.outbound.customerSurveys.features.conversational.benefits.0') || 'Higher response rates'}
                </span>
              </div>
              <div class="flex items-center">
                <svg class="w-4 h-4 text-green-500 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-sm text-gray-700">
                  {t('seavoice.pages.solutions.outbound.customerSurveys.features.conversational.benefits.1') || 'Natural interactions'}
                </span>
              </div>
              <div class="flex items-center">
                <svg class="w-4 h-4 text-green-500 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-sm text-gray-700">
                  {t('seavoice.pages.solutions.outbound.customerSurveys.features.conversational.benefits.2') || 'Detailed feedback'}
                </span>
              </div>
            </div>
          </div>

          <!-- Real-Time Analytics Feature -->
          <div class="bg-white rounded-xl p-8 shadow-lg border border-gray-200 hover:shadow-xl transition-shadow">
            <div class="w-12 h-12 bg-gradient-to-r from-cyan-600 to-blue-600 rounded-lg flex items-center justify-center mb-6">
              <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
              </svg>
            </div>
            <h3 class="text-2xl font-bold text-gray-900 mb-4">
