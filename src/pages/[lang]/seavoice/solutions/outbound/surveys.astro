          <!-- Market Research Survey -->
          <div class="bg-white rounded-xl p-8 shadow-lg border border-gray-200">
            <h3 class="text-xl font-bold text-gray-900 mb-4">
              {t('seavoice.pages.solutions.outbound.customerSurveys.surveyTypes.marketResearch.title') || 'Market Research'}
            </h3>
            <p class="text-gray-600 mb-6">
              {t('seavoice.pages.solutions.outbound.customerSurveys.surveyTypes.marketResearch.description') || 'Understand market trends, preferences, and competitive landscape'}
