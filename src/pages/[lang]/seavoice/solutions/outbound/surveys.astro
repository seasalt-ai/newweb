                {t('seavoice.pages.solutions.outbound.customerSurveys.sections.keyMetrics') || 'Key Metrics:'}
              </h4>
              <div class="flex flex-wrap gap-2">
                <span class="text-xs bg-cyan-100 text-cyan-800 px-2 py-1 rounded">
                  {t('seavoice.pages.solutions.outbound.customerSurveys.surveyTypes.csat.metrics.0') || 'CSAT Score'}
                </span>
                <span class="text-xs bg-cyan-100 text-cyan-800 px-2 py-1 rounded">
                  {t('seavoice.pages.solutions.outbound.customerSurveys.surveyTypes.csat.metrics.1') || 'Net Promoter Score'}
                </span>
                <span class="text-xs bg-cyan-100 text-cyan-800 px-2 py-1 rounded">
                  {t('seavoice.pages.solutions.outbound.customerSurveys.surveyTypes.csat.metrics.2') || 'Response Rate'}
                </span>
              </div>
            </div>
          </div>

          <!-- Post-Purchase Survey -->
          <div class="bg-white rounded-xl p-8 shadow-lg border border-gray-200">
            <h3 class="text-xl font-bold text-gray-900 mb-4">
              {t('seavoice.pages.solutions.outbound.customerSurveys.surveyTypes.postPurchase.title') || 'Post-Purchase Feedback'}
            </h3>
            <p class="text-gray-600 mb-6">
              {t('seavoice.pages.solutions.outbound.customerSurveys.surveyTypes.postPurchase.description') || 'Gather insights immediately after a purchase or service interaction'}
            </p>
            
            <div class="mb-6">
