    description: t('seavoice.pages.solutions.outbound.subscriptionRenewals.renewalProcess.step2.description') || 'Highlight subscription benefits and usage statistics',
    timing: t('seavoice.pages.solutions.outbound.subscriptionRenewals.renewalProcess.step2.timing') || '14 days before',
    action: t('seavoice.pages.solutions.outbound.subscriptionRenewals.renewalProcess.step2.action') || 'Value demonstration'
  },
  {
    step: 3,
