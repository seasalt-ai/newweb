];

// 效益指標配置
const benefits = [
  { 
    metric: t('seavoice.pages.solutions.outbound.subscriptionRenewals.benefits.metric1.value') || '85%', 
    description: t('seavoice.pages.solutions.outbound.subscriptionRenewals.benefits.metric1.description') || 'Subscription renewal rate'
  },
  { 
    metric: t('seavoice.pages.solutions.outbound.subscriptionRenewals.benefits.metric2.value') || '40%', 
