    description: t('seavoice.pages.solutions.outbound.subscriptionRenewals.renewalProcess.step3.description') || 'Direct renewal request with payment processing',
    timing: t('seavoice.pages.solutions.outbound.subscriptionRenewals.renewalProcess.step3.timing') || '7 days before',
    action: t('seavoice.pages.solutions.outbound.subscriptionRenewals.renewalProcess.step3.action') || 'Renewal processing'
