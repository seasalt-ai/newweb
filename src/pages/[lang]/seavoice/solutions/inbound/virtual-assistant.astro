---
import { getTranslationHelpers, type SupportedLanguage } from '../../../../../i18n/helpers';
import Layout from '../../../../../layouts/Layout.astro';

// Generate static paths for all supported languages
export async function getStaticPaths() {
  const supportedLocales = [
    'en', 'es', 'zh-tw', 'zh-cn', 'ja', 'ko', 'fr', 'de', 'ar', 'fa',
    'fil', 'hi', 'id', 'ms', 'pl', 'pt', 'ru', 'ta', 'th', 'vi'
  ];
  
  return supportedLocales.map((lang) => ({
    params: { lang }
  }));
}

// Extract language from params and validate it
const { lang } = Astro.params;
const validatedLang = (lang as SupportedLanguage) || 'en';

// Get translation helpers
const { t } = await getTranslationHelpers(validatedLang);

// SEO data
const seoTitle = t('seo.seavoice.virtualAssistant.title') || '24/7 Virtual Assistant - AI Voice Agent | SeaVoice';
const seoDescription = t('seo.seavoice.virtualAssistant.description') || 'Transform customer service with AI-powered virtual assistants that handle calls 24/7. Reduce wait times and improve satisfaction.';
const seoKeywords = t('seo.seavoice.virtualAssistant.keywords') || 'virtual assistant, AI voice agent, 24/7 customer service, automated phone support, SeaVoice';

// Breadcrumbs
const breadcrumbs = [
  { name: 'Home', url: `/${validatedLang}/` },
  { name: 'SeaVoice', url: `/${validatedLang}/seavoice/` },
  { name: 'Solutions', url: `/${validatedLang}/seavoice/solutions/` },
  { name: 'Inbound', url: `/${validatedLang}/seavoice/solutions/inbound/` },
  { name: t('seavoice.pages.solutions.inbound.virtualAssistant.breadcrumb') || 'Virtual Assistant' }
];

// FAQs
const faqs = [
  {
    question: t('seavoice.pages.solutions.inbound.virtualAssistant.faq.q1') || 'What tasks can the virtual assistant handle?',
    answer: t('seavoice.pages.solutions.inbound.virtualAssistant.faq.a1') || 'It can answer FAQs, route calls, schedule, collect information, and escalate to human agents with full context.'
  },
  {
    question: t('seavoice.pages.solutions.inbound.virtualAssistant.faq.q2') || 'Does it support multiple languages?',
    answer: t('seavoice.pages.solutions.inbound.virtualAssistant.faq.a2') || 'Yes. Multi-language is supported with natural speech understanding and generation.'
  }
];

// Features data
const features = [
  {
    icon: 'Clock',
    title: t('seavoice.pages.solutions.inbound.virtualAssistant.features.availability.title') || '24/7 Availability',
    description: t('seavoice.pages.solutions.inbound.virtualAssistant.features.availability.description') || 'Never miss a call with round-the-clock AI assistance',
    benefits: [
      t('seavoice.pages.solutions.inbound.virtualAssistant.features.availability.benefits.0') || 'Always available, even during holidays',
      t('seavoice.pages.solutions.inbound.virtualAssistant.features.availability.benefits.1') || 'Instant response to customer inquiries',
      t('seavoice.pages.solutions.inbound.virtualAssistant.features.availability.benefits.2') || 'Reduce customer wait times to zero'
    ]
  },
  {
    icon: 'Phone',
    title: t('seavoice.pages.solutions.inbound.virtualAssistant.features.callHandling.title') || 'Smart Call Handling',
    description: t('seavoice.pages.solutions.inbound.virtualAssistant.features.callHandling.description') || 'Intelligent call routing and response management',
    benefits: [
      t('seavoice.pages.solutions.inbound.virtualAssistant.features.callHandling.benefits.0') || 'Natural conversation flow',
      t('seavoice.pages.solutions.inbound.virtualAssistant.features.callHandling.benefits.1') || 'Context-aware responses',
      t('seavoice.pages.solutions.inbound.virtualAssistant.features.callHandling.benefits.2') || 'Seamless escalation when needed'
    ]
  },
  {
    icon: 'Users',
    title: t('seavoice.pages.solutions.inbound.virtualAssistant.features.handoffs.title') || 'Intelligent Handoffs',
    description: t('seavoice.pages.solutions.inbound.virtualAssistant.features.handoffs.description') || 'Smooth transitions to human agents when required',
    benefits: [
      t('seavoice.pages.solutions.inbound.virtualAssistant.features.handoffs.benefits.0') || 'Context preservation during transfers',
      t('seavoice.pages.solutions.inbound.virtualAssistant.features.handoffs.benefits.1') || 'Intelligent routing to specialists',
      t('seavoice.pages.solutions.inbound.virtualAssistant.features.handoffs.benefits.2') || 'Detailed call summaries for agents'
    ]
  }
];

// Use cases data
const useCases = [
  {
    title: t('seavoice.pages.solutions.inbound.virtualAssistant.useCases.healthcare.title') || 'Healthcare Support',
    description: t('seavoice.pages.solutions.inbound.virtualAssistant.useCases.healthcare.description') || 'Handle appointment scheduling, prescription refills, and general inquiries',
    metrics: [
      t('seavoice.pages.solutions.inbound.virtualAssistant.useCases.healthcare.metrics.0') || '80% reduction in call wait times',
      t('seavoice.pages.solutions.inbound.virtualAssistant.useCases.healthcare.metrics.1') || '24/7 patient support availability',
      t('seavoice.pages.solutions.inbound.virtualAssistant.useCases.healthcare.metrics.2') || '95% patient satisfaction rate'
    ]
  },
  {
    title: t('seavoice.pages.solutions.inbound.virtualAssistant.useCases.ecommerce.title') || 'E-commerce Support',
    description: t('seavoice.pages.solutions.inbound.virtualAssistant.useCases.ecommerce.description') || 'Provide product information, track orders, and handle returns',
    metrics: [
      t('seavoice.pages.solutions.inbound.virtualAssistant.useCases.ecommerce.metrics.0') || '60% increase in customer satisfaction',
      t('seavoice.pages.solutions.inbound.virtualAssistant.useCases.ecommerce.metrics.1') || '40% reduction in support costs',
      t('seavoice.pages.solutions.inbound.virtualAssistant.useCases.ecommerce.metrics.2') || '24/7 order tracking assistance'
    ]
  },
  {
    title: t('seavoice.pages.solutions.inbound.virtualAssistant.useCases.financial.title') || 'Financial Services',
    description: t('seavoice.pages.solutions.inbound.virtualAssistant.useCases.financial.description') || 'Secure account assistance, balance inquiries, and fraud reporting',
    metrics: [
      t('seavoice.pages.solutions.inbound.virtualAssistant.useCases.financial.metrics.0') || '99.9% security compliance',
      t('seavoice.pages.solutions.inbound.virtualAssistant.useCases.financial.metrics.1') || '50% faster transaction processing',
      t('seavoice.pages.solutions.inbound.virtualAssistant.useCases.financial.metrics.2') || '24/7 fraud protection monitoring'
    ]
  }
];

// Benefits data
const benefits = [
  { 
    metric: '80%', 
    description: t('seavoice.pages.solutions.inbound.virtualAssistant.metrics.abandonment.description') || 'Reduction in call abandonment'
  },
  { 
    metric: '24/7', 
    description: t('seavoice.pages.solutions.inbound.virtualAssistant.metrics.availability.description') || 'Always available service'
  },
  { 
    metric: '60%', 
    description: t('seavoice.pages.solutions.inbound.virtualAssistant.metrics.costSavings.description') || 'Cost savings on support'
  },
  { 
    metric: '95%', 
    description: t('seavoice.pages.solutions.inbound.virtualAssistant.metrics.satisfaction.description') || 'Customer satisfaction rate'
  }
];
---

<Layout 
  title={seoTitle}
  description={seoDescription}
  keywords={seoKeywords}
  lang={validatedLang}
  breadcrumbs={breadcrumbs}
  faqs={faqs}
>
  <!-- Hero Section -->
  <section class="bg-gradient-to-br from-blue-50 via-white to-purple-50 py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <div class="flex items-center justify-center mb-6">
          <svg class="w-16 h-16 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <h1 class="text-5xl font-bold text-gray-900 mb-6">
          {t('seavoice.pages.solutions.inbound.virtualAssistant.hero.title') || '24/7 AI Virtual Assistant'}
        </h1>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto mb-8">
          {t('seavoice.pages.solutions.inbound.virtualAssistant.hero.description') || 'Transform your customer service with AI-powered virtual assistants that never sleep, ensuring every call is answered professionally and promptly.'}
        </p>
        <a 
          href={`/${validatedLang}/seavoice/pricing`}
          class="inline-block bg-blue-600 text-white px-8 py-4 rounded-lg text-lg font-semibold hover:bg-blue-700 transition-colors"
        >
          {t('seavoice.pages.solutions.inbound.virtualAssistant.hero.primaryCta') || 'Get Started Today'}
        </a>
      </div>
    </div>
  </section>

  <!-- Features Section -->
  <section class="py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-4xl font-bold text-gray-900 mb-6">
          {t('seavoice.pages.solutions.inbound.virtualAssistant.features.title') || 'Key Features'}
        </h2>
        <p class="text-xl text-gray-600">
          {t('seavoice.pages.solutions.inbound.virtualAssistant.features.description') || 'Powerful capabilities that make our virtual assistants indispensable to your business'}
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        {features.map((feature, index) => (
          <div class="bg-white rounded-xl p-8 shadow-lg border border-gray-200 hover:shadow-xl transition-shadow">
            <div class="w-12 h-12 bg-gradient-to-r from-blue-600 to-purple-600 rounded-lg flex items-center justify-center mb-6">
              {feature.icon === 'Clock' && (
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              )}
              {feature.icon === 'Phone' && (
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
              )}
              {feature.icon === 'Users' && (
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197m13.5-9a2.5 2.5 0 11-5 0 2.5 2.5 0 015 0z" />
                </svg>
              )}
            </div>
            <h3 class="text-2xl font-bold text-gray-900 mb-4">{feature.title}</h3>
            <p class="text-gray-600 mb-6 leading-relaxed">{feature.description}</p>
            <div class="space-y-2">
              {feature.benefits.map((benefit, benefitIndex) => (
                <div class="flex items-center">
                  <svg class="w-4 h-4 text-green-500 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  <span class="text-sm text-gray-700">{benefit}</span>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Benefits Metrics -->
  <section class="py-20 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-4xl font-bold text-gray-900 mb-6">
          {t('seavoice.pages.solutions.inbound.virtualAssistant.benefits.title') || 'Proven Results'}
        </h2>
        <p class="text-xl text-gray-600">
          {t('seavoice.pages.solutions.inbound.virtualAssistant.benefits.description') || 'See the measurable impact of our virtual assistant technology'}
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        {benefits.map((benefit, index) => (
          <div class="bg-white rounded-xl p-8 shadow-lg text-center">
            <div class="text-4xl font-bold text-blue-600 mb-4">{benefit.metric}</div>
            <p class="text-gray-600">{benefit.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Use Cases -->
  <section class="py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-4xl font-bold text-gray-900 mb-6">
          {t('seavoice.pages.solutions.inbound.virtualAssistant.useCases.title') || 'Industry Applications'}
        </h2>
        <p class="text-xl text-gray-600">
          {t('seavoice.pages.solutions.inbound.virtualAssistant.useCases.description') || 'Discover how virtual assistants transform customer service across industries'}
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {useCases.map((useCase, index) => (
          <div class="bg-white rounded-xl p-8 shadow-lg border border-gray-200">
            <h3 class="text-xl font-bold text-gray-900 mb-4">{useCase.title}</h3>
            <p class="text-gray-600 mb-6">{useCase.description}</p>
            <div class="space-y-2">
              {useCase.metrics.map((metric, metricIndex) => (
                <div class="flex items-center">
                  <div class="w-2 h-2 bg-blue-600 rounded-full mr-3"></div>
                  <span class="text-sm text-gray-700">{metric}</span>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-20 bg-gradient-to-r from-blue-600 to-purple-600 text-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-4xl font-bold mb-6">
        {t('seavoice.pages.solutions.inbound.virtualAssistant.cta.title') || 'Ready to Deploy Your Virtual Assistant?'}
      </h2>
      <p class="text-xl mb-8 opacity-90">
        {t('seavoice.pages.solutions.inbound.virtualAssistant.cta.description') || 'Join thousands of businesses using AI virtual assistants to deliver exceptional customer service 24/7.'}
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a 
          href={`/${validatedLang}/seavoice/pricing`}
          class="inline-block bg-white text-blue-600 px-8 py-4 rounded-lg text-lg font-semibold hover:bg-gray-100 transition-colors"
        >
          {t('seavoice.pages.solutions.inbound.virtualAssistant.cta.primaryButton') || 'Start Free Trial'}
        </a>
        <a 
          href="https://meetings.hubspot.com/seasalt-ai/seasalt-demo"
          target="_blank"
          class="inline-block border-2 border-white text-white px-8 py-4 rounded-lg text-lg font-semibold hover:bg-white hover:text-blue-600 transition-colors"
        >
          {t('seavoice.pages.solutions.inbound.virtualAssistant.cta.secondaryButton') || 'Schedule Demo'}
        </a>
      </div>
    </div>
  </section>
</Layout>