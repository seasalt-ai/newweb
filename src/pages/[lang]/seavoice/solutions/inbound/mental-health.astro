---
import { getTranslationHelpers, type SupportedLanguage } from '../../../../../i18n/helpers';
import Layout from '../../../../../layouts/Layout.astro';

// Generate static paths for all supported languages
export async function getStaticPaths() {
  const supportedLocales = [
    'en', 'es', 'zh-tw', 'zh-cn', 'ja', 'ko', 'fr', 'de', 'ar', 'fa',
    'fil', 'hi', 'id', 'ms', 'pl', 'pt', 'ru', 'ta', 'th', 'vi'
  ];
  
  return supportedLocales.map((lang) => ({
    params: { lang }
  }));
}

const { lang } = Astro.params;
const currentLang = (lang as SupportedLanguage) || 'en';
const { t } = await getTranslationHelpers(currentLang);

// Generate SEO data using the same keys as the original React component
const seoData = {
  title: t('seo.seavoice.mentalHealth.title') || 'Mental Health Voice Companion - 24/7 AI Support | SeaVoice',
  description: t('seo.seavoice.mentalHealth.description') || 'Provide compassionate, 24/7 mental health support with AI that listens, understands, and responds with empathy. Safely bridge the gap between crisis and professional care.',
  keywords: t('seo.seavoice.mentalHealth.keywords') || 'mental health AI, crisis intervention, voice companion, 24/7 support, empathetic AI, mental health screening',
  ogImage: '/images/og/seavoice-mental-health.jpg'
};

// Features data - matching the original structure exactly
const features = [
  {
    icon: 'heart',
    title: t('seavoice.solutions.inbound.mentalHealth.features.empathetic.title') || 'Empathetic AI Companion',
    description: t('seavoice.solutions.inbound.mentalHealth.features.empathetic.description') || 'Trained to provide compassionate, non-judgmental support with appropriate emotional responses.',
    benefits: [
      t('seavoice.solutions.inbound.mentalHealth.features.empathetic.benefits.activeListening') || 'Active listening techniques',
      t('seavoice.solutions.inbound.mentalHealth.features.empathetic.benefits.emotionalValidation') || 'Emotional validation and support',
      t('seavoice.solutions.inbound.mentalHealth.features.empathetic.benefits.crisisRecognition') || 'Crisis recognition and response'
    ]
  },
  {
    icon: 'shield',
    title: t('seavoice.solutions.inbound.mentalHealth.features.safe.title') || 'Safe & Confidential',
    description: t('seavoice.solutions.inbound.mentalHealth.features.safe.description') || 'HIPAA-compliant platform ensuring complete privacy and confidentiality for all interactions.',
    benefits: [
      t('seavoice.solutions.inbound.mentalHealth.features.safe.benefits.hipaaCompliance') || 'HIPAA compliance guaranteed',
      t('seavoice.solutions.inbound.mentalHealth.features.safe.benefits.encryptedConversations') || 'End-to-end encrypted conversations',
      t('seavoice.solutions.inbound.mentalHealth.features.safe.benefits.anonymousOptions') || 'Anonymous interaction options'
    ]
  },
  {
    icon: 'clock',
    title: t('seavoice.solutions.inbound.mentalHealth.features.availability.title') || '24/7 Availability',
    description: t('seavoice.solutions.inbound.mentalHealth.features.availability.description') || 'Always available when someone needs to talk, providing immediate support during crisis moments.',
    benefits: [
      t('seavoice.solutions.inbound.mentalHealth.features.availability.benefits.roundTheClockAccess') || 'Round-the-clock access',
      t('seavoice.solutions.inbound.mentalHealth.features.availability.benefits.immediateResponse') || 'Immediate response times',
      t('seavoice.solutions.inbound.mentalHealth.features.availability.benefits.noWaitTimes') || 'No wait times or queues'
    ]
  }
];

// Capabilities data - matching the original structure
const capabilities = [
  {
    title: t('seavoice.solutions.inbound.mentalHealth.capabilities.screening.title') || 'Initial Mental Health Screening',
    description: t('seavoice.solutions.inbound.mentalHealth.capabilities.screening.description') || 'Conduct preliminary assessments using validated screening tools to identify support needs.',
    outcomes: [
      t('seavoice.solutions.inbound.mentalHealth.capabilities.screening.outcomes.earlyIdentification') || 'Early identification of mental health concerns',
      t('seavoice.solutions.inbound.mentalHealth.capabilities.screening.outcomes.riskAssessment') || 'Risk assessment and severity evaluation',
      t('seavoice.solutions.inbound.mentalHealth.capabilities.screening.outcomes.appropriateReferrals') || 'Appropriate referrals to professionals'
    ]
  },
  {
    title: t('seavoice.solutions.inbound.mentalHealth.capabilities.crisis.title') || 'Crisis Intervention',
    description: t('seavoice.solutions.inbound.mentalHealth.capabilities.crisis.description') || 'Recognize crisis situations and provide immediate support with proper escalation protocols.',
    outcomes: [
      t('seavoice.solutions.inbound.mentalHealth.capabilities.crisis.outcomes.crisisDetection') || 'Advanced crisis detection algorithms',
      t('seavoice.solutions.inbound.mentalHealth.capabilities.crisis.outcomes.deEscalationTechniques') || 'Proven de-escalation techniques',
      t('seavoice.solutions.inbound.mentalHealth.capabilities.crisis.outcomes.emergencyProtocols') || 'Immediate emergency protocol activation'
    ]
  },
  {
    title: t('seavoice.solutions.inbound.mentalHealth.capabilities.navigation.title') || 'Resource Navigation',
    description: t('seavoice.solutions.inbound.mentalHealth.capabilities.navigation.description') || 'Guide users to appropriate mental health resources and professional services in their area.',
    outcomes: [
      t('seavoice.solutions.inbound.mentalHealth.capabilities.navigation.outcomes.serviceMatching') || 'Intelligent service matching',
      t('seavoice.solutions.inbound.mentalHealth.capabilities.navigation.outcomes.appointmentScheduling') || 'Appointment scheduling assistance',
      t('seavoice.solutions.inbound.mentalHealth.capabilities.navigation.outcomes.followUpSupport') || 'Follow-up support coordination'
    ]
  },
  {
    title: t('seavoice.solutions.inbound.mentalHealth.capabilities.emotional.title') || 'Emotional Support',
    description: t('seavoice.solutions.inbound.mentalHealth.capabilities.emotional.description') || 'Provide compassionate listening and emotional validation during difficult times.',
    outcomes: [
      t('seavoice.solutions.inbound.mentalHealth.capabilities.emotional.outcomes.reducedIsolation') || 'Reduced feelings of isolation',
      t('seavoice.solutions.inbound.mentalHealth.capabilities.emotional.outcomes.emotionalRelief') || 'Immediate emotional relief',
      t('seavoice.solutions.inbound.mentalHealth.capabilities.emotional.outcomes.copingStrategies') || 'Practical coping strategies'
    ]
  }
];

// Benefits metrics - matching original
const benefits = [
  { 
    metric: '24/7', 
    description: t('seavoice.solutions.inbound.mentalHealth.benefits.alwaysAvailableSupport') || 'Always available mental health support'
  },
  { 
    metric: '60%', 
    description: t('seavoice.solutions.inbound.mentalHealth.benefits.crisisEscalationReduction') || 'Reduction in crisis escalation rates'
  },
  { 
    metric: '85%', 
    description: t('seavoice.solutions.inbound.mentalHealth.benefits.userSatisfactionRate') || 'User satisfaction with AI interactions'
  },
  { 
    metric: '40%', 
    description: t('seavoice.solutions.inbound.mentalHealth.benefits.helpSeekingBehaviorIncrease') || 'Increase in help-seeking behavior'
  }
];

// Safety features - matching original array
const safetyFeatures = [
  t('seavoice.solutions.inbound.mentalHealth.safetyFeatures.crisisKeywordDetection') || 'Crisis keyword detection and analysis',
  t('seavoice.solutions.inbound.mentalHealth.safetyFeatures.suicideRiskAssessment') || 'Suicide risk assessment protocols',
  t('seavoice.solutions.inbound.mentalHealth.safetyFeatures.automaticEscalationProtocols') || 'Automatic escalation to professionals',
  t('seavoice.solutions.inbound.mentalHealth.safetyFeatures.emergencyContactIntegration') || 'Emergency contact integration',
  t('seavoice.solutions.inbound.mentalHealth.safetyFeatures.professionalHandoffProcedures') || 'Seamless professional handoff procedures',
  t('seavoice.solutions.inbound.mentalHealth.safetyFeatures.followUpScheduling') || 'Follow-up appointment scheduling'
];
---

<Layout 
  title={seoData.title}
  description={seoData.description}
  keywords={seoData.keywords}
  ogImage={seoData.ogImage}
  lang={currentLang}
  jsonLd={{
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": seoData.title,
    "description": seoData.description,
    "url": Astro.url.href,
    "isPartOf": {
      "@type": "WebSite",
      "name": "Seasalt.ai",
      "url": "https://seasalt.ai"
    },
    "about": {
      "@type": "SoftwareApplication",
      "name": "SeaVoice Mental Health Companion",
      "description": seoData.description,
      "applicationCategory": "HealthApplication",
      "operatingSystem": "Any",
      "offers": {
        "@type": "Offer",
        "description": "AI-powered mental health support and crisis intervention"
      }
    }
  }}
>

  <!-- Hero Section -->
  <section class="bg-gradient-to-br from-pink-50 via-white to-purple-50 py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <div class="flex items-center justify-center mb-6">
          <svg class="w-16 h-16 text-pink-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
          </svg>
        </div>
        <h1 class="text-5xl font-bold text-gray-900 mb-6">
          {t('seavoice.solutions.inbound.mentalHealth.hero.title') || 'Mental Health Voice Companion'}
        </h1>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto mb-8">
          {t('seavoice.solutions.inbound.mentalHealth.hero.description') || 'Provide compassionate, 24/7 mental health support with AI that listens, understands, and responds with empathy. Safely bridge the gap between crisis and professional care.'}
        </p>
        <a 
          href={`/${currentLang}/seavoice/pricing`}
          class="inline-block bg-pink-600 text-white px-8 py-4 rounded-lg text-lg font-semibold hover:bg-pink-700 transition-colors"
        >
          {t('seavoice.solutions.inbound.mentalHealth.hero.cta') || 'Learn About Mental Health AI'}
        </a>
      </div>
    </div>
  </section>

  <!-- Features Section -->
  <section class="py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-4xl font-bold text-gray-900 mb-6">
          {t('seavoice.solutions.inbound.mentalHealth.features.title') || 'Compassionate AI Support'}
        </h2>
        <p class="text-xl text-gray-600">
          {t('seavoice.solutions.inbound.mentalHealth.features.description') || 'Advanced AI trained in mental health support and crisis intervention techniques'}
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        {features.map((feature, index) => (
          <div class="bg-white rounded-xl p-8 shadow-lg border border-gray-200 hover:shadow-xl transition-shadow">
            <div class="w-12 h-12 bg-gradient-to-r from-pink-600 to-purple-600 rounded-lg flex items-center justify-center mb-6">
              {feature.icon === 'heart' && (
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                </svg>
              )}
              {feature.icon === 'shield' && (
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                </svg>
              )}
              {feature.icon === 'clock' && (
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              )}
            </div>
            <h3 class="text-2xl font-bold text-gray-900 mb-4">{feature.title}</h3>
            <p class="text-gray-600 mb-6 leading-relaxed">{feature.description}</p>
            <div class="space-y-2">
              {feature.benefits.map((benefit, benefitIndex) => (
                <div class="flex items-center">
                  <svg class="w-4 h-4 text-green-500 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  <span class="text-sm text-gray-700">{benefit}</span>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Capabilities Section -->
  <section class="py-20 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-4xl font-bold text-gray-900 mb-6">
          {t('seavoice.solutions.inbound.mentalHealth.capabilities.title') || 'Mental Health Support Capabilities'}
        </h2>
        <p class="text-xl text-gray-600">
          {t('seavoice.solutions.inbound.mentalHealth.capabilities.description') || 'Comprehensive support across the mental health care spectrum'}
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {capabilities.map((capability, index) => (
          <div class="bg-white rounded-xl p-8 shadow-lg border border-gray-200">
            <h3 class="text-xl font-bold text-gray-900 mb-4">{capability.title}</h3>
            <p class="text-gray-600 mb-6">{capability.description}</p>
            <div class="space-y-2">
              {capability.outcomes.map((outcome, outcomeIndex) => (
                <div class="flex items-center">
                  <div class="w-2 h-2 bg-pink-600 rounded-full mr-3"></div>
                  <span class="text-sm text-gray-700">{outcome}</span>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Safety Features Section -->
  <section class="py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <h2 class="text-4xl font-bold text-gray-900 mb-6">
            {t('seavoice.solutions.inbound.mentalHealth.safety.title') || 'Safety-First Design'}
          </h2>
          <p class="text-lg text-gray-600 mb-8">
            {t('seavoice.solutions.inbound.mentalHealth.safety.description') || 'Our mental health AI is designed with safety as the top priority, featuring advanced crisis detection and immediate escalation protocols to ensure users receive appropriate professional care when needed.'}
          </p>
          <div class="space-y-6">
            <div class="flex items-center">
              <svg class="w-6 h-6 text-pink-600 mr-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
              <div>
                <h3 class="font-semibold text-gray-900">
                  {t('seavoice.solutions.inbound.mentalHealth.safety.crisisDetection.title') || 'Advanced Crisis Detection'}
                </h3>
                <p class="text-gray-600">
                  {t('seavoice.solutions.inbound.mentalHealth.safety.crisisDetection.description') || 'AI algorithms identify crisis situations and trigger immediate protocols'}
                </p>
              </div>
            </div>
            <div class="flex items-center">
              <svg class="w-6 h-6 text-pink-600 mr-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
              <div>
                <h3 class="font-semibold text-gray-900">
                  {t('seavoice.solutions.inbound.mentalHealth.safety.professionalHandoff.title') || 'Professional Handoff'}
                </h3>
                <p class="text-gray-600">
                  {t('seavoice.solutions.inbound.mentalHealth.safety.professionalHandoff.description') || 'Seamless transfer to qualified mental health professionals when needed'}
                </p>
              </div>
            </div>
            <div class="flex items-center">
              <svg class="w-6 h-6 text-pink-600 mr-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197m13.5-9a2.5 2.5 0 11-5 0 2.5 2.5 0 015 0z" />
              </svg>
              <div>
                <h3 class="font-semibold text-gray-900">
                  {t('seavoice.solutions.inbound.mentalHealth.safety.emergencyProtocols.title') || 'Emergency Protocols'}
                </h3>
                <p class="text-gray-600">
                  {t('seavoice.solutions.inbound.mentalHealth.safety.emergencyProtocols.description') || 'Immediate connection to crisis hotlines and emergency services when required'}
                </p>
              </div>
            </div>
          </div>
        </div>
        
        <div class="bg-gradient-to-br from-pink-50 to-purple-50 rounded-2xl p-8">
          <h3 class="text-2xl font-bold text-gray-900 mb-6">
            {t('seavoice.solutions.inbound.mentalHealth.safety.features.title') || 'Safety Features'}
          </h3>
          <div class="grid grid-cols-1 gap-3">
            {safetyFeatures.map((feature, index) => (
              <div class="flex items-center p-3 bg-white rounded-lg shadow-sm">
                <svg class="w-5 h-5 text-green-500 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <span class="text-gray-700 font-medium">{feature}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Benefits Metrics Section -->
  <section class="py-20 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-4xl font-bold text-gray-900 mb-6">
          {t('seavoice.solutions.inbound.mentalHealth.benefits.title') || 'Mental Health Impact'}
        </h2>
        <p class="text-xl text-gray-600">
          {t('seavoice.solutions.inbound.mentalHealth.benefits.description') || 'Measurable improvements in mental health support accessibility and effectiveness'}
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        {benefits.map((benefit, index) => (
          <div class="bg-white rounded-xl p-8 shadow-lg text-center border border-gray-200">
            <div class="text-4xl font-bold text-pink-600 mb-4">{benefit.metric}</div>
            <p class="text-gray-600">{benefit.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-20 bg-gradient-to-r from-pink-600 to-purple-600 text-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-4xl font-bold mb-6">
        {t('seavoice.solutions.inbound.mentalHealth.cta.title') || 'Ready to Support Mental Health?'}
      </h2>
      <p class="text-xl mb-8 opacity-90">
        {t('seavoice.solutions.inbound.mentalHealth.cta.description') || 'Provide compassionate, 24/7 mental health support with AI that truly understands and cares for your community.'}
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a 
          href={`/${currentLang}/seavoice/pricing`}
          class="inline-block bg-white text-pink-600 px-8 py-4 rounded-lg text-lg font-semibold hover:bg-gray-100 transition-colors"
        >
          {t('seavoice.solutions.inbound.mentalHealth.cta.learnMore') || 'Learn More'}
        </a>
        <a 
          href="https://meetings.hubspot.com/seasalt-ai/seasalt-demo"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block border-2 border-white text-white px-8 py-4 rounded-lg text-lg font-semibold hover:bg-white hover:text-pink-600 transition-colors"
        >
          {t('seavoice.solutions.inbound.mentalHealth.cta.contactSpecialists') || 'Contact Specialists'}
        </a>
      </div>
    </div>
  </section>

</Layout>