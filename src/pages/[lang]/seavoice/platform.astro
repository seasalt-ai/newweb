---
// Generate static paths for all supported languages
export async function getStaticPaths() {
  const supportedLocales = [
    'en', 'es', 'zh-tw', 'zh-cn', 'ja', 'ko', 'fr', 'de', 'ar', 'fa',
    'fil', 'hi', 'id', 'ms', 'pl', 'pt', 'ru', 'ta', 'th', 'vi'
  ];
  
  return supportedLocales.map((lang) => ({
    params: { lang }
  }));
}
import Layout from '../../../layouts/Layout.astro';
import { getTranslationHelpers, type SupportedLanguage } from '../../../i18n/helpers';


const { lang } = Astro.params;
const currentLang = (lang as SupportedLanguage) || 'en';
const { t } = await getTranslationHelpers(currentLang);

// SEO配置
const seoData = {
  title: t('seavoice.platform.hero.title') || 'The Complete AI Voice Platform - SeaVoice',
  description: t('seavoice.platform.hero.description') || 'Discover the technology that powers human-like voice interactions, seamless integrations, and actionable insights for your business.',
  canonical: `/${currentLang}/seavoice/platform`,
};

// 平台特色功能配置
const features = [
  {
    icon: 'mic',
    title: t('seavoice.platform.features.aiVoice.title') || 'AI Voice Agents',
    description: t('seavoice.platform.features.aiVoice.description') || 'Human-like voice agents that handle inbound and outbound calls 24/7 with perfect consistency.',
    features: [
      t('seavoice.platform.features.aiVoice.feature1') || '24/7 availability',
      t('seavoice.platform.features.aiVoice.feature2') || 'Human-like conversations',
      t('seavoice.platform.features.aiVoice.feature3') || 'Dynamic pauses and tone shifts',
      t('seavoice.platform.features.aiVoice.feature4') || 'Multi-language support'
    ]
  },
  {
    icon: 'brain',
    title: t('seavoice.platform.features.conversationalAI.title') || 'Conversational AI',
    description: t('seavoice.platform.features.conversationalAI.description') || 'Advanced AI that learns from your documents and remembers past interactions for personalized service.',
    features: [
      t('seavoice.platform.features.conversationalAI.feature1') || 'RAG technology',
      t('seavoice.platform.features.conversationalAI.feature2') || 'Long-term memory',
      t('seavoice.platform.features.conversationalAI.feature3') || 'Custom knowledge base',
      t('seavoice.platform.features.conversationalAI.feature4') || 'Context awareness'
    ]
  },
  {
    icon: 'chart',
    title: t('seavoice.platform.features.analytics.title') || 'Analytics & Insights',
    description: t('seavoice.platform.features.analytics.description') || 'Real-time transcripts, sentiment analysis, and actionable insights from every conversation.',
    features: [
      t('seavoice.platform.features.analytics.feature1') || 'Real-time transcripts',
      t('seavoice.platform.features.analytics.feature2') || 'Sentiment analysis',
      t('seavoice.platform.features.analytics.feature3') || 'Performance metrics',
      t('seavoice.platform.features.analytics.feature4') || 'Call volume analytics'
    ]
  },
  {
    icon: 'phone',
    title: t('seavoice.platform.features.telephony.title') || 'Telephony & Connectivity',
    description: t('seavoice.platform.features.telephony.description') || 'Flexible integration with VoIP, SIP, and BYOC options for seamless connectivity.',
    features: [
      t('seavoice.platform.features.telephony.feature1') || 'VoIP integration',
      t('seavoice.platform.features.telephony.feature2') || 'SIP trunking',
      t('seavoice.platform.features.telephony.feature3') || 'BYOC support',
      t('seavoice.platform.features.telephony.feature4') || 'Global coverage'
    ]
  },
  {
    icon: 'globe',
    title: t('seavoice.platform.features.integrations.title') || 'Integrations & Channels',
    description: t('seavoice.platform.features.integrations.description') || 'Connect with your existing tools and reach customers across multiple channels.',
    features: [
      t('seavoice.platform.features.integrations.feature1') || 'CRM integration',
      t('seavoice.platform.features.integrations.feature2') || 'WhatsApp Voice API',
      t('seavoice.platform.features.integrations.feature3') || 'LINE Business Calls',
      t('seavoice.platform.features.integrations.feature4') || 'Calendar sync'
    ]
  },
  {
    icon: 'zap',
    title: t('seavoice.platform.features.speech.title') || 'Speech Technologies',
    description: t('seavoice.platform.features.speech.description') || 'Industry-leading speech-to-text and text-to-speech with custom voice profiles.',
    features: [
      t('seavoice.platform.features.speech.feature1') || 'High accuracy STT',
      t('seavoice.platform.features.speech.feature2') || 'Natural TTS',
      t('seavoice.platform.features.speech.feature3') || 'Voice cloning',
      t('seavoice.platform.features.speech.feature4') || '10+ languages'
    ]
  }
];

// 技術展示配置
const technologyShowcase = [
  {
    title: t('seavoice.platform.technology.speechRecognition.title') || 'Speech Recognition',
    description: t('seavoice.platform.technology.speechRecognition.description') || 'Advanced STT technology with 99%+ accuracy, even with background noise and industry jargon.',
    metrics: [
      t('seavoice.platform.technology.speechRecognition.metric1') || '99%+ accuracy',
      t('seavoice.platform.technology.speechRecognition.metric2') || 'Real-time processing',
      t('seavoice.platform.technology.speechRecognition.metric3') || 'Noise reduction'
    ]
  },
  {
    title: t('seavoice.platform.technology.nlp.title') || 'Natural Language Processing',
    description: t('seavoice.platform.technology.nlp.description') || 'Context-aware AI that understands intent and maintains natural conversation flow.',
    metrics: [
      t('seavoice.platform.technology.nlp.metric1') || 'Intent recognition',
      t('seavoice.platform.technology.nlp.metric2') || 'Context retention',
      t('seavoice.platform.technology.nlp.metric3') || 'Emotional intelligence'
    ]
  },
  {
    title: t('seavoice.platform.technology.voiceSynthesis.title') || 'Voice Synthesis',
    description: t('seavoice.platform.technology.voiceSynthesis.description') || 'Human-like text-to-speech with customizable voices and natural prosody.',
    metrics: [
      t('seavoice.platform.technology.voiceSynthesis.metric1') || 'Natural prosody',
      t('seavoice.platform.technology.voiceSynthesis.metric2') || 'Voice cloning',
      t('seavoice.platform.technology.voiceSynthesis.metric3') || 'Emotion control'
    ]
  }
];

// 圖示組件映射
function getIconSvg(iconName: string) {
  const icons = {
    mic: '<svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z"></path></svg>',
    brain: '<svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path></svg>',
    chart: '<svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path></svg>',
    phone: '<svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>',
    globe: '<svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"></path></svg>',
    zap: '<svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>'
  };
  return icons[iconName as keyof typeof icons] || icons.mic;
}
---

<Layout seo={seoData} lang={currentLang}>
  <!-- Hero Section -->
  <section class="bg-gradient-to-br from-blue-50 via-white to-teal-50 py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <h1 class="text-5xl font-bold text-gray-900 mb-6">
          {t('seavoice.platform.hero.title') || 'The Complete AI Voice Platform'}
        </h1>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto mb-8">
          {t('seavoice.platform.hero.description') || 'Discover the technology that powers human-like voice interactions, seamless integrations, and actionable insights for your business.'}
        </p>
        <a
          href="https://chat.seasalt.ai/gpt/signup"
          target="_blank"
          rel="noopener noreferrer"
          class="bg-blue-600 text-white px-8 py-4 rounded-lg text-lg font-semibold hover:bg-blue-700 transition-colors"
        >
          {t('seavoice.platform.hero.cta') || 'Explore Platform Capabilities'}
        </a>
      </div>
    </div>
  </section>

  <!-- Platform Features -->
  <section class="py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
        {features.map((feature) => (
          <div class="bg-white rounded-xl p-8 shadow-lg border border-gray-200 hover:shadow-xl transition-shadow">
            <div class="flex items-center mb-6">
              <div class="w-12 h-12 bg-gradient-to-r from-blue-600 to-teal-600 rounded-lg flex items-center justify-center mr-4">
                <Fragment set:html={getIconSvg(feature.icon)} />
              </div>
              <h3 class="text-2xl font-bold text-gray-900">{feature.title}</h3>
            </div>
            <p class="text-gray-600 mb-6 leading-relaxed">{feature.description}</p>
            <ul class="space-y-2">
              {feature.features.map((item) => (
                <li class="flex items-center text-gray-700">
                  <div class="w-2 h-2 bg-blue-600 rounded-full mr-3"></div>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Technology Showcase -->
  <section class="py-20 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-4xl font-bold text-gray-900 mb-6">
          {t('seavoice.platform.technology.title') || 'Built on Industry-Leading Technology'}
        </h2>
        <p class="text-xl text-gray-600">
          {t('seavoice.platform.technology.subtitle') || 'Powered by the original Kaldi team\'s expertise in speech recognition'}
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {technologyShowcase.map((tech) => (
          <div class="bg-white rounded-xl p-8 shadow-lg">
            <h3 class="text-xl font-bold text-gray-900 mb-4">{tech.title}</h3>
            <p class="text-gray-600 mb-6">{tech.description}</p>
            <div class="space-y-2">
              {tech.metrics.map((metric) => (
                <div class="flex items-center">
                  <div class="w-2 h-2 bg-blue-600 rounded-full mr-3"></div>
                  <span class="text-sm text-gray-700">{metric}</span>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

</Layout>