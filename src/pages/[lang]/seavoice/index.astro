  <script>
    // Use case card navigation
    document.addEventListener('DOMContentLoaded', function() {
      const useCaseCards = document.querySelectorAll('.use-case-card');
      const currentLang = window.location.pathname.split('/')[1] || 'en';
      
      useCaseCards.forEach(card => {
        card.addEventListener('click', function() {
          const url = this.getAttribute('data-url');
          if (url) {
            // Navigate to the use case page with language prefix
            window.location.href = `/${currentLang}/seavoice${url}`;
          }
        });
        
        // Add keyboard accessibility
        card.addEventListener('keydown', function(e) {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            this.click();
          }
        });
        
        // Make it focusable
        card.setAttribute('tabindex', '0');
      });
      
      // Enhanced FAQ toggle functionality
      let allExpanded = false;
      const toggleAllButton = document.getElementById('faq-toggle-all');
      const toggleText = document.getElementById('toggle-text');
      const faqItems = document.querySelectorAll('.faq-item');
      const expandAllText = toggleText.textContent || 'Expand All Questions';
      const collapseAllText = 'Collapse All';
      
      // Individual FAQ toggle
      faqItems.forEach(item => {
        const button = item.querySelector('.faq-button');
        const answer = item.querySelector('.faq-answer');
        const chevron = button.querySelector('.faq-chevron');
        
        button.addEventListener('click', function() {
          const isOpen = answer.style.maxHeight && answer.style.maxHeight !== '0px';
          
          if (isOpen) {
            answer.style.maxHeight = '0px';
            chevron.style.transform = 'rotate(0deg)';
          } else {
            answer.style.maxHeight = answer.scrollHeight + 'px';
            chevron.style.transform = 'rotate(180deg)';
          }
          
          // Update toggle all button state
          updateToggleAllState();
        });
      });
      
      // Expand/Collapse all functionality
      toggleAllButton.addEventListener('click', function() {
        allExpanded = !allExpanded;
        
        faqItems.forEach(item => {
          const answer = item.querySelector('.faq-answer');
          const chevron = item.querySelector('.faq-chevron');
          
          if (allExpanded) {
            answer.style.maxHeight = answer.scrollHeight + 'px';
            chevron.style.transform = 'rotate(180deg)';
          } else {
            answer.style.maxHeight = '0px';
            chevron.style.transform = 'rotate(0deg)';
          }
        });
        
        toggleText.textContent = allExpanded ? collapseAllText : expandAllText;
      });
      
      // Update toggle all button state based on individual item states
      function updateToggleAllState() {
        const openItems = Array.from(faqItems).filter(item => {
          const answer = item.querySelector('.faq-answer');
          return answer.style.maxHeight && answer.style.maxHeight !== '0px';
        });
        
        if (openItems.length === faqItems.length) {
          allExpanded = true;
          toggleText.textContent = collapseAllText;
        } else if (openItems.length === 0) {
          allExpanded = false;
          toggleText.textContent = expandAllText;
        }
      }
    });
  </script>
</Layout>
