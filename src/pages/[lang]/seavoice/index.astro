        url: '/solutions/outbound/campaigns'
      },
      {
        title: t('seavoice.home.useCases.outbound.proactiveSupport.title') || 'Proactive Support',
        description: t('seavoice.home.useCases.outbound.proactiveSupport.description') || 'Prevent issues before they occur',
        type: t('seavoice.home.useCases.types.outbound') || 'Outbound',
        url: '/solutions/outbound/proactive-support'
      },
      {
        title: t('seavoice.home.useCases.outbound.renewals.title') || 'Contract Renewals',
        description: t('seavoice.home.useCases.outbound.renewals.description') || 'Automate renewal processes',
        type: t('seavoice.home.useCases.types.outbound') || 'Outbound',
        url: '/solutions/outbound/renewals'
      }
    ]
  }
];

// Platform steps - exactly 5 as in original
const platformSteps = [
  {
    title: t('seavoice.home.howItWorks.step1.title') || 'Configure AI Agent',
    description: t('seavoice.home.howItWorks.step1.description') || 'Set up your voice agent with custom prompts and workflows'
  },
  {
    title: t('seavoice.home.howItWorks.step2.title') || 'Connect Phone System',
    description: t('seavoice.home.howItWorks.step2.description') || 'Integrate with your existing phone infrastructure'
  },
  {
    title: t('seavoice.home.howItWorks.step3.title') || 'Handle Calls 24/7',
    description: t('seavoice.home.howItWorks.step3.description') || 'AI agents automatically answer and process calls'
  },
  {
    title: t('seavoice.home.howItWorks.step4.title') || 'Real-time Support',
    description: t('seavoice.home.howItWorks.step4.description') || 'Human oversight and intervention when needed'
  },
  {
    title: t('seavoice.home.howItWorks.step5.title') || 'Analytics & Insights',
    description: t('seavoice.home.howItWorks.step5.description') || 'Track performance and optimize conversations'
  }
];

// Testimonials - matching original
const testimonials = [
  {
    quote: t('seavoice.home.testimonials.quote') || 'SeaVoice has transformed our customer service. We now handle 10x more calls with better satisfaction rates.',
    author: t('seavoice.home.testimonials.author') || 'Sarah Johnson',
    role: t('seavoice.home.testimonials.role') || 'Head of Operations',
    company: t('seavoice.home.testimonials.company') || 'TechCorp Inc.'
  }
];

// FAQ items - exactly 11 as in original
const faqItems = [
  {
    question: t('seavoice.home.faq.q1.question') || 'How quickly can SeaVoice be deployed?',
    answer: t('seavoice.home.faq.q1.answer') || 'SeaVoice can typically be deployed within 24-48 hours, depending on your specific requirements and integrations.'
  },
  {
    question: t('seavoice.home.faq.q2.question') || 'What languages does SeaVoice support?',
    answer: t('seavoice.home.faq.q2.answer') || 'SeaVoice supports over 30 languages and can be configured for multiple languages simultaneously.'
  },
  {
    question: t('seavoice.home.faq.q3.question') || 'How does SeaVoice handle complex queries?',
    answer: t('seavoice.home.faq.q3.answer') || 'SeaVoice uses advanced AI to understand context and can seamlessly transfer to human agents when needed.'
  },
  {
    question: t('seavoice.home.faq.q4.question') || 'Is SeaVoice compliant with industry regulations?',
