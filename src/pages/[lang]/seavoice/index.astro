---

<Layout 
  title={seoTitle} 
  description={seoDescription} 
  keywords={seoKeywords} 
  lang={validatedLang}
  headerVersion="seavoice"
  footerVersion="seavoice"
>

  <div class="min-h-screen bg-gradient-to-br from-slate-50 via-white to-blue-50">
    
    <!-- Hero Section - Exactly matching UnifiedHomePage -->
    <section class="relative bg-gradient-to-br from-indigo-900 via-purple-900 to-pink-800 py-24 lg:py-32 overflow-hidden">
      <!-- Animated background elements -->
      <div class="absolute inset-0">
        <div class="absolute top-0 left-0 w-96 h-96 bg-blue-500/10 rounded-full mix-blend-multiply filter blur-xl animate-pulse"></div>
        <div class="absolute top-0 right-0 w-96 h-96 bg-purple-500/10 rounded-full mix-blend-multiply filter blur-xl animate-pulse delay-1000"></div>
        <div class="absolute bottom-0 left-1/2 w-96 h-96 bg-pink-500/10 rounded-full mix-blend-multiply filter blur-xl animate-pulse delay-2000"></div>
      </div>
      
      <!-- Floating particles -->
      <div class="absolute inset-0 overflow-hidden">
        {Array.from({ length: 50 }, (_, i) => (
          <div 
            key={i}
            class="absolute w-1 h-1 bg-white/20 rounded-full animate-pulse"
            style={{
              left: `${Math.random() * 100}%`,
              top: `${Math.random() * 100}%`,
              animationDelay: `${Math.random() * 3}s`,
              animationDuration: `${2 + Math.random() * 3}s`
            }}
          />
        ))}
      </div>
      
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
          <!-- Left column - Hero Content -->
          <div class="text-left">
            <div class="inline-flex items-center px-4 py-2 bg-white/10 backdrop-blur-sm rounded-full border border-white/20 text-white/80 text-sm font-medium mb-8">
              <svg class="w-4 h-4 mr-2 text-yellow-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
              </svg>
              {t('seavoice.home.hero.tagline') || 'AI-Powered Voice Automation'}
            </div>
            
            <h1 class="font-bold text-white leading-tight mb-8 tracking-tight" style="font-size: 4rem; line-height: 1.1; font-weight: bold; color: white;">
              <span class="bg-gradient-to-r from-blue-300 via-purple-300 to-pink-300 bg-clip-text text-transparent" style="font-size: inherit;">
                {t('seavoice.home.hero.title.line1') || 'Transform'}
              </span>
              <br />
              <span class="text-white/90" style="font-size: inherit;">{t('seavoice.home.hero.title.line2') || 'Customer Interactions'}</span>
            </h1>
            
            <p class="text-xl sm:text-2xl text-white/80 leading-relaxed max-w-4xl mb-12 font-light">
              {t('seavoice.home.hero.subtitle.line1') || 'Experience the future of voice interactions with AI agents that understand, engage,'}
              <br class="hidden sm:block" />
              <span class="text-blue-300">{t('seavoice.home.hero.subtitle.line2') || 'and deliver exceptional customer experiences 24/7.'}</span>
            </p>

            <div class="flex flex-col sm:flex-row gap-6 justify-start mb-16">
              <a 
                href={getMeetingUrl(validatedLang)} 
                target="_blank" 
                rel="noopener noreferrer" 
                class="group relative bg-gradient-to-r from-blue-500 to-purple-600 text-white px-8 py-4 rounded-2xl text-lg font-semibold shadow-2xl hover:shadow-blue-500/25 transition-all duration-300 flex items-center justify-center overflow-hidden"
              >
                <div class="absolute inset-0 bg-gradient-to-r from-blue-600 to-purple-700 opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
                <span class="relative z-10">{t('seavoice.home.hero.bookDemo') || 'Book a Demo'}</span>
                <svg class="relative z-10 ml-2 w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                </svg>
              </a>
              
              <a 
                href="https://chat.seasalt.ai/signup" 
                target="_blank" 
                rel="noopener noreferrer"
                class="group relative bg-white/10 backdrop-blur-sm border-2 border-white/30 text-white px-8 py-4 rounded-2xl text-lg font-semibold hover:bg-white/20 transition-all duration-300 flex items-center justify-center"
              >
                <span>{t('seavoice.home.hero.signUp') || 'Get Started'}</span>
                <svg class="ml-2 w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                </svg>
              </a>
            </div>
          </div>

          <!-- Right column - VoiceConversationFlow React Island -->
          <div class="relative">
            <VoiceConversationFlow 
              lang={validatedLang} 
              client:load 
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Voice Demo Section - Matching original -->
    <section class="py-20 bg-gradient-to-br from-slate-50 to-blue-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="text-4xl sm:text-5xl font-bold bg-gradient-to-r from-blue-600 to-purple-600 bg-clip-text text-transparent mb-6">
            {t('seavoice.home.voiceDemo.title') || 'Experience AI Voice in Action'}
          </h2>
          <p class="text-xl text-gray-600 max-w-3xl mx-auto">
            {t('seavoice.home.voiceDemo.subtitle') || 'Listen to how our AI handles real customer interactions with natural, intelligent responses.'}
          </p>
        </div>
        <div class="max-w-4xl mx-auto">
          <VoiceDemo 
            lang={validatedLang} 
            client:load 
          />
        </div>
      </div>
    </section>

    <!-- Use Cases Section - Exactly matching original with all 18 use cases -->
    <section class="py-24 bg-white relative overflow-hidden">
      <!-- Background decorative elements -->
      <div class="absolute top-0 right-0 w-96 h-96 bg-blue-100/30 rounded-full -translate-y-1/2 translate-x-1/2 blur-3xl"></div>
      <div class="absolute bottom-0 left-0 w-96 h-96 bg-purple-100/30 rounded-full translate-y-1/2 -translate-x-1/2 blur-3xl"></div>
      
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
        <div class="text-center mb-20">
          <div class="inline-flex items-center px-4 py-2 bg-gradient-to-r from-blue-100 to-purple-100 rounded-full border border-blue-200 text-blue-700 text-sm font-medium mb-6">
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"></path>
            </svg>
            {t('seavoice.home.useCases.badge') || 'Proven Solutions'}
          </div>
          <h2 class="text-4xl sm:text-5xl font-bold text-gray-900 mb-6 leading-tight">
            {t('seavoice.home.useCases.title.line1') || t('seavoice.home.useCases.title') || 'Powerful Voice Solutions'}
            <br />
            {t('seavoice.home.useCases.title.line2') || 'for Every Business Need'}
          </h2>
          <p class="text-xl text-gray-600 max-w-3xl mx-auto">
            {t('seavoice.home.useCases.subtitle') || 'From customer service to lead generation, SeaVoice handles it all with intelligent automation.'}
          </p>
        </div>

        {useCaseCategories.map((category, categoryIndex) => (
          <div key={categoryIndex} class="mb-16">
            <div class="flex items-center mb-8">
              <div class={`w-12 h-12 ${colorClasses[category.color as keyof typeof colorClasses].bg100} rounded-lg flex items-center justify-center mr-4`}>
                <svg class={`w-6 h-6 ${colorClasses[category.color as keyof typeof colorClasses].text600}`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
                </svg>
              </div>
              <h3 class="text-2xl font-bold text-gray-900">
                {category.category}
              </h3>
            </div>
            
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
              {category.cases.map((useCase, index) => (
                <a 
                  key={index} 
                  href={`/${validatedLang}/seavoice${useCase.url}`}
                  class={`${colorClasses[category.color as keyof typeof colorClasses].bg50} rounded-xl p-6 hover:shadow-lg transition-all border ${colorClasses[category.color as keyof typeof colorClasses].border100} cursor-pointer group block use-case-card`}
                  data-url={useCase.url}
                >
                  <div class="flex items-center justify-between mb-3">
                    <span class={`inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium ${colorClasses[category.color as keyof typeof colorClasses].bg100} ${colorClasses[category.color as keyof typeof colorClasses].text800}`}>
                      {useCase.type}
                    </span>
                    <svg class={`w-4 h-4 ${colorClasses[category.color as keyof typeof colorClasses].text600} opacity-0 group-hover:opacity-100 transition-opacity`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                    </svg>
                  </div>
                  <h4 class="text-lg font-semibold text-gray-900 mb-3 group-hover:text-blue-600 transition-colors">{useCase.title}</h4>
                  <p class="text-gray-600 text-sm">{useCase.description}</p>
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- How It Works Section -->
    <section class="py-24 bg-gradient-to-br from-slate-50 via-blue-50 to-indigo-100 relative overflow-hidden">
      <!-- Background pattern -->
      <div class="absolute inset-0 opacity-5">
