---
import { getTranslationHelpers, type SupportedLanguage } from '../../../i18n/helpers';
import { getMeetingUrl } from "../../../constants/urls";
import Layout from '../../../layouts/Layout.astro';
import VoiceConversationFlow from '../../../components/react/seavoice/VoiceConversationFlow.tsx';
import VoiceDemo from '../../../components/react/seavoice/VoiceDemo.tsx';
import InteractiveCallDashboard from '../../../components/react/seavoice/InteractiveCallDashboard.tsx';

// Generate static paths for all supported languages
export async function getStaticPaths() {
  const supportedLocales = [
    'en', 'es', 'zh-tw', 'zh-cn', 'ja', 'ko', 'fr', 'de', 'ar', 'fa',
    'fil', 'hi', 'id', 'ms', 'pl', 'pt', 'ru', 'ta', 'th', 'vi'
  ];
  
  return supportedLocales.map((lang) => ({
    params: { lang }
  }));
}

// Extract language from params and validate it
const { lang } = Astro.params;
const validatedLang = (lang as SupportedLanguage) || 'en';

// Get translation helpers
const { t } = await getTranslationHelpers(validatedLang);

// Use translations for SEO - matching original structure
const seoTitle = t('seo.seavoice.homepage.title') || 'SeaVoice - AI Voice Automation Platform | Seasalt.ai';
const seoDescription = t('seo.seavoice.homepage.description') || 'Transform your customer interactions with AI-powered voice agents. 24/7 availability, unlimited scalability, and seamless integration.';
const seoKeywords = t('seo.seavoice.homepage.keywords') || 'AI voice, call center software, voice analytics, SeaVoice, intelligent call routing, automated phone system, voice assistant, 24/7 customer service';

// Color mapping for use cases - matching original structure
const colorClasses = {
  blue: {
    bg100: 'bg-blue-100',
    bg50: 'bg-blue-50',
    text600: 'text-blue-600',
    text800: 'text-blue-800',
    border100: 'border-blue-100'
  },
  purple: {
    bg100: 'bg-purple-100',
    bg50: 'bg-purple-50', 
    text600: 'text-purple-600',
    text800: 'text-purple-800',
    border100: 'border-purple-100'
  }
};

// Use Case Categories - exactly matching the original structure with 9 inbound + 9 outbound
const useCaseCategories = [
