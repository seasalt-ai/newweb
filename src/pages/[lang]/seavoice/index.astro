    category: t('seavoice.home.useCases.inbound.category') || 'Inbound Solutions',
    color: 'blue',
    cases: [
      {
        title: t('seavoice.home.useCases.inbound.appointmentBooking.title') || 'Appointment Booking',
        description: t('seavoice.home.useCases.inbound.appointmentBooking.description') || 'Automated scheduling and management',
