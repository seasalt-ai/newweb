        type: t('seavoice.home.useCases.types.outbound') || 'Outbound',
        url: '/solutions/outbound/surveys'
      },
      {
        title: t('seavoice.home.useCases.outbound.collections.title') || 'Collections Service',
        description: t('seavoice.home.useCases.outbound.collections.description') || 'Professional debt recovery',
        type: t('seavoice.home.useCases.types.outbound') || 'Outbound',
        url: '/solutions/outbound/collections'
      },
      {
        title: t('seavoice.home.useCases.outbound.reactivation.title') || 'Customer Reactivation', 
        description: t('seavoice.home.useCases.outbound.reactivation.description') || 'Win back lapsed customers',
        type: t('seavoice.home.useCases.types.outbound') || 'Outbound',
        url: '/solutions/outbound/reactivation'
      },
      {
        title: t('seavoice.home.useCases.outbound.fraudAlerts.title') || 'Fraud Alerts',
        description: t('seavoice.home.useCases.outbound.fraudAlerts.description') || 'Instant security notifications',
        type: t('seavoice.home.useCases.types.outbound') || 'Outbound',
        url: '/solutions/outbound/fraud-alerts'
