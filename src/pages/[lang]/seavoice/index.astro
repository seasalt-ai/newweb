        url: '/solutions/inbound/appointment-booking'
      },
      {
        title: t('seavoice.home.useCases.inbound.technicalSupport.title') || 'Technical Support', 
        description: t('seavoice.home.useCases.inbound.technicalSupport.description') || 'Instant troubleshooting assistance',
        type: t('seavoice.home.useCases.types.inbound') || 'Inbound',
        url: '/solutions/inbound/technical-support'
      },
      {
        title: t('seavoice.home.useCases.inbound.virtualAssistant.title') || '24/7 Virtual Assistant',
        description: t('seavoice.home.useCases.inbound.virtualAssistant.description') || 'Always available customer support',
        type: t('seavoice.home.useCases.types.inbound') || 'Inbound',
        url: '/solutions/inbound/virtual-assistant'
      },
      {
        title: t('seavoice.home.useCases.inbound.callTransfer.title') || 'Intelligent Call Transfer',
        description: t('seavoice.home.useCases.inbound.callTransfer.description') || 'Route calls to the right department',
        type: t('seavoice.home.useCases.types.inbound') || 'Inbound', 
        url: '/solutions/inbound/call-transfer'
      },
      {
        title: t('seavoice.home.useCases.inbound.orderTracking.title') || 'Order Tracking',
        description: t('seavoice.home.useCases.inbound.orderTracking.description') || 'Real-time order status updates',
        type: t('seavoice.home.useCases.types.inbound') || 'Inbound',
        url: '/solutions/inbound/order-tracking'
