---
import Layout from '../../../layouts/Layout.astro';
import { getTranslationHelpers, supportedLocales, type SupportedLanguage } from '../../../i18n/helpers';
import { getMeetingUrl } from '../../../constants/urls';
import SupportPlan from '../../../components/SupportPlan.astro';
import SeaChatPricingCalculator from '../../../components/react/SeaChatPricingCalculator.tsx';

// 為所有支持的語言生成靜態路徑
export async function getStaticPaths() {
  return supportedLocales.map((lang) => ({
    params: { lang }
  }));
}

// 取得動態語言參數
const { lang } = Astro.params;
const currentLang = (lang as SupportedLanguage) || 'en';

// 獲取翻譯幫助函數
const { t, translations } = await getTranslationHelpers(currentLang);

// SEO 設定
const title = t('seachat.pricing.title') + ' - SeaChat | SeaSalt.ai' || 'SeaChat Pricing - Choose Your Plan | SeaSalt.ai';
const description = t('seachat.pricing.subtitle') || 'Transparent pricing for SeaChat AI-powered chatbot platform. Start free with unlimited contacts. Scale with premium features and enterprise support.';
const keywords = 'SeaChat pricing, AI chatbot cost, customer service automation pricing, chatbot platform plans, conversational AI pricing';

---

<Layout 
  title={title} 
  description={description} 
  lang={currentLang}
  keywords={keywords}
  type="product"
  product={{
    name: "SeaChat",
    brand: "Seasalt.ai",
    category: "AI Chatbot Platform",
    description: "Free AI chatbot platform with unlimited conversations, enterprise AI models, and omnichannel integration",
    price: "0",
    currency: "USD",
    availability: "InStock"
  }}
  headerVersion="seachat"
  footerVersion="seachat"
  breadcrumbs={[{ name: 'Home', url: `/${currentLang}/` }, { name: 'SeaChat', url: `/${currentLang}/seachat/` }, { name: 'Pricing' }]}
