  <!-- 添加計費切換的 JavaScript -->
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const toggle = document.getElementById('billing-toggle');
      const toggleSwitch = document.getElementById('toggle-switch');
      const premiumPrice = document.querySelector('.premium-price');
      const premiumPeriod = document.querySelector('.premium-period');
      const yearlyDescription = document.querySelector('.yearly-description');
      
      let isYearly = false;
      
      if (toggle && toggleSwitch && premiumPrice && premiumPeriod) {
        toggle.addEventListener('click', function() {
          isYearly = !isYearly;
          
          // 更新開關狀態
          toggle.setAttribute('aria-checked', isYearly.toString());
          
          if (isYearly) {
            toggleSwitch.classList.remove('translate-x-1');
            toggleSwitch.classList.add('translate-x-6');
            premiumPrice.textContent = '$299';
            premiumPeriod.textContent = '/year';
            if (yearlyDescription) yearlyDescription.classList.remove('hidden');
          } else {
            toggleSwitch.classList.remove('translate-x-6');
            toggleSwitch.classList.add('translate-x-1');
            premiumPrice.textContent = '$29.99';
            premiumPeriod.textContent = '/month';
            if (yearlyDescription) yearlyDescription.classList.add('hidden');
          }
        });
      }
    });
  </script>
