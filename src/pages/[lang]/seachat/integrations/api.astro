---
import { getTranslationHelpers, languages, type SupportedLanguage } from '../../../../i18n/helpers';
import Layout from '../../../../layouts/Layout.astro';

export async function getStaticPaths() {
  return Object.keys(languages).map(lang => ({ params: { lang } }));
}

const { lang } = Astro.params;
const { t } = await getTranslationHelpers(lang as SupportedLanguage);

// API Features data
const apiFeatures = [
  {
    icon: 'code',
    title: t('seachat.integrations.api.features.restful.title'),
    description: t('seachat.integrations.api.features.restful.description'),
    color: 'from-blue-500 to-indigo-600'
  },
  {
    icon: 'zap',
    title: t('seachat.integrations.api.features.webhooks.title'),
    description: t('seachat.integrations.api.features.webhooks.description'),
    color: 'from-green-500 to-teal-600'
  },
  {
    icon: 'puzzle',
    title: t('seachat.integrations.api.features.custom.title'),
    description: t('seachat.integrations.api.features.custom.description'),
    color: 'from-purple-500 to-pink-600'
  },
  {
    icon: 'settings',
    title: t('seachat.integrations.api.features.workflow.title'),
    description: t('seachat.integrations.api.features.workflow.description'),
    color: 'from-orange-500 to-red-600'
  }
];

// Integration types data
const integrationTypes = [
  {
    title: t('seachat.integrations.api.types.crm.title'),
    description: t('seachat.integrations.api.types.crm.description'),
    example: t('seachat.integrations.api.types.crm.example'),
    complexity: t('seachat.integrations.api.types.crm.complexity'),
    timeEstimate: t('seachat.integrations.api.types.crm.time')
  },
  {
    title: t('seachat.integrations.api.types.ecommerce.title'),
    description: t('seachat.integrations.api.types.ecommerce.description'),
    example: t('seachat.integrations.api.types.ecommerce.example'),
    complexity: t('seachat.integrations.api.types.ecommerce.complexity'),
    timeEstimate: t('seachat.integrations.api.types.ecommerce.time')
  },
  {
    title: t('seachat.integrations.api.types.payment.title'),
    description: t('seachat.integrations.api.types.payment.description'),
    example: t('seachat.integrations.api.types.payment.example'),
    complexity: t('seachat.integrations.api.types.payment.complexity'),
    timeEstimate: t('seachat.integrations.api.types.payment.time')
  },
  {
    title: t('seachat.integrations.api.types.analytics.title'),
    description: t('seachat.integrations.api.types.analytics.description'),
    example: t('seachat.integrations.api.types.analytics.example'),
    complexity: t('seachat.integrations.api.types.analytics.complexity'),
    timeEstimate: t('seachat.integrations.api.types.analytics.time')
  }
];

// Benefits data
const benefits = [
  {
    title: t('seachat.integrations.api.benefits.dataFlow.title'),
    description: t('seachat.integrations.api.benefits.dataFlow.description'),
    metric: '100%'
  },
  {
    title: t('seachat.integrations.api.benefits.manualWork.title'),
    description: t('seachat.integrations.api.benefits.manualWork.description'),
    metric: '80%'
  },
  {
    title: t('seachat.integrations.api.benefits.insights.title'),
    description: t('seachat.integrations.api.benefits.insights.description'),
    metric: '3x'
  },
  {
    title: t('seachat.integrations.api.benefits.implementation.title'),
    description: t('seachat.integrations.api.benefits.implementation.description'),
    metric: '75%'
  }
];

// Code example
const codeExample = `// Initialize SeaChat API client
const SeaChat = require('@seachat/api');
const client = new SeaChat({
  apiKey: 'your_api_key_here',
  webhookSecret: 'your_webhook_secret'
});

// Listen for new conversations
client.webhooks.on('conversation.created', async (conversation) => {
  // Custom logic for new conversations
  console.log('New conversation:', conversation.id);
  
  // Example: Create CRM lead
  await createCRMLead({
    email: conversation.customer.email,
    source: 'support_chat',
    conversation_id: conversation.id
  });
});

// Create custom integration endpoint
app.post('/api/seachat/webhook', (req, res) => {
  const event = client.webhooks.verify(req.body, req.headers);
  
  switch(event.type) {
    case 'message.received':
      handleNewMessage(event.data);
      break;
    case 'conversation.resolved':
      updateCRMStatus(event.data);
      break;
  }
  
  res.status(200).send('OK');
});`;

// SEO metadata
const canonicalUrl = `https://seasalt.ai/${lang}/seachat/integrations/api`;
---

<Layout 
  title={t('seachat.integrations.api.title')}
  description={t('seachat.integrations.api.subtitle')}
  canonical={canonicalUrl}
  lang={lang as SupportedLanguage}
>
  <div>
    <!-- Hero Section -->
    <section class="py-20 bg-gradient-to-br from-gray-900 via-blue-900 to-indigo-800 text-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center">
          <div class="flex items-center justify-center mb-6">
            <svg class="w-16 h-16 text-blue-300 mr-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path>
            </svg>
            <h1 class="text-5xl md:text-6xl font-bold">
              {t('seachat.integrations.api.title')}
            </h1>
          </div>
          <p class="text-2xl text-blue-200 mb-8 max-w-4xl mx-auto">
            {t('seachat.integrations.api.subtitle')}
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a
              href="https://chat.seasalt.ai/gpt/signup"
              target="_blank"
              rel="noopener noreferrer"
              class="bg-blue-500 hover:bg-blue-400 text-white px-8 py-4 rounded-lg text-lg font-semibold transition-all transform hover:scale-105 text-center"
            >
              {t('seachat.integrations.api.accessButton')}
            </a>
            <a
              href="https://api.seasalt.ai/"
              target="_blank"
              rel="noopener noreferrer"
              class="border-2 border-white text-white hover:bg-white hover:text-blue-900 px-8 py-4 rounded-lg text-lg font-semibold transition-all text-center"
            >
              {t('seachat.integrations.api.docsButton')}
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- API Features -->
    <section class="py-20 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4">
            {t('seachat.integrations.api.capabilitiesTitle')}
          </h2>
          <p class="text-xl text-gray-600 max-w-3xl mx-auto">
            {t('seachat.integrations.api.capabilitiesSubtitle')}
          </p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
          {apiFeatures.map((feature, index) => (
            <div
              key={index}
              class="bg-white rounded-2xl p-8 shadow-lg hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2 border border-gray-100"
            >
              <div class={`w-16 h-16 bg-gradient-to-br ${feature.color} rounded-2xl flex items-center justify-center mb-6`}>
                {feature.icon === 'code' && (
                  <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path>
                  </svg>
                )}
                {feature.icon === 'zap' && (
                  <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                  </svg>
                )}
                {feature.icon === 'puzzle' && (
                  <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 4a2 2 0 114 0v1a1 1 0 001 1h3a1 1 0 011 1v3a1 1 0 01-1 1h-1a2 2 0 100 4h1a1 1 0 011 1v3a1 1 0 01-1 1h-3a1 1 0 01-1-1v-1a2 2 0 10-4 0v1a1 1 0 01-1 1H7a1 1 0 01-1-1v-3a1 1 0 00-1-1H4a2 2 0 110-4h1a1 1 0 001-1V7a1 1 0 011-1h3a1 1 0 001-1V4z"></path>
                  </svg>
                )}
                {feature.icon === 'settings' && (
                  <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                  </svg>
                )}
              </div>
              <h3 class="text-xl font-bold text-gray-900 mb-4">{feature.title}</h3>
              <p class="text-gray-600 leading-relaxed">{feature.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Integration Types -->
    <section class="py-20 bg-gray-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4">
            {t('seachat.integrations.api.patternsTitle')}
          </h2>
          <p class="text-xl text-gray-600 max-w-3xl mx-auto">
            {t('seachat.integrations.api.patternsSubtitle')}
          </p>
        </div>

        <div class="grid md:grid-cols-2 gap-8">
          {integrationTypes.map((integration, index) => (
            <div
              key={index}
              class="bg-white rounded-2xl p-8 shadow-lg hover:shadow-xl transition-all duration-300"
            >
              <h3 class="text-2xl font-bold text-gray-900 mb-4">{integration.title}</h3>
              <p class="text-gray-600 mb-6">{integration.description}</p>
              
              <div class="bg-blue-50 rounded-lg p-4 mb-6 border border-blue-100">
                <h4 class="font-semibold text-blue-900 mb-2">{t('seachat.integrations.api.useCaseTitle')}:</h4>
                <p class="text-blue-800 text-sm">{integration.example}</p>
              </div>
              
              <div class="flex items-center justify-between">
                <div class="flex items-center space-x-4">
                  <div class={`px-3 py-1 rounded-full text-sm font-medium ${
                    integration.complexity === t('seachat.integrations.api.types.analytics.complexity') ? 'bg-green-100 text-green-800' :
                    integration.complexity === t('seachat.integrations.api.types.crm.complexity') ? 'bg-yellow-100 text-yellow-800' :
                    'bg-red-100 text-red-800'
                  }`}>
                    {integration.complexity}
                  </div>
                  <span class="text-sm text-gray-600">{integration.timeEstimate}</span>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Code Example -->
    <section class="py-20 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4">
            {t('seachat.integrations.api.exampleTitle')}
          </h2>
          <p class="text-xl text-gray-600 max-w-3xl mx-auto">
            {t('seachat.integrations.api.exampleSubtitle')}
          </p>
        </div>

        <div class="bg-gray-900 rounded-2xl p-8 overflow-x-auto">
          <div class="flex items-center justify-between mb-6">
            <h3 class="text-xl font-bold text-white">{t('seachat.integrations.api.integrationExample')}</h3>
            <button id="copyCodeBtn" class="flex items-center space-x-2 text-gray-400 hover:text-white transition-colors">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
              </svg>
              <span id="copyBtnText">{t('seachat.integrations.api.copyCode')}</span>
            </button>
          </div>
          <pre class="text-green-400 text-sm leading-relaxed overflow-x-auto">
            <code id="codeContent">{codeExample}</code>
          </pre>
        </div>
      </div>
    </section>

    <!-- Benefits Section -->
    <section class="py-20 bg-gray-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4">
            {t('seachat.integrations.api.benefitsTitle')}
          </h2>
          <p class="text-xl text-gray-600 max-w-3xl mx-auto">
            {t('seachat.integrations.api.benefitsSubtitle')}
          </p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
          {benefits.map((benefit, index) => (
            <div
              key={index}
              class="bg-white rounded-2xl p-8 shadow-lg text-center hover:shadow-xl transition-all duration-300"
            >
              <div class="text-4xl font-bold text-blue-600 mb-4">{benefit.metric}</div>
              <h3 class="text-xl font-bold text-gray-900 mb-4">{benefit.title}</h3>
              <p class="text-gray-600">{benefit.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Getting Started -->
    <section class="py-20 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid lg:grid-cols-2 gap-12 items-center">
          <div>
            <h2 class="text-4xl font-bold text-gray-900 mb-6">
              {t('seachat.integrations.api.buildTitle')}
            </h2>
            <p class="text-lg text-gray-600 mb-8">
              {t('seachat.integrations.api.buildSubtitle')}
            </p>
            
            <div class="space-y-6">
              <div class="flex items-start space-x-4">
                <div class="w-8 h-8 bg-blue-600 text-white rounded-full flex items-center justify-center font-bold text-sm flex-shrink-0">1</div>
                <div>
                  <h4 class="font-semibold text-gray-900 mb-2">{t('seachat.integrations.api.steps.credentials.title')}</h4>
                  <p class="text-gray-600">{t('seachat.integrations.api.steps.credentials.description')}</p>
                </div>
              </div>
              
              <div class="flex items-start space-x-4">
                <div class="w-8 h-8 bg-purple-600 text-white rounded-full flex items-center justify-center font-bold text-sm flex-shrink-0">2</div>
                <div>
                  <h4 class="font-semibold text-gray-900 mb-2">{t('seachat.integrations.api.steps.docs.title')}</h4>
                  <p class="text-gray-600">{t('seachat.integrations.api.steps.docs.description')}</p>
                </div>
              </div>
              
              <div class="flex items-start space-x-4">
                <div class="w-8 h-8 bg-green-600 text-white rounded-full flex items-center justify-center font-bold text-sm flex-shrink-0">3</div>
                <div>
                  <h4 class="font-semibold text-gray-900 mb-2">{t('seachat.integrations.api.steps.build.title')}</h4>
                  <p class="text-gray-600">{t('seachat.integrations.api.steps.build.description')}</p>
                </div>
              </div>
              
              <div class="flex items-start space-x-4">
                <div class="w-8 h-8 bg-orange-600 text-white rounded-full flex items-center justify-center font-bold text-sm flex-shrink-0">4</div>
                <div>
                  <h4 class="font-semibold text-gray-900 mb-2">{t('seachat.integrations.api.steps.deploy.title')}</h4>
                  <p class="text-gray-600">{t('seachat.integrations.api.steps.deploy.description')}</p>
                </div>
              </div>
            </div>
          </div>
          
          <div class="bg-gradient-to-br from-blue-50 to-purple-50 rounded-2xl p-8 border border-blue-100">
            <h3 class="text-2xl font-bold text-gray-900 mb-6">{t('seachat.integrations.api.resourcesTitle')}</h3>
            <div class="space-y-4">
              <div class="flex items-center space-x-3">
                <svg class="w-5 h-5 text-green-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                <span class="text-gray-700">{t('seachat.integrations.api.resources.docs')}</span>
              </div>
              <div class="flex items-center space-x-3">
                <svg class="w-5 h-5 text-green-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                <span class="text-gray-700">{t('seachat.integrations.api.resources.explorer')}</span>
              </div>
              <div class="flex items-center space-x-3">
                <svg class="w-5 h-5 text-green-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                <span class="text-gray-700">{t('seachat.integrations.api.resources.examples')}</span>
              </div>
              <div class="flex items-center space-x-3">
                <svg class="w-5 h-5 text-green-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                <span class="text-gray-700">{t('seachat.integrations.api.resources.sandbox')}</span>
              </div>
              <div class="flex items-center space-x-3">
                <svg class="w-5 h-5 text-green-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                <span class="text-gray-700">{t('seachat.integrations.api.resources.simulator')}</span>
              </div>
              <div class="flex items-center space-x-3">
                <svg class="w-5 h-5 text-green-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                <span class="text-gray-700">{t('seachat.integrations.api.resources.community')}</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="py-20 bg-gradient-to-r from-gray-900 to-blue-900">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-4xl md:text-5xl font-bold text-white mb-6">
          {t('seachat.integrations.api.ctaTitle')}
        </h2>
        <p class="text-xl text-blue-100 mb-8 max-w-3xl mx-auto">
          {t('seachat.integrations.api.ctaSubtitle')}
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="https://chat.seasalt.ai/gpt/signup"
            target="_blank"
            rel="noopener noreferrer"
            class="bg-blue-500 hover:bg-blue-400 text-white px-8 py-4 rounded-lg text-lg font-semibold transition-colors text-center"
          >
            {t('seachat.integrations.api.ctaAccessButton')}
          </a>
          <a
            href="https://api.seasalt.ai/"
            target="_blank"
            rel="noopener noreferrer"
            class="border-2 border-white text-white hover:bg-white hover:text-blue-900 px-8 py-4 rounded-lg text-lg font-semibold transition-all flex items-center justify-center"
          >
            {t('seachat.integrations.api.ctaDocsButton')}
            <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
            </svg>
          </a>
        </div>
      </div>
    </section>
  </div>

  <!-- Script for copy code functionality -->
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const copyBtn = document.getElementById('copyCodeBtn');
      const codeContent = document.getElementById('codeContent');
      const btnText = document.getElementById('copyBtnText');
      
      if (copyBtn && codeContent && btnText) {
        copyBtn.addEventListener('click', async function() {
          try {
            await navigator.clipboard.writeText(codeContent.textContent || '');
            const originalText = btnText.textContent;
            btnText.textContent = 'Copied!';
            copyBtn.classList.add('text-green-400');
            
            setTimeout(() => {
              btnText.textContent = originalText;
              copyBtn.classList.remove('text-green-400');
            }, 2000);
          } catch (err) {
            console.error('Failed to copy text:', err);
          }
        });
      }
    });
  </script>
</Layout>