---
import { getTranslationHelpers, languages, type SupportedLanguage } from '../../../../i18n/helpers';
import { getMeetingUrl } from "../../../../constants/urls";
import Layout from '../../../../layouts/Layout.astro';

export async function getStaticPaths() {
  return Object.keys(languages).map(lang => ({ params: { lang } }));
}

const { lang } = Astro.params;
const { t, translations } = await getTranslationHelpers(lang as SupportedLanguage);

// E-commerce platforms data
const platforms = [
  {
    name: t('seachat.integrations.ecommerce.platforms.bigcommerce.name'),
    logo: '🏬',
    description: t('seachat.integrations.ecommerce.platforms.bigcommerce.description'),
    features: [
      t('seachat.integrations.ecommerce.platforms.bigcommerce.features.orders'),
      t('seachat.integrations.ecommerce.platforms.bigcommerce.features.products'),
      t('seachat.integrations.ecommerce.platforms.bigcommerce.features.customers'),
      t('seachat.integrations.ecommerce.platforms.bigcommerce.features.shipping')
    ],
    setupTime: t('seachat.integrations.ecommerce.platforms.bigcommerce.setupTime'),
    popularity: t('seachat.integrations.ecommerce.platforms.bigcommerce.popularity')
  },
  {
    name: t('seachat.integrations.ecommerce.platforms.etsy.name'),
    logo: '🎨',
    description: t('seachat.integrations.ecommerce.platforms.etsy.description'),
    features: [
      t('seachat.integrations.ecommerce.platforms.etsy.features.orders'),
      t('seachat.integrations.ecommerce.platforms.etsy.features.shop'),
      t('seachat.integrations.ecommerce.platforms.etsy.features.messages'),
      t('seachat.integrations.ecommerce.platforms.etsy.features.listings')
    ],
    setupTime: t('seachat.integrations.ecommerce.platforms.etsy.setupTime'),
    popularity: t('seachat.integrations.ecommerce.platforms.etsy.popularity')
  },
  {
    name: t('seachat.integrations.ecommerce.platforms.fourthwall.name'),
    logo: '🎬',
    description: t('seachat.integrations.ecommerce.platforms.fourthwall.description'),
    features: [
      t('seachat.integrations.ecommerce.platforms.fourthwall.features.merch'),
      t('seachat.integrations.ecommerce.platforms.fourthwall.features.memberships'),
      t('seachat.integrations.ecommerce.platforms.fourthwall.features.donations'),
      t('seachat.integrations.ecommerce.platforms.fourthwall.features.community')
    ],
    setupTime: t('seachat.integrations.ecommerce.platforms.fourthwall.setupTime'),
    popularity: t('seachat.integrations.ecommerce.platforms.fourthwall.popularity')
