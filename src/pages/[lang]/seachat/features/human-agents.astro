---
import Layout from '../../../../layouts/Layout.astro';
import { getTranslationHelpers, type SupportedLanguage, supportedLocales } from '../../../../i18n/helpers';

// Generate all static paths for supported languages
export async function getStaticPaths() {
  return supportedLocales.map((lang) => ({
    params: { lang }
  }));
}

const { lang } = Astro.params;
const currentLang = (lang as SupportedLanguage) || 'en';

// Get translation helpers for the current language
const { t } = await getTranslationHelpers(currentLang);

// SEO data for the human agents page
const title = t('seachat.features.humanAgents.title') + ' - SeaChat' || 'Human Agent Chat - SeaChat';
const description = t('seachat.features.humanAgents.subtitle') || 'Start with real human support agents, completely free for life. No limits, no catches, just genuine human connection with your customers.';
const keywords = 'human agents, live chat, customer support, free agents, real humans, chat support';

const seoData = {
  title,
  description,
  keywords,
  ogTitle: title,
  ogDescription: description,
  ogType: 'website'
};

// Breadcrumbs
const breadcrumbs = [
  { name: 'Home', url: `/${currentLang}/` },
  { name: 'SeaChat', url: `/${currentLang}/seachat/` },
  { name: 'Features', url: `/${currentLang}/seachat/features/` },
  { name: t('seachat.features.humanAgents.title') || 'Human Agent Chat' }
];

// Features data
const features = [
  {
    icon: '∞',
    title: t('seachat.features.humanAgents.unlimited.title') || 'Unlimited Agent Hours',
    description: t('seachat.features.humanAgents.unlimited.description') || 'No time limits, no hourly caps. Your human agent works as much as you need, completely free.'
  },
  {
    icon: '💬',
    title: t('seachat.features.humanAgents.realtime.title') || 'Real-time Chat Management',
    description: t('seachat.features.humanAgents.realtime.description') || 'Handle multiple conversations simultaneously with our intuitive chat interface.'
  },
  {
    icon: '👥',
    title: t('seachat.features.humanAgents.collaboration.title') || 'Multi-agent Collaboration',
    description: t('seachat.features.humanAgents.collaboration.description') || 'Scale your team with seamless agent-to-agent handoffs and collaboration tools.'
  },
  {
    icon: '🛡️',
    title: t('seachat.features.humanAgents.security.title') || 'Advanced Security',
    description: t('seachat.features.humanAgents.security.description') || 'Enterprise-grade security with end-to-end encryption and data protection.'
  },
  {
    icon: '⭐',
    title: t('seachat.features.humanAgents.analytics.title') || 'Performance Analytics',
    description: t('seachat.features.humanAgents.analytics.description') || 'Track response times, customer satisfaction, and agent performance metrics.'
  },
  {
    icon: '✅',
    title: t('seachat.features.humanAgents.workflows.title') || 'Custom Workflows',
    description: t('seachat.features.humanAgents.workflows.description') || 'Create personalized workflows and automation rules for your support process.'
  }
];

// Benefits data
const benefits = [
  {
    title: t('seachat.features.humanAgents.benefits.personal.title') || 'Personal Touch',
    description: t('seachat.features.humanAgents.benefits.personal.description') || 'Human empathy and understanding that AI cannot replicate',
    icon: '❤️'
  },
  {
    title: t('seachat.features.humanAgents.benefits.complex.title') || 'Complex Problem Solving',
    description: t('seachat.features.humanAgents.benefits.complex.description') || 'Handle nuanced situations that require human judgment',
    icon: '👥'
  },
  {
    title: t('seachat.features.humanAgents.benefits.brand.title') || 'Brand Representation',
    description: t('seachat.features.humanAgents.benefits.brand.description') || 'Agents who truly understand and represent your brand values',
    icon: '⭐'
  },
  {
    title: t('seachat.features.humanAgents.benefits.relationships.title') || 'Customer Relationships',
    description: t('seachat.features.humanAgents.benefits.relationships.description') || 'Build lasting relationships through genuine human connections',
    icon: '☕'
  }
];
---

<Layout 
  title={seoData.title}
  description={seoData.description}
  keywords={seoData.keywords}
  lang={currentLang}
  ogTitle={seoData.ogTitle}
  ogDescription={seoData.ogDescription}
  ogType={seoData.ogType}
  breadcrumbs={breadcrumbs}
>
  <div>
    <!-- Hero Section -->
    <section class="py-20 bg-gradient-to-br from-blue-900 via-blue-800 to-blue-700 text-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center">
          <div class="flex items-center justify-center mb-6">
            <span class="text-6xl mr-4">👥</span>
            <h1 class="text-5xl md:text-6xl font-bold">
              {t('seachat.features.humanAgents.title') || 'Human Agent Chat'}
            </h1>
          </div>
          <p class="text-2xl text-blue-200 mb-8 max-w-4xl mx-auto">
            {t('seachat.features.humanAgents.subtitle') || 'Start with real human support agents, completely free for life. No limits, no catches, just genuine human connection with your customers.'}
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href="https://chat.seasalt.ai/gpt/signup" class="bg-teal-500 hover:bg-teal-400 text-white px-8 py-4 rounded-lg text-lg font-semibold transition-all transform hover:scale-105">
              {t('seachat.features.humanAgents.startButton') || 'Start Free Forever'}
            </a>
            <a href={`https://calendar.app.google/NL13hnQEG5Mj6LsPA`} target="_blank" rel="noopener noreferrer" class="border-2 border-white text-white hover:bg-white hover:text-blue-900 px-8 py-4 rounded-lg text-lg font-semibold transition-all">
              {t('seachat.features.humanAgents.demoButton') || 'Watch Demo'}
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Free Forever Section -->
    <section class="py-20 bg-gradient-to-br from-green-50 to-teal-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4">
            {t('seachat.features.humanAgents.freeForever.title') || 'Truly Free as in Free 🍺 & 🎙️'}
          </h2>
          <p class="text-xl text-gray-600 max-w-3xl mx-auto">
            {t('seachat.features.humanAgents.freeForever.subtitle') || 'We mean it when we say free. One human agent for life, with unlimited everything.'}
          </p>
        </div>

        <div class="bg-white rounded-3xl p-12 shadow-2xl border border-green-100">
          <div class="grid md:grid-cols-2 gap-12 items-center">
            <div>
              <h3 class="text-3xl font-bold text-gray-900 mb-6">
                {t('seachat.features.humanAgents.freeForever.meaningTitle') || 'What "Free Forever" Really Means'}
              </h3>
              <div class="space-y-4">
                <div class="flex items-center space-x-3">
                  <span class="text-green-500 text-xl">✅</span>
                  <span class="text-lg text-gray-700">{t('seachat.features.humanAgents.freeForever.agent') || '1 Human Agent for Life'}</span>
                </div>
                <div class="flex items-center space-x-3">
                  <span class="text-green-500 text-xl">✅</span>
                  <span class="text-lg text-gray-700">{t('seachat.features.humanAgents.freeForever.conversations') || 'Unlimited Chat Conversations'}</span>
                </div>
                <div class="flex items-center space-x-3">
                  <span class="text-green-500 text-xl">✅</span>
                  <span class="text-lg text-gray-700">{t('seachat.features.humanAgents.freeForever.history') || 'Unlimited Chat History'}</span>
                </div>
                <div class="flex items-center space-x-3">
                  <span class="text-green-500 text-xl">✅</span>
                  <span class="text-lg text-gray-700">{t('seachat.features.humanAgents.freeForever.contacts') || 'Unlimited Contacts'}</span>
                </div>
                <div class="flex items-center space-x-3">
                  <span class="text-green-500 text-xl">✅</span>
                  <span class="text-lg text-gray-700">{t('seachat.features.humanAgents.freeForever.export') || 'Freedom to Export All Data'}</span>
                </div>
                <div class="flex items-center space-x-3">
                  <span class="text-green-500 text-xl">✅</span>
                  <span class="text-lg text-gray-700">{t('seachat.features.humanAgents.freeForever.noCredit') || 'No Credit Card Required'}</span>
                </div>
              </div>
            </div>
            <div class="bg-gradient-to-br from-green-100 to-teal-100 rounded-2xl p-8 text-center">
              <div class="text-6xl font-bold text-green-600 mb-4">∞</div>
              <h4 class="text-2xl font-bold text-gray-900 mb-4">{t('seachat.features.humanAgents.freeForever.unlimited') || 'Unlimited Everything'}</h4>
              <p class="text-gray-700 mb-6">
                {t('seachat.features.humanAgents.freeForever.noCaps') || 'No hidden fees, no time limits, no conversation caps. Just pure, unlimited human support.'}
              </p>
              <div class="bg-white rounded-lg p-4 shadow-md">
                <div class="text-3xl font-bold text-gray-900">$0</div>
                <div class="text-gray-600">{t('seachat.features.humanAgents.freeForever.forever') || 'Forever'}</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Features Grid -->
    <section class="py-20 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4">
            {t('seachat.features.humanAgents.featuresTitle') || 'Powerful Human Agent Features'}
          </h2>
          <p class="text-xl text-gray-600 max-w-3xl mx-auto">
            {t('seachat.features.humanAgents.featuresSubtitle') || 'Everything you need to provide exceptional human-powered customer support.'}
          </p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
          {features.map((feature) => (
            <div class="bg-white rounded-2xl p-8 shadow-lg hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2 border border-gray-100">
              <div class="w-16 h-16 bg-gradient-to-br from-blue-500 to-teal-500 rounded-2xl flex items-center justify-center mb-6">
                <span class="text-2xl">{feature.icon}</span>
              </div>
              <h3 class="text-xl font-bold text-gray-900 mb-4">{feature.title}</h3>
              <p class="text-gray-600 leading-relaxed">{feature.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Why Human Agents Matter -->
    <section class="py-20 bg-gray-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4">
            {t('seachat.features.humanAgents.whyMatterTitle') || 'Why Human Agents Still Matter'}
          </h2>
          <p class="text-xl text-gray-600 max-w-3xl mx-auto">
            {t('seachat.features.humanAgents.whyMatterSubtitle') || 'In an AI-driven world, human connection remains irreplaceable for building trust and solving complex problems.'}
          </p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
          {benefits.map((benefit) => (
            <div class="text-center bg-white rounded-xl p-8 shadow-lg hover:shadow-xl transition-all duration-300">
              <div class="w-16 h-16 bg-gradient-to-br from-pink-500 to-red-500 rounded-full flex items-center justify-center mx-auto mb-6">
                <span class="text-2xl">{benefit.icon}</span>
              </div>
              <h3 class="text-xl font-bold text-gray-900 mb-4">{benefit.title}</h3>
              <p class="text-gray-600">{benefit.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="py-20 bg-gradient-to-r from-blue-600 to-teal-500">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-4xl md:text-5xl font-bold text-white mb-6">
          {t('seachat.features.humanAgents.ctaTitle') || 'Ready to Start with Human Agents?'}
        </h2>
        <p class="text-xl text-blue-100 mb-8 max-w-3xl mx-auto">
          {t('seachat.features.humanAgents.ctaSubtitle') || 'Join thousands of businesses providing exceptional customer support with our free human agents.'}
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="https://chat.seasalt.ai/gpt/signup" class="bg-white text-blue-600 hover:bg-gray-100 px-8 py-4 rounded-lg text-lg font-semibold transition-colors">
            {t('seachat.features.humanAgents.ctaStartButton') || 'Start Free Now'}
          </a>
          <a href={`https://calendar.app.google/NL13hnQEG5Mj6LsPA`} target="_blank" rel="noopener noreferrer" class="border-2 border-white text-white hover:bg-white hover:text-blue-600 px-8 py-4 rounded-lg text-lg font-semibold transition-all">
            {t('seachat.features.humanAgents.ctaDemoButton') || 'Schedule Demo'}
          </a>
        </div>
      </div>
    </section>
  </div>
</Layout>
