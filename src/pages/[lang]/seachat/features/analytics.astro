---
import Layout from '../../../../layouts/Layout.astro';
import { getTranslationHelpers, type SupportedLanguage } from '../../../../i18n/helpers';
import { getMeetingUrl } from '../../../../constants/urls';

// Generate all static paths for supported languages
export async function getStaticPaths() {
  const supportedLanguages: SupportedLanguage[] = [
    'en', 'es', 'zh-tw', 'zh-cn', 'ja', 'ko', 'fr', 'de', 'ar', 'fa', 
    'fil', 'hi', 'id', 'ms', 'pl', 'pt', 'ru', 'ta', 'th', 'vi'
  ];
  
  return supportedLanguages.map((lang) => ({
    params: { lang }
  }));
}

const { lang } = Astro.params;
const currentLang = (lang as SupportedLanguage) || 'en';

// Get translation helpers for the current language
const { t } = await getTranslationHelpers(currentLang);

// SEO data for the analytics page
const title = t('seachat.features.analytics.title') || 'Analytics & Insights';
const description = t('seachat.features.analytics.subtitle') || 'Make data-driven decisions with comprehensive analytics that reveal customer behavior, agent performance, and optimization opportunities.';

const seoData = {
  title: `${title} | SeaChat`,
  description,
  keywords: 'analytics, insights, data analytics, customer analytics, performance metrics, reporting, dashboards',
  ogTitle: title,
  ogDescription: description,
  ogType: 'website'
};

// Breadcrumbs
const breadcrumbs = [
  { name: 'Home', url: `/${currentLang}/` },
  { name: 'SeaChat', url: `/${currentLang}/seachat/` },
  { name: 'Features', url: `/${currentLang}/seachat/features/` },
  { name: title }
];

// Get meeting URL based on language
const meetingUrl = getMeetingUrl(currentLang);

// Metrics data
const metrics = [
  {
    icon: '👥',
    title: t('seachat.features.analytics.metrics.satisfaction.title') || 'Customer Satisfaction',
    value: '94.5%',
    change: '+2.3%',
    color: 'from-green-500 to-emerald-500'
  },
  {
    icon: '⏰',
    title: t('seachat.features.analytics.metrics.responseTime.title') || 'Average Response Time',
    value: '1.2 min',
    change: '-15%',
    color: 'from-blue-500 to-indigo-500'
  },
  {
    icon: '🎯',
    title: t('seachat.features.analytics.metrics.resolution.title') || 'Resolution Rate',
    value: '87.3%',
    change: '+5.1%',
    color: 'from-purple-500 to-pink-500'
  },
  {
    icon: '📈',
    title: t('seachat.features.analytics.metrics.growth.title') || 'Monthly Growth',
    value: '23.4%',
    change: '+8.2%',
    color: 'from-orange-500 to-red-500'
  }
];

// Features data
const features = [
  {
    icon: '📊',
    title: t('seachat.features.analytics.seachat.features.dashboards.title') || 'Real-time Dashboards',
    description: t('seachat.features.analytics.seachat.features.dashboards.description') || 'Monitor your support performance with live, customizable dashboards.',
    benefits: [
      t('seachat.features.analytics.seachat.features.dashboards.benefits.metrics') || 'Live performance metrics',
      t('seachat.features.analytics.seachat.features.dashboards.benefits.kpi') || 'Custom KPI tracking',
      t('seachat.features.analytics.seachat.features.dashboards.benefits.team') || 'Team performance views',
      t('seachat.features.analytics.seachat.features.dashboards.benefits.alerts') || 'Alert notifications'
    ]
  },
  {
    icon: '📈',
    title: t('seachat.features.analytics.seachat.features.reporting.title') || 'Advanced Reporting',
    description: t('seachat.features.analytics.seachat.features.reporting.description') || 'Generate detailed reports with actionable insights and trends.',
    benefits: [
      t('seachat.features.analytics.seachat.features.reporting.benefits.automated') || 'Automated report generation',
      t('seachat.features.analytics.seachat.features.reporting.benefits.dates') || 'Custom date ranges',
      t('seachat.features.analytics.seachat.features.reporting.benefits.export') || 'Export capabilities',
      t('seachat.features.analytics.seachat.features.reporting.benefits.scheduled') || 'Scheduled delivery'
    ]
  },
  {
    icon: '👁️',
    title: t('seachat.features.analytics.seachat.features.journey.title') || 'Customer Journey Analytics',
    description: t('seachat.features.analytics.seachat.features.journey.description') || 'Track customer interactions across all touchpoints and channels.',
    benefits: [
      t('seachat.features.analytics.seachat.features.journey.benefits.tracking') || 'Multi-channel tracking',
      t('seachat.features.analytics.seachat.features.journey.benefits.visualization') || 'Journey visualization',
      t('seachat.features.analytics.seachat.features.journey.benefits.conversion') || 'Conversion analysis',
      t('seachat.features.analytics.seachat.features.journey.benefits.dropoff') || 'Drop-off identification'
    ]
  },
  {
    icon: '🎯',
    title: t('seachat.features.analytics.seachat.features.optimization.title') || 'Performance Optimization',
    description: t('seachat.features.analytics.seachat.features.optimization.description') || 'Identify bottlenecks and optimize your support operations.',
    benefits: [
      t('seachat.features.analytics.seachat.features.optimization.benefits.bottlenecks') || 'Bottleneck detection',
      t('seachat.features.analytics.seachat.features.optimization.benefits.resources') || 'Resource allocation',
      t('seachat.features.analytics.seachat.features.optimization.benefits.efficiency') || 'Efficiency recommendations',
      t('seachat.features.analytics.seachat.features.optimization.benefits.roi') || 'ROI analysis'
    ]
  }
];

// Chart heights for dashboard preview animation
const chartHeights = [65, 78, 82, 71, 89, 94, 87, 92, 85, 96, 88, 91];
---

<Layout 
  title={seoData.title}
  description={seoData.description}
  keywords={seoData.keywords}
  lang={currentLang}
  ogTitle={seoData.ogTitle}
  ogDescription={seoData.ogDescription}
  ogType={seoData.ogType}
  breadcrumbs={breadcrumbs}
>
  <div>
    <!-- Hero Section -->
    <section class="py-20 bg-gradient-to-br from-blue-900 via-indigo-800 to-purple-700 text-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center">
          <div class="flex items-center justify-center mb-6">
            <span class="text-6xl mr-4">📊</span>
            <h1 class="text-5xl md:text-6xl font-bold">
              {t('seachat.features.analytics.title') || 'Analytics & Insights'}
            </h1>
          </div>
          <p class="text-2xl text-blue-200 mb-8 max-w-4xl mx-auto">
            {t('seachat.features.analytics.subtitle') || 'Make data-driven decisions with comprehensive analytics that reveal customer behavior, agent performance, and optimization opportunities.'}
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href="https://chat.seasalt.ai/gpt/signup" target="_blank" rel="noopener noreferrer" class="bg-blue-500 hover:bg-blue-400 text-white px-8 py-4 rounded-lg text-lg font-semibold transition-all transform hover:scale-105 text-center">
              {t('common.actions.signUpForFree') || 'Sign Up For Free'}
            </a>
            <a href={meetingUrl} target="_blank" rel="noopener noreferrer" class="border-2 border-white text-white hover:bg-white hover:text-blue-900 px-8 py-4 rounded-lg text-lg font-semibold transition-all text-center">
              {t('common.actions.scheduleDemo') || 'Schedule Demo'}
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Key Metrics -->
    <section class="py-20 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4">
            {t('seachat.features.analytics.metricsTitle') || 'Key Performance Metrics'}
          </h2>
          <p class="text-xl text-gray-600 max-w-3xl mx-auto">
            {t('seachat.features.analytics.metricsSubtitle') || 'Track the metrics that matter most to your customer support success.'}
          </p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
          {metrics.map((metric, index) => (
            <div key={index} class="bg-white rounded-2xl p-8 shadow-lg hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2 border border-gray-100">
              <div class={`w-16 h-16 bg-gradient-to-br ${metric.color} rounded-2xl flex items-center justify-center mb-6`}>
                <span class="text-2xl">{metric.icon}</span>
              </div>
              <h3 class="text-3xl font-bold text-gray-900 mb-2">{metric.value}</h3>
              <p class="text-gray-600 mb-2">{metric.title}</p>
              <div class="flex items-center text-green-600 text-sm font-medium">
                <span class="mr-1">📈</span>
                {metric.change} {t('seachat.features.analytics.metrics.period') || 'this month'}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Analytics Features -->
    <section class="py-20 bg-gray-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4">
            {t('seachat.features.analytics.featuresTitle') || 'Comprehensive Analytics Suite'}
          </h2>
          <p class="text-xl text-gray-600 max-w-3xl mx-auto">
            {t('seachat.features.analytics.featuresSubtitle') || 'Everything you need to understand, measure, and improve your customer support operations.'}
          </p>
        </div>

        <div class="grid md:grid-cols-2 gap-12">
          {features.map((feature, index) => (
            <div key={index} class="bg-white rounded-2xl p-8 shadow-lg hover:shadow-xl transition-all duration-300">
              <div class="w-16 h-16 bg-gradient-to-br from-blue-500 to-purple-500 rounded-2xl flex items-center justify-center mb-6">
                <span class="text-2xl">{feature.icon}</span>
              </div>
              
              <h3 class="text-2xl font-bold text-gray-900 mb-4">{feature.title}</h3>
              <p class="text-gray-600 mb-6 text-lg">{feature.description}</p>
              
              <div class="space-y-3">
                {feature.benefits.map((benefit, idx) => (
                  <div key={idx} class="flex items-center space-x-3">
                    <div class="w-2 h-2 bg-blue-500 rounded-full"></div>
                    <span class="text-gray-700">{benefit}</span>
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Dashboard Preview -->
    <section class="py-20 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4">
            {t('seachat.features.analytics.dashboardTitle') || 'Interactive Dashboard Preview'}
          </h2>
          <p class="text-xl text-gray-600 max-w-3xl mx-auto">
            {t('seachat.features.analytics.dashboardSubtitle') || 'See how our analytics dashboard provides actionable insights at a glance.'}
          </p>
        </div>

        <div class="bg-gradient-to-br from-gray-900 to-blue-900 rounded-2xl p-8 text-white">
          <div class="grid lg:grid-cols-3 gap-8">
            <div class="lg:col-span-2">
              <h3 class="text-xl font-bold mb-6">{t('seachat.features.analytics.dashboard.overview') || 'Performance Overview'}</h3>
              <div class="bg-white/10 rounded-xl p-6 backdrop-blur-sm">
                <div class="h-64 flex items-end justify-between space-x-2">
                  {chartHeights.map((height, index) => (
                    <div key={index} class="bg-gradient-to-t from-blue-400 to-purple-400 rounded-t flex-1" style={`height: ${height}%`}></div>
                  ))}
                </div>
                <div class="flex justify-between mt-4 text-sm text-blue-200">
                  <span>{t('seachat.features.analytics.dashboard.months.jan') || 'Jan'}</span>
                  <span>{t('seachat.features.analytics.dashboard.months.dec') || 'Dec'}</span>
                </div>
              </div>
            </div>
            
            <div>
              <h3 class="text-xl font-bold mb-6">{t('seachat.features.analytics.dashboard.quickStats') || 'Quick Stats'}</h3>
              <div class="space-y-4">
                <div class="bg-white/10 rounded-lg p-4 backdrop-blur-sm">
                  <div class="text-2xl font-bold">1,247</div>
                  <div class="text-blue-200">{t('seachat.features.analytics.dashboard.activeConversations') || 'Active Conversations'}</div>
                </div>
                <div class="bg-white/10 rounded-lg p-4 backdrop-blur-sm">
                  <div class="text-2xl font-bold">98.2%</div>
                  <div class="text-blue-200">{t('seachat.features.analytics.dashboard.systemUptime') || 'System Uptime'}</div>
                </div>
                <div class="bg-white/10 rounded-lg p-4 backdrop-blur-sm">
                  <div class="text-2xl font-bold">4.8/5</div>
                  <div class="text-blue-200">{t('seachat.features.analytics.dashboard.customerRating') || 'Customer Rating'}</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="py-20 bg-gradient-to-r from-blue-600 to-purple-600">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-4xl md:text-5xl font-bold text-white mb-6">
          {t('seachat.features.analytics.ctaTitle') || 'Start Making Data-Driven Decisions'}
        </h2>
        <p class="text-xl text-blue-100 mb-8 max-w-3xl mx-auto">
          {t('seachat.features.analytics.ctaSubtitle') || 'Unlock the power of analytics to optimize your customer support and drive business growth.'}
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="https://chat.seasalt.ai/gpt/signup" target="_blank" rel="noopener noreferrer" class="bg-white text-blue-600 hover:bg-gray-100 px-8 py-4 rounded-lg text-lg font-semibold transition-colors text-center">
            {t('common.actions.signUpForFree') || 'Sign Up For Free'}
          </a>
          <a href={meetingUrl} target="_blank" rel="noopener noreferrer" class="border-2 border-white text-white hover:bg-white hover:text-blue-600 px-8 py-4 rounded-lg text-lg font-semibold transition-all flex items-center justify-center text-center">
            {t('common.actions.scheduleDemo') || 'Schedule Demo'}
          </a>
        </div>
      </div>
    </section>
  </div>
</Layout>