---
import Layout from '../../../../layouts/Layout.astro';
import { getTranslationHelpers, type SupportedLanguage } from '../../../../i18n/helpers';
import FintechPage from '../../../../components/react/seachat/FintechPage';

// Generate static paths for all supported languages
export async function getStaticPaths() {
  const supportedLanguages = [
    'en', 'es', 'zh-tw', 'zh-cn', 'ja', 'ko', 'fr', 'de', 'ar', 'fa',
    'fil', 'hi', 'id', 'ms', 'pl', 'pt', 'ru', 'ta', 'th', 'vi'
  ];

  return supportedLanguages.map((lang) => ({
    params: { lang }
  }));
}

const { lang } = Astro.params;
const currentLang = (lang as SupportedLanguage) || 'en';

// Get translations for server-side rendering
const { t, translations } = await getTranslationHelpers(currentLang);

// SEO metadata
const seoTitle = t('seachat.solutions.fintech.seo.title') || 'SeaChat for Fintech - Secure Financial Services Customer Support';
const seoDescription = t('seachat.solutions.fintech.seo.description') || 'Secure, compliant customer support for financial services. Handle transactions, provide investment guidance, and ensure regulatory compliance with confidence using SeaChat AI-powered solutions.';
const seoKeywords = t('seachat.solutions.fintech.seo.keywords') || 'SeaChat fintech, financial services AI, PCI DSS compliance, investment support, fraud detection, KYC AML compliance, financial customer support';

// Canonical URL
const canonicalUrl = `https://seasalt.ai/${currentLang}/seachat/solutions/fintech`;

// Open Graph and Twitter data
const ogData = {
  title: seoTitle,
  description: seoDescription,
  type: 'website',
  url: canonicalUrl,
  image: 'https://seasalt.ai/images/seachat-fintech-og.jpg',
  site_name: 'Seasalt.ai',
};

const twitterData = {
  card: 'summary_large_image',
  title: seoTitle,
  description: seoDescription,
  image: 'https://seasalt.ai/images/seachat-fintech-twitter.jpg',
};

// Structured data for Fintech Solutions
const structuredData = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "SeaChat Fintech Solutions",
  "applicationCategory": "FinancialServices",
  "description": seoDescription,
  "url": canonicalUrl,
  "operatingSystem": "Web-based",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD",
    "priceValidUntil": "2025-12-31",
    "availability": "https://schema.org/InStock",
    "description": "Free trial available"
  },
  "provider": {
    "@type": "Organization",
    "name": "Seasalt.ai",
    "url": "https://seasalt.ai"
  },
  "featureList": [
    "PCI DSS Compliance",
    "Fraud Detection",
    "Investment Support",
    "Transaction Management",
    "KYC/AML Compliance",
    "Multi-language Support",
    "Bank-grade Security"
  ],
  "screenshot": "https://seasalt.ai/images/seachat-fintech-screenshot.jpg"
};
---

<Layout 
  title={seoTitle} 
  description={seoDescription}
  keywords={seoKeywords}
  lang={currentLang}
  canonicalUrl={canonicalUrl}
  ogData={ogData}
  twitterData={twitterData}
  structuredData={structuredData}
>
  <FintechPage 
    client:only="react" 
    lang={currentLang} 
    translations={translations}
  />
</Layout>