---
import Layout from '../../../../layouts/Layout.astro';
import { getTranslationHelpers, type SupportedLanguage } from '../../../../i18n/helpers';
import { getMeetingUrl } from '../../../../constants/urls';

// Generate static paths for all supported languages
export async function getStaticPaths() {
  const supportedLanguages = [
    'en', 'es', 'zh-tw', 'zh-cn', 'ja', 'ko', 'fr', 'de', 'ar', 'fa',
    'fil', 'hi', 'id', 'ms', 'pl', 'pt', 'ru', 'ta', 'th', 'vi'
  ];

  return supportedLanguages.map((lang) => ({
    params: { lang }
  }));
}

const { lang } = Astro.params;
const currentLang = (lang as SupportedLanguage) || 'en';

// Get translations for server-side rendering
const { t } = await getTranslationHelpers(currentLang);

// SEO metadata - 使用與舊版本相同的翻譯鍵
const seoTitle = t('seachat.solutions.education.seo.title') || 'SeaChat for Education - Streamline Student Support & Campus Communication';
const seoDescription = t('seachat.solutions.education.seo.description') || 'Transform your educational institution with intelligent AI support for students, parents, faculty, and staff. Automate admissions, academic support, and campus operations.';
const seoKeywords = t('seachat.solutions.education.seo.keywords') || 'SeaChat education, student support, campus communication, educational AI, admission automation, academic assistance';

// Canonical URL
const canonicalUrl = `https://seasalt.ai/${currentLang}/seachat/solutions/education`;

// Open Graph and Twitter data
const ogData = {
  title: seoTitle,
  description: seoDescription,
  type: 'website',
  url: canonicalUrl,
  image: 'https://seasalt.ai/images/seachat-education-og.jpg',
  site_name: 'Seasalt.ai',
};

const twitterData = {
  card: 'summary_large_image',
  title: seoTitle,  
  description: seoDescription,
  image: 'https://seasalt.ai/images/seachat-education-twitter.jpg',
};

// Structured data
const structuredData = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "SeaChat Education Solutions",
  "applicationCategory": "BusinessApplication",
  "description": seoDescription,
  "url": canonicalUrl,
  "operatingSystem": "Web-based",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD",
    "priceValidUntil": "2025-12-31",
    "availability": "https://schema.org/InStock",
    "description": "Free trial available"
  },
  "provider": {
    "@type": "Organization",
    "name": "Seasalt.ai",
    "url": "https://seasalt.ai"
  },
  "featureList": [
    "Student Support Automation",
    "Administrative Task Management", 
    "Stakeholder Communication",
    "LMS Integration",
    "24/7 Campus Assistance",
    "Multi-Language Support"
  ],
  "screenshot": "https://seasalt.ai/images/seachat-education-screenshot.jpg"
};

// Page data - 保持與舊版本相同的翻譯鍵
const features = [
  {
    icon: 'book-open',
    titleKey: 'seachat.solutions.education.features.student.title',
    titleDefault: 'Student Support Services',
    descKey: 'seachat.solutions.education.features.student.description',
    descDefault: 'Provide comprehensive support for student inquiries, enrollment, academic guidance, and technical assistance.',
    benefits: [
      { key: 'seachat.solutions.education.features.student.benefits.support', default: '24/7 student support' },
      { key: 'seachat.solutions.education.features.student.benefits.enrollment', default: 'Enrollment assistance' },
      { key: 'seachat.solutions.education.features.student.benefits.academic', default: 'Academic guidance' },
      { key: 'seachat.solutions.education.features.student.benefits.technical', default: 'Technical support' }
    ]
  },
  {
    icon: 'calendar',
    titleKey: 'seachat.solutions.education.features.admin.title',
    titleDefault: 'Administrative Automation',
    descKey: 'seachat.solutions.education.features.admin.description',
    descDefault: 'Streamline administrative tasks including class scheduling, event management, and deadline tracking.',
    benefits: [
      { key: 'seachat.solutions.education.features.admin.benefits.scheduling', default: 'Class scheduling automation' },
      { key: 'seachat.solutions.education.features.admin.benefits.events', default: 'Event management' },
      { key: 'seachat.solutions.education.features.admin.benefits.deadlines', default: 'Deadline notifications' },
      { key: 'seachat.solutions.education.features.admin.benefits.registration', default: 'Course registration' }
    ]
  },
  {
    icon: 'users',
    titleKey: 'seachat.solutions.education.features.stakeholder.title',
    titleDefault: 'Stakeholder Communication',
    descKey: 'seachat.solutions.education.features.stakeholder.description',
    descDefault: 'Connect students, parents, faculty, and staff through unified communication portals.',
    benefits: [
      { key: 'seachat.solutions.education.features.stakeholder.benefits.portals', default: 'Unified communication portals' },
      { key: 'seachat.solutions.education.features.stakeholder.benefits.parent', default: 'Parent engagement' },
      { key: 'seachat.solutions.education.features.stakeholder.benefits.faculty', default: 'Faculty collaboration' },
      { key: 'seachat.solutions.education.features.stakeholder.benefits.staff', default: 'Staff coordination' }
    ]
  },
  {
    icon: 'message-square',
    titleKey: 'seachat.solutions.education.features.lms.title',
    titleDefault: 'LMS Integration',
    descKey: 'seachat.solutions.education.features.lms.description',
    descDefault: 'Seamlessly integrate with learning management systems to provide contextual support.',
    benefits: [
      { key: 'seachat.solutions.education.features.lms.benefits.connectivity', default: 'LMS connectivity' },
      { key: 'seachat.solutions.education.features.lms.benefits.grades', default: 'Grade inquiries' },
      { key: 'seachat.solutions.education.features.lms.benefits.assignments', default: 'Assignment help' },
      { key: 'seachat.solutions.education.features.lms.benefits.courses', default: 'Course information' }
    ]
  }
];

const integrations = [
  { 
    nameKey: 'seachat.solutions.education.integrations.canvas.name',
    nameDefault: 'Canvas',
    logo: '🎨', 
    descKey: 'seachat.solutions.education.integrations.canvas.description',
    descDefault: 'Complete integration with Canvas LMS platform'
  },
  { 
    nameKey: 'seachat.solutions.education.integrations.blackboard.name',
    nameDefault: 'Blackboard Learn',
    logo: '⚫', 
    descKey: 'seachat.solutions.education.integrations.blackboard.description',
    descDefault: 'Native Blackboard Learn integration for seamless support'
  },
  { 
    nameKey: 'seachat.solutions.education.integrations.moodle.name',
    nameDefault: 'Moodle',
    logo: '🎓', 
    descKey: 'seachat.solutions.education.integrations.moodle.description',
    descDefault: 'Open-source Moodle LMS connectivity'
  },
  { 
    nameKey: 'seachat.solutions.education.integrations.google.name',
    nameDefault: 'Google Classroom',
    logo: '📚', 
    descKey: 'seachat.solutions.education.integrations.google.description',
    descDefault: 'Google for Education suite integration'
  },
  { 
    nameKey: 'seachat.solutions.education.integrations.zoom.name',
    nameDefault: 'Zoom',
    logo: '📹', 
    descKey: 'seachat.solutions.education.integrations.zoom.description',
    descDefault: 'Video conferencing and webinar support'
  },
  { 
    nameKey: 'seachat.solutions.education.integrations.teams.name',
    nameDefault: 'Microsoft Teams',
    logo: '💼', 
    descKey: 'seachat.solutions.education.integrations.teams.description',
    descDefault: 'Microsoft Teams for Education integration'
  },
  { 
    nameKey: 'seachat.solutions.education.integrations.sis.name',
    nameDefault: 'Student Information System',
    logo: '🗂️', 
    descKey: 'seachat.solutions.education.integrations.sis.description',
    descDefault: 'Connect with existing SIS platforms'
  },
  { 
    nameKey: 'seachat.solutions.education.integrations.library.name',
    nameDefault: 'Library Systems',
    logo: '📖', 
    descKey: 'seachat.solutions.education.integrations.library.description',
    descDefault: 'Library catalog and resource management'
  }
];

const metrics = [
  { 
    value: '50%', 
    labelKey: 'seachat.solutions.education.metrics.admin.label',
    labelDefault: 'Reduction in Administrative Tasks',
    descKey: 'seachat.solutions.education.metrics.admin.description',
    descDefault: 'Through intelligent automation'
  },
  { 
    value: '85%', 
    labelKey: 'seachat.solutions.education.metrics.satisfaction.label',
    labelDefault: 'Student Satisfaction Rate',
    descKey: 'seachat.solutions.education.metrics.satisfaction.description',
    descDefault: 'For AI-powered support interactions'
  },
  { 
    value: '40%', 
    labelKey: 'seachat.solutions.education.metrics.response.label',
    labelDefault: 'Faster Response Times',
    descKey: 'seachat.solutions.education.metrics.response.description',
    descDefault: 'With automated inquiry handling'
  },
  { 
    value: '60%', 
    labelKey: 'seachat.solutions.education.metrics.enrollment.label',
    labelDefault: 'Increase in Enrollment Inquiries',
    descKey: 'seachat.solutions.education.metrics.enrollment.description',
    descDefault: 'Through 24/7 availability'
  }
];

const stakeholders = [
  {
    titleKey: 'seachat.solutions.education.stakeholders.students.title',
    titleDefault: 'Students',
    descKey: 'seachat.solutions.education.stakeholders.students.description',
    descDefault: 'Comprehensive support for all student needs',
    features: [
      { key: 'seachat.solutions.education.stakeholders.students.features.courses', default: 'Course information' },
      { key: 'seachat.solutions.education.stakeholders.students.features.assignments', default: 'Assignment help' },
      { key: 'seachat.solutions.education.stakeholders.students.features.grades', default: 'Grade inquiries' },
      { key: 'seachat.solutions.education.stakeholders.students.features.campus', default: 'Campus services' }
    ]
  },
  {
    titleKey: 'seachat.solutions.education.stakeholders.parents.title',
    titleDefault: 'Parents',
    descKey: 'seachat.solutions.education.stakeholders.parents.description',
    descDefault: 'Keep parents informed and engaged',
    features: [
      { key: 'seachat.solutions.education.stakeholders.parents.features.progress', default: 'Student progress updates' },
      { key: 'seachat.solutions.education.stakeholders.parents.features.payment', default: 'Payment information' },
      { key: 'seachat.solutions.education.stakeholders.parents.features.events', default: 'School events' },
      { key: 'seachat.solutions.education.stakeholders.parents.features.communication', default: 'Teacher communication' }
    ]
  },
  {
    titleKey: 'seachat.solutions.education.stakeholders.faculty.title',
    titleDefault: 'Faculty',
    descKey: 'seachat.solutions.education.stakeholders.faculty.description',
    descDefault: 'Support teaching and administrative tasks',
    features: [
      { key: 'seachat.solutions.education.stakeholders.faculty.features.management', default: 'Class management' },
      { key: 'seachat.solutions.education.stakeholders.faculty.features.inquiries', default: 'Student inquiries' },
      { key: 'seachat.solutions.education.stakeholders.faculty.features.resources', default: 'Resource access' },
      { key: 'seachat.solutions.education.stakeholders.faculty.features.technical', default: 'Technical support' }
    ]
  },
  {
    titleKey: 'seachat.solutions.education.stakeholders.staff.title',
    titleDefault: 'Staff',
    descKey: 'seachat.solutions.education.stakeholders.staff.description',
    descDefault: 'Administrative efficiency and support',
    features: [
      { key: 'seachat.solutions.education.stakeholders.staff.features.automation', default: 'Process automation' },
      { key: 'seachat.solutions.education.stakeholders.staff.features.information', default: 'Information management' },
      { key: 'seachat.solutions.education.stakeholders.staff.features.workflow', default: 'Workflow optimization' },
      { key: 'seachat.solutions.education.stakeholders.staff.features.reporting', default: 'Reporting tools' }
    ]
  }
];

const useCases = [
  {
    titleKey: 'seachat.solutions.education.useCases.enrollment.title',
    titleDefault: 'Enrollment Support',
    descKey: 'seachat.solutions.education.useCases.enrollment.description',
    descDefault: 'Streamline admission processes and support prospective students',
    exampleKey: 'seachat.solutions.education.useCases.enrollment.example',
    exampleDefault: 'What documents do I need for my application?',
    outcomeKey: 'seachat.solutions.education.useCases.enrollment.outcome',
    outcomeDefault: 'Instantly provide personalized checklist based on program and student type'
  },
  {
    titleKey: 'seachat.solutions.education.useCases.academic.title',
    titleDefault: 'Academic Support',
    descKey: 'seachat.solutions.education.useCases.academic.description',
    descDefault: 'Help students with course-related questions and academic guidance',
    exampleKey: 'seachat.solutions.education.useCases.academic.example',
    exampleDefault: 'How can I access my course materials?',
    outcomeKey: 'seachat.solutions.education.useCases.academic.outcome',
    outcomeDefault: 'Direct students to LMS with personalized login assistance'
  },
  {
    titleKey: 'seachat.solutions.education.useCases.campus.title',
    titleDefault: 'Campus Services',
    descKey: 'seachat.solutions.education.useCases.campus.description',
    descDefault: 'Provide information about campus facilities and services',
    exampleKey: 'seachat.solutions.education.useCases.campus.example',
    exampleDefault: 'Where is the library located?',
    outcomeKey: 'seachat.solutions.education.useCases.campus.outcome',
    outcomeDefault: 'Provide location, hours, and available services with interactive map'
  },
  {
    titleKey: 'seachat.solutions.education.useCases.financial.title',
    titleDefault: 'Financial Aid Support',
    descKey: 'seachat.solutions.education.useCases.financial.description',
    descDefault: 'Assist with financial aid inquiries and payment questions',
    exampleKey: 'seachat.solutions.education.useCases.financial.example',
    exampleDefault: 'What financial aid options are available?',
    outcomeKey: 'seachat.solutions.education.useCases.financial.outcome',
