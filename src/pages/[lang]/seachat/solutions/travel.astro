              {['Amadeus GDS', 'Sabre GDS', 'Travelport', 'Booking.com', 'Expedia API', 'HubSpot CRM'].map((integration) => (
                <div class="flex items-center space-x-3">
                  <svg class="w-5 h-5 text-green-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                  </svg>
                  <span class="text-gray-700">{integration}</span>
                </div>
              ))}
            </div>
          </div>
          
          <div class="bg-gradient-to-br from-cyan-50 to-blue-50 rounded-2xl p-8 border border-cyan-100">
            <h3 class="text-2xl font-bold text-gray-900 mb-6">
              {t('seachat.solutions.travel.bookingFlowTitle') || 'Travel Booking Flow'}
