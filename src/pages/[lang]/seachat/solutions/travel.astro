              <div class="flex items-start space-x-4">
                <div class="w-8 h-8 bg-cyan-600 text-white rounded-full flex items-center justify-center font-bold text-sm">1</div>
                <div>
                  <h4 class="font-semibold text-gray-900">
                    {t('seachat.solutions.travel.flow.inquiry.title') || 'Travel Inquiry'}
                  </h4>
                  <p class="text-gray-600 text-sm">
                    {t('seachat.solutions.travel.flow.inquiry.description') || 'Customer asks about travel options'}
                  </p>
                </div>
              </div>
              
              <div class="flex items-start space-x-4">
                <div class="w-8 h-8 bg-blue-600 text-white rounded-full flex items-center justify-center font-bold text-sm">2</div>
                <div>
                  <h4 class="font-semibold text-gray-900">
                    {t('seachat.solutions.travel.flow.search.title') || 'Real-time Search'}
                  </h4>
                  <p class="text-gray-600 text-sm">
                    {t('seachat.solutions.travel.flow.search.description') || 'AI searches across multiple systems'}
                  </p>
                </div>
              </div>
              
              <div class="flex items-start space-x-4">
                <div class="w-8 h-8 bg-teal-600 text-white rounded-full flex items-center justify-center font-bold text-sm">3</div>
                <div>
                  <h4 class="font-semibold text-gray-900">
                    {t('seachat.solutions.travel.flow.assistance.title') || 'Booking Assistance'}
                  </h4>
                  <p class="text-gray-600 text-sm">
                    {t('seachat.solutions.travel.flow.assistance.description') || 'Guided booking with payment processing'}
                  </p>
                </div>
              </div>
              
              <div class="flex items-start space-x-4">
                <div class="w-8 h-8 bg-green-600 text-white rounded-full flex items-center justify-center font-bold text-sm">4</div>
                <div>
                  <h4 class="font-semibold text-gray-900">
                    {t('seachat.solutions.travel.flow.confirmation.title') || 'Confirmation & Support'}
                  </h4>
                  <p class="text-gray-600 text-sm">
                    {t('seachat.solutions.travel.flow.confirmation.description') || 'Booking confirmation with ongoing support'}
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="py-20 bg-gradient-to-r from-cyan-600 to-blue-500">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-4xl md:text-5xl font-bold text-white mb-6">
          {t('seachat.solutions.travel.ctaTitle') || 'Ready to Transform Travel Experiences?'}
        </h2>
        <p class="text-xl text-cyan-100 mb-8 max-w-3xl mx-auto">
          {t('seachat.solutions.travel.ctaSubtitle') || 'Join travel companies already using SeaChat to provide exceptional customer service and streamline booking processes worldwide.'}
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="https://chat.seasalt.ai/gpt/signup"
            target="_blank"
            rel="noopener noreferrer"
            class="bg-white text-cyan-600 hover:bg-gray-100 px-8 py-4 rounded-lg text-lg font-semibold transition-colors text-center"
          >
            {t('seachat.solutions.travel.ctaTrialButton') || 'Start Travel For Free'}
