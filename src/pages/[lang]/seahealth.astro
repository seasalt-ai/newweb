---
import Layout from '../../layouts/Layout.astro';
import { getTranslationHelpers, type SupportedLanguage } from '../../i18n/helpers';
import { getTranslationHelpers, supportedLocales, type SupportedLanguage } from '../../i18n/helpers';

export async function getStaticPaths() {
  return supportedLocales.map((lang) => ({
    params: { lang }
  }));
}

const { lang } = Astro.params;
const currentLang = (lang as SupportedLanguage) || 'en';

const { t } = await getTranslationHelpers(currentLang);

const title = t('solutions.seahealth.seo.title') || 'SeaHealth - AI-Powered Healthcare Communication';
const description = t('solutions.seahealth.seo.description') || 'Transform your healthcare practice with SeaHealth AI receptionists. Never miss calls, book appointments automatically, and provide 24/7 patient support.';
const keywords = t('solutions.seahealth.seo.keywords') || 'healthcare AI, medical receptionist, appointment booking, patient communication, healthcare automation';

const breadcrumbs = [
  { name: t('header.home') || 'Home', url: `/${currentLang}/` },
  { name: t('footer.seahealth') || 'SeaHealth' }
];
---

<Layout 
  title={title} 
  description={description} 
  lang={currentLang}
  keywords={keywords}
  breadcrumbs={breadcrumbs}
  type="software"
  canonical={`https://seasalt.ai/${currentLang}/seahealth/`}
>
  <main class="min-h-screen bg-white">
    <!-- Hero Section -->
    <section class="relative bg-gradient-to-r from-blue-50 to-blue-100 py-16 px-4 text-center overflow-hidden">
      <img src="/health-images/main/background-hero.svg" alt="Background" class="absolute inset-0 w-full h-full object-cover opacity-20 pointer-events-none animate-pulse" />
      <div class="relative z-10 max-w-3xl mx-auto">
        <h1 class="text-2xl md:text-3xl font-semibold text-blue-900 mb-2 drop-shadow-lg">{t('solutions.seahealth.hero.title')}</h1>
        <h2 class="text-5xl md:text-6xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-blue-500 via-cyan-400 to-green-400 mb-6 animate-gradient-x">{t('solutions.seahealth.hero.subtitle')}</h2>
        <div class="flex flex-col md:flex-row justify-center items-center gap-4 md:gap-8 mb-10">
          <div class="flex flex-col items-center bg-gradient-to-br from-white via-blue-100 to-cyan-100 border-2 border-blue-300 rounded-2xl px-14 py-10 text-blue-800 font-bold shadow-xl min-w-[320px] min-h-[180px] max-w-[340px] hover:scale-105 transition-transform duration-300 animate-fade-in-up">
            <svg class="w-14 h-14 mb-4 text-blue-500 animate-bounce" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
            </svg>
            <span class="text-2xl md:text-2xl text-center leading-snug break-words">{t('solutions.seahealth.hero.features.newPatients')}</span>
          </div>
          <div class="flex flex-col items-center bg-gradient-to-br from-white via-blue-100 to-cyan-100 border-2 border-blue-300 rounded-2xl px-14 py-10 text-blue-800 font-bold shadow-xl min-w-[320px] min-h-[180px] max-w-[340px] hover:scale-105 transition-transform duration-300 animate-fade-in-up delay-100">
            <svg class="w-14 h-14 mb-4 text-blue-500 animate-bounce" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
            </svg>
            <span class="text-2xl md:text-2xl text-center leading-snug break-words">{t('solutions.seahealth.hero.features.aiReceptionists')}</span>
          </div>
          <div class="flex flex-col items-center bg-gradient-to-br from-white via-blue-100 to-cyan-100 border-2 border-blue-300 rounded-2xl px-14 py-10 text-blue-800 font-bold shadow-xl min-w-[320px] min-h-[180px] max-w-[340px] hover:scale-105 transition-transform duration-300 animate-fade-in-up delay-200">
            <svg class="w-14 h-14 mb-4 text-blue-500 animate-bounce" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
            </svg>
            <span class="text-2xl md:text-2xl text-center leading-snug break-words">{t('solutions.seahealth.hero.features.callAnalytics')}</span>
          </div>
        </div>
        <a href="https://meetings.hubspot.com/seasalt-ai/seasalt-meeting/" target="_blank" rel="noopener noreferrer" class="inline-block bg-gradient-to-r from-blue-500 to-cyan-400 hover:from-blue-600 hover:to-green-400 text-white px-10 py-5 rounded-2xl text-2xl font-extrabold shadow-2xl transition-all duration-200 mb-4 animate-fade-in">{t('solutions.seahealth.hero.cta')}</a>
        <p class="text-lg md:text-xl text-blue-800 drop-shadow-lg animate-fade-in-up delay-300">{t('solutions.seahealth.hero.description')}</p>
      </div>
    </section>

    <!-- Top 4 Reasons -->
    <section class="py-12 bg-white">
      <div class="max-w-4xl mx-auto px-4">
        <h2 class="text-4xl md:text-5xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-blue-500 via-cyan-400 to-green-400 mb-8 animate-gradient-x">{t('solutions.seahealth.top4Reasons.title')}</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <div class="flex flex-col items-center bg-gradient-to-br from-white via-blue-100 to-cyan-100 border-2 border-blue-300 rounded-2xl px-6 py-6 text-blue-800 font-bold shadow-xl min-h-[120px] hover:scale-105 transition-transform duration-300 animate-fade-in-up">
            <svg class="w-10 h-10 mb-2 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
            </svg>
            <span class="text-xl md:text-2xl text-center">{t('solutions.seahealth.top4Reasons.neverMissCall')}</span>
          </div>
          <div class="flex flex-col items-center bg-gradient-to-br from-white via-blue-100 to-cyan-100 border-2 border-blue-300 rounded-2xl px-6 py-6 text-blue-800 font-bold shadow-xl min-h-[120px] hover:scale-105 transition-transform duration-300 animate-fade-in-up delay-100">
            <svg class="w-10 h-10 mb-2 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
            </svg>
            <span class="text-xl md:text-2xl text-center">{t('solutions.seahealth.top4Reasons.neverMissComplaint')}</span>
          </div>
          <div class="flex flex-col items-center bg-gradient-to-br from-white via-blue-100 to-cyan-100 border-2 border-blue-300 rounded-2xl px-6 py-6 text-blue-800 font-bold shadow-xl min-h-[120px] hover:scale-105 transition-transform duration-300 animate-fade-in-up delay-200">
            <svg class="w-10 h-10 mb-2 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3a2 2 0 012-2h4a2 2 0 012 2v4m-6 0V6a2 2 0 012-2h4a2 2 0 012 2v1m-6 0V9a2 2 0 002 2h4a2 2 0 002-2V7m-6 0H6a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V9a2 2 0 00-2-2h-3"></path>
            </svg>
            <span class="text-xl md:text-2xl text-center">{t('solutions.seahealth.top4Reasons.bookAppointments')}</span>
          </div>
          <div class="flex flex-col items-center bg-gradient-to-br from-white via-blue-100 to-cyan-100 border-2 border-blue-300 rounded-2xl px-6 py-6 text-blue-800 font-bold shadow-xl min-h-[120px] hover:scale-105 transition-transform duration-300 animate-fade-in-up delay-300">
            <svg class="w-10 h-10 mb-2 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192L5.636 18.364M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z"></path>
            </svg>
            <span class="text-xl md:text-2xl text-center">{t('solutions.seahealth.top4Reasons.provide247Hotline')}</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Addressing Front Office Challenges -->
    <section class="py-16 bg-white">
      <div class="max-w-5xl mx-auto px-4">
        <h2 class="text-4xl md:text-5xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-blue-500 via-cyan-400 to-green-400 mb-8 animate-gradient-x text-center">
          {t('solutions.seahealth.frontOfficeChallenges.title')}
        </h2>
        <div class="grid md:grid-cols-3 gap-8">
          <!-- Unmonitored Front Desk Phone Call -->
          <div class="bg-gradient-to-br from-white via-blue-100 to-cyan-100 border-2 border-blue-300 rounded-2xl shadow-xl p-8 flex flex-col items-center animate-fade-in-up">
            <div class="mb-2 flex items-center justify-center">
              <svg class="w-16 h-16 text-blue-500 mr-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
              </svg>
              <h3 class="text-xl font-bold text-blue-900 text-center">{t('solutions.seahealth.frontOfficeChallenges.unmonitoredCalls.title')}</h3>
            </div>
            <div class="space-y-2 text-blue-800 text-base">
              <div class="flex items-center">
                <svg class="w-10 h-10 mr-3 text-yellow-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.866-.833-2.498 0L4.238 16.5c-.77.833.192 2.5 1.732 2.5z"></path>
                </svg>
                {t('solutions.seahealth.frontOfficeChallenges.unmonitoredCalls.complaint')}
              </div>
              <div class="flex items-center">
                <svg class="w-10 h-10 mr-3 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                </svg>
                {t('solutions.seahealth.frontOfficeChallenges.unmonitoredCalls.risks')}
              </div>
              <div class="flex items-center">
                <svg class="w-16 h-16 mr-4 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
                </svg>
                {t('solutions.seahealth.frontOfficeChallenges.unmonitoredCalls.professionalism')}
              </div>
            </div>
          </div>
          <!-- Missed Inbound Calls from Patients -->
          <div class="bg-gradient-to-br from-white via-blue-100 to-cyan-100 border-2 border-blue-300 rounded-2xl shadow-xl p-8 flex flex-col items-center animate-fade-in-up delay-100">
            <div class="mb-2 flex items-center justify-center">
              <svg class="w-16 h-16 text-blue-500 mr-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
              </svg>
              <h3 class="text-xl font-bold text-blue-900 text-center">{t('solutions.seahealth.frontOfficeChallenges.missedCalls.title')}</h3>
            </div>
            <div class="space-y-2 text-blue-800 text-base">
              <div class="flex items-center">
                <svg class="w-10 h-10 mr-3 text-cyan-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-5 5v-5zM4.06189 13C4.55399 16.3923 7.02913 19 10.5 19c.17 0 .33-.02.49-.05m-.49.05c1.38 0 2.61-.56 3.5-1.46M4.06189 13c-.1-.66-.1-1.34 0-2C4.55399 7.60771 7.02913 5 10.5 5c3.47087 0 5.94601 2.60771 6.43811 6m-.43811-6h5m-5 0V0m5 11c-.1.66-.1 1.34 0 2m-5-2h5m-5-2v5"></path>
                </svg>
                {t('solutions.seahealth.frontOfficeChallenges.missedCalls.voicemails')}
              </div>
              <div class="flex items-center">
                <svg class="w-10 h-10 mr-3 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"></path>
                </svg>
                {t('solutions.seahealth.frontOfficeChallenges.missedCalls.scheduling')}
              </div>
              <div class="flex items-center">
                <svg class="w-16 h-16 mr-4 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192L5.636 18.364M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z"></path>
                </svg>
                {t('solutions.seahealth.frontOfficeChallenges.missedCalls.retention')}
              </div>
            </div>
          </div>
          <!-- Outbound Calls Nobody Wants to Make -->
          <div class="bg-gradient-to-br from-white via-blue-100 to-cyan-100 border-2 border-blue-300 rounded-2xl shadow-xl p-8 flex flex-col items-center animate-fade-in-up delay-200">
            <div class="mb-2 flex items-center justify-center">
              <svg class="w-16 h-16 text-blue-500 mr-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18"></path>
              </svg>
              <h3 class="text-xl font-bold text-blue-900 text-center">{t('solutions.seahealth.frontOfficeChallenges.outboundCalls.title')}</h3>
            </div>
            <div class="space-y-2 text-blue-800 text-base">
              <div class="flex items-center">
                <svg class="w-10 h-10 mr-3 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
                </svg>
                {t('solutions.seahealth.frontOfficeChallenges.outboundCalls.followUp')}
              </div>
              <div class="flex items-center">
                <svg class="w-10 h-10 mr-3 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M9 19l3 3m0 0l3-3m-3 3V10"></path>
                </svg>
                {t('solutions.seahealth.frontOfficeChallenges.outboundCalls.insurance')}
              </div>
              <div class="flex items-center">
                <svg class="w-16 h-16 mr-4 text-yellow-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"></path>
                </svg>
                {t('solutions.seahealth.frontOfficeChallenges.outboundCalls.reactivation')}
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Solutions for Every Healthcare Setting -->
    <section class="py-16 bg-blue-50">
      <div class="max-w-6xl mx-auto px-4">
        <h2 class="text-4xl md:text-5xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-blue-500 via-cyan-400 to-green-400 mb-10 animate-gradient-x text-center">{t('solutions.seahealth.solutions.title')}</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-8">
          <!-- Hospitals & Clinics -->
          <div class="relative flex flex-col items-center justify-center rounded-2xl shadow-lg overflow-hidden min-h-[180px] h-56 p-6" style="background-image: url(/health-images/settings/hospital.png); background-size: cover; background-position: center;">
            <img src="/health-images/settings/hospital.svg" alt="Hospitals & Clinics Icon" class="w-16 h-16 mb-2 z-10" />
            <h3 class="text-lg font-semibold text-white text-center z-10 drop-shadow-lg">{t('solutions.seahealth.solutions.hospitals')}</h3>
            <div class="absolute inset-0 bg-black/30 z-0"></div>
          </div>
          <!-- Dental Clinics -->
          <div class="relative flex flex-col items-center justify-center rounded-2xl shadow-lg overflow-hidden min-h-[180px] h-56 p-6" style="background-image: url(/health-images/settings/dental.png); background-size: cover; background-position: center;">
            <img src="/health-images/settings/dental.svg" alt="Dental Clinics Icon" class="w-16 h-16 mb-2 z-10" />
            <h3 class="text-lg font-semibold text-white text-center z-10 drop-shadow-lg">{t('solutions.seahealth.solutions.dental')}</h3>
            <div class="absolute inset-0 bg-black/30 z-0"></div>
          </div>
          <!-- Hospice Homes -->
          <div class="relative flex flex-col items-center justify-center rounded-2xl shadow-lg overflow-hidden min-h-[180px] h-56 p-6" style="background-image: url(/health-images/settings/hospice.png); background-size: cover; background-position: center;">
            <img src="/health-images/settings/hospice.svg" alt="Hospice Homes Icon" class="w-16 h-16 mb-2 z-10" />
            <h3 class="text-lg font-semibold text-white text-center z-10 drop-shadow-lg">{t('solutions.seahealth.solutions.hospice')}</h3>
            <div class="absolute inset-0 bg-black/30 z-0"></div>
          </div>
          <!-- Emergency Care -->
          <div class="relative flex flex-col items-center justify-center rounded-2xl shadow-lg overflow-hidden min-h-[180px] h-56 p-6" style="background-image: url(/health-images/settings/emergency.png); background-size: cover; background-position: center;">
            <img src="/health-images/settings/emergency.svg" alt="Emergency Care Icon" class="w-16 h-16 mb-2 z-10" />
            <h3 class="text-lg font-semibold text-white text-center z-10 drop-shadow-lg">{t('solutions.seahealth.solutions.emergency')}</h3>
            <div class="absolute inset-0 bg-black/30 z-0"></div>
          </div>
          <!-- Adult Family Homes -->
          <div class="relative flex flex-col items-center justify-center rounded-2xl shadow-lg overflow-hidden min-h-[180px] h-56 p-6" style="background-image: url(/health-images/settings/adult.png); background-size: cover; background-position: center;">
            <img src="/health-images/settings/adult.svg" alt="Adult Family Homes Icon" class="w-16 h-16 mb-2 z-10" />
            <h3 class="text-lg font-semibold text-white text-center z-10 drop-shadow-lg">{t('solutions.seahealth.solutions.adult')}</h3>
            <div class="absolute inset-0 bg-black/30 z-0"></div>
          </div>
          <!-- Veterinary Hospitals -->
          <div class="relative flex flex-col items-center justify-center rounded-2xl shadow-lg overflow-hidden min-h-[180px] h-56 p-6" style="background-image: url(/health-images/settings/vet.png); background-size: cover; background-position: center;">
            <img src="/health-images/settings/vet.svg" alt="Veterinary Hospitals Icon" class="w-16 h-16 mb-2 z-10" />
            <h3 class="text-lg font-semibold text-white text-center z-10 drop-shadow-lg">{t('solutions.seahealth.solutions.veterinary')}</h3>
            <div class="absolute inset-0 bg-black/30 z-0"></div>
          </div>
