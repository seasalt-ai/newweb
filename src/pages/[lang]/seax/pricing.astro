  <script>
    // Handle pricing toggle functionality
    document.addEventListener("DOMContentLoaded", function () {
      const toggle = document.getElementById("billing-toggle");
      const thumb = document.getElementById("toggle-thumb");
      const pricingPlans = document.getElementById("pricing-plans");
      let isYearly = false;

      toggle.addEventListener("click", function () {
        isYearly = !isYearly;

        // Update toggle appearance
        if (isYearly) {
          thumb.classList.remove("translate-x-1");
          thumb.classList.add("translate-x-6");
        } else {
          thumb.classList.remove("translate-x-6");
          thumb.classList.add("translate-x-1");
        }

        // Update pricing displays
        const priceElements = pricingPlans.querySelectorAll(
          "[data-monthly-price]",
        );
        priceElements.forEach((element) => {
          const monthlyPrice = element.getAttribute("data-monthly-price");
          const yearlyPrice = element.getAttribute("data-yearly-price");
          element.textContent = isYearly ? yearlyPrice : monthlyPrice;
        });

        // Update additional pricing (for omnichannel)
        const additionalElements = pricingPlans.querySelectorAll(
          "[data-monthly-additional]",
        );
        additionalElements.forEach((element) => {
          const monthlyAdditional = element.getAttribute(
            "data-monthly-additional",
          );
          const yearlyAdditional = element.getAttribute(
            "data-yearly-additional",
          );
          element.textContent = isYearly ? yearlyAdditional : monthlyAdditional;
        });
      });
    });
  </script>
