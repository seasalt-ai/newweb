              >
              <span class="font-semibold text-sm"
                >{t("seax.pricing.channels.smsLocal.campaignSetup")}</span
              >
            </div>
            <div class="flex justify-between">
              <span class="text-gray-600"
                >{t("seax.pricing.channels.labels.monthly")}</span
              >
              <span class="font-semibold text-sm"
                >{t("seax.pricing.channels.smsLocal.monthly")}</span
              >
            </div>
