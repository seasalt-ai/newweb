                  d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
                ></path>
              </svg>
            </div>
            <div>
              <h3 class="text-lg font-semibold text-gray-900">
                {t("seax.pricing.channels.smsTollFree.name")}
              </h3>
              <p class="text-sm text-gray-600">
                {t("seax.pricing.channels.smsTollFree.description")}
              </p>
            </div>
          </div>

          <div class="space-y-2">
            <div class="flex justify-between">
              <span class="text-gray-600 text-sm"
                >{t("seax.pricing.channels.labels.campaignSetup")}</span
              >
              <span class="font-semibold text-sm"
                >{t("seax.pricing.channels.smsTollFree.campaignSetup")}</span
              >
            </div>
            <div class="flex justify-between">
              <span class="text-gray-600"
                >{t("seax.pricing.channels.labels.monthly")}</span
              >
              <span class="font-semibold text-sm"
                >{t("seax.pricing.channels.smsTollFree.monthly")}</span
              >
            </div>
            <div class="flex justify-between">
              <span class="text-gray-600"
                >{t("seax.pricing.channels.labels.usage")}</span
              >
              <span class="font-semibold"
                >{t("seax.pricing.channels.smsTollFree.usage")}</span
              >
            </div>
          </div>
        </div>

        <!-- SMS Short Code -->
        <div
          class="bg-white rounded-xl p-6 shadow-lg hover:shadow-xl transition-shadow duration-300"
        >
          <div class="flex items-center space-x-3 mb-4">
            <div class="p-3 rounded-lg bg-purple-100 text-purple-600">
              <svg
                class="w-6 h-6"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M13 10V3L4 14h7v7l9-11h-7z"></path>
              </svg>
            </div>
            <div>
              <h3 class="text-lg font-semibold text-gray-900">
                {t("seax.pricing.channels.smsShortCode.name")}
              </h3>
              <p class="text-sm text-gray-600">
                {t("seax.pricing.channels.smsShortCode.description")}
              </p>
            </div>
          </div>

