---
import SeaxLayout from "../../../layouts/SeaxLayout.astro";
import SupportPlan from "../../../components/SupportPlan.tsx";
import OmniChannelCalculator from "../../../components/OmniChannelCalculator.tsx";
import ROICalculator from "../../../components/ROICalculator.tsx";
import {
  getTranslationHelpers,
  languages,
  getLocalizedPath,
} from "../../../i18n/helpers";

const { lang } = Astro.params;
const { t, translations } = await getTranslationHelpers(lang);

// SEO Configuration
const seoData = {
  title: t("seax.pricing.seo.title"),
  description: t("seax.pricing.seo.description"),
  keywords: t("seax.pricing.seo.keywords"),
  canonical: "https://seasalt.ai" + getLocalizedPath("/seax/pricing", lang),
  ogImage: "/seax-pricing.png",
};

// Breadcrumbs
const breadcrumbs = [
  { name: "Home", url: getLocalizedPath("/", lang) },
  { name: "SeaX", url: getLocalizedPath("/seax", lang) },
  { name: "Pricing", url: getLocalizedPath("/seax/pricing", lang) },
];

// FAQs
const faqs = [
  {
    question: "What happens if I exceed my message volume?",
    answer:
      "If you exceed your monthly message allocation, you'll be charged on a per-message basis according to our standard rates. We'll notify you before you reach your limit.",
  },
  {
    question: "Are there any hidden fees?",
    answer:
      "No hidden fees. All pricing is transparent and includes access to the platform, basic support, and all core features. Additional services like setup assistance are clearly marked as optional.",
  },
  {
    question: "Can I change plans anytime?",
    answer:
      "Yes, you can upgrade or downgrade your plan at any time. Changes take effect at your next billing cycle, and we'll prorate any differences.",
  },
  {
    question: "Do you support international messaging?",
    answer:
      "Yes, SeaX supports international SMS and voice communications to over 200 countries with competitive rates and reliable delivery.",
  },
];

export async function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({
    params: { lang },
  }));
}
---

<SeaxLayout
  {seoData}
  breadcrumbs={breadcrumbs}
  faqs={faqs}
  lang={lang}
  headerVersion="seax"
  footerVersion="seax"
  productKey={null}
  type="service"
  service={{
    offers: [
      {
        name: t("seax.pricing.plans.whatsapp.name"),
        price: t("seax.pricing.plans.whatsapp.price.monthly"),
        priceCurrency: "USD",
        description: t("seax.pricing.plans.whatsapp.description"),
      },
      {
        name: t("seax.pricing.plans.omnichannel.name"),
        price: t("seax.pricing.plans.omnichannel.price.monthly"),
        priceCurrency: "USD",
        description: t("seax.pricing.plans.omnichannel.description"),
      },
      {
        name: t("seax.pricing.plans.custom.name"),
        price: "Contact for pricing",
        priceCurrency: "USD",
        description: t("seax.pricing.plans.custom.description"),
      },
    ],
  }}
>
  <!-- Hero Section -->
  <div
    class="bg-gradient-to-br from-slate-900 via-blue-900 to-indigo-900 py-16 sm:py-24"
  >
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-4xl sm:text-5xl font-bold text-white mb-6">
        {t("seax.pricing.hero.title.main")}
        <span class="text-blue-200 block"
          >{t("seax.pricing.hero.title.highlight")}</span
        >
      </h1>
      <p class="text-xl text-blue-100 mb-8 max-w-3xl mx-auto">
        {t("seax.pricing.hero.description")}
      </p>
    </div>
  </div>

  <!-- Pricing Tiers -->
  <div class="py-20 bg-gradient-to-br from-purple-50 via-pink-50 to-indigo-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl font-bold text-gray-900 mb-4">
          {t("seax.pricing.plans.title")}
        </h2>

        <!-- Billing Toggle -->
        <div class="flex items-center justify-center mb-8">
          <span class="mr-3 text-gray-900 font-medium"
            >{t("seax.pricing.plans.billing.monthly")}</span
          >
          <button
            id="billing-toggle"
            class="relative inline-flex h-6 w-11 items-center rounded-full bg-blue-600 transition-colors focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2"
          >
            <span
              id="toggle-thumb"
              class="inline-block h-4 w-4 transform rounded-full bg-white transition-transform translate-x-1"
            ></span>
          </button>
          <span class="ml-3 text-gray-500">
            {t("seax.pricing.plans.billing.yearly")}
            <span class="text-green-500 font-semibold"
              >{t("seax.pricing.plans.billing.savings")}</span
            >
          </span>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8" id="pricing-plans">
        <!-- WhatsApp Plan -->
        <div
          class="relative bg-white rounded-2xl shadow-xl overflow-hidden flex flex-col h-full hover:shadow-2xl hover:-translate-y-2 transition-all duration-300"
        >
          <!-- Header with gradient background -->
          <div
            class="bg-gradient-to-r from-purple-400 to-purple-500 p-8 text-center"
          >
            <div class="text-sm text-white/80 mb-2">
              {t("seax.pricing.plans.whatsapp.subheader")}
            </div>
            <h3 class="text-2xl font-bold mb-4 text-white">
              {t("seax.pricing.plans.whatsapp.name")}
            </h3>
          </div>

          <!-- Pricing -->
          <div class="px-8 py-6 text-center">
            <div class="mb-4">
              <div
                class="text-4xl font-bold text-purple-600 mb-2"
                data-monthly-price={t(
                  "seax.pricing.plans.whatsapp.price.monthly",
                )}
                data-yearly-price={t(
                  "seax.pricing.plans.whatsapp.price.yearly",
                )}
              >
                {t("seax.pricing.plans.whatsapp.price.monthly")}
              </div>
              <div class="text-sm text-gray-600">
                {t("seax.pricing.plans.whatsapp.description")}
              </div>
            </div>
          </div>

          <!-- Features -->
          <div class="px-8 pb-6 flex-grow">
            <div class="space-y-3">
              <div class="flex items-start space-x-3">
                <svg
                  class="w-5 h-5 text-green-500 flex-shrink-0 mt-0.5"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                    clip-rule="evenodd"></path>
                </svg>
                <span class="text-sm text-gray-700"
                  >{t("seax.pricing.plans.whatsapp.features.0")}</span
                >
              </div>
              <div class="flex items-start space-x-3">
                <svg
                  class="w-5 h-5 text-green-500 flex-shrink-0 mt-0.5"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                    clip-rule="evenodd"></path>
                </svg>
                <span class="text-sm text-gray-700"
                  >{t("seax.pricing.plans.whatsapp.features.1")}</span
                >
              </div>
              <div class="flex items-start space-x-3">
                <svg
                  class="w-5 h-5 text-green-500 flex-shrink-0 mt-0.5"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                    clip-rule="evenodd"></path>
                </svg>
                <span class="text-sm text-gray-700"
                  >{t("seax.pricing.plans.whatsapp.features.2")}</span
                >
              </div>
              <div class="flex items-start space-x-3">
                <svg
                  class="w-5 h-5 text-green-500 flex-shrink-0 mt-0.5"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                    clip-rule="evenodd"></path>
                </svg>
                <span class="text-sm text-gray-700"
                  >{t("seax.pricing.plans.whatsapp.features.3")}</span
                >
              </div>
              <div class="flex items-start space-x-3">
                <svg
                  class="w-5 h-5 text-green-500 flex-shrink-0 mt-0.5"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                    clip-rule="evenodd"></path>
                </svg>
                <span class="text-sm text-gray-700"
                  >{t("seax.pricing.plans.whatsapp.features.4")}</span
                >
              </div>
            </div>
          </div>

          <!-- CTA Button -->
          <div class="px-8 pb-8 mt-auto">
            <a
              href="https://seax.seasalt.ai/signup"
              class="w-full py-3 px-6 rounded-lg font-semibold transition-all transform hover:scale-105 text-center inline-block bg-purple-500 hover:bg-purple-600 text-white"
