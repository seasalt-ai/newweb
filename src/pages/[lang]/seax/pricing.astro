---
import SeaxLayout from '../../../layouts/SeaxLayout.astro';
import SupportPlan from '../../../components/SupportPlan.tsx';
import OmniChannelCalculator from '../../../components/OmniChannelCalculator.tsx';
import ROICalculator from '../../../components/ROICalculator.tsx';
import { getTranslationHelpers, languages, getLocalizedPath } from '../../../i18n/helpers';

const { lang } = Astro.params;
const { t, translations } = await getTranslationHelpers(lang);

// SEO Configuration
const seoData = {
  title: t('seax.pricing.seo.title'),
  description: t('seax.pricing.seo.description'),
  keywords: t('seax.pricing.seo.keywords'),
  canonical: 'https://seasalt.ai' + getLocalizedPath('/seax/pricing', lang),
  ogImage: '/seax-pricing.png'
};

// Breadcrumbs
const breadcrumbs = [
  { name: 'Home', url: getLocalizedPath('/', lang) },
  { name: 'SeaX', url: getLocalizedPath('/seax', lang) },
  { name: 'Pricing', url: getLocalizedPath('/seax/pricing', lang) }
];

// FAQs
const faqs = [
  {
    question: "What happens if I exceed my message volume?",
    answer: "If you exceed your monthly message allocation, you'll be charged on a per-message basis according to our standard rates. We'll notify you before you reach your limit."
  },
  {
    question: "Are there any hidden fees?",
    answer: "No hidden fees. All pricing is transparent and includes access to the platform, basic support, and all core features. Additional services like setup assistance are clearly marked as optional."
  },
  {
    question: "Can I change plans anytime?",
    answer: "Yes, you can upgrade or downgrade your plan at any time. Changes take effect at your next billing cycle, and we'll prorate any differences."
  },
  {
    question: "Do you support international messaging?",
    answer: "Yes, SeaX supports international SMS and voice communications to over 200 countries with competitive rates and reliable delivery."
  }
];

export async function getStaticPaths() {
  return Object.keys(languages).map(lang => ({
    params: { lang },
  }));
}
---

<SeaxLayout 
  {seoData} 

  breadcrumbs={breadcrumbs} 
  faqs={faqs} 
  lang={lang}
  headerVersion="seax"
  footerVersion="seax"
  productKey={null}
  type="service"
  service={{
    "offers": [
      {
        "name": t('seax.pricing.plans.free.name'),
        "price": t('seax.pricing.plans.free.price.monthly'),
        "priceCurrency": "USD",
        "description": t('seax.pricing.plans.free.tagline')
      },
      {
        "name": t('seax.pricing.plans.pro.name'),
        "price": t('seax.pricing.plans.pro.price.monthly'),
        "priceCurrency": "USD",
        "description": t('seax.pricing.plans.pro.tagline')
      },
      {
        "name": t('seax.pricing.plans.premium.name'),
        "price": t('seax.pricing.plans.premium.price.monthly'),
        "priceCurrency": "USD",
        "description": t('seax.pricing.plans.premium.tagline')
      }
    ]
  }}
>
  <!-- Hero Section -->
  <div class="bg-gradient-to-br from-slate-900 via-blue-900 to-indigo-900 py-16 sm:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-4xl sm:text-5xl font-bold text-white mb-6">
        {t('seax.pricing.hero.title.main')}
        <span class="text-blue-200 block">{t('seax.pricing.hero.title.highlight')}</span>
      </h1>
      <p class="text-xl text-blue-100 mb-8 max-w-3xl mx-auto">
        {t('seax.pricing.hero.description')}
      </p>
    </div>
  </div>

  <!-- Pricing Tiers -->
  <div class="py-20 bg-gradient-to-br from-purple-50 via-pink-50 to-indigo-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl font-bold text-gray-900 mb-4">
          {t('seax.pricing.plans.title')}
        </h2>
        
        <!-- Billing Toggle -->
        <div class="flex items-center justify-center mb-8">
          <div
            id="billing-toggle"
            class="inline-flex rounded-full bg-gray-200 p-1 text-sm font-medium shadow-inner cursor-pointer"
            role="switch"
            aria-checked="false"
          >
            <div
              id="billing-label-monthly"
              class="px-4 py-1 rounded-full bg-white text-gray-900 shadow-sm transition-all duration-150"
            >
              {t('seax.pricing.plans.billing.monthly')}
            </div>
            <div
              id="billing-label-yearly"
              class="px-4 py-1 rounded-full text-gray-600 transition-all duration-150"
            >
              {t('seax.pricing.plans.billing.yearly')}
            </div>
          </div>
          <span class="ml-3 text-gray-500 text-sm">
            <span class="text-green-600 font-semibold">{t('seax.pricing.plans.billing.savings')}</span>
          </span>
        </div>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8" id="pricing-plans">
        <!-- Free Plan -->
        <div class="bg-white rounded-2xl shadow-xl overflow-hidden flex flex-col border border-gray-200">
          <div class="px-8 pt-8 pb-6 text-center">
            <h3 class="text-2xl font-bold text-gray-900 mb-2">
              {t('seax.pricing.plans.free.name')}
            </h3>
            <p class="text-sm text-gray-500 mb-4">
              {t('seax.pricing.plans.free.tagline')}
            </p>
            <div class="flex items-baseline justify-center space-x-1">
              <span
                class="text-4xl font-bold text-gray-900"
                data-monthly-price={t('seax.pricing.plans.free.price.monthly')}
                data-yearly-price={t('seax.pricing.plans.free.price.yearly')}
              >
                {t('seax.pricing.plans.free.price.monthly')}
              </span>
              <span class="text-sm text-gray-500">
                {t('seax.pricing.plans.free.priceSuffix')}
              </span>
            </div>
            <div
              class="text-xs text-gray-500 mt-1"
              data-billing-note
              data-monthly-note={t('seax.pricing.plans.billingNotes.monthly', { amount: t('seax.pricing.plans.free.price.monthly') })}
              data-yearly-note={t('seax.pricing.plans.billingNotes.yearly', { amount: t('seax.pricing.plans.free.price.yearly') })}
            >
              {t('seax.pricing.plans.billingNotes.monthly', { amount: t('seax.pricing.plans.free.price.monthly') })}
            </div>
          </div>
          <div class="px-8 pb-6 flex-grow">
            <div class="space-y-3">
              {Array.from({ length: 8 }, (_, i) => (
                <div class="flex items-start space-x-3" key={i}>
                  <svg class="w-5 h-5 text-green-500 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                    <path
                      fill-rule="evenodd"
                      d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                      clip-rule="evenodd"
                    />
                  </svg>
                  <span class="text-sm text-gray-700">
                    {t(`seax.pricing.plans.free.features.${i}`)}
                  </span>
                </div>
              ))}
            </div>
          </div>
          <div class="px-8 pb-8 border-t border-gray-100 mt-auto">
            <a
              href="https://seax.seasalt.ai/signup"
              class="w-full py-3 px-6 rounded-lg font-semibold transition-all transform hover:scale-105 text-center inline-block bg-white text-indigo-600 border border-indigo-600 hover:bg-indigo-50"
            >
              {t('seax.pricing.plans.free.cta')}
            </a>
          </div>
        </div>

        <!-- Pro Plan (Most Popular) -->
        <div class="relative bg-white rounded-2xl shadow-2xl overflow-hidden flex flex-col border-2 border-indigo-500">
          <div class="absolute -top-3 left-1/2 -translate-x-1/2">
            <span class="px-3 py-1 rounded-full bg-indigo-600 text-white text-xs font-semibold uppercase tracking-wide shadow">
              {t('seax.pricing.plans.pro.mostPopular')}
            </span>
          </div>
          <div class="px-8 pt-10 pb-6 text-center bg-gradient-to-b from-indigo-50 to-white">
            <h3 class="text-2xl font-bold text-gray-900 mb-2">
              {t('seax.pricing.plans.pro.name')}
            </h3>
            <p class="text-sm text-gray-500 mb-4">
              {t('seax.pricing.plans.pro.tagline')}
            </p>
            <div class="flex items-baseline justify-center space-x-1">
              <span
                class="text-4xl font-bold text-indigo-600"
                data-monthly-price={t('seax.pricing.plans.pro.price.monthly')}
                data-yearly-price={t('seax.pricing.plans.pro.price.yearly')}
              >
                {t('seax.pricing.plans.pro.price.monthly')}
              </span>
              <span class="text-sm text-gray-500">
                {t('seax.pricing.plans.pro.priceSuffix')}
              </span>
            </div>
            <div
              class="text-xs text-gray-500 mt-1"
              data-billing-note
              data-monthly-note={t('seax.pricing.plans.billingNotes.monthly', { amount: t('seax.pricing.plans.pro.price.monthly') })}
              data-yearly-note={t('seax.pricing.plans.billingNotes.yearly', { amount: t('seax.pricing.plans.pro.price.yearly') })}
            >
              {t('seax.pricing.plans.billingNotes.monthly', { amount: t('seax.pricing.plans.pro.price.monthly') })}
            </div>
          </div>
          <div class="px-8 pb-6 flex-grow">
            <div class="space-y-3">
              {Array.from({ length: 7 }, (_, i) => (
                <div class="flex items-start space-x-3" key={i}>
                  <svg class="w-5 h-5 text-green-500 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                    <path
                      fill-rule="evenodd"
                      d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                      clip-rule="evenodd"
                    />
                  </svg>
                  <span class="text-sm text-gray-700">
                    {t(`seax.pricing.plans.pro.features.${i}`)}
                  </span>
                </div>
              ))}
            </div>
          </div>
          <div class="px-8 pb-8 border-t border-gray-100 mt-auto">
            <a
              href="https://seax.seasalt.ai/signup"
              class="w-full py-3 px-6 rounded-lg font-semibold transition-all transform hover:scale-105 text-center inline-block bg-indigo-600 hover:bg-indigo-700 text-white"
            >
              {t('seax.pricing.plans.pro.cta')}
            </a>
          </div>
        </div>

        <!-- Premium Plan -->
        <div class="bg-white rounded-2xl shadow-xl overflow-hidden flex flex-col border border-gray-200">
          <div class="px-8 pt-8 pb-6 text-center">
            <h3 class="text-2xl font-bold text-gray-900 mb-2">
              {t('seax.pricing.plans.premium.name')}
            </h3>
            <p class="text-sm text-gray-500 mb-4">
              {t('seax.pricing.plans.premium.tagline')}
            </p>
            <div class="flex items-baseline justify-center space-x-1">
              <span
                class="text-4xl font-bold text-gray-900"
                data-monthly-price={t('seax.pricing.plans.premium.price.monthly')}
                data-yearly-price={t('seax.pricing.plans.premium.price.yearly')}
              >
                {t('seax.pricing.plans.premium.price.monthly')}
              </span>
              <span class="text-sm text-gray-500">
                {t('seax.pricing.plans.premium.priceSuffix')}
              </span>
            </div>
            <div
              class="text-xs text-gray-500 mt-1"
              data-billing-note
              data-monthly-note={t('seax.pricing.plans.billingNotes.monthly', { amount: t('seax.pricing.plans.premium.price.monthly') })}
              data-yearly-note={t('seax.pricing.plans.billingNotes.yearly', { amount: t('seax.pricing.plans.premium.price.yearly') })}
            >
              {t('seax.pricing.plans.billingNotes.monthly', { amount: t('seax.pricing.plans.premium.price.monthly') })}
            </div>
          </div>
          <div class="px-8 pb-6 flex-grow">
            <div class="space-y-3">
              {Array.from({ length: 14 }, (_, i) => (
                <div class="flex items-start space-x-3" key={i}>
                  <svg class="w-5 h-5 text-green-500 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                    <path
                      fill-rule="evenodd"
                      d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                      clip-rule="evenodd"
                    />
                  </svg>
                  <span class="text-sm text-gray-700">
                    {t(`seax.pricing.plans.premium.features.${i}`)}
                  </span>
                </div>
              ))}
            </div>
          </div>
          <div class="px-8 pb-8 border-t border-gray-100 mt-auto">
            <a
              href="https://seax.seasalt.ai/signup"
              class="w-full py-3 px-6 rounded-lg font-semibold transition-all transform hover:scale-105 text-center inline-block bg-white text-indigo-600 border border-indigo-600 hover:bg-indigo-50"
            >
              {t('seax.pricing.plans.premium.cta')}
            </a>
          </div>
        </div>
      </div>
      
      <!-- Disclaimer -->
      <div class="text-center mt-8">
        <p class="text-sm text-gray-600">
          {t('seax.pricing.plans.disclaimer')}
        </p>
      </div>
    </div>
  </div>

  <!-- Channel-Specific Pricing -->
  <div class="py-20 bg-gradient-to-br from-emerald-50 via-teal-50 to-cyan-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl font-bold text-gray-900 mb-4">
          {t('seax.pricing.channels.title')}
        </h2>
        <p class="text-lg text-gray-600">
          {t('seax.pricing.channels.subtitle')}
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- SMS Local -->
        <div class="bg-white rounded-xl p-6 shadow-lg hover:shadow-xl transition-shadow duration-300">
          <div class="flex items-center space-x-3 mb-4">
            <div class="p-3 rounded-lg bg-blue-100 text-blue-600">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
              </svg>
            </div>
            <div>
              <h3 class="text-lg font-semibold text-gray-900">{t('seax.pricing.channels.smsLocal.name')}</h3>
              <p class="text-sm text-gray-600">{t('seax.pricing.channels.smsLocal.description')}</p>
            </div>
          </div>
          
          <div class="space-y-2">
            <div class="flex justify-between">
              <span class="text-gray-600 text-sm">{t('seax.pricing.channels.labels.campaignSetup')}</span>
              <span class="font-semibold text-sm">{t('seax.pricing.channels.smsLocal.campaignSetup')}</span>
            </div>
            <div class="flex justify-between">
              <span class="text-gray-600">{t('seax.pricing.channels.labels.monthly')}</span>
              <span class="font-semibold text-sm">{t('seax.pricing.channels.smsLocal.monthly')}</span>
            </div>
            <div class="flex justify-between">
              <span class="text-gray-600">{t('seax.pricing.channels.labels.usage')}</span>
              <span class="font-semibold">{t('seax.pricing.channels.smsLocal.usage')}</span>
            </div>
          </div>
        </div>

        <!-- SMS Toll-Free -->
        <div class="bg-white rounded-xl p-6 shadow-lg hover:shadow-xl transition-shadow duration-300">
          <div class="flex items-center space-x-3 mb-4">
            <div class="p-3 rounded-lg bg-green-100 text-green-600">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
              </svg>
            </div>
            <div>
              <h3 class="text-lg font-semibold text-gray-900">{t('seax.pricing.channels.smsTollFree.name')}</h3>
              <p class="text-sm text-gray-600">{t('seax.pricing.channels.smsTollFree.description')}</p>
            </div>
          </div>
          
          <div class="space-y-2">
            <div class="flex justify-between">
              <span class="text-gray-600 text-sm">{t('seax.pricing.channels.labels.campaignSetup')}</span>
              <span class="font-semibold text-sm">{t('seax.pricing.channels.smsTollFree.campaignSetup')}</span>
            </div>
            <div class="flex justify-between">
              <span class="text-gray-600">{t('seax.pricing.channels.labels.monthly')}</span>
              <span class="font-semibold text-sm">{t('seax.pricing.channels.smsTollFree.monthly')}</span>
            </div>
            <div class="flex justify-between">
              <span class="text-gray-600">{t('seax.pricing.channels.labels.usage')}</span>
              <span class="font-semibold">{t('seax.pricing.channels.smsTollFree.usage')}</span>
            </div>
          </div>
        </div>

        <!-- SMS Short Code -->
        <div class="bg-white rounded-xl p-6 shadow-lg hover:shadow-xl transition-shadow duration-300">
          <div class="flex items-center space-x-3 mb-4">
            <div class="p-3 rounded-lg bg-purple-100 text-purple-600">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
              </svg>
            </div>
            <div>
              <h3 class="text-lg font-semibold text-gray-900">{t('seax.pricing.channels.smsShortCode.name')}</h3>
              <p class="text-sm text-gray-600">{t('seax.pricing.channels.smsShortCode.description')}</p>
            </div>
          </div>
          
          <div class="space-y-2">
            <div class="flex justify-between">
              <span class="text-gray-600">{t('seax.pricing.channels.labels.setup')}</span>
              <span class="font-semibold">{t('seax.pricing.channels.smsShortCode.setup')}</span>
            </div>
            <div class="flex justify-between">
              <span class="text-gray-600">{t('seax.pricing.channels.labels.quarterly')}</span>
              <span class="font-semibold">{t('seax.pricing.channels.smsShortCode.quarterly')}</span>
            </div>
            <div class="flex justify-between">
              <span class="text-gray-600">{t('seax.pricing.channels.labels.usage')}</span>
              <span class="font-semibold">{t('seax.pricing.channels.smsShortCode.usage')}</span>
            </div>
          </div>
        </div>

        <!-- WhatsApp -->
        <div class="bg-white rounded-xl p-6 shadow-lg hover:shadow-xl transition-shadow duration-300">
          <div class="flex items-center space-x-3 mb-4">
            <div class="p-3 rounded-lg bg-emerald-100 text-emerald-600">
              <svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
              </svg>
            </div>
            <div>
              <h3 class="text-lg font-semibold text-gray-900">{t('seax.pricing.channels.whatsapp.name')}</h3>
              <p class="text-sm text-gray-600">{t('seax.pricing.channels.whatsapp.description')}</p>
            </div>
          </div>
          
          <div class="space-y-2">
            <div class="flex justify-between">
              <span class="text-gray-600 text-sm">{t('seax.pricing.channels.labels.metaSetup')}</span>
              <span class="font-semibold text-sm">{t('seax.pricing.channels.whatsapp.metaSetup')}</span>
            </div>
            <div class="flex justify-between">
              <span class="text-gray-600">{t('seax.pricing.channels.labels.monthly')}</span>
              <span class="font-semibold text-sm">{t('seax.pricing.channels.whatsapp.monthly')}</span>
            </div>
            <div class="flex justify-between">
              <span class="text-gray-600">{t('seax.pricing.channels.labels.usage')}</span>
              <span class="font-semibold">{t('seax.pricing.channels.whatsapp.usage')}</span>
            </div>
          </div>
        </div>

        <!-- Voice -->
