          <!-- Recommended Badge -->
          <div
            class="absolute top-0 right-0 bg-blue-500 text-white px-3 py-1 rounded-bl-lg text-sm font-medium"
          >
            Most Popular
          </div>

          <!-- Header with gradient background -->
          <div
            class="bg-gradient-to-r from-blue-400 to-blue-500 p-8 text-center"
          >
            <div class="text-sm text-white/80 mb-2">
              {t("seax.pricing.plans.omnichannel.subheader")}
            </div>
            <h3 class="text-2xl font-bold mb-4 text-white">
              {t("seax.pricing.plans.omnichannel.name")}
            </h3>
          </div>

          <!-- Pricing -->
          <div class="px-8 py-6 text-center">
            <div class="mb-4">
              <div class="flex justify-center items-center space-x-4">
                <div>
                  <div
                    class="text-4xl font-bold text-blue-600"
                    data-monthly-price={t(
                      "seax.pricing.plans.omnichannel.price.monthly",
                    )}
                    data-yearly-price={t(
                      "seax.pricing.plans.omnichannel.price.yearly",
                    )}
                  >
                    {t("seax.pricing.plans.omnichannel.price.monthly")}
                  </div>
                  <div class="text-sm text-gray-600">
                    {t("seax.pricing.plans.omnichannel.description")}
                  </div>
                </div>
                <div>
                  <div
                    class="text-4xl font-bold text-blue-600"
                    data-monthly-additional={t(
                      "seax.pricing.plans.omnichannel.additionalPrice.monthly",
                    )}
                    data-yearly-additional={t(
                      "seax.pricing.plans.omnichannel.additionalPrice.yearly",
                    )}
                  >
                    {
                      t(
                        "seax.pricing.plans.omnichannel.additionalPrice.monthly",
                      )
                    }
                  </div>
                  <div class="text-sm text-gray-600">
                    {t("seax.pricing.plans.omnichannel.additionalDescription")}
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Features -->
          <div class="px-8 pb-6 flex-grow">
            <div class="space-y-3">
              {
                Array.from({ length: 12 }, (_, i) => (
                  <div class="flex items-start space-x-3" key={i}>
                    <svg
                      class="w-5 h-5 text-green-500 flex-shrink-0 mt-0.5"
                      fill="currentColor"
                      viewBox="0 0 20 20"
                    >
                      <path
                        fill-rule="evenodd"
                        d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                        clip-rule="evenodd"
                      />
                    </svg>
                    <span class="text-sm text-gray-700">
                      {t(`seax.pricing.plans.omnichannel.features.${i}`)}
                    </span>
                  </div>
                )).slice(0, 12)
              }
            </div>
          </div>

          <!-- CTA Button -->
          <div class="px-8 pb-8 mt-auto">
            <a
              href="https://seax.seasalt.ai/signup"
              class="w-full py-3 px-6 rounded-lg font-semibold transition-all transform hover:scale-105 text-center inline-block bg-blue-500 hover:bg-blue-600 text-white"
            >
              {t("seax.pricing.plans.omnichannel.cta")}
            </a>
          </div>
        </div>

        <!-- Custom Enterprise Plan -->
        <div
          class="relative bg-white rounded-2xl shadow-xl overflow-hidden flex flex-col h-full hover:shadow-2xl hover:-translate-y-2 transition-all duration-300"
        >
          <!-- Header with gradient background -->
          <div
            class="bg-gradient-to-r from-green-400 to-green-500 p-8 text-center"
          >
            <div class="text-sm text-white/80 mb-2">
              {t("seax.pricing.plans.custom.subheader")}
            </div>
            <h3 class="text-2xl font-bold mb-4 text-white">
              {t("seax.pricing.plans.custom.name")}
            </h3>
          </div>

          <!-- Pricing -->
          <div class="px-8 py-6 text-center">
            <div class="mb-4">
              <div class="text-xl font-medium text-gray-600 mb-2">
                {t("seax.pricing.plans.custom.description")}
              </div>
            </div>
          </div>

          <!-- Features -->
          <div class="px-8 pb-6 flex-grow">
            <div class="space-y-3">
              <div class="flex items-start space-x-3">
                <svg
                  class="w-5 h-5 text-green-500 flex-shrink-0 mt-0.5"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                    clip-rule="evenodd"></path>
                </svg>
                <span class="text-sm text-gray-700"
                  >{t("seax.pricing.plans.custom.features.0")}</span
                >
              </div>
              <div class="flex items-start space-x-3">
                <svg
                  class="w-5 h-5 text-green-500 flex-shrink-0 mt-0.5"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                    clip-rule="evenodd"></path>
                </svg>
                <span class="text-sm text-gray-700"
                  >{t("seax.pricing.plans.custom.features.1")}</span
                >
              </div>
              <div class="flex items-start space-x-3">
                <svg
                  class="w-5 h-5 text-green-500 flex-shrink-0 mt-0.5"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                    clip-rule="evenodd"></path>
                </svg>
                <span class="text-sm text-gray-700"
                  >{t("seax.pricing.plans.custom.features.2")}</span
                >
              </div>
            </div>
          </div>

          <!-- CTA Button -->
          <div class="px-8 pb-8 mt-auto">
            <a
              href={`https://calendar.app.google/GcdRQv1DVoiDaoCT6?lang=${lang}`}
              class="w-full py-3 px-6 rounded-lg font-semibold transition-all transform hover:scale-105 text-center inline-block bg-green-500 hover:bg-green-600 text-white"
            >
              {t("seax.pricing.plans.custom.cta")}
            </a>
          </div>
        </div>
      </div>

      <!-- Disclaimer -->
      <div class="text-center mt-8">
        <p class="text-sm text-gray-600">
          {t("seax.pricing.plans.disclaimer")}
