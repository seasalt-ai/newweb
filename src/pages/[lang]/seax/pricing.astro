  <script>
    // Handle pricing toggle functionality
    document.addEventListener('DOMContentLoaded', function() {
      const toggle = document.getElementById('billing-toggle');
      const monthlyLabel = document.getElementById('billing-label-monthly');
      const yearlyLabel = document.getElementById('billing-label-yearly');
      const pricingPlans = document.getElementById('pricing-plans');

      if (!toggle || !pricingPlans || !monthlyLabel || !yearlyLabel) {
        return;
      }

      let isYearly = false;

      function updateToggleAppearance() {
        if (isYearly) {
          toggle.setAttribute('aria-checked', 'true');
          monthlyLabel.classList.remove('bg-white', 'text-gray-900', 'shadow-sm');
          monthlyLabel.classList.add('text-gray-600');
          yearlyLabel.classList.add('bg-white', 'text-gray-900', 'shadow-sm');
          yearlyLabel.classList.remove('text-gray-600');
        } else {
          toggle.setAttribute('aria-checked', 'false');
          yearlyLabel.classList.remove('bg-white', 'text-gray-900', 'shadow-sm');
          yearlyLabel.classList.add('text-gray-600');
          monthlyLabel.classList.add('bg-white', 'text-gray-900', 'shadow-sm');
          monthlyLabel.classList.remove('text-gray-600');
        }
      }

      function applyBillingMode() {
        // Update pricing displays
        const priceElements = pricingPlans.querySelectorAll('[data-monthly-price]');
        priceElements.forEach(element => {
          const monthlyPrice = element.getAttribute('data-monthly-price');
          const yearlyPrice = element.getAttribute('data-yearly-price');

          if (!monthlyPrice || !yearlyPrice) return;

          if (!isYearly) {
            element.textContent = monthlyPrice;
          } else {
            // When yearly is selected, show the average monthly price
            // based on the yearly total (e.g. $99.9 / 12 -> $8.33)
            const numericYearly = parseFloat(yearlyPrice.replace(/[^0-9.]/g, ''));
            if (isNaN(numericYearly)) {
              element.textContent = monthlyPrice;
              return;
            }

            const monthlyEquivalent = numericYearly / 12;
            const currencyPrefixMatch = yearlyPrice.trim().match(/^[^0-9]+/);
            const currencyPrefix = currencyPrefixMatch ? currencyPrefixMatch[0] : '$';
            const formatted = `${currencyPrefix}${monthlyEquivalent.toFixed(2)}`;
            element.textContent = formatted;
          }
        });

        // Update billing notes
        const noteElements = pricingPlans.querySelectorAll('[data-billing-note]');
        noteElements.forEach(element => {
          const monthlyNote = element.getAttribute('data-monthly-note') || '';
          const yearlyNote = element.getAttribute('data-yearly-note') || '';
          element.textContent = isYearly ? yearlyNote : monthlyNote;
        });

        // Update additional pricing (for omnichannel)
        const additionalElements = pricingPlans.querySelectorAll('[data-monthly-additional]');
        additionalElements.forEach(element => {
          const monthlyAdditional = element.getAttribute('data-monthly-additional');
          const yearlyAdditional = element.getAttribute('data-yearly-additional');
          element.textContent = isYearly ? yearlyAdditional : monthlyAdditional;
        });
      }

      function setBillingMode(yearly) {
        isYearly = yearly;
        updateToggleAppearance();
        applyBillingMode();
      }

      // Click on whole toggle alternates mode
      toggle.addEventListener('click', function() {
        setBillingMode(!isYearly);
      });

      // Clicking specific labels sets explicit mode
      monthlyLabel.addEventListener('click', function(event) {
        event.stopPropagation();
        setBillingMode(false);
      });

      yearlyLabel.addEventListener('click', function(event) {
        event.stopPropagation();
        setBillingMode(true);
      });

      // Initialize appearance
      updateToggleAppearance();
    });
  </script>
