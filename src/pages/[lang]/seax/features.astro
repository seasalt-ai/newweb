---
import SeaxLayout from '../../../layouts/SeaxLayout.astro';
import { getTranslationHelpers, languages, getLocalizedPath } from '../../../i18n/helpers';

const { lang } = Astro.params;
const { t, translations } = await getTranslationHelpers(lang);

// SEO Configuration
const seoData = {
  title: t('seax.features.seo.title'),
  description: t('seax.features.seo.description'),
  keywords: t('seax.features.seo.keywords'),
  canonical: 'https://seasalt.ai' + getLocalizedPath('/seax/features', lang),
  ogImage: '/seax-features.png'
};

// Breadcrumbs
const breadcrumbs = [
  { name: 'Home', url: getLocalizedPath('/', lang) },
  { name: 'SeaX', url: getLocalizedPath('/seax', lang) },
  { name: 'Features', url: getLocalizedPath('/seax/features', lang) }
];

// FAQs
const faqs = [
  {
    question: "What makes SeaX different from other messaging platforms?",
    answer: "SeaX is specifically designed for massive scale communications. It can handle millions of messages and thousands of calls simultaneously with advanced AI automation and real-time analytics."
  },
  {
    question: "Can SeaX integrate with my existing CRM?",
    answer: "Yes, SeaX offers seamless integrations with major CRM platforms including Salesforce, HubSpot, and others through our robust API and webhook system."
  },
  {
    question: "What kind of analytics does SeaX provide?",
    answer: "SeaX provides comprehensive real-time analytics including delivery rates, response tracking, conversion metrics, and detailed campaign performance reports with exportable data."
  }
];

export async function getStaticPaths() {
  return Object.keys(languages).map(lang => ({
    params: { lang },
  }));
}
