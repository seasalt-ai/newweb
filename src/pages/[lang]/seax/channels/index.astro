---
import SeaxLayout from "../../../../layouts/SeaxLayout.astro";
import {
  getTranslationHelpers,
  languages,
  getLocalizedPath,
} from "../../../../i18n/helpers";

const { lang } = Astro.params;
const { t, translations } = await getTranslationHelpers(lang);

// SEO Configuration
const seoData = {
  title:
    t("seax.channels.seo.title") ||
    "Multi-Channel Marketing Platform - SMS, WhatsApp & Voice | SeaX",
  description:
    t("seax.channels.seo.description") ||
    "Reach customers across all channels with SeaX. Unified SMS, WhatsApp, and Voice marketing platform for maximum engagement and conversion.",
  keywords:
    t("seax.channels.seo.keywords") ||
    "multi-channel marketing, SMS marketing, WhatsApp marketing, voice marketing, omnichannel communication",
  canonical: "https://seasalt.ai" + getLocalizedPath("/seax/channels", lang),
  ogImage: "/seax-channels.png",
};

// Breadcrumbs
const breadcrumbs = [
  { name: "Home", url: getLocalizedPath("/", lang) },
  { name: "SeaX", url: getLocalizedPath("/seax", lang) },
  { name: "Channels", url: getLocalizedPath("/seax/channels", lang) },
];

// FAQs
const faqs = [
  {
    question:
      t("seax.channels.faqs.multichannel.question") ||
      "What is multi-channel marketing and why is it important?",
    answer:
      t("seax.channels.faqs.multichannel.answer") ||
      "Multi-channel marketing allows you to reach customers through their preferred communication channels - SMS, WhatsApp, and Voice. This approach increases engagement rates, improves customer experience, and maximizes your marketing ROI by meeting customers where they are.",
  },
  {
    question:
      t("seax.channels.faqs.integration.question") ||
      "How do all the channels work together in SeaX?",
    answer:
      t("seax.channels.faqs.integration.answer") ||
      "SeaX provides a unified dashboard where you can create cross-channel campaigns, track customer journeys across all touchpoints, and automate sequences that span multiple channels based on customer behavior and preferences.",
  },
  {
    question:
      t("seax.channels.faqs.analytics.question") ||
      "Can I track performance across all channels?",
    answer:
      t("seax.channels.faqs.analytics.answer") ||
      "Yes, SeaX provides comprehensive analytics that show performance metrics for each channel individually and collectively. You can see cross-channel attribution, customer journey mapping, and ROI analysis for your omnichannel campaigns.",
  },
];

// Channel data
const channels = [
  {
    name: t("seax.channels.sms.name") || "SMS Marketing",
    description:
      t("seax.channels.sms.description") ||
      "Instant messaging with 98% open rates for time-sensitive campaigns",
    icon: "sms",
    color: "blue",
    href: getLocalizedPath("/seax/channels/sms", lang),
    features: [
      t("seax.channels.sms.feature1") || "Bulk SMS campaigns",
      t("seax.channels.sms.feature2") || "Two-way messaging",
      t("seax.channels.sms.feature3") || "Smart routing",
      t("seax.channels.sms.feature4") || "Delivery tracking",
    ],
    stats: [
      { value: "98%", label: t("seax.channels.sms.stat1") || "Open Rate" },
      {
        value: "6 sec",
        label: t("seax.channels.sms.stat2") || "Avg. Response Time",
      },
    ],
    subChannels: [
      {
        name: t("seax.channels.smsLocal.name") || "Local Numbers (10DLC)",
        description:
          t("seax.channels.smsLocal.shortDescription") ||
          "Trusted area codes for compliant business messaging",
        href: getLocalizedPath("/seax/channels/sms-local", lang),
        icon: "location",
        color: "blue",
      },
      {
        name: t("seax.channels.smsTollFree.name") || "Toll-Free Numbers",
        description:
          t("seax.channels.smsTollFree.shortDescription") ||
          "Premium brand recognition, free for customers",
        href: getLocalizedPath("/seax/channels/sms-toll-free", lang),
        icon: "gift",
        color: "green",
      },
      {
        name: t("seax.channels.smsShortCode.name") || "Short Codes",
        description:
          t("seax.channels.smsShortCode.shortDescription") ||
          "Enterprise-grade, ultra-high volume messaging",
        href: getLocalizedPath("/seax/channels/sms-short-code", lang),
        icon: "lightning",
        color: "purple",
      },
    ],
  },
  {
    name: t("seax.channels.whatsapp.name") || "WhatsApp Business",
    description:
      t("seax.channels.whatsapp.description") ||
      "Rich media messaging on the world's most popular messaging app",
    icon: "whatsapp",
    color: "green",
    href: getLocalizedPath("/seax/channels/whatsapp", lang),
    features: [
      t("seax.channels.whatsapp.feature1") || "Business API integration",
      t("seax.channels.whatsapp.feature2") || "Rich media messages",
      t("seax.channels.whatsapp.feature3") || "Interactive buttons",
      t("seax.channels.whatsapp.feature4") || "Automated flows",
    ],
    stats: [
      {
        value: "2B+",
        label: t("seax.channels.whatsapp.stat1") || "Global Users",
      },
      {
        value: "65%",
        label: t("seax.channels.whatsapp.stat2") || "Engagement Rate",
      },
    ],
  },
  {
    name: t("seax.channels.voice.name") || "Voice Communications",
    description:
      t("seax.channels.voice.description") ||
      "Automated voice campaigns and interactive voice response systems",
    icon: "voice",
    color: "purple",
    href: getLocalizedPath("/seax/channels/voice", lang),
    features: [
      t("seax.channels.voice.feature1") || "Automated calling",
      t("seax.channels.voice.feature2") || "Interactive IVR",
      t("seax.channels.voice.feature3") || "Call recording",
      t("seax.channels.voice.feature4") || "Voice analytics",
    ],
    stats: [
      { value: "99.9%", label: t("seax.channels.voice.stat1") || "Uptime" },
      { value: "<200ms", label: t("seax.channels.voice.stat2") || "Latency" },
    ],
  },
];

// Benefits data
const benefits = [
  {
    title: t("seax.channels.benefits.unified.title") || "Unified Dashboard",
    description:
      t("seax.channels.benefits.unified.description") ||
      "Manage all your communication channels from one central platform",
    icon: "dashboard",
  },
  {
    title:
      t("seax.channels.benefits.crossChannel.title") ||
      "Cross-Channel Campaigns",
    description:
      t("seax.channels.benefits.crossChannel.description") ||
      "Create seamless campaigns that span multiple channels for maximum impact",
    icon: "flow",
  },
  {
    title: t("seax.channels.benefits.analytics.title") || "Unified Analytics",
    description:
      t("seax.channels.benefits.analytics.description") ||
      "Get comprehensive insights across all channels with detailed attribution",
    icon: "analytics",
  },
  {
    title: t("seax.channels.benefits.automation.title") || "Smart Automation",
    description:
      t("seax.channels.benefits.automation.description") ||
      "Automate customer journeys with intelligent channel selection",
    icon: "automation",
  },
];

export async function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({
    params: { lang },
  }));
}

// Helper function to get demo URL
const getDemoUrl = () => {
  return `https://calendar.app.google/GcdRQv1DVoiDaoCT6?lang=${lang}`;
};

// Helper function to get color classes
const getColorClasses = (color) => {
  const colorMap = {
    blue: {
      bg: "bg-blue-50",
      icon: "bg-blue-100",
      iconColor: "text-blue-600",
      titleHover: "group-hover:text-blue-600",
      button: "bg-blue-600 hover:bg-blue-700",
      accent: "text-blue-600",
    },
    green: {
      bg: "bg-green-50",
      icon: "bg-green-100",
      iconColor: "text-green-600",
      titleHover: "group-hover:text-green-600",
      button: "bg-green-600 hover:bg-green-700",
      accent: "text-green-600",
    },
    indigo: {
      bg: "bg-indigo-50",
      icon: "bg-indigo-100",
      iconColor: "text-indigo-600",
      titleHover: "group-hover:text-indigo-600",
      button: "bg-indigo-600 hover:bg-indigo-700",
      accent: "text-indigo-600",
    },
    purple: {
      bg: "bg-purple-50",
      icon: "bg-purple-100",
      iconColor: "text-purple-600",
      titleHover: "group-hover:text-purple-600",
      button: "bg-purple-600 hover:bg-purple-700",
      accent: "text-purple-600",
    },
  };
  return colorMap[color] || colorMap.blue;
};
---

<SeaxLayout
  {seoData}
  productKey="seax"
  breadcrumbs={breadcrumbs}
  faqs={faqs}
  lang={lang}
  headerVersion="seax"
  footerVersion="seax"
>
  <!-- Hero Section -->
  <div class="bg-gradient-to-br from-gray-50 to-blue-50 py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <div
          class="inline-flex items-center space-x-2 bg-blue-100 text-blue-800 px-4 py-2 rounded-full text-sm font-medium mb-6"
        >
          <svg
            class="w-4 h-4"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M13 10V3L4 14h7v7l9-11h-7z"></path>
          </svg>
          <span
            >{t("seax.channels.hero.badge") || "Multi-Channel Marketing"}</span
          >
        </div>

        <h1 class="text-4xl md:text-6xl font-bold text-gray-900 mb-6">
          {t("seax.channels.hero.title.line1") || "Reach Customers"}
          <br />
          <span
            class="bg-gradient-to-r from-blue-600 to-purple-600 bg-clip-text text-transparent"
          >
            {t("seax.channels.hero.title.line2") || "Everywhere They Are"}
          </span>
        </h1>

        <p class="text-xl text-gray-600 max-w-3xl mx-auto mb-10">
          {
            t("seax.channels.hero.description") ||
              "Connect with your audience across SMS, WhatsApp, and Voice channels from one unified platform. Maximize engagement with seamless omnichannel campaigns."
          }
        </p>

        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="https://seax.seasalt.ai/signup"
            target="_blank"
            rel="noopener noreferrer"
            class="bg-blue-600 text-white px-8 py-4 rounded-lg font-semibold hover:bg-blue-700 transition-colors flex items-center justify-center space-x-2"
          >
            <span>{t("seax.channels.hero.cta.primary") || "Sign Up Now"}</span>
            <svg
              class="w-5 h-5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
            </svg>
          </a>
          <a
            href={getDemoUrl()}
            target="_blank"
            rel="noopener noreferrer"
            class="border-2 border-blue-600 text-blue-600 px-8 py-4 rounded-lg font-semibold hover:bg-blue-50 transition-colors text-center"
          >
            {t("seax.channels.hero.cta.secondary") || "Watch Demo"}
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Channels Grid -->
  <div class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl font-bold text-gray-900 mb-4">
          {
            t("seax.channels.channels.title") ||
              "Choose Your Communication Channels"
          }
        </h2>
        <p class="text-lg text-gray-600">
          {
            t("seax.channels.channels.subtitle") ||
              "Each channel is optimized for different types of customer interactions"
          }
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {
          channels.map((channel, index) => {
            const colors = getColorClasses(channel.color);
            return (
              <div
                key={index}
                class={`${colors.bg} rounded-2xl p-8 group hover:shadow-lg transition-all duration-300`}
              >
                <div class="flex items-start justify-between mb-6">
                  <div class="flex items-center space-x-4">
                    <div
                      class={`${colors.icon} p-3 rounded-lg group-hover:scale-110 transition-transform`}
                    >
                      {channel.icon === "sms" && (
                        <svg
                          class={`w-8 h-8 ${colors.iconColor}`}
                          fill="none"
                          stroke="currentColor"
                          viewBox="0 0 24 24"
                        >
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"
                          />
                        </svg>
                      )}
                      {channel.icon === "whatsapp" && (
                        <svg
                          class={`w-8 h-8 ${colors.iconColor}`}
                          viewBox="0 0 24 24"
                          fill="currentColor"
                        >
                          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893A11.821 11.821 0 0020.465 3.516Z" />
                        </svg>
                      )}
                      {channel.icon === "voice" && (
                        <svg
                          class={`w-8 h-8 ${colors.iconColor}`}
                          fill="none"
                          stroke="currentColor"
                          viewBox="0 0 24 24"
                        >
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                          />
                        </svg>
                      )}
                    </div>
                    <div>
                      <h3
                        class={`text-2xl font-bold text-gray-900 ${colors.titleHover} transition-colors`}
                      >
                        {channel.name}
                      </h3>
                      <div class="flex items-center space-x-6 mt-2">
                        {channel.stats.map((stat, statIndex) => (
                          <div key={statIndex} class="text-center">
                            <div class={`text-lg font-bold ${colors.accent}`}>
                              {stat.value}
                            </div>
                            <div class="text-xs text-gray-600">
                              {stat.label}
                            </div>
                          </div>
                        ))}
                      </div>
                    </div>
                  </div>
                </div>

                <p class="text-gray-600 mb-6">{channel.description}</p>

                <div class="grid grid-cols-2 gap-3 mb-8">
                  {channel.features.map((feature, featureIndex) => (
                    <div key={featureIndex} class="flex items-center space-x-2">
                      <svg
                        class={`w-4 h-4 ${colors.accent}`}
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
                        />
                      </svg>
                      <span class="text-sm text-gray-700">{feature}</span>
                    </div>
                  ))}
                </div>

                <div class="space-y-4">
                  <a
                    href={channel.href}
                    class={`${colors.button} text-white px-6 py-3 rounded-lg font-semibold transition-colors flex items-center justify-center space-x-2 group`}
                  >
                    <span>Learn More</span>
                    <svg
                      class="w-4 h-4 group-hover:translate-x-1 transition-transform"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M17 8l4 4m0 0l-4 4m4-4H3"
                      />
                    </svg>
                  </a>

                  {channel.subChannels && (
                    <div class="border-t pt-4">
                      <h4 class="text-sm font-semibold text-gray-700 mb-3 uppercase tracking-wide">
                        SMS Types:
                      </h4>
                      <div class="space-y-2">
                        {channel.subChannels.map((subChannel, subIndex) => {
                          const subColors = getColorClasses(subChannel.color);
                          return (
                            <a
                              key={subIndex}
                              href={subChannel.href}
                              class="flex items-center space-x-3 p-3 rounded-lg bg-white/50 hover:bg-white/80 transition-colors group/sub"
                            >
                              <div
                                class={`${subColors.icon} p-2 rounded-md flex-shrink-0`}
                              >
                                {subChannel.icon === "location" && (
                                  <svg
                                    class={`w-4 h-4 ${subColors.iconColor}`}
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                                  >
                                    <path
                                      stroke-linecap="round"
                                      stroke-linejoin="round"
                                      stroke-width="2"
                                      d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                                    />
                                    <path
                                      stroke-linecap="round"
                                      stroke-linejoin="round"
                                      stroke-width="2"
                                      d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
                                    />
                                  </svg>
                                )}
                                {subChannel.icon === "gift" && (
                                  <svg
                                    class={`w-4 h-4 ${subColors.iconColor}`}
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                                  >
                                    <path
                                      stroke-linecap="round"
                                      stroke-linejoin="round"
                                      stroke-width="2"
                                      d="M12 8v13m0-13V6a2 2 0 112 2h-2zm0 0V5.5A2.5 2.5 0 109.5 8H12zm-7 4h14M5 12a2 2 0 110-4h14a2 2 0 110 4M5 12v7a2 2 0 002 2h10a2 2 0 002-2v-7"
                                    />
                                  </svg>
                                )}
                                {subChannel.icon === "lightning" && (
                                  <svg
                                    class={`w-4 h-4 ${subColors.iconColor}`}
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                                  >
                                    <path
                                      stroke-linecap="round"
                                      stroke-linejoin="round"
                                      stroke-width="2"
                                      d="M13 10V3L4 14h7v7l9-11h-7z"
                                    />
                                  </svg>
                                )}
                              </div>
                              <div class="flex-1 min-w-0">
                                <h5
                                  class={`text-sm font-semibold text-gray-900 group-hover/sub:${subColors.iconColor.replace("text-", "text-")} transition-colors`}
                                >
                                  {subChannel.name}
                                </h5>
                                <p class="text-xs text-gray-600 mt-1">
                                  {subChannel.description}
                                </p>
                              </div>
                              <svg
                                class="w-4 h-4 text-gray-400 group-hover/sub:text-gray-600 group-hover/sub:translate-x-1 transition-all"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                              >
                                <path
                                  stroke-linecap="round"
                                  stroke-linejoin="round"
                                  stroke-width="2"
                                  d="M9 5l7 7-7 7"
                                />
                              </svg>
                            </a>
                          );
                        })}
                      </div>
                    </div>
                  )}
                </div>
              </div>
            );
          })
        }
      </div>
    </div>
  </div>

  <!-- Benefits Section -->
  <div class="py-20 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl font-bold text-gray-900 mb-4">
          {
            t("seax.channels.benefits.title") ||
              "Why Choose Multi-Channel Marketing?"
          }
        </h2>
        <p class="text-lg text-gray-600">
          {
            t("seax.channels.benefits.subtitle") ||
              "Maximize your reach and engagement with integrated channel management"
          }
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
        {
          benefits.map((benefit, index) => (
            <div key={index} class="text-center">
              <div class="bg-white rounded-xl p-6 shadow-sm hover:shadow-md transition-shadow">
                <div class="bg-blue-100 p-4 rounded-lg w-16 h-16 flex items-center justify-center mx-auto mb-4">
                  {benefit.icon === "dashboard" && (
                    <svg
                      class="w-8 h-8 text-blue-600"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"
                      />
                    </svg>
                  )}
                  {benefit.icon === "flow" && (
                    <svg
                      class="w-8 h-8 text-blue-600"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M13 10V3L4 14h7v7l9-11h-7z"
                      />
                    </svg>
                  )}
                  {benefit.icon === "analytics" && (
                    <svg
                      class="w-8 h-8 text-blue-600"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M16 8v8m-4-5v5m-4-2v2m-2 4h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"
                      />
                    </svg>
                  )}
                  {benefit.icon === "automation" && (
                    <svg
                      class="w-8 h-8 text-blue-600"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"
                      />
                    </svg>
                  )}
                </div>
                <h3 class="text-xl font-semibold text-gray-900 mb-3">
                  {benefit.title}
                </h3>
                <p class="text-gray-600">{benefit.description}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>

  <!-- CTA Section -->
  <div class="bg-gradient-to-r from-blue-600 to-purple-600 py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-bold text-white mb-4">
        {
          t("seax.channels.cta.title") ||
            "Ready to Scale Your Multi-Channel Marketing?"
        }
      </h2>
      <p class="text-xl text-blue-100 mb-8">
        {
          t("seax.channels.cta.subtitle") ||
            "Join thousands of businesses reaching customers across all channels with SeaX"
        }
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="https://seax.seasalt.ai/signup"
          target="_blank"
          rel="noopener noreferrer"
          class="bg-white text-blue-600 px-8 py-4 rounded-lg font-semibold hover:bg-gray-50 transition-colors flex items-center justify-center space-x-2"
        >
          <span>{t("seax.channels.cta.primary") || "Sign Up Now"}</span>
          <svg
            class="w-5 h-5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
          </svg>
        </a>

        <a
          href={getDemoUrl()}
          target="_blank"
          rel="noopener noreferrer"
          class="border-2 border-white text-white px-8 py-4 rounded-lg font-semibold hover:bg-white hover:text-blue-600 transition-colors"
        >
          {t("seax.channels.cta.secondary") || "Watch Demo"}
        </a>
      </div>
    </div>
  </div>
</SeaxLayout>
