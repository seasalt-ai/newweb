---
import SeaxLayout from '../../../../layouts/SeaxLayout.astro';
import { getTranslationHelpers, languages, getLocalizedPath } from '../../../../i18n/helpers';

const { lang } = Astro.params;
const { t, translations } = await getTranslationHelpers(lang);

// Generate SEO data using SMS Local specific keys
const seoData = {
  title: t('seax.channels.smsLocal.seo.title'),
  description: t('seax.channels.smsLocal.seo.description'),
  keywords: 'SMS Local, 10DLC, A2P messaging, local numbers, business SMS',
  canonical: 'https://seasalt.ai' + getLocalizedPath('/seax/channels/sms-local', lang),
  ogImage: '/seax-sms-local.png'
};

// Breadcrumbs
const breadcrumbs = [
  { name: 'Home', url: getLocalizedPath('/', lang) },
  { name: 'SeaX', url: getLocalizedPath('/seax', lang) },
  { name: 'Channels', url: getLocalizedPath('/seax/channels', lang) },
  { name: t('seax.channels.smsLocal.title'), url: getLocalizedPath('/seax/channels/sms-local', lang) }
];

// Features - get from i18n
const featuresObj = t('seax.channels.smsLocal.features.items', { returnObjects: true }) as Record<string, string>;
const features = Object.values(featuresObj || {});

// Use cases - get from i18n
const useCasesObj = t('seax.channels.smsLocal.useCases.items', { returnObjects: true }) as Record<string, string>;
const useCases = Object.values(useCasesObj || {});

// Stats data
const stats = [
  {
    value: t('seax.channels.smsLocal.stats.deliveryRateValue'),
    label: t('seax.channels.smsLocal.stats.deliveryRate'),
    icon: 'message'
  },
  {
    value: t('seax.channels.smsLocal.stats.openRateValue'),
    label: t('seax.channels.smsLocal.stats.openRate'),
    icon: 'users'
  },
  {
    value: t('seax.channels.smsLocal.stats.supportValue'),
    label: t('seax.channels.smsLocal.stats.support'),
    icon: 'check'
  }
];

// Pricing data
const pricingRaw = t('seax.channels.smsLocal.pricing', { returnObjects: true }) as any;
const pricing = {
  setup: pricingRaw?.setup?.value ?? '',
  monthly: pricingRaw?.monthly?.value ?? '',
  perMessage: pricingRaw?.perMessage?.value ?? '',
  note: pricingRaw?.note ?? ''
};

const pricingLabels = {
  setup: pricingRaw?.setup?.label ?? 'Setup',
  monthly: pricingRaw?.monthly?.label ?? 'Monthly',
  perMessage: pricingRaw?.perMessage?.label ?? 'Per Message'
};

// Testimonial
const testimonial = {
  quote: t('seax.channels.smsLocal.testimonial.quote'),
  author: t('seax.channels.smsLocal.testimonial.author'),
  company: t('seax.channels.smsLocal.testimonial.company'),
  results: t('seax.channels.smsLocal.testimonial.results')
};

// FAQs
const faqs = [
  {
    question: "What is 10DLC SMS?",
    answer: "10DLC (10-Digit Long Code) is an Application-to-Person messaging system that uses local phone numbers for business messaging, providing better deliverability and carrier trust."
  },
  {
    question: "How does brand registration work?",
    answer: "We handle the complete brand registration process with The Campaign Registry (TCR), including business verification and campaign approval to ensure optimal delivery rates."
  },
  {
    question: "What are the benefits of local numbers?",
    answer: "Local numbers provide familiar area codes that customers trust, leading to higher open rates and better engagement compared to short codes or toll-free numbers."
  }
];

export async function getStaticPaths() {
  return Object.keys(languages).map(lang => ({
    params: { lang },
  }));
}

// Helper function to get demo URL
const getDemoUrl = () => {
  return `https://calendly.com/seasalt-ai/seasalt-ai-demo?lang=${lang}`;
};
---

<SeaxLayout 
  {seoData} 
  productKey="seax" 
  breadcrumbs={breadcrumbs} 
  faqs={faqs} 
  lang={lang}
  headerVersion="seax"
  footerVersion="seax"
>
  <!-- Hero Section -->
  <div class="bg-gradient-to-br from-blue-50 to-purple-50 py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="lg:grid lg:grid-cols-2 lg:gap-12 items-center">
        <div>
          <h1 class="text-4xl lg:text-6xl font-bold text-gray-900 mb-6">
            {t('seax.channels.smsLocal.subtitle')}
            <span class="bg-gradient-to-r from-blue-600 to-purple-600 bg-clip-text text-transparent block">
              {t('seax.channels.smsLocal.title')}
            </span>
          </h1>
          <p class="text-xl text-gray-600 mb-8">
            {t('seax.channels.smsLocal.description')}
          </p>
          
          
          <div class="flex flex-col sm:flex-row gap-4">
            <a
              href="https://seax.seasalt.ai/signup"
              target="_blank"
              rel="noopener noreferrer"
              class="bg-blue-600 text-white px-8 py-4 rounded-lg font-semibold hover:bg-blue-700 transition-colors flex items-center justify-center space-x-2"
            >
              <span>{t('seax.channelTemplate.hero.getStarted')}</span>
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
              </svg>
            </a>
          </div>
        </div>
        
        <!-- Campaign Dashboard -->
        <div class="mt-12 lg:mt-0">
          <div class="bg-white rounded-2xl shadow-2xl p-8">
            <div class="space-y-6">
              <div class="flex items-center justify-between">
                <div class="text-lg font-semibold text-gray-900">
                  {t('seax.channels.smsLocal.hero.campaign.title')}
                </div>
                <div class="bg-green-100 text-green-800 px-3 py-1 rounded-full text-sm font-medium">
                  {t('seax.channels.smsLocal.hero.campaign.status')}
                </div>
              </div>

              <div class="grid grid-cols-2 gap-4">
                <div class="bg-blue-50 rounded-lg p-4">
                  <div class="text-2xl font-bold text-blue-600 mb-1">
                    {t('seax.channels.smsLocal.hero.campaign.messagesSentValue')}
                  </div>
                  <div class="text-sm text-gray-600">
                    {t('seax.channels.smsLocal.hero.campaign.messagesSent')}
                  </div>
                </div>
                <div class="bg-green-50 rounded-lg p-4">
                  <div class="text-2xl font-bold text-green-600 mb-1">
                    {t('seax.channels.smsLocal.hero.campaign.deliveryRateValue')}
                  </div>
                  <div class="text-sm text-gray-600">
                    {t('seax.channels.smsLocal.hero.campaign.deliveryRate')}
                  </div>
                </div>
              </div>

              <div class="space-y-3">
                <div class="text-sm font-medium text-gray-700">
                  {t('seax.channels.smsLocal.hero.recentActivity.title')}
                </div>
                <div class="space-y-2">
                  <div class="flex items-center space-x-3 p-3 bg-gray-50 rounded-lg">
                    <div class="w-2 h-2 bg-blue-500 rounded-full"></div>
                    <div class="flex-1 text-sm">
                      <div class="font-medium">
                        {t('seax.channels.smsLocal.hero.recentActivity.marketing.title')}
                      </div>
                      <div class="text-gray-500">
                        {t('seax.channels.smsLocal.hero.recentActivity.marketing.details')}
                      </div>
                    </div>
                  </div>
                  <div class="flex items-center space-x-3 p-3 bg-gray-50 rounded-lg">
                    <div class="w-2 h-2 bg-green-500 rounded-full"></div>
                    <div class="flex-1 text-sm">
                      <div class="font-medium">
                        {t('seax.channels.smsLocal.hero.recentActivity.appointment.title')}
                      </div>
                      <div class="text-gray-500">
                        {t('seax.channels.smsLocal.hero.recentActivity.appointment.details')}
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Stats Section -->
  <div class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {stats.map((stat, index) => (
          <div key={index} class="text-center">
            <div class="bg-blue-50 rounded-lg p-6">
              <div class="flex justify-center mb-4">
                {stat.icon === 'message' && (
                  <svg class="w-8 h-8 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
                  </svg>
                )}
                {stat.icon === 'users' && (
                  <svg class="w-8 h-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197m13.5-9a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0z"/>
                  </svg>
                )}
                {stat.icon === 'check' && (
                  <svg class="w-8 h-8 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                  </svg>
                )}
              </div>
              <div class="text-3xl font-bold text-blue-600 mb-2">
                {stat.value}
              </div>
              <div class="text-gray-600 font-medium">
                {stat.label}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- Features Section -->
  <div class="py-20 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl font-bold text-gray-900 mb-4">
          {t('seax.channels.smsLocal.features.title')}
        </h2>
        <p class="text-lg text-gray-600">
          {t('seax.channels.smsLocal.features.subtitle')}
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {features.map((feature, index) => (
          <div key={index} class="bg-white rounded-lg p-6 shadow-sm">
            <div class="flex items-start space-x-3">
              <svg class="w-6 h-6 text-green-500 flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
              <span class="text-gray-800 font-medium">{feature}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- Use Cases Section -->
  <div class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl font-bold text-gray-900 mb-4">
          {t('seax.channels.smsLocal.useCases.title')}
        </h2>
        <p class="text-lg text-gray-600">
          {t('seax.channels.smsLocal.useCases.subtitle')}
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {useCases.map((useCase, index) => (
          <div key={index} class="bg-blue-50 rounded-lg p-6">
            <div class="flex items-start space-x-3">
              <svg class="w-6 h-6 text-blue-600 flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/>
              </svg>
              <span class="text-gray-800 font-medium">{useCase}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- Compliance Section -->
  <div class="py-20 bg-yellow-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-gray-900 mb-4">
          {t('seax.channels.smsLocal.compliance.title')}
        </h2>
        <p class="text-lg text-gray-600">
          {t('seax.channels.smsLocal.compliance.description')}
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <div class="bg-white rounded-lg p-6 shadow-sm">
          <div class="bg-blue-100 p-3 rounded-lg w-fit mb-4">
            <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-gray-900 mb-2">
            {t('seax.channels.smsLocal.compliance.brandRegistration.title')}
          </h3>
          <p class="text-gray-600">
            {t('seax.channels.smsLocal.compliance.brandRegistration.description')}
          </p>
        </div>

        <div class="bg-white rounded-lg p-6 shadow-sm">
          <div class="bg-green-100 p-3 rounded-lg w-fit mb-4">
            <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-gray-900 mb-2">
            {t('seax.channels.smsLocal.compliance.campaignApproval.title')}
          </h3>
          <p class="text-gray-600">
            {t('seax.channels.smsLocal.compliance.campaignApproval.description')}
          </p>
        </div>

        <div class="bg-white rounded-lg p-6 shadow-sm">
          <div class="bg-purple-100 p-3 rounded-lg w-fit mb-4">
            <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-gray-900 mb-2">
            {t('seax.channels.smsLocal.compliance.monitoring.title')}
          </h3>
          <p class="text-gray-600">
            {t('seax.channels.smsLocal.compliance.monitoring.description')}
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- Pricing Section -->
  <div class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl font-bold text-gray-900 mb-4">
          {t('seax.channels.smsLocal.pricing.title')}
        </h2>
        <p class="text-xl text-gray-600">
          {t('seax.channels.smsLocal.pricing.subtitle')}
        </p>
      </div>
      
      <div class="max-w-4xl mx-auto">
        <div class="bg-gradient-to-r from-blue-50 to-purple-50 p-8 rounded-2xl">
          <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-center">
            <div>
              <div class="text-3xl font-bold text-blue-600">{pricing.setup}</div>
              <div class="text-gray-600 mt-2">{pricingLabels.setup}</div>
            </div>
            <div>
              <div class="text-3xl font-bold text-blue-600">{pricing.monthly}</div>
              <div class="text-gray-600 mt-2">{pricingLabels.monthly}</div>
            </div>
            <div>
              <div class="text-3xl font-bold text-blue-600">{pricing.perMessage}</div>
              <div class="text-gray-600 mt-2">{pricingLabels.perMessage}</div>
            </div>
          </div>
          {pricing.note && (
            <div class="text-center mt-6">
              <p class="text-sm text-gray-600">{pricing.note}</p>
            </div>
          )}
        </div>
      </div>
    </div>
  </div>

  <!-- Testimonial Section -->
  <div class="py-20 bg-gray-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <blockquote class="text-xl italic text-gray-700 mb-6">
        "{testimonial.quote}"
      </blockquote>
      <div class="text-lg font-semibold text-gray-900">{testimonial.author}</div>
      <div class="text-gray-600">{testimonial.company}</div>
      <div class="text-sm text-blue-600 mt-2">{testimonial.results}</div>
    </div>
  </div>

  <!-- CTA Section -->
  <div class="py-20 bg-gradient-to-r from-blue-600 to-purple-600">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl lg:text-4xl font-bold text-white mb-6">
        {t('seax.channelTemplate.cta.title')}
      </h2>
      <p class="text-xl text-white opacity-90 mb-8 max-w-2xl mx-auto">
        {t('seax.channelTemplate.cta.subtitle')}
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="https://seax.seasalt.ai/signup"
          target="_blank"
          rel="noopener noreferrer"
          class="bg-white text-blue-600 hover:bg-gray-50 px-8 py-4 rounded-lg text-lg font-semibold transition-all duration-200"
        >
          {t('seax.channelTemplate.cta.getStarted')}
        </a>
        <a
          href="#pricing"
          class="border-2 border-white text-white hover:bg-white hover:text-blue-600 px-8 py-4 rounded-lg text-lg font-semibold transition-all duration-200"
        >
          {t('seax.channelTemplate.cta.viewPricing')}
        </a>
      </div>
    </div>
  </div>
</SeaxLayout>