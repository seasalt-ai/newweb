---
import SeaxLayout from '../../../../layouts/SeaxLayout.astro';
import { getTranslationHelpers, languages, getLocalizedPath } from '../../../../i18n/helpers';

const { lang } = Astro.params;
const { t, translations } = await getTranslationHelpers(lang);

// Generate enhanced SEO data using standardized utility
const seoData = {
  title: t('seax.channels.voice.seoTitle') || 'Voice Call Automation Platform - AI-Powered Phone Campaigns | SeaX',
  description: t('seax.channels.voice.seoDescription') || 'Automate phone calls at scale with SeaX Voice. AI-powered voice campaigns, appointment reminders, surveys, and customer outreach with high connection rates across 100+ countries.',
  keywords: 'voice communication, automated calls, IVR system, call center automation, voice broadcasting, phone marketing',
  canonical: 'https://seasalt.ai' + getLocalizedPath('/seax/channels/voice', lang),
  ogImage: '/seax-voice.png'
};

// Breadcrumbs
const breadcrumbs = [
  { name: 'Home', url: getLocalizedPath('/', lang) },
  { name: 'SeaX', url: getLocalizedPath('/seax', lang) },
  { name: 'Channels', url: getLocalizedPath('/seax/channels', lang) },
  { name: 'Voice', url: getLocalizedPath('/seax/channels/voice', lang) }
];

// FAQs
const faqs = [
  {
    question: "What voice communication features does SeaX provide?",
    answer: "SeaX offers comprehensive voice solutions including automated outbound calling, interactive voice response (IVR) systems, call recording, voice analytics, and integration with CRM systems for seamless customer communications."
  },
  {
    question: "Can I set up interactive voice response (IVR) systems?",
    answer: "Yes, SeaX provides advanced IVR capabilities with customizable call flows, voice menus, call routing, and integration with your existing systems to create professional automated phone experiences."
  },
  {
    question: "How does SeaX ensure call quality and compliance?",
    answer: "SeaX uses enterprise-grade infrastructure with high-quality voice carriers, complies with telecommunications regulations, and provides call recording and monitoring features for quality assurance."
  }
];

// Features and Use Cases, from objects convert to arrays
const featuresObj = {
  '0': t('seax.channels.voice.features.items.0') || 'AI-powered natural voice synthesis',
  '1': t('seax.channels.voice.features.items.1') || 'Multi-language support (25+ languages)',
  '2': t('seax.channels.voice.features.items.2') || 'Real-time call analytics and reporting',
  '3': t('seax.channels.voice.features.items.3') || 'Interactive voice response (IVR) capability',
  '4': t('seax.channels.voice.features.items.4') || 'Voicemail detection and handling',
  '5': t('seax.channels.voice.features.items.5') || 'Call recording and transcription',
  '6': t('seax.channels.voice.features.items.6') || 'Smart retry logic and scheduling',
  '7': t('seax.channels.voice.features.items.7') || 'Compliance with telemarketing regulations'
};
const features = Object.values(featuresObj || {});

const useCasesObj = {
  '0': t('seax.channels.voice.useCases.items.0') || 'Appointment reminders and confirmations',
  '1': t('seax.channels.voice.useCases.items.1') || 'Customer satisfaction surveys',
  '2': t('seax.channels.voice.useCases.items.2') || 'Payment reminders and collections',
  '3': t('seax.channels.voice.useCases.items.3') || 'Emergency alerts and notifications',
  '4': t('seax.channels.voice.useCases.items.4') || 'Event confirmations and updates',
  '5': t('seax.channels.voice.useCases.items.5') || 'Lead qualification and nurturing',
  '6': t('seax.channels.voice.useCases.items.6') || 'Market research and polling',
  '7': t('seax.channels.voice.useCases.items.7') || 'Service outage notifications'
};
const useCases = Object.values(useCasesObj || {});

// Features / UseCases titles
const featuresTitle = t('seax.channels.voice.features.title') || 'Powerful Voice Features';
const featuresSubtitle = t('seax.channels.voice.features.subtitle') || 'Everything you need for successful voice campaigns';
const useCasesTitle = t('seax.channels.voice.useCases.title') || 'Voice Campaign Use Cases';
const useCasesSubtitle = t('seax.channels.voice.useCases.subtitle') || 'Proven applications for voice automation';

// Pricing raw object
const pricingRaw = {
  title: t('seax.channels.voice.pricing.title') || 'Voice Campaign Pricing',
  subtitle: t('seax.channels.voice.pricing.subtitle') || 'Cost-effective pricing for voice automation',
  setup: {
    label: t('seax.channels.voice.pricing.setup.label') || 'Setup Fee',
    value: t('seax.channels.voice.pricing.setup.value') || '$199'
  },
  monthly: {
    label: t('seax.channels.voice.pricing.monthly.label') || 'Monthly Fee',
    value: t('seax.channels.voice.pricing.monthly.value') || '$49'
  },
  perMessage: {
    label: t('seax.channels.voice.pricing.perMessage.label') || 'Per Message',
    value: t('seax.channels.voice.pricing.perMessage.value') || '$0.08'
  },
  perMinute: {
    label: t('seax.channels.voice.pricing.perMinute.label') || 'Per Minute',
    value: t('seax.channels.voice.pricing.perMinute.value') || '$0.12'
  },
  note: {
    value: t('seax.channels.voice.pricing.note.value') || 'Volume discounts available for 10,000+ calls/month'
  }
};

// Extract pricing values
const pricing = {
  setup: pricingRaw.setup?.value || '',
  monthly: pricingRaw.monthly?.value || '',
  perMessage: pricingRaw.perMessage?.value,
  perMinute: pricingRaw.perMinute?.value,
  note: pricingRaw.note?.value,
};

const pricingLabels = {
  setup: pricingRaw.setup?.label || 'Setup',
  monthly: pricingRaw.monthly?.label || 'Monthly',
  perMessage: pricingRaw.perMessage?.label || 'Per Message',
};

// Stats
const stats = [
  {
    value: t('seax.channels.voice.hero.widget.countriesValue') || '100+',
    label: t('seax.channels.voice.hero.widget.countriesLabel') || 'Countries Supported',
    icon: 'globe'
  },
  {
    value: t('seax.channels.voice.hero.widget.connectionRateValue') || '87%',
    label: t('seax.channels.voice.hero.widget.connectionRateLabel') || 'Connection Rate',
    icon: 'phone'
  },
  {
    value: t('seax.channels.voice.stats.languagesValue') || '25+',
    label: t('seax.channels.voice.stats.languagesLabel') || 'Languages Supported',
    icon: 'microphone'
  }
];

// Testimonial
const testimonial = {
  quote: t('seax.channels.voice.testimonial.quote') || 'SeaX voice campaigns have revolutionized our appointment reminders. We\'ve reduced no-shows by 70% and improved customer satisfaction significantly.',
  author: t('seax.channels.voice.testimonial.author') || 'Dr. Emily Rodriguez',
  company: t('seax.channels.voice.testimonial.company') || 'HealthFirst Medical Group',
  results: t('seax.channels.voice.testimonial.results') || '70% reduction in no-shows and 95% customer satisfaction rate'
};


export async function getStaticPaths() {
  return Object.keys(languages).map(lang => ({
    params: { lang },
  }));
}
---

<SeaxLayout 
  {seoData} 
  productKey="seax" 
  breadcrumbs={breadcrumbs} 
  faqs={faqs} 
  lang={lang}
  headerVersion="seax"
  footerVersion="seax"
>
  <!-- Hero Section with Widget (Based on original Voice.tsx) -->
  <div class="bg-gradient-to-br from-blue-50 to-indigo-100 py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <!-- Left Column - Title & Description -->
        <div class="space-y-8">
          <div class="space-y-4">
            <h1 class="text-4xl sm:text-5xl font-bold text-gray-900">
              {t('seax.channels.voice.title') || 'AI Voice Campaigns'}
            </h1>
            <h2 class="text-2xl text-purple-600">
              {t('seax.channels.voice.subtitle') || 'Automated Phone Calls at Scale'}
            </h2>
            <p class="text-xl text-gray-600">
              {t('seax.channels.voice.description') || 'Reach customers instantly with AI-powered voice campaigns. Perfect for appointment reminders, surveys, emergency alerts, and personalized customer outreach across 100+ countries.'}
            </p>
          </div>
          
          <!-- Stats Grid -->
          <div class="grid grid-cols-3 gap-4">
            {stats.map((stat, index) => (
              <div class="text-center">
                <div class="text-2xl font-bold text-purple-600">{stat.value}</div>
                <div class="text-sm text-gray-600">{stat.label}</div>
              </div>
            ))}
          </div>
          
          <!-- CTA Buttons -->
          <div class="flex flex-col sm:flex-row gap-4">
            <a
              href="https://seax.seasalt.ai/signup"
              target="_blank"
              rel="noopener noreferrer"
              class="bg-blue-600 text-white px-8 py-4 rounded-lg font-semibold hover:bg-blue-700 transition-colors flex items-center justify-center space-x-2"
            >
              <span>{t('seax.channelTemplate.hero.getStarted') || 'Get Started'}</span>
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
              </svg>
            </a>
          </div>
        </div>
        
        <!-- Right Column - Hero Widget (Based on original Voice.tsx) -->
        <div class="relative">
          <div class="bg-white rounded-2xl shadow-2xl p-8">
            <div class="space-y-6">
              <div class="flex items-center justify-between">
                <div class="text-lg font-semibold text-gray-900">
                  {t('seax.channels.voice.hero.widget.title') || 'AI Voice Dashboard'}
                </div>
                <div class="bg-blue-100 text-blue-800 px-3 py-1 rounded-full text-sm font-medium">
                  {t('seax.channels.voice.hero.widget.poweredBy') || 'Powered by SeaX'}
                </div>
              </div>
              <div class="text-center">
                <div class="text-4xl font-bold text-blue-600 mb-2">
                  {t('seax.channels.voice.hero.widget.callsNumber') || '24,847'}
                </div>
                <div class="text-sm text-gray-600">
                  {t('seax.channels.voice.hero.widget.callsCompletedToday') || 'calls completed today'}
                </div>
              </div>
              <div class="grid grid-cols-2 gap-4">
                <div class="bg-green-50 rounded-lg p-4">
                  <div class="text-2xl font-bold text-green-600 mb-1">
                    {t('seax.channels.voice.hero.widget.connectionRateValue') || '87%'}
                  </div>
                  <div class="text-sm text-gray-600">
                    {t('seax.channels.voice.hero.widget.connectionRateLabel') || 'Connection Rate'}
                  </div>
                </div>
                <div class="bg-purple-50 rounded-lg p-4">
                  <div class="text-2xl font-bold text-purple-600 mb-1">
                    {t('seax.channels.voice.hero.widget.countriesValue') || '100+'}
                  </div>
                  <div class="text-sm text-gray-600">
                    {t('seax.channels.voice.hero.widget.countriesLabel') || 'Countries Supported'}
                  </div>
                </div>
              </div>
              <div class="space-y-3">
                <div class="text-sm font-medium text-gray-700">
                  {t('seax.channels.voice.hero.widget.activeCalls') || 'Active Calls'}
                </div>
                <div class="space-y-2">
                  <div class="flex items-center space-x-3 p-3 bg-gray-50 rounded-lg">
                    <div class="w-2 h-2 bg-blue-500 rounded-full animate-pulse"></div>
                    <div class="flex-1 text-sm">
                      <div class="font-medium">
                        {t('seax.channels.voice.hero.widget.usPhoneNumber') || '+1 (555) 123-4567'}
                      </div>
                      <div class="text-gray-500">
                        {t('seax.channels.voice.hero.widget.appointmentReminder') || 'Appointment reminder call'}
                      </div>
                    </div>
                  </div>
                  <div class="flex items-center space-x-3 p-3 bg-gray-50 rounded-lg">
                    <div class="w-2 h-2 bg-green-500 rounded-full animate-pulse"></div>
                    <div class="flex-1 text-sm">
                      <div class="font-medium">
                        {t('seax.channels.voice.hero.widget.ukPhoneNumber') || '+44 20 7946 0958'}
                      </div>
                      <div class="text-gray-500">
                        {t('seax.channels.voice.hero.widget.surveyCall') || 'Customer satisfaction survey'}
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  
  <!-- Stats Section -->
  <div class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {stats.map((stat, index) => (
          <div class="text-center">
            <div class="bg-blue-50 rounded-lg p-6">
              <div class="flex justify-center mb-4">
                {index === 0 && (
                  <svg class="w-8 h-8 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12h18"/>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
                  </svg>
                )}
                {index === 1 && (
                  <svg class="w-8 h-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                  </svg>
                )}
                {index === 2 && (
                  <svg class="w-8 h-8 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z"/>
                  </svg>
                )}
              </div>
              <div class="text-3xl font-bold text-blue-600 mb-2">
                {stat.value}
              </div>
              <div class="text-gray-600 font-medium">
                {stat.label}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
  
  <!-- Features Section -->
  <div class="py-20 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl font-bold text-gray-900 mb-4">
          {featuresTitle}
        </h2>
        <p class="text-lg text-gray-600">
          {featuresSubtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {features.map((feature, index) => (
          <div class="bg-white rounded-lg p-6 shadow-sm">
            <div class="flex items-start space-x-3">
              <svg class="w-6 h-6 text-green-500 flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
              <span class="text-gray-800 font-medium">{feature}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
  
  <!-- Use Cases Section -->
  <div class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl font-bold text-gray-900 mb-4">
          {useCasesTitle}
        </h2>
        <p class="text-lg text-gray-600">
          {useCasesSubtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {useCases.map((useCase, index) => (
          <div class="bg-blue-50 rounded-lg p-6">
            <div class="flex items-start space-x-3">
              <svg class="w-6 h-6 text-blue-600 flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/>
              </svg>
              <span class="text-gray-800 font-medium">{useCase}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
  
  <!-- Pricing Section -->
  <div class="py-20 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl font-bold text-gray-900 mb-4">
          {pricingRaw.title}
        </h2>
        <p class="text-lg text-gray-600">
          {pricingRaw.subtitle}
        </p>
      </div>
      
      <div class="bg-white rounded-2xl p-8 shadow-lg max-w-2xl mx-auto">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div class="text-center">
            <div class="bg-green-100 p-3 rounded-lg w-fit mx-auto mb-4">
              <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.268-5.5L21 6.5 9 18.5l-3-3"/>
              </svg>
            </div>
            <div class="text-lg font-semibold text-gray-900 mb-2">{pricingLabels.setup}</div>
            <div class="text-2xl font-bold text-green-600">{pricing.setup}</div>
          </div>
          
          <div class="text-center">
            <div class="bg-blue-100 p-3 rounded-lg w-fit mx-auto mb-4">
              <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
            </div>
            <div class="text-lg font-semibold text-gray-900 mb-2">{pricingLabels.monthly}</div>
            <div class="text-2xl font-bold text-blue-600">{pricing.monthly}</div>
          </div>
          
          <div class="text-center">
            <div class="bg-purple-100 p-3 rounded-lg w-fit mx-auto mb-4">
              <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/>
              </svg>
            </div>
            <div class="text-lg font-semibold text-gray-900 mb-2">{pricingRaw.perMinute?.label || 'Per Minute'}</div>
            <div class="text-2xl font-bold text-purple-600">
              {pricing.perMinute}
            </div>
          </div>
        </div>
        
        {pricing.note && (
          <div class="mt-8 p-4 bg-yellow-50 rounded-lg">
            <p class="text-sm text-yellow-800 text-center">
              {pricing.note}
            </p>
          </div>
        )}
      </div>
    </div>
  </div>
  
  <!-- Testimonial Section -->
  <div class="py-20 bg-blue-600">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <blockquote class="text-xl text-blue-100 mb-8">
        "{testimonial.quote}"
      </blockquote>
      
      <div class="text-white font-semibold">
        {testimonial.author}
      </div>
      <div class="text-blue-200 mb-4">
        {testimonial.company}
      </div>
      
      <div class="bg-white/10 rounded-lg p-4 max-w-md mx-auto">
        <div class="text-white font-bold text-lg">
          {testimonial.results}
        </div>
      </div>
    </div>
  </div>
  
  <!-- Final CTA Section -->
  <div class="py-20 bg-gray-900">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-bold text-white mb-4">
        {t('seax.channelTemplate.cta.title') || 'Ready to Scale Your Outreach?'}
      </h2>
      <p class="text-xl text-gray-300 mb-8">
        {t('seax.channelTemplate.cta.subtitle') || 'Join thousands of businesses reaching millions with SeaX'}
      </p>
      
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="https://seax.seasalt.ai/signup"
          target="_blank"
          rel="noopener noreferrer"
          class="bg-blue-600 text-white px-8 py-4 rounded-lg font-semibold hover:bg-blue-700 transition-colors flex items-center justify-center space-x-2"
        >
          <span>{t('seax.channelTemplate.cta.getStarted') || 'Get Started Today'}</span>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
        
        <a
          href={getLocalizedPath('/seax/pricing', lang)}
          class="border-2 border-gray-600 text-gray-300 px-8 py-4 rounded-lg font-semibold hover:bg-gray-800 transition-colors"
        >
          {t('seax.channelTemplate.cta.viewPricing') || 'View Pricing'}
        </a>
      </div>
    </div>
  </div>
</SeaxLayout>
