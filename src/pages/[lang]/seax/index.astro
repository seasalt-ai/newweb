---
import SeaxLayout from "../../../layouts/SeaxLayout.astro";
import {
  getTranslationHelpers,
  supportedLocales,
  getLocalizedPath,
  type SupportedLanguage,
} from "../../../i18n/helpers";
import Hero from "../../../components/react/seax/Hero";
import StatsCounter from "../../../components/react/seax/StatsCounter";
import ScaleComparison from "../../../components/react/seax/ScaleComparison";
import RealTimeDashboard from "../../../components/react/seax/RealTimeDashboard";

const { lang } = Astro.params;
const { t, translations } = await getTranslationHelpers(lang);

// SEO Configuration
const seoData = {
  title: t("seax.home.seo.title"),
  description: t("seax.home.seo.description"),
  keywords: t("seax.home.seo.keywords"),
  canonical: "https://seasalt.ai" + getLocalizedPath("/seax", lang),
  ogImage: "/seax-logo.png",
};

// SeaX breadcrumbs
const breadcrumbs = [
  { name: "Home", url: getLocalizedPath("/", lang) },
  { name: "SeaX", url: getLocalizedPath("/seax", lang) },
];

// SeaX FAQs
const faqs = [
  {
    question: "What is SeaX?",
    answer:
      "SeaX is a cloud communication platform that enables businesses to send millions of SMS messages, make voice calls, and conduct WhatsApp campaigns at scale. It's designed for high-volume outreach and customer engagement.",
  },
  {
    question: "How many messages can SeaX send?",
    answer:
      "SeaX can handle massive scale communications, sending millions of SMS messages and making thousands of voice calls simultaneously. It's built for enterprise-level campaigns and bulk communications.",
  },
  {
    question: "What channels does SeaX support?",
    answer:
      "SeaX supports multiple communication channels including SMS, voice calls, WhatsApp Business API, and other messaging platforms, allowing businesses to reach customers through their preferred channels.",
  },
  {
    question: "Is SeaX suitable for lead generation?",
    answer:
      "Yes, SeaX is specifically designed for lead generation and customer outreach campaigns. It includes features for lead capture, qualification, nurturing, and conversion tracking with real-time analytics.",
  },
];

export async function getStaticPaths() {
  return supportedLocales.map((lang) => ({
    params: { lang },
  }));
}
---

<SeaxLayout
  {seoData}
  breadcrumbs={breadcrumbs}
  faqs={faqs}
  lang={lang}
  headerVersion="seax"
  footerVersion="seax"
  type="service"
  service={{
    offers: [
      {
        name: t("seax.pricing.plans.whatsapp.name"),
        price: t("seax.pricing.plans.whatsapp.price.monthly"),
        priceCurrency: "USD",
        description: t("seax.pricing.plans.whatsapp.description"),
      },
      {
        name: t("seax.pricing.plans.omnichannel.name"),
        price: t("seax.pricing.plans.omnichannel.price.monthly"),
        priceCurrency: "USD",
        description: t("seax.pricing.plans.omnichannel.description"),
      },
      {
        name: t("seax.pricing.plans.custom.name"),
        price: "Contact for pricing",
        priceCurrency: "USD",
        description: t("seax.pricing.plans.custom.description"),
      },
    ],
  }}
>
  <Hero
    client:only="react"
    lang={lang}
    translations_obj={translations}
    translations={{
      badge:
        t("seax.hero.badge") || "🚀 The Ultimate Mass Communication Platform",
      headline: {
        reach: t("seax.hero.headline.reach") || "Reach",
        millions: t("seax.hero.headline.millions") || "Millions",
        instantly: t("seax.hero.headline.instantly") || "Instantly",
      },
      subtitle:
        t("seax.hero.subtitle") ||
        "Send millions of SMS messages, make thousands of phone calls, and run WhatsApp campaigns simultaneously. SeaX is built for businesses that need to communicate at massive scale.",
      benefits: {
        messages: t("seax.hero.benefits.messages") || "10M+ Messages Daily",
        calls: t("seax.hero.benefits.calls") || "100K+ Calls Per Hour",
        uptime: t("seax.hero.benefits.uptime") || "99.9% Uptime Guaranteed",
      },
      cta: {
        bookDemo: t("seax.hero.cta.bookDemo") || "Book Demo",
        signUp: t("seax.hero.cta.signUp") || "Sign Up Now",
      },
      liveActivity: t("seax.hero.liveActivity") || "Live Activity",
      stats: {
        sent: t("seax.hero.stats.sent") || "Sent",
        delivered: t("seax.hero.stats.delivered") || "Delivered",
        active: t("seax.hero.stats.active") || "Active Now",
      },
      visual: {
        title: t("seax.hero.visual.title") || "Watch SeaX in Action",
        subtitle:
          t("seax.hero.visual.subtitle") ||
          "Real-time mass communication at scale",
      },
    }}
  />
  <StatsCounter
    client:only="react"
    translations={{
      section: {
        title:
          t("statsCounter.section.title") || "Trusted by businesses worldwide",
        subtitle:
          t("statsCounter.section.subtitle") ||
          "Our platform powers millions of conversations every day",
      },
      stats: {
        messages: {
          label: t("statsCounter.stats.messages.label") || "Messages Sent",
          suffix: t("statsCounter.stats.messages.suffix") || "M+",
        },
        calls: {
          label: t("statsCounter.stats.calls.label") || "Calls Made",
          suffix: t("statsCounter.stats.calls.suffix") || "K+",
        },
        uptime: {
          label: t("statsCounter.stats.uptime.label") || "System Uptime",
          suffix: t("statsCounter.stats.uptime.suffix") || "%",
        },
        countries: {
          label: t("statsCounter.stats.countries.label") || "Countries Served",
          suffix: t("statsCounter.stats.countries.suffix") || "+",
        },
        roi: {
          label: t("statsCounter.stats.roi.label") || "ROI Increase",
          suffix: t("statsCounter.stats.roi.suffix") || "%",
        },
      },
      dashboard: {
        title: t("statsCounter.dashboard.title") || "SeaX Dashboard",
        messagesSent:
          t("statsCounter.dashboard.messagesSent") || "Messages Sent",
        deliveryRate:
          t("statsCounter.dashboard.deliveryRate") || "Delivery Rate",
        recentActivity:
          t("statsCounter.dashboard.recentActivity") || "Recent Activity",
        demo: {
          messagesSent: t("statsCounter.dashboard.demo.messagesSent") || "2.4M",
          deliveryRate: t("statsCounter.dashboard.demo.deliveryRate") || "85%",
        },
      },
      activity: {
        flashSale: {
          title:
            t("statsCounter.activity.flashSale.title") || "Flash Sale Campaign",
          detail:
            t("statsCounter.activity.flashSale.detail") ||
            "50,000 SMS sent • 2 min ago",
        },
        leadFollowup: {
          title:
            t("statsCounter.activity.leadFollowup.title") || "Lead Follow-up",
          detail:
            t("statsCounter.activity.leadFollowup.detail") ||
            "12,000 calls completed • 5 min ago",
        },
        whatsapp: {
          title:
            t("statsCounter.activity.whatsapp.title") || "WhatsApp Campaign",
          detail:
            t("statsCounter.activity.whatsapp.detail") ||
            "25,000 messages queued • 8 min ago",
        },
      },
      status: {
        liveRunning:
          t("statsCounter.status.liveRunning") || "Live campaigns running",
        liveActivity:
          t("statsCounter.status.liveActivity") ||
          "Live activity: Messages being sent right now",
      },
    }}
  />

  <!-- The Scaling Problem Section -->
  <div class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Section Header -->
      <div class="text-center mb-16">
        <h2 class="text-4xl font-bold text-gray-900 mb-4">
          {t("seax.home.scalingProblem.title")}
        </h2>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
          {t("seax.home.scalingProblem.subtitle")}
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-12 items-center">
        <!-- Left Column -->
        <div class="space-y-6">
          <!-- Manual Outreach -->
          <div class="flex items-start space-x-4">
            <div
              class="flex-shrink-0 w-12 h-12 bg-red-100 rounded-full flex items-center justify-center"
            >
              <svg
                class="w-6 h-6 text-red-600 transform rotate-45"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                ></path>
              </svg>
            </div>
            <div>
              <h3 class="text-lg font-semibold text-gray-900 mb-2">
                {t("seax.home.scalingProblem.manualOutreach.title")}
              </h3>
              <p class="text-gray-600">
                {t("seax.home.scalingProblem.manualOutreach.description")}
              </p>
            </div>
          </div>

          <!-- SeaX Automation -->
          <div class="flex items-start space-x-4">
            <div
              class="flex-shrink-0 w-12 h-12 bg-green-100 rounded-full flex items-center justify-center"
            >
              <svg
                class="w-6 h-6 text-green-600"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M13 10V3L4 14h7v7l9-11h-7z"></path>
              </svg>
            </div>
            <div>
              <h3 class="text-lg font-semibold text-gray-900 mb-2">
                {t("seax.home.scalingProblem.seaxAutomation.title")}
              </h3>
              <p class="text-gray-600">
                {t("seax.home.scalingProblem.seaxAutomation.description")}
              </p>
            </div>
          </div>
        </div>

        <!-- Right Column (Stats) -->
        <div
          class="bg-gradient-to-br from-blue-50 to-indigo-100 rounded-2xl p-8"
        >
          <div class="grid grid-cols-2 gap-6">
            <!-- Messages Sent -->
            <div class="text-center">
              <div class="text-3xl font-bold text-blue-600">
                {t("seax.home.scalingProblem.stats.messagesSent.value")}
              </div>
              <div class="text-sm text-gray-600">
                {t("seax.home.scalingProblem.stats.messagesSent.label")}
              </div>
            </div>

            <!-- Calls Per Hour -->
            <div class="text-center">
              <div class="text-3xl font-bold text-blue-600">
                {t("seax.home.scalingProblem.stats.callsPerHour.value")}
              </div>
              <div class="text-sm text-gray-600">
                {t("seax.home.scalingProblem.stats.callsPerHour.label")}
              </div>
            </div>

            <!-- Delivery Rate -->
            <div class="text-center">
              <div class="text-3xl font-bold text-blue-600">
                {t("seax.home.scalingProblem.stats.deliveryRate.value")}
              </div>
              <div class="text-sm text-gray-600">
                {t("seax.home.scalingProblem.stats.deliveryRate.label")}
              </div>
            </div>

            <!-- ROI Average -->
            <div class="text-center">
              <div class="text-3xl font-bold text-blue-600">
                {t("seax.home.scalingProblem.stats.roiAverage.value")}
              </div>
              <div class="text-sm text-gray-600">
                {t("seax.home.scalingProblem.stats.roiAverage.label")}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Scale Comparison Animation -->
  <ScaleComparison
    client:only="react"
    lang={lang}
    translations={translations}
  />

  <!-- Massive Scale Features -->
  <div class="py-20 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-4xl font-bold text-gray-900 mb-4">
          {t("seax.home.features.title")}
        </h2>
        <p class="text-xl text-gray-600">
          {t("seax.home.features.subtitle")}
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        <a
          href={getLocalizedPath("/seax/channels/sms", lang)}
          class="bg-white rounded-xl p-6 shadow-lg hover:shadow-xl transition-all group"
        >
          <div
            class="w-14 h-14 bg-blue-100 rounded-lg flex items-center justify-center mb-4 group-hover:bg-blue-200 transition-colors"
          >
            <svg
              class="w-8 h-8 text-blue-600"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"
              ></path>
            </svg>
          </div>
          <h3
            class="text-xl font-semibold text-gray-900 mb-2 group-hover:text-blue-600 transition-colors"
          >
            {t("seax.home.features.sms.title")}
          </h3>
          <p class="text-gray-600">{t("seax.home.features.sms.description")}</p>
          <div
            class="mt-4 flex items-center text-blue-600 opacity-0 group-hover:opacity-100 transition-opacity"
          >
            <span class="text-sm font-medium">Learn more</span>
            <svg
              class="w-4 h-4 ml-2"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
            </svg>
          </div>
        </a>

        <a
          href={getLocalizedPath("/seax/channels/whatsapp", lang)}
          class="bg-white rounded-xl p-6 shadow-lg hover:shadow-xl transition-all group"
        >
          <div
            class="w-14 h-14 bg-green-100 rounded-lg flex items-center justify-center mb-4 group-hover:bg-green-200 transition-colors"
          >
            <svg
              class="w-8 h-8 text-green-600"
              viewBox="0 0 24 24"
              fill="currentColor"
            >
              <path
                d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893A11.821 11.821 0 0020.465 3.516Z"
              ></path>
            </svg>
          </div>
          <h3
            class="text-xl font-semibold text-gray-900 mb-2 group-hover:text-green-600 transition-colors"
          >
            {t("seax.home.features.whatsapp.title")}
          </h3>
          <p class="text-gray-600">
            {t("seax.home.features.whatsapp.description")}
          </p>
          <div
            class="mt-4 flex items-center text-green-600 opacity-0 group-hover:opacity-100 transition-opacity"
          >
            <span class="text-sm font-medium">Learn more</span>
            <svg
              class="w-4 h-4 ml-2"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
            </svg>
          </div>
        </a>

        <a
          href={getLocalizedPath("/seax/channels/voice", lang)}
          class="bg-white rounded-xl p-6 shadow-lg hover:shadow-xl transition-all group"
        >
          <div
            class="w-14 h-14 bg-purple-100 rounded-lg flex items-center justify-center mb-4 group-hover:bg-purple-200 transition-colors"
          >
            <svg
              class="w-8 h-8 text-purple-600"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
              ></path>
            </svg>
          </div>
          <h3
            class="text-xl font-semibold text-gray-900 mb-2 group-hover:text-purple-600 transition-colors"
          >
            {t("seax.home.features.voice.title")}
          </h3>
          <p class="text-gray-600">
            {t("seax.home.features.voice.description")}
          </p>
          <div
            class="mt-4 flex items-center text-purple-600 opacity-0 group-hover:opacity-100 transition-opacity"
          >
            <span class="text-sm font-medium">Learn more</span>
            <svg
              class="w-4 h-4 ml-2"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
            </svg>
          </div>
        </a>
      </div>
    </div>
  </div>

  <!-- Lead Generation Focus -->
  <div class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-4xl font-bold text-gray-900 mb-4">
          {t("seax.home.leadGeneration.title")}
        </h2>
        <p class="text-xl text-gray-600">
          {t("seax.home.leadGeneration.subtitle")}
        </p>
      </div>

      <div class="relative">
        <div class="grid md:grid-cols-4 gap-8">
          <!-- Step 1 -->
          <div class="relative">
            <div
              class="bg-gradient-to-br from-blue-50 to-indigo-100 rounded-xl p-6 text-center"
            >
              <div
                class="w-16 h-16 bg-blue-600 rounded-full flex items-center justify-center mx-auto mb-4"
              >
                <svg
                  class="w-8 h-8 text-white"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M7 20l4-16m2 16l4-16M6 9h14M4 15h14"></path>
                </svg>
              </div>
              <h3 class="text-xl font-semibold text-gray-900 mb-2">
                {t("seax.home.leadGeneration.capture.title")}
              </h3>
              <p class="text-gray-600">
                {t("seax.home.leadGeneration.capture.description")}
              </p>
            </div>
            <div
              class="hidden md:block absolute top-1/2 -right-4 transform -translate-y-1/2"
            >
              <svg
                class="w-8 h-8 text-blue-400"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 5l7 7-7 7"></path>
              </svg>
            </div>
          </div>

          <!-- Step 2 -->
          <div class="relative">
            <div
              class="bg-gradient-to-br from-blue-50 to-indigo-100 rounded-xl p-6 text-center"
            >
              <div
                class="w-16 h-16 bg-blue-600 rounded-full flex items-center justify-center mx-auto mb-4"
              >
                <svg
                  class="w-8 h-8 text-white"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"
                  ></path>
                </svg>
              </div>
              <h3 class="text-xl font-semibold text-gray-900 mb-2">
                {t("seax.home.leadGeneration.qualify.title")}
              </h3>
              <p class="text-gray-600">
                {t("seax.home.leadGeneration.qualify.description")}
              </p>
            </div>
            <div
              class="hidden md:block absolute top-1/2 -right-4 transform -translate-y-1/2"
            >
              <svg
                class="w-8 h-8 text-blue-400"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 5l7 7-7 7"></path>
              </svg>
            </div>
          </div>

          <!-- Step 3 -->
          <div class="relative">
            <div
              class="bg-gradient-to-br from-blue-50 to-indigo-100 rounded-xl p-6 text-center"
            >
              <div
                class="w-16 h-16 bg-blue-600 rounded-full flex items-center justify-center mx-auto mb-4"
              >
                <svg
                  class="w-8 h-8 text-white"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path>
                </svg>
              </div>
              <h3 class="text-xl font-semibold text-gray-900 mb-2">
                {t("seax.home.leadGeneration.nurture.title")}
              </h3>
              <p class="text-gray-600">
                {t("seax.home.leadGeneration.nurture.description")}
              </p>
            </div>
            <div
              class="hidden md:block absolute top-1/2 -right-4 transform -translate-y-1/2"
            >
