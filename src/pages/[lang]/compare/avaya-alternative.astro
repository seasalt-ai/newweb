---
import Layout from '../../../layouts/Layout.astro';
import { getTranslationHelpers, type SupportedLanguage, supportedLocales } from '../../../i18n/helpers';
import { getMeetingUrl } from "../../../constants/urls";
import { ArrowLeft, Check, X } from 'lucide-react';

// 為所有支持的語言生成靜態路徑
export async function getStaticPaths() {
  return supportedLocales.map((lang) => ({
    params: { lang }
  }));
}

// 取得動態語言參數
const { lang } = Astro.params;
const currentLang = (lang as SupportedLanguage) || 'en';

// 獲取翻譯幫助函數
const { t } = await getTranslationHelpers(currentLang);

// SEO 資料
const title = t('compare.avayaAlternative.seo.title') || 'Best Avaya Alternative - Seasalt.ai Modern Contact Center';
const description = t('compare.avayaAlternative.seo.description') || 'Discover why Seasalt.ai is the best Avaya alternative. Modern cloud-native architecture vs legacy on-premise systems.';
const keywords = 'Avaya alternative, cloud contact center, modern architecture, legacy system replacement';

// 比較功能資料
const comparisonFeatures = [
  {
    feature: t('compare.avayaAlternative.comparison.features.platformType.name'),
    seasalt: t('compare.avayaAlternative.comparison.features.platformType.seasalt'),
    competitor: t('compare.avayaAlternative.comparison.features.platformType.competitor'),
    seasaltAdvantage: true
  },
  {
    feature: t('compare.avayaAlternative.comparison.features.startingPrice.name'),
    seasalt: t('compare.avayaAlternative.comparison.features.startingPrice.seasalt'),
    competitor: t('compare.avayaAlternative.comparison.features.startingPrice.competitor'),
    seasaltAdvantage: true
  },
  {
    feature: t('compare.avayaAlternative.comparison.features.setupComplexity.name'),
    seasalt: t('compare.avayaAlternative.comparison.features.setupComplexity.seasalt'),
    competitor: t('compare.avayaAlternative.comparison.features.setupComplexity.competitor'),
    seasaltAdvantage: true
  },
  {
    feature: t('compare.avayaAlternative.comparison.features.modernArchitecture.name'),
    seasalt: t('compare.avayaAlternative.comparison.features.modernArchitecture.seasalt'),
    competitor: t('compare.avayaAlternative.comparison.features.modernArchitecture.competitor'),
    seasaltAdvantage: true
  },
  {
    feature: t('compare.avayaAlternative.comparison.features.aiIntegration.name'),
    seasalt: t('compare.avayaAlternative.comparison.features.aiIntegration.seasalt'),
    competitor: t('compare.avayaAlternative.comparison.features.aiIntegration.competitor'),
    seasaltAdvantage: true
  },
  {
    feature: t('compare.avayaAlternative.comparison.features.targetMarket.name'),
    seasalt: t('compare.avayaAlternative.comparison.features.targetMarket.seasalt'),
    competitor: t('compare.avayaAlternative.comparison.features.targetMarket.competitor'),
    seasaltAdvantage: false
  }
];

const meetingUrl = getMeetingUrl(currentLang);
---

<Layout 
  title={title} 
  description={description} 
  lang={currentLang}
  keywords={keywords}
  type="website"
>
  <!-- Hero Section -->
  <section class="bg-gradient-to-br from-indigo-50 via-white to-indigo-100 py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
<a href={`/${currentLang}/compare`} class="inline-flex items-center text-gray-600 hover:text-indigo-600 transition-colors duration-200 mb-8">
        <ArrowLeft className="h-5 w-5 mr-2" />
        {t('compare.avayaAlternative.navigation.backToCompare')}
      </a>
      
      <div class="text-center mb-16">
        <h1 class="text-4xl lg:text-6xl font-bold text-gray-900 mb-6">
          {t('compare.avayaAlternative.hero.title.main')}{' '}
          <span class="bg-gradient-to-r from-indigo-600 to-indigo-700 bg-clip-text text-transparent">
            {t('compare.avayaAlternative.hero.title.highlight')}
          </span>
        </h1>
        <p class="text-xl text-gray-600 max-w-4xl mx-auto">
          {t('compare.avayaAlternative.hero.description')}
        </p>
      </div>
    </div>
  </section>

  <!-- Detailed Comparison -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl lg:text-4xl font-bold text-gray-900 mb-4">
          {t('compare.avayaAlternative.comparison.title')}
        </h2>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
          {t('compare.avayaAlternative.comparison.subtitle')}
        </p>
      </div>

      <div class="bg-white rounded-2xl shadow-lg overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full">
            <thead class="bg-gray-50">
              <tr>
                <th class="px-6 py-4 text-left text-sm font-semibold text-gray-900">{t('compare.avayaAlternative.comparison.tableHeaders.feature')}</th>
                <th class="px-6 py-4 text-center text-sm font-semibold text-blue-600">{t('compare.avayaAlternative.comparison.tableHeaders.seasalt')}</th>
                <th class="px-6 py-4 text-center text-sm font-semibold text-gray-900">{t('compare.avayaAlternative.comparison.tableHeaders.avaya')}</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200">
              {comparisonFeatures.map((item, index) => (
                <tr key={index} class="hover:bg-gray-50">
                  <td class="px-6 py-4 text-sm font-medium text-gray-900">{item.feature}</td>
                  <td class="px-6 py-4 text-center">
                    <div class="flex items-center justify-center">
                      {item.seasaltAdvantage && <Check className="h-5 w-5 text-green-600 mr-2" />}
                      <span class="text-sm text-gray-700">{item.seasalt}</span>
                    </div>
                  </td>
                  <td class="px-6 py-4 text-center">
                    <div class="flex items-center justify-center">
                      {item.seasaltAdvantage && <X className="h-5 w-5 text-red-500 mr-2" />}
                      <span class="text-sm text-gray-700">{item.competitor}</span>
                    </div>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>

  <!-- Architecture Comparison -->
  <section class="py-20 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl lg:text-4xl font-bold text-gray-900 mb-4">
          {t('compare.avayaAlternative.architecture.title')}
        </h2>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
          {t('compare.avayaAlternative.architecture.subtitle')}
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-8">
        <div class="bg-white p-8 rounded-xl shadow-lg">
          <h3 class="text-2xl font-bold text-indigo-600 mb-6">{t('compare.avayaAlternative.architecture.seasalt.title')}</h3>
          <ul class="space-y-4">
            <li class="flex items-start">
              <Check className="h-5 w-5 text-green-600 mr-3 mt-0.5" />
              <span class="text-gray-700">{t('compare.avayaAlternative.architecture.seasalt.feature1')}</span>
            </li>
            <li class="flex items-start">
              <Check className="h-5 w-5 text-green-600 mr-3 mt-0.5" />
              <span class="text-gray-700">{t('compare.avayaAlternative.architecture.seasalt.feature2')}</span>
            </li>
            <li class="flex items-start">
              <Check className="h-5 w-5 text-green-600 mr-3 mt-0.5" />
              <span class="text-gray-700">{t('compare.avayaAlternative.architecture.seasalt.feature3')}</span>
            </li>
            <li class="flex items-start">
              <Check className="h-5 w-5 text-green-600 mr-3 mt-0.5" />
              <span class="text-gray-700">{t('compare.avayaAlternative.architecture.seasalt.feature4')}</span>
            </li>
            <li class="flex items-start">
              <Check className="h-5 w-5 text-green-600 mr-3 mt-0.5" />
              <span class="text-gray-700">{t('compare.avayaAlternative.architecture.seasalt.feature5')}</span>
            </li>
          </ul>
        </div>

        <div class="bg-white p-8 rounded-xl shadow-lg">
          <h3 class="text-2xl font-bold text-gray-600 mb-6">{t('compare.avayaAlternative.architecture.avaya.title')}</h3>
          <ul class="space-y-4">
            <li class="flex items-start">
              <X className="h-5 w-5 text-red-500 mr-3 mt-0.5" />
              <span class="text-gray-700">{t('compare.avayaAlternative.architecture.avaya.feature1')}</span>
            </li>
            <li class="flex items-start">
              <X className="h-5 w-5 text-red-500 mr-3 mt-0.5" />
              <span class="text-gray-700">{t('compare.avayaAlternative.architecture.avaya.feature2')}</span>
            </li>
            <li class="flex items-start">
              <X className="h-5 w-5 text-red-500 mr-3 mt-0.5" />
              <span class="text-gray-700">{t('compare.avayaAlternative.architecture.avaya.feature3')}</span>
            </li>
            <li class="flex items-start">
              <X className="h-5 w-5 text-red-500 mr-3 mt-0.5" />
              <span class="text-gray-700">{t('compare.avayaAlternative.architecture.avaya.feature4')}</span>
            </li>
            <li class="flex items-start">
              <X className="h-5 w-5 text-red-500 mr-3 mt-0.5" />
              <span class="text-gray-700">{t('compare.avayaAlternative.architecture.avaya.feature5')}</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Business Impact -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl lg:text-4xl font-bold text-gray-900 mb-4">
          {t('compare.avayaAlternative.businessImpact.title')}
        </h2>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
          {t('compare.avayaAlternative.businessImpact.subtitle')}
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        <div class="bg-green-50 p-6 rounded-xl text-center">
          <h3 class="text-xl font-bold text-green-800 mb-4">{t('compare.avayaAlternative.businessImpact.timeToValue.title')}</h3>
          <div class="space-y-3">
            <div class="bg-white p-3 rounded-lg">
              <div class="text-2xl font-bold text-green-600">{t('compare.avayaAlternative.businessImpact.timeToValue.seasalt.value')}</div>
              <div class="text-sm text-green-700">{t('compare.avayaAlternative.businessImpact.timeToValue.seasalt.label')}</div>
            </div>
            <div class="bg-red-50 p-3 rounded-lg">
              <div class="text-2xl font-bold text-red-600">{t('compare.avayaAlternative.businessImpact.timeToValue.avaya.value')}</div>
              <div class="text-sm text-red-700">{t('compare.avayaAlternative.businessImpact.timeToValue.avaya.label')}</div>
            </div>
          </div>
        </div>

        <div class="bg-blue-50 p-6 rounded-xl text-center">
          <h3 class="text-xl font-bold text-blue-800 mb-4">{t('compare.avayaAlternative.businessImpact.setupComplexity.title')}</h3>
          <div class="space-y-3">
            <div class="bg-white p-3 rounded-lg">
              <div class="text-2xl font-bold text-blue-600">{t('compare.avayaAlternative.businessImpact.setupComplexity.seasalt.value')}</div>
              <div class="text-sm text-blue-700">{t('compare.avayaAlternative.businessImpact.setupComplexity.seasalt.label')}</div>
            </div>
            <div class="bg-red-50 p-3 rounded-lg">
              <div class="text-2xl font-bold text-red-600">{t('compare.avayaAlternative.businessImpact.setupComplexity.avaya.value')}</div>
              <div class="text-sm text-red-700">{t('compare.avayaAlternative.businessImpact.setupComplexity.avaya.label')}</div>
            </div>
          </div>
        </div>

        <div class="bg-purple-50 p-6 rounded-xl text-center">
          <h3 class="text-xl font-bold text-purple-800 mb-4">{t('compare.avayaAlternative.businessImpact.ongoingMaintenance.title')}</h3>
          <div class="space-y-3">
            <div class="bg-white p-3 rounded-lg">
              <div class="text-2xl font-bold text-purple-600">{t('compare.avayaAlternative.businessImpact.ongoingMaintenance.seasalt.value')}</div>
              <div class="text-sm text-purple-700">{t('compare.avayaAlternative.businessImpact.ongoingMaintenance.seasalt.label')}</div>
            </div>
            <div class="bg-red-50 p-3 rounded-lg">
              <div class="text-2xl font-bold text-red-600">{t('compare.avayaAlternative.businessImpact.ongoingMaintenance.avaya.value')}</div>
              <div class="text-sm text-red-700">{t('compare.avayaAlternative.businessImpact.ongoingMaintenance.avaya.label')}</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-20 bg-gradient-to-r from-indigo-600 to-indigo-700">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl lg:text-4xl font-bold text-white mb-6">
        {t('compare.avayaAlternative.cta.title')}
      </h2>
      <p class="text-xl text-white opacity-90 mb-8 max-w-2xl mx-auto">
        {t('compare.avayaAlternative.cta.subtitle')}
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="https://seax.seasalt.ai/signup"
          class="bg-white text-indigo-600 hover:bg-gray-50 px-8 py-4 rounded-lg text-lg font-semibold transition-all duration-200"
        >
          {t('compare.avayaAlternative.cta.signUp')}
        </a>
        <a
          href={meetingUrl}
          class="border-2 border-white text-white hover:bg-white hover:text-indigo-600 px-8 py-4 rounded-lg text-lg font-semibold transition-all duration-200"
        >
          {t('compare.avayaAlternative.cta.bookDemo')}
        </a>
      </div>
    </div>
  </section>
</Layout>
