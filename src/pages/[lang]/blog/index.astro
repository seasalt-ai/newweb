---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import { getTranslationHelpers, type SupportedLanguage } from '../../../i18n/helpers';

// 生成所有支持的語言路徑
export async function getStaticPaths() {
  const supportedLocales = [
    'en', 'es', 'zh-tw', 'zh-cn', 'ja', 'ko', 'fr', 'de', 'ar', 'fa',
    'fil', 'hi', 'id', 'ms', 'pl', 'pt', 'ru', 'ta', 'th', 'vi', 'ro'
  ];
  
  return supportedLocales.map((lang) => ({
    params: { lang }
  }));
}

const { lang } = Astro.params;
const currentLang = (lang as SupportedLanguage) || 'en';
const { t, translations } = await getTranslationHelpers(currentLang);


// 獲取當前語言的 blog 文章
const allBlogPosts = await getCollection('blog', ({ data, id }) => {
  // 從文件路徑中提取語言 (blog/en/post-name.md -> en)
  const postLang = id.split('/')[0];
  return data.draft !== true && postLang === currentLang;
});

// 按發布日期排序（最新的在前）
const sortedPosts = allBlogPosts.sort((a, b) => 
  new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime()
);

// 收集所有標籤
const allTags = Array.from(new Set(
  sortedPosts.flatMap(post => post.data.tags || [])
)).sort();

// 生成結構化資料
const structuredData = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "itemListElement": sortedPosts.slice(0, 10).map((post, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "item": {
      "@type": "BlogPosting",
      "headline": post.data.title,
      "description": post.data.description,
      "image": post.data.image?.url,
      "datePublished": post.data.publishDate.toISOString(),
      "author": {
        "@type": "Person",
        "name": post.data.author || "Seasalt.ai"
      },
      "url": `/${currentLang}/blog/${post.slug.split('/')[1]}`
    }
  }))
};

const title = t('blog.seo.title') || `Blog - SeaSalt.ai`;
const description = t('blog.seo.description') || t('blog.hero.description') || 'Latest articles and insights from SeaSalt.ai';
---

<Layout 
  title={title} 
  description={description} 
  lang={currentLang}
  type="website"
>
  <!-- SEO 結構化資料 -->
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  
  <div class="min-h-screen bg-white">
    <main>
      <!-- Hero Section -->
      <section class="bg-gradient-to-br from-blue-50 via-white to-indigo-50 py-20">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="text-center mb-16 flex flex-col">
            <a 
              href={`/${currentLang}`} 
              class="inline-flex items-center text-gray-600 hover:text-blue-600 transition-colors duration-200 mb-6 sm:mb-8"
            >
              <svg class="h-5 w-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
              </svg>
              {t('blog.nav.backToHome') || 'Back to Home'}
            </a>
            <h1 class="text-3xl sm:text-4xl lg:text-6xl font-bold text-gray-900 mb-4 sm:mb-6">
              {t('blog.hero.title') || 'Seasalt.ai'}{' '}
              <span>
                {t('blog.hero.highlight') || 'Blog'}
              </span>
            </h1>
            <p class="text-lg sm:text-xl text-gray-600 max-w-3xl mx-auto">
              {t('blog.hero.description') || 'Insights, tips, and updates on AI-powered customer communications, business automation, and the future of customer experience.'}
            </p>
          </div>

          <!-- 搜尋和篩選 -->
          <div class="max-w-4xl mx-auto mb-8 sm:mb-12">
            <div class="flex flex-col md:flex-row gap-3 sm:gap-4">
              <div class="flex-1 relative">
                <svg class="absolute left-3 top-1/2 transform -translate-y-1/2 h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                </svg>
                <input
                  type="text"
                  id="search-input"
                  placeholder={t('blog.search.placeholder') || 'Search blog posts...'}
                  class="w-full pl-10 pr-4 py-2.5 sm:py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent text-sm sm:text-base"
                />
              </div>
              <div class="md:w-64">
                <select
                  id="tag-filter"
                  class="w-full px-4 py-2.5 sm:py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent text-sm sm:text-base"
                >
                  <option value="">{t('blog.filter.allCategories') || 'All Categories'}</option>
                  {allTags.map(tag => (
                    <option value={tag}>{tag}</option>
                  ))}
                </select>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Blog Posts Grid -->
      <section class="py-20 bg-white">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div id="posts-container">
            {sortedPosts.length === 0 ? (
              <div class="text-center py-8 sm:py-12">
                <p class="text-lg sm:text-xl text-gray-600">
                  {t('blog.empty.noPosts') || 'No blog posts found.'}
                </p>
              </div>
            ) : (
              <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8" id="posts-grid">
                {sortedPosts.map((post) => {
                  const publishDate = new Date(post.data.publishDate).toLocaleDateString(
                    currentLang === 'zh-tw' ? 'zh-TW' : currentLang === 'zh-cn' ? 'zh-CN' : currentLang, 
                    {
                      year: 'numeric',
                      month: 'long',
                      day: 'numeric'
                    }
                  );
                  
                  const updatedDate = post.data.updatedDate ? new Date(post.data.updatedDate).toLocaleDateString(
                    currentLang === 'zh-tw' ? 'zh-TW' : currentLang === 'zh-cn' ? 'zh-CN' : currentLang
                  ) : null;

                  return (
                    <article 
                      class="bg-white rounded-2xl shadow-lg hover:shadow-xl transition-all duration-300 overflow-hidden group post-item" 
                      data-title={post.data.title.toLowerCase()}
                      data-description={post.data.description?.toLowerCase() || ''}
                      data-tags={post.data.tags?.join(' ').toLowerCase() || ''}
                    >
                      <div class="bg-gray-200">
                        {post.data.image ? (
                          <img
                            src={post.data.image.url}
                            alt={post.data.image.alt}
                            class="w-full h-40 sm:h-48 object-cover group-hover:scale-105 transition-transform duration-300"
                            onerror="this.src='/seasalt-ai-icon.png'"
                          />
                        ) : (
                          <div class="w-full h-40 sm:h-48 bg-gradient-to-br from-blue-100 to-indigo-100 flex items-center justify-center">
                            <svg class="w-12 h-12 text-blue-400" fill="currentColor" viewBox="0 0 20 20">
                              <path d="M4 3a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V5a2 2 0 00-2-2H4zm12 12H4l4-8 3 6 2-4 3 6z"></path>
                            </svg>
                          </div>
                        )}
                      </div>
                      
                      <div class="p-4 sm:p-6">
                        <div class="flex flex-wrap items-center text-xs sm:text-sm text-gray-500 mb-2 sm:mb-3 gap-2 sm:gap-0">
                          <svg class="h-3 w-3 sm:h-4 sm:w-4 mr-1" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd"></path>
                          </svg>
                          <span class="mr-2 sm:mr-4">
                            {publishDate}
                            {updatedDate && updatedDate !== publishDate && (
                              <span class="text-xs text-gray-400 ml-1">
                                ({t('blog.post.updated') || 'Updated'}: {updatedDate})
                              </span>
                            )}
                          </span>
                          {post.data.author && (
                            <>
                              <svg class="h-3 w-3 sm:h-4 sm:w-4 mr-1" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd"></path>
                              </svg>
                              <span>{post.data.author}</span>
                            </>
                          )}
                        </div>
                        
                        <h2 class="text-lg sm:text-xl font-bold text-gray-900 mb-2 sm:mb-3 group-hover:text-blue-600 transition-colors duration-200">
                          <a href={`/${currentLang}/blog/${post.slug.split('/')[1]}`}>
                            {post.data.title}
                          </a>
                        </h2>
                        
                        <p class="text-sm sm:text-base text-gray-600 mb-3 sm:mb-4 line-clamp-3">
                          {post.data.description}
                        </p>
                        
                        {post.data.tags && post.data.tags.length > 0 && (
                          <div class="flex flex-wrap gap-1.5 sm:gap-2 mb-3 sm:mb-4">
                            {post.data.tags.slice(0, 3).map((tag) => (
                              <span
                                class="inline-flex items-center px-1.5 sm:px-2 py-0.5 sm:py-1 bg-blue-100 text-blue-800 text-xs font-medium rounded-full cursor-pointer hover:bg-blue-200 transition-colors duration-200 tag-filter-btn"
                                data-tag={tag}
                              >
                                <svg class="h-2.5 w-2.5 sm:h-3 sm:w-3 mr-1" fill="currentColor" viewBox="0 0 20 20">
                                  <path fill-rule="evenodd" d="M17.707 9.293a1 1 0 010 1.414l-7 7a1 1 0 01-1.414 0l-7-7A.997.997 0 012 10V5a3 3 0 013-3h5c.256 0 .512.098.707.293l7 7zM5 6a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd"></path>
                                </svg>
                                {tag}
                              </span>
                            ))}
                            {post.data.tags.length > 3 && (
                              <span class="inline-flex items-center px-1.5 sm:px-2 py-0.5 sm:py-1 bg-gray-100 text-gray-600 text-xs font-medium rounded-full">
                                +{post.data.tags.length - 3}
                              </span>
                            )}
                          </div>
                        )}
                        
                        <a
                          href={`/${currentLang}/blog/${post.slug.split('/')[1]}`}
                          class="inline-flex items-center text-blue-600 hover:text-blue-700 font-medium"
                        >
                          {t('blog.post.readMore') || 'Read More →'}
                        </a>
                      </div>
                    </article>
                  );
                })}
              </div>
            )}
          </div>
          
          <!-- 無搜尋結果提示 -->
          <div id="no-results" class="text-center py-8 sm:py-12 hidden">
            <p class="text-lg sm:text-xl text-gray-600">
              {t('blog.empty.noResults') || 'No posts match your search criteria.'}
            </p>
            <button
              id="clear-filters"
              class="mt-4 text-blue-600 hover:text-blue-700 font-medium"
            >
              {t('blog.empty.clearFilters') || t('blog.clearFilters') || 'Clear filters'}
            </button>
          </div>
        </div>
      </section>

      <!-- Newsletter CTA -->
      <section class="py-16 sm:py-20 bg-gradient-to-r from-blue-600 to-indigo-600">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center overflow-hidden">
          <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-white mb-4 sm:mb-6">
            {t('blog.newsletter.title') || 'Stay Updated with Our Latest Insights'}
          </h2>
          <p class="text-lg sm:text-xl text-white opacity-90 mb-6 sm:mb-8 max-w-2xl mx-auto">
            {t('blog.newsletter.description') || 'Get the latest articles on AI automation, customer experience, and business growth delivered straight to your inbox.'}
          </p>
          <div class="flex flex-col sm:flex-row gap-3 sm:gap-4 justify-center max-w-md mx-auto">
            <input
              type="email"
              id="newsletter-email"
              placeholder={t('blog.newsletter.emailPlaceholder') || 'Enter your email'}
              class="bg-white flex-1 px-4 py-2.5 sm:py-3 rounded-lg border-0 focus:ring-2 focus:ring-white focus:ring-opacity-50 text-sm sm:text-base"
            />
            <button 
              id="newsletter-subscribe"
              class="bg-white text-blue-600 hover:bg-gray-50 px-5 sm:px-6 py-2.5 sm:py-3 rounded-lg font-semibold transition-all duration-200 text-sm sm:text-base"
            >
              {t('blog.newsletter.subscribeButton') || 'Subscribe'}
            </button>
          </div>
        </div>
      </section>
    </main>
  </div>
</Layout>


<script>
  document.addEventListener('DOMContentLoaded', function() {
    const searchInput = document.getElementById('search-input');
    const tagFilter = document.getElementById('tag-filter');
    const postsGrid = document.getElementById('posts-grid');
    const noResults = document.getElementById('no-results');
    const clearFiltersBtn = document.getElementById('clear-filters');
    const newsletterEmail = document.getElementById('newsletter-email');
    const newsletterSubscribe = document.getElementById('newsletter-subscribe');
    
    let currentSearchTerm = '';
    let currentTag = '';
    
    function filterPosts() {
      const posts = document.querySelectorAll('.post-item');
      let visibleCount = 0;
      
      posts.forEach(post => {
        const title = post.dataset.title || '';
        const description = post.dataset.description || '';
        const tags = post.dataset.tags || '';
        
        const matchesSearch = !currentSearchTerm || 
          title.includes(currentSearchTerm.toLowerCase()) ||
          description.includes(currentSearchTerm.toLowerCase()) ||
          tags.includes(currentSearchTerm.toLowerCase());
          
        const matchesTag = !currentTag || tags.includes(currentTag.toLowerCase());
        
        if (matchesSearch && matchesTag) {
          post.classList.remove('hidden');
          visibleCount++;
        } else {
          post.classList.add('hidden');
        }
      });
      
      // 顯示/隱藏無結果訊息
      if (visibleCount === 0 && (currentSearchTerm || currentTag)) {
        postsGrid.classList.add('hidden');
        noResults.classList.remove('hidden');
      } else {
        postsGrid.classList.remove('hidden');
        noResults.classList.add('hidden');
      }
    }
    
    // 搜尋功能
    if (searchInput) {
      searchInput.addEventListener('input', function(e) {
        currentSearchTerm = e.target.value;
        filterPosts();
      });
    }
    
    // 標籤篩選
    if (tagFilter) {
      tagFilter.addEventListener('change', function(e) {
        currentTag = e.target.value;
        filterPosts();
      });
    }
    
    // 點擊標籤按鈕篩選
    document.addEventListener('click', function(e) {
      if (e.target.classList.contains('tag-filter-btn') || e.target.parentElement.classList.contains('tag-filter-btn')) {
        e.preventDefault();
        const tagBtn = e.target.classList.contains('tag-filter-btn') ? e.target : e.target.parentElement;
        const tag = tagBtn.dataset.tag;
        if (tag && tagFilter) {
          tagFilter.value = tag;
          currentTag = tag;
          filterPosts();
        }
      }
    });
    
    // 清除篩選
    if (clearFiltersBtn) {
      clearFiltersBtn.addEventListener('click', function() {
        currentSearchTerm = '';
        currentTag = '';
        if (searchInput) searchInput.value = '';
        if (tagFilter) tagFilter.value = '';
        filterPosts();
      });
    }
    
    // Newsletter 訂閱
    if (newsletterSubscribe && newsletterEmail) {
      newsletterSubscribe.addEventListener('click', function(e) {
        e.preventDefault();
        const email = newsletterEmail.value.trim();
        
        if (!email) {
          alert('請輸入電子郵件地址');
          return;
        }
        
        if (!isValidEmail(email)) {
          alert('請輸入有效的電子郵件地址');
          return;
        }
        
        // 這裡可以添加實際的訂閱邏輯
        alert('感謝訂閱！我們會將最新文章直接送到您的收件匣。');
        newsletterEmail.value = '';
      });
    }
    
    function isValidEmail(email) {
      const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      return emailRegex.test(email);
    }
  });
</script>
