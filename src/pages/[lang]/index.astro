---
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import ProblemSolution from '../../components/ProblemSolution.astro';
import Features from '../../components/Features.astro';
import HowItWorks from '../../components/HowItWorks.astro';
import UseCases from '../../components/UseCases.astro';
import Industries from '../../components/Industries.astro';
import Channels from '../../components/Channels.astro';
import Comparison from '../../components/Comparison.astro';
import { getTranslationHelpers, type SupportedLanguage } from '../../i18n/helpers';

// 為所有支持的語言生成靜態路徑
export async function getStaticPaths() {
  const supportedLocales = [
    'en', 'es', 'zh-tw', 'zh-cn', 'ja', 'ko', 'fr', 'de', 'ar', 'fa',
    'fil', 'hi', 'id', 'ms', 'pl', 'pt', 'ru', 'ta', 'th', 'vi'
  ];
  
  return supportedLocales.map((lang) => ({
    params: { lang }
  }));
}

// 取得動態語言參數
const { lang } = Astro.params;
const currentLang = (lang as SupportedLanguage) || 'en';

// 獲取翻譯幫助函數
const { t } = await getTranslationHelpers(currentLang);

// 使用翻譯的標題和描述
const title = t('seo.homepage.title') || 'SeaSalt.ai - AI-Powered Contact Center Solutions';
const description = t('seo.homepage.description') || 'Transform your customer communications with SeaSalt.ai\'s AI-powered omnichannel platform. Unify WhatsApp, SMS, voice calls, and chat in one intelligent solution.';
const keywords = t('seo.homepage.keywords') || 'omni-channel contact center, small business communication, unified inbox, customer service software, WhatsApp business, voice calls, chat support';

// 首頁的 FAQ 結構化資料
const homepageFaqs = [
  {
    question: "What is Seasalt.ai?",
    answer: "Seasalt.ai is an AI-powered omnichannel customer communication platform that helps businesses automate customer service across multiple channels including WhatsApp, SMS, voice calls, and web chat."
  },
  {
    question: "What products does Seasalt.ai offer?",
    answer: "Seasalt.ai offers three main products: SeaChat for AI chatbots and customer service automation, SeaX for omnichannel communication campaigns, and SeaVoice for AI voice agents and call automation."
  },
  {
    question: "How does Seasalt.ai help businesses?",
    answer: "Seasalt.ai helps businesses reduce customer service costs, improve response times, automate repetitive tasks, and provide 24/7 customer support across multiple communication channels using advanced AI technology."
  }
];

// 首頁的麵包屑導航
const homepageBreadcrumbs = [
  {
    name: "Home",
    url: currentLang === 'en' ? "/" : `/${currentLang}/`
  }
];

// 完整的 Organization 資訊
const enhancedOrganization = {
  name: "Seasalt.ai",
  alternateName: "Seasalt AI",
  url: "https://seasalt.ai",
  logo: "https://seasalt.ai/seasalt-ai-logo.png",
  sameAs: [
    "https://www.linkedin.com/company/seasalt-ai/",
    "https://twitter.com/SeasaltAI",
    "https://www.youtube.com/@seasaltai",
    "https://discord.gg/VgAWg3c7rU"
  ],
  contactPoint: {
    telephone: "+1-SMB-AI-AGENT",
    contactType: "customer service",
    availableLanguage: [
      "Arabic", "German", "English", "Spanish", "Persian", "Filipino", 
      "French", "Hindi", "Indonesian", "Japanese", "Korean", "Malay", 
      "Polish", "Portuguese", "Russian", "Tamil", "Thai", "Vietnamese", 
      "Chinese (Simplified)", "Chinese (Traditional)"
    ]
  },
  address: {
    streetAddress: "Downtown",
    addressLocality: "Bellevue",
    addressRegion: "WA",
    postalCode: "98004",
    addressCountry: "US"
  }
};

// 自訂 JSON-LD 結構化資料
const customJsonLd = [
  // SeaChat Service 結構化資料 (符合您原本提供的格式)
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "SeaChat",
    "description": "SeaChat: AI-powered chat automation and agent-assist platform by Seasalt AI, enabling multilingual, live-agent-transfer, webchat, SMS, WhatsApp, and CRM integrations for 24/7 conversational support.",
    "url": "https://chat.seasalt.ai/",
    "provider": {
      "@type": "Organization",
      "name": "Seasalt AI",
      "url": "https://seasalt.ai/"
    },
    "applicationCategory": "ChatBot",
    "isAccessibleForFree": "True",
    "keywords": "AI chatbot, live agent transfer, multilingual, webchat, SMS, WhatsApp, CRM integration",
    "featureList": [
      "No-code setup in 10 minutes",
      "Live agent transfer",
      "Multilingual support",
      "Integrates with webchat, SMS, Line, WhatsApp, CRM, Shopify, calendars, Twilio"
    ],
    "availableOnDevice": "Web",
    "audience": {
      "@type": "Audience",
      "audienceType": "Businesses, Educational Institutions, Customer Support Teams"
    }
  }
];
---

<Layout 
  title={title} 
  description={description} 
  lang={currentLang}
  keywords={keywords}
  type="website"
  headerVersion="default"
  footerVersion="default"
  faqs={homepageFaqs}
  breadcrumbs={homepageBreadcrumbs}
  organization={enhancedOrganization}
  customJsonLd={customJsonLd}
>
	<Hero lang={currentLang} />
	<ProblemSolution lang={currentLang} />
	<Features lang={currentLang} />
	<HowItWorks lang={currentLang} />
	<UseCases lang={currentLang} />
	<Industries lang={currentLang} />
	<Channels lang={currentLang} />
	<Comparison lang={currentLang} />
</Layout>
