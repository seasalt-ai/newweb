                <td class="px-4 sm:px-6 py-3 sm:py-4 text-center text-xs sm:text-sm text-gray-700">
                  <div class="break-words hyphens-auto">{t('pricing.comparison.respondIo.aiCapabilities')}</div>
                </td>
                <td class="px-4 sm:px-6 py-3 sm:py-4 text-center text-xs sm:text-sm text-gray-700">
                  <div class="break-words hyphens-auto leading-tight">{t('pricing.comparison.respondIo.bestFor')}</div>
                </td>
              </tr>
              
              <!-- Intercom -->
              <tr class="hover:bg-gray-50">
                <td class="px-4 sm:px-6 py-3 sm:py-4">
                  <div class="flex items-center flex-wrap gap-2">
                    <div class="flex-shrink-0">
                      <a 
                        href={`/${currentLang}/compare/intercom-alternative`}
                        class="text-xs sm:text-sm font-semibold hover:underline break-words hyphens-auto text-blue-600 hover:text-blue-800"
                      >
                        {t('pricing.comparison.intercom.name')}
                      </a>
                    </div>
                  </div>
                </td>
                <td class="px-4 sm:px-6 py-3 sm:py-4 text-center text-xs sm:text-sm text-gray-700">
                  <div class="break-words hyphens-auto">{t('pricing.comparison.intercom.startingPrice')}</div>
                </td>
                <td class="px-4 sm:px-6 py-3 sm:py-4 text-center text-xs sm:text-sm text-gray-700">
                  <div class="break-words hyphens-auto">{t('pricing.comparison.intercom.pricingModel')}</div>
                </td>
                <td class="px-4 sm:px-6 py-3 sm:py-4 text-center text-xs sm:text-sm text-gray-700">
                  <div class="break-words hyphens-auto">{t('pricing.comparison.intercom.unifiedVoiceDigital')}</div>
                </td>
                <td class="px-4 sm:px-6 py-3 sm:py-4 text-center text-xs sm:text-sm text-gray-700">
                  <div class="break-words hyphens-auto">{t('pricing.comparison.intercom.aiCapabilities')}</div>
                </td>
                <td class="px-4 sm:px-6 py-3 sm:py-4 text-center text-xs sm:text-sm text-gray-700">
                  <div class="break-words hyphens-auto leading-tight">{t('pricing.comparison.intercom.bestFor')}</div>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- FAQ Section with React Component for Interactivity -->
    <div class="mb-16 sm:mb-20">
      <h3 class="text-xl sm:text-2xl font-bold text-gray-900 text-center mb-8 sm:mb-12">
        {t('pricing.faq.title')}
      </h3>
      <!-- React 組件處理 FAQ 互動 -->
      <PricingFAQ lang={currentLang} client:load translations={translations} />
    </div>

    <!-- Dramatic Final CTA Section -->
    <section class="relative py-20 bg-gradient-to-br from-blue-600 via-purple-700 to-indigo-800 overflow-hidden">
      <!-- Animated Background Elements -->
      <div class="absolute inset-0">
        <div class="absolute top-10 left-10 w-32 h-32 bg-white/10 rounded-full animate-pulse"></div>
        <div class="absolute bottom-10 right-10 w-24 h-24 bg-white/10 rounded-full animate-bounce delay-1000"></div>
        <div class="absolute top-1/2 left-1/4 w-16 h-16 bg-white/10 rounded-full animate-pulse delay-500"></div>
      </div>
      
      <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <!-- Main Heading -->
        <div class="mb-8">
          <h2 class="text-4xl sm:text-5xl lg:text-6xl font-black text-white mb-4 leading-tight">
            {t('pricing.cta.title')}
            <span class="block bg-gradient-to-r from-yellow-300 to-orange-400 bg-clip-text text-transparent">
              {t('pricing.cta.titleGradient')}
            </span>
          </h2>
          <p class="text-xl sm:text-2xl text-blue-100 max-w-3xl mx-auto leading-relaxed">
            {t('pricing.cta.description')}
          </p>
        </div>
        
        <!-- Stats Row -->
        <div class="grid grid-cols-3 gap-8 mb-12 max-w-2xl mx-auto">
          <div class="text-center">
            <div class="text-3xl sm:text-4xl font-black text-white mb-2">{t('pricing.cta.stats.customers')}</div>
            <div class="text-sm text-blue-200">{t('pricing.cta.stats.customersLabel')}</div>
          </div>
          <div class="text-center">
            <div class="text-3xl sm:text-4xl font-black text-white mb-2">{t('pricing.cta.stats.uptime')}</div>
            <div class="text-sm text-blue-200">{t('pricing.cta.stats.uptimeLabel')}</div>
          </div>
          <div class="text-center">
            <div class="text-3xl sm:text-4xl font-black text-white mb-2">{t('pricing.cta.stats.support')}</div>
            <div class="text-sm text-blue-200">{t('pricing.cta.stats.supportLabel')}</div>
          </div>
        </div>
        
        <!-- CTA Buttons -->
        <div class="flex flex-col sm:flex-row gap-4 justify-center items-center mb-8">
          <a
            href="https://seax.seasalt.ai/signup"
            class="group relative inline-flex items-center justify-center px-8 py-4 text-xl font-black text-blue-900 bg-gradient-to-r from-yellow-300 via-orange-400 to-yellow-300 rounded-2xl shadow-2xl hover:shadow-yellow-300/50 transform hover:scale-110 transition-all duration-300 animate-pulse hover:animate-none"
          >
            <span class="relative z-10 flex items-center">
              {t('pricing.cta.primary')}
              <Star className="w-6 h-6 ml-2 animate-spin" />
            </span>
            <div class="absolute inset-0 bg-gradient-to-r from-yellow-400 to-orange-500 rounded-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
          </a>
          
          <a
            href={meetingUrl}
            class="inline-flex items-center px-6 py-3 text-lg font-semibold text-white border-2 border-white rounded-xl hover:bg-white hover:text-blue-900 transition-all duration-300 transform hover:scale-105"
          >
            {t('pricing.cta.secondary')}
          </a>
        </div>
        
        <!-- Trust Badges -->
        <div class="flex flex-wrap justify-center items-center gap-6 text-blue-200 text-sm">
          <div class="flex items-center gap-2">
            <Check className="w-5 h-5 text-green-400" />
            <span>{t('pricing.cta.trustBadge1')}</span>
          </div>
          <div class="flex items-center gap-2">
            <Check className="w-5 h-5 text-green-400" />
            <span>{t('pricing.cta.trustBadge2')}</span>
          </div>
          <div class="flex items-center gap-2">
            <Check className="w-5 h-5 text-green-400" />
            <span>{t('pricing.cta.trustBadge3')}</span>
          </div>
          <div class="flex items-center gap-2">
            <Check className="w-5 h-5 text-green-400" />
            <span>{t('pricing.cta.trustBadge4')}</span>
          </div>
        </div>
        
        <!-- Urgency Message -->
        <div class="mt-8 p-4 bg-white/10 backdrop-blur rounded-xl border border-white/20">
          <p class="text-white font-semibold">
            {t('pricing.cta.urgency')}
          </p>
        </div>
      </div>
    </section>
  </div>
</Layout>
