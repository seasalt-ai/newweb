---
import Layout from '../../../layouts/Layout.astro';
import { getTranslationHelpers, type SupportedLanguage } from '../../../i18n/helpers';
import { getMeetingUrl } from "../../../constants/urls";
import { ArrowLeft, Check, Star, Users, Zap, BarChart3, Clock, Shield, Briefcase } from 'lucide-react';

// 為所有支持的語言生成靜態路徑
export async function getStaticPaths() {
  const supportedLocales = [
    'en', 'es', 'zh-tw', 'zh-cn', 'ja', 'ko', 'fr', 'de', 'ar', 'fa',
    'fil', 'hi', 'id', 'ms', 'pl', 'pt', 'ru', 'ta', 'th', 'vi'
  ];
  
  return supportedLocales.map((lang) => ({
    params: { lang }
  }));
}

// Get language and i18n functions
const { lang } = Astro.params;
const currentLang = (lang as SupportedLanguage) || 'en';
const { t } = await getTranslationHelpers(currentLang);

// SEO data
const seoTitle = t('solutions.smeOwners.seo.title') || 'SME Solutions - Seasalt.ai';
const seoDescription = t('solutions.smeOwners.seo.description') || 'AI-powered solutions designed for small and medium enterprises.';
const seoKeywords = 'SME solutions, small business automation, AI for SMEs, business growth, productivity tools, small business CRM';
const canonicalUrl = currentLang === 'en' ? 'https://seasalt.ai/solutions/sme-owners' : `https://seasalt.ai/${currentLang}/solutions/sme-owners`;

// 麵包屑導航
const breadcrumbs = [
  { name: 'Home', url: `/${currentLang}/` },
  { name: 'Solutions', url: `/${currentLang}/solutions/` },
  { name: 'SME Owners' }
];

// Page data
const challenges = [
  {
    icon: 'Users',
    title: t('solutions.smeOwners.challenges.wearingMultipleHats.title'),
    description: t('solutions.smeOwners.challenges.wearingMultipleHats.description'),
    color: 'text-blue-600',
    bgColor: 'bg-blue-50'
  },
  {
    icon: 'Clock',
    title: t('solutions.smeOwners.challenges.limitedTimeResources.title'),
    description: t('solutions.smeOwners.challenges.limitedTimeResources.description'),
    color: 'text-orange-600',
    bgColor: 'bg-orange-50'
  },
  {
    icon: 'BarChart3',
    title: t('solutions.smeOwners.challenges.scalingChallenges.title'),
    description: t('solutions.smeOwners.challenges.scalingChallenges.description'),
    color: 'text-purple-600',
    bgColor: 'bg-purple-50'
  }
];

const solutions = [
  {
    icon: 'Zap',
    title: t('solutions.smeOwners.solutions.aiAutomation.title'),
    description: t('solutions.smeOwners.solutions.aiAutomation.description'),
    benefits: [
      t('solutions.smeOwners.solutions.aiAutomation.benefits.routineQuestions'),
      t('solutions.smeOwners.solutions.aiAutomation.benefits.bookAppointments'),
      t('solutions.smeOwners.solutions.aiAutomation.benefits.qualifyLeads'),
      t('solutions.smeOwners.solutions.aiAutomation.benefits.instantResponses')
    ],
    color: 'text-green-600',
    bgColor: 'bg-green-50',
    borderColor: 'border-green-200'
  },
  {
    icon: 'Users',
    title: t('solutions.smeOwners.solutions.unifiedView.title'),
    description: t('solutions.smeOwners.solutions.unifiedView.description'),
    benefits: [
      t('solutions.smeOwners.solutions.unifiedView.benefits.singleInbox'),
      t('solutions.smeOwners.solutions.unifiedView.benefits.conversationHistory'),
      t('solutions.smeOwners.solutions.unifiedView.benefits.neverLoseTrack'),
      t('solutions.smeOwners.solutions.unifiedView.benefits.seamlessHandoffs')
    ],
    color: 'text-blue-600',
    bgColor: 'bg-blue-50',
    borderColor: 'border-blue-200'
  },
  {
    icon: 'BarChart3',
    title: t('solutions.smeOwners.solutions.smartMarketing.title'),
    description: t('solutions.smeOwners.solutions.smartMarketing.description'),
    benefits: [
      t('solutions.smeOwners.solutions.smartMarketing.benefits.automatedFollowup'),
      t('solutions.smeOwners.solutions.smartMarketing.benefits.personalizedMessaging'),
      t('solutions.smeOwners.solutions.smartMarketing.benefits.trackPerformance'),
      t('solutions.smeOwners.solutions.smartMarketing.benefits.recoverCarts')
    ],
    color: 'text-purple-600',
    bgColor: 'bg-purple-50',
    borderColor: 'border-purple-200'
  }
];

const useCases = [
  {
    title: t('solutions.smeOwners.useCases.soloEntrepreneur.title'),
    scenario: t('solutions.smeOwners.useCases.soloEntrepreneur.scenario'),
    solution: t('solutions.smeOwners.useCases.soloEntrepreneur.solution')
  },
  {
    title: t('solutions.smeOwners.useCases.smallRetailer.title'),
    scenario: t('solutions.smeOwners.useCases.smallRetailer.scenario'),
    solution: t('solutions.smeOwners.useCases.smallRetailer.solution')
  },
  {
    title: t('solutions.smeOwners.useCases.serviceProvider.title'),
    scenario: t('solutions.smeOwners.useCases.serviceProvider.scenario'),
    solution: t('solutions.smeOwners.useCases.serviceProvider.solution')
  },
  {
    title: t('solutions.smeOwners.useCases.growingStartup.title'),
    scenario: t('solutions.smeOwners.useCases.growingStartup.scenario'),
    solution: t('solutions.smeOwners.useCases.growingStartup.solution')
  }
];

const roi = [
  {
    metric: t('solutions.smeOwners.roi.timeSaved.metric'),
    description: t('solutions.smeOwners.roi.timeSaved.description'),
    icon: 'Clock'
  },
  {
    metric: t('solutions.smeOwners.roi.responseRate.metric'),
    description: t('solutions.smeOwners.roi.responseRate.description'),
    icon: 'Star'
  },
  {
    metric: t('solutions.smeOwners.roi.availability.metric'),
    description: t('solutions.smeOwners.roi.availability.description'),
    icon: 'Shield'
  },
  {
    metric: t('solutions.smeOwners.roi.conversationsHandled.metric'),
    description: t('solutions.smeOwners.roi.conversationsHandled.description'),
    icon: 'Users'
  }
];
---

<Layout 
  title={seoTitle}
  description={seoDescription}
  canonical={canonicalUrl}
  lang={currentLang}
  keywords={seoKeywords}
  type="service"
  breadcrumbs={breadcrumbs}
  image="https://seasalt.ai/seasalt-ai-og-image.png"
  article={{
    publishedTime: '2024-01-01T00:00:00Z',
    modifiedTime: '2024-01-15T00:00:00Z',
    author: 'Seasalt.ai Team',
    section: 'Solutions'
  }}
>
  <main>
    <!-- Hero Section -->
    <section class="bg-gradient-to-br from-blue-50 via-white to-indigo-50 py-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="lg:grid lg:grid-cols-2 lg:gap-12 items-center">
          <div>
            <a 
              href={currentLang === 'en' ? '/' : `/${currentLang}/`} 
              class="inline-flex items-center text-gray-600 hover:text-blue-600 transition-colors duration-200 mb-8"
            >
              <ArrowLeft size={20} class="mr-2" />
              {t('solutions.smeOwners.navigation.backToHome')}
            </a>
            
            <h1 class="text-4xl lg:text-6xl font-bold text-gray-900 mb-6">
              {t('solutions.smeOwners.hero.title.part1')}{' '}
              <span class="bg-gradient-to-r from-blue-600 to-indigo-600 bg-clip-text text-transparent">
                {t('solutions.smeOwners.hero.title.part2')}
              </span>
            </h1>
            
            <h2 class="text-2xl lg:text-3xl font-semibold text-gray-700 mb-8">
              {t('solutions.smeOwners.hero.subtitle')}
            </h2>
            
            <p class="text-xl text-gray-600 mb-8">
              {t('solutions.smeOwners.hero.description')}
            </p>
            
            <div class="flex flex-col sm:flex-row gap-4">
              <a
                href="https://seax.seasalt.ai/signup"
                class="bg-blue-600 hover:bg-blue-700 text-white px-8 py-4 rounded-lg text-lg font-semibold transition-all duration-200"
              >
                {t('solutions.smeOwners.hero.cta.getAssistant')}
              </a>
              <a
                href={getMeetingUrl(currentLang)}
                class="border-2 border-blue-600 text-blue-600 hover:bg-blue-600 hover:text-white px-8 py-4 rounded-lg text-lg font-semibold transition-all duration-200"
              >
                {t('solutions.smeOwners.hero.cta.bookDemo')}
              </a>
            </div>
          </div>
          
          <div class="mt-12 lg:mt-0">
            <div class="relative">
              <div class="bg-white rounded-2xl shadow-2xl p-6">
                <div class="flex items-center mb-4">
                  <Briefcase size={32} class="text-blue-600 mr-3" />
                  <h3 class="text-lg font-semibold">{t('solutions.smeOwners.hero.dashboard.title')}</h3>
                </div>
                <div class="space-y-3">
                  <div class="bg-green-50 p-3 rounded-lg border-l-4 border-green-500">
                    <p class="text-sm font-medium text-green-800">{t('solutions.smeOwners.hero.dashboard.aiHandledInquiries')}</p>
                    <p class="text-xs text-green-600">{t('solutions.smeOwners.hero.dashboard.timeSaved')}</p>
                  </div>
                  <div class="bg-blue-50 p-3 rounded-lg border-l-4 border-blue-500">
                    <p class="text-sm font-medium text-blue-800">{t('solutions.smeOwners.hero.dashboard.appointmentsBooked')}</p>
                    <p class="text-xs text-blue-600">{t('solutions.smeOwners.hero.dashboard.whileInMeetings')}</p>
                  </div>
                  <div class="bg-purple-50 p-3 rounded-lg border-l-4 border-purple-500">
                    <p class="text-sm font-medium text-purple-800">{t('solutions.smeOwners.hero.dashboard.leadsQualified')}</p>
                    <p class="text-xs text-purple-600">{t('solutions.smeOwners.hero.dashboard.readyForFollowup')}</p>
                  </div>
                  <div class="bg-orange-50 p-3 rounded-lg border-l-4 border-orange-500">
                    <p class="text-sm font-medium text-orange-800">{t('solutions.smeOwners.hero.dashboard.smsCampaign')}</p>
                    <p class="text-xs text-orange-600">{t('solutions.smeOwners.hero.dashboard.newCustomers')}</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Challenges Section -->
    <section class="py-20 bg-gray-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="text-3xl lg:text-4xl font-bold text-gray-900 mb-4">
            {t('solutions.smeOwners.challenges.title')}
          </h2>
          <p class="text-xl text-gray-600 max-w-3xl mx-auto">
            {t('solutions.smeOwners.challenges.description')}
          </p>
        </div>

        <div class="grid md:grid-cols-3 gap-8">
          {challenges.map((challenge, index) => {
            let IconComponent;
            if (challenge.icon === 'Users') IconComponent = Users;
            else if (challenge.icon === 'Clock') IconComponent = Clock;
            else if (challenge.icon === 'BarChart3') IconComponent = BarChart3;
            
            return (
            <div key={index} class={`p-8 rounded-2xl ${challenge.bgColor} border border-gray-200 hover:shadow-lg transition-all duration-300 text-center`}>
              <div class={`${challenge.color} mb-6 mx-auto w-fit`}>
                {IconComponent && <IconComponent size={32} />}
              </div>
              <h3 class="text-xl font-semibold text-gray-900 mb-4">
                {challenge.title}
              </h3>
              <p class="text-gray-600">
                {challenge.description}
              </p>
            </div>
          )})}
        </div>
      </div>
    </section>

    <!-- Solutions Section -->
    <section class="py-20 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="text-3xl lg:text-4xl font-bold text-gray-900 mb-4">
            {t('solutions.smeOwners.solutions.title')}
          </h2>
          <p class="text-xl text-gray-600 max-w-3xl mx-auto">
            {t('solutions.smeOwners.solutions.description')}
          </p>
        </div>

        <div class="space-y-12">
          {solutions.map((solution, index) => {
            let IconComponent;
            if (solution.icon === 'Zap') IconComponent = Zap;
            else if (solution.icon === 'Users') IconComponent = Users;
            else if (solution.icon === 'BarChart3') IconComponent = BarChart3;
            
            return (
            <div key={index} class={`p-8 rounded-2xl border-2 ${solution.borderColor} ${solution.bgColor} hover:shadow-lg transition-all duration-300`}>
              <div class="grid lg:grid-cols-2 gap-8 items-start">
                <div>
                  <div class={`${solution.color} mb-6`}>
                    {IconComponent && <IconComponent size={32} />}
                  </div>
                  <h3 class="text-2xl font-bold text-gray-900 mb-4">
                    {solution.title}
                  </h3>
                  <p class="text-lg text-gray-700 leading-relaxed">
                    {solution.description}
                  </p>
                </div>
                <div>
                  <h4 class="text-lg font-semibold text-gray-900 mb-4">{t('solutions.smeOwners.solutions.keyBenefits')}</h4>
                  <ul class="space-y-3">
                    {solution.benefits.map((benefit, benefitIndex) => (
                      <li key={benefitIndex} class="flex items-start">
                        <Check size={20} class={`${solution.color} mr-3 mt-0.5 flex-shrink-0`} />
                        <span class="text-gray-700">{benefit}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            </div>
          )})}
        </div>
      </div>
    </section>

    <!-- Use Cases -->
    <section class="py-20 bg-gray-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="text-3xl lg:text-4xl font-bold text-gray-900 mb-4">
            {t('solutions.smeOwners.useCases.title')}
          </h2>
          <p class="text-xl text-gray-600 max-w-3xl mx-auto">
            {t('solutions.smeOwners.useCases.description')}
          </p>
        </div>

        <div class="grid md:grid-cols-2 gap-8">
          {useCases.map((useCase, index) => (
            <div key={index} class="bg-white p-8 rounded-2xl shadow-lg hover:shadow-xl transition-all duration-300">
              <h3 class="text-xl font-bold text-gray-900 mb-4">
                {useCase.title}
              </h3>
              <div class="mb-4">
                <h4 class="text-sm font-semibold text-gray-600 mb-2">{t('solutions.smeOwners.useCases.challengeLabel')}</h4>
                <p class="text-gray-700 mb-4">{useCase.scenario}</p>
              </div>
              <div>
                <h4 class="text-sm font-semibold text-blue-600 mb-2">{t('solutions.smeOwners.useCases.solutionLabel')}</h4>
                <p class="text-gray-700">{useCase.solution}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ROI Section -->
    <section class="py-20 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="text-3xl lg:text-4xl font-bold text-gray-900 mb-4">
            {t('solutions.smeOwners.roi.title')}
          </h2>
          <p class="text-xl text-gray-600 max-w-3xl mx-auto">
            {t('solutions.smeOwners.roi.description')}
          </p>
        </div>

        <div class="grid md:grid-cols-4 gap-8">
          {roi.map((item, index) => {
            let IconComponent;
            if (item.icon === 'Clock') IconComponent = Clock;
            else if (item.icon === 'Star') IconComponent = Star;
            else if (item.icon === 'Shield') IconComponent = Shield;
            else if (item.icon === 'Users') IconComponent = Users;
            
            return (
            <div key={index} class="bg-gradient-to-br from-blue-50 to-indigo-50 p-8 rounded-2xl text-center hover:shadow-lg transition-all duration-300">
              <div class="text-blue-600 mb-4 mx-auto w-fit">
                {IconComponent && <IconComponent size={24} />}
              </div>
              <div class="text-3xl font-bold text-blue-600 mb-2">
                {item.metric}
              </div>
              <p class="text-gray-700 text-sm">
                {item.description}
              </p>
            </div>
          )})}
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="py-20 bg-gradient-to-r from-blue-600 to-indigo-600">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-3xl lg:text-4xl font-bold text-white mb-6">
          {t('solutions.smeOwners.cta.title')}
        </h2>
        <p class="text-xl text-white opacity-90 mb-8 max-w-2xl mx-auto">
          {t('solutions.smeOwners.cta.description')}
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="https://seax.seasalt.ai/signup"
            class="bg-white text-blue-600 hover:bg-gray-50 px-8 py-4 rounded-lg text-lg font-semibold transition-all duration-200"
          >
            {t('solutions.smeOwners.cta.startTrial')}
          </a>
          <a
            href={getMeetingUrl(currentLang)}
            class="border-2 border-white text-white hover:bg-white hover:text-blue-600 px-8 py-4 rounded-lg text-lg font-semibold transition-all duration-200"
          >
            {t('solutions.smeOwners.cta.scheduleDemo')}
          </a>
        </div>
        <p class="text-white opacity-75 mt-6 text-sm">
          {t('solutions.smeOwners.cta.disclaimer')}
        </p>
      </div>
    </section>
  </main>
</Layout>
