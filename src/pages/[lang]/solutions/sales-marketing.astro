---
import Layout from '../../../layouts/Layout.astro';
import { getTranslationHelpers, type SupportedLanguage, supportedLocales } from '../../../i18n/helpers';
import { getMeetingUrl } from "../../../constants/urls";
import { ArrowLeft, Check, Star, TrendingUp, Target, Megaphone, Zap } from 'lucide-react';

// 為所有支持的語言生成靜態路徑
export async function getStaticPaths() {
  return supportedLocales.map((lang) => ({
    params: { lang }
  }));
}

// Get language and i18n functions
const { lang } = Astro.params;
const currentLang = (lang as SupportedLanguage) || 'en';
const { t } = await getTranslationHelpers(currentLang);

// SEO data
const seoTitle = t('solutions.salesMarketing.seo.title') || 'Sales & Marketing Solutions - Seasalt.ai';
const seoDescription = t('solutions.salesMarketing.seo.description') || 'Transform your sales and marketing with AI automation.';
const seoKeywords = 'sales automation, marketing automation, lead generation, conversion optimization, CRM, sales funnel';
const canonicalUrl = currentLang === 'en' ? 'https://seasalt.ai/solutions/sales-marketing' : `https://seasalt.ai/${currentLang}/solutions/sales-marketing`;

// 麵包屑導航
const breadcrumbs = [
  { name: 'Home', url: `/${currentLang}/` },
  { name: 'Solutions', url: `/${currentLang}/solutions/` },
  { name: 'Sales & Marketing' }
];

// Page data
const challenges = [
  {
    icon: 'Target',
    title: t('solutions.salesMarketing.challenges.leadGeneration.title'),
    description: t('solutions.salesMarketing.challenges.leadGeneration.description'),
    color: 'text-green-600',
    bgColor: 'bg-green-50'
  },
  {
    icon: 'TrendingUp',
    title: t('solutions.salesMarketing.challenges.conversion.title'),
    description: t('solutions.salesMarketing.challenges.conversion.description'),
    color: 'text-blue-600',
    bgColor: 'bg-blue-50'
  },
  {
    icon: 'Megaphone',
    title: t('solutions.salesMarketing.challenges.campaignManagement.title'),
    description: t('solutions.salesMarketing.challenges.campaignManagement.description'),
    color: 'text-purple-600',
    bgColor: 'bg-purple-50'
  }
];

const solutions = [
  {
    icon: 'Target',
    title: t('solutions.salesMarketing.solutions.leadCapture.title'),
    description: t('solutions.salesMarketing.solutions.leadCapture.description'),
    benefits: [
      t('solutions.salesMarketing.solutions.leadCapture.benefit1'),
      t('solutions.salesMarketing.solutions.leadCapture.benefit2'),
      t('solutions.salesMarketing.solutions.leadCapture.benefit3'),
      t('solutions.salesMarketing.solutions.leadCapture.benefit4')
    ],
    color: 'text-green-600',
    bgColor: 'bg-green-50',
    borderColor: 'border-green-200'
  },
  {
    icon: 'Zap',
    title: t('solutions.salesMarketing.solutions.responseTime.title'),
    description: t('solutions.salesMarketing.solutions.responseTime.description'),
    benefits: [
      t('solutions.salesMarketing.solutions.responseTime.benefit1'),
      t('solutions.salesMarketing.solutions.responseTime.benefit2'),
      t('solutions.salesMarketing.solutions.responseTime.benefit3'),
      t('solutions.salesMarketing.solutions.responseTime.benefit4')
    ],
    color: 'text-blue-600',
    bgColor: 'bg-blue-50',
    borderColor: 'border-blue-200'
  },
  {
    icon: 'Megaphone',
    title: t('solutions.salesMarketing.solutions.omnichannel.title'),
    description: t('solutions.salesMarketing.solutions.omnichannel.description'),
    benefits: [
      t('solutions.salesMarketing.solutions.omnichannel.benefit1'),
      t('solutions.salesMarketing.solutions.omnichannel.benefit2'),
      t('solutions.salesMarketing.solutions.omnichannel.benefit3'),
      t('solutions.salesMarketing.solutions.omnichannel.benefit4')
    ],
    color: 'text-purple-600',
    bgColor: 'bg-purple-50',
    borderColor: 'border-purple-200'
  }
];

const useCases = [
  {
    title: t('solutions.salesMarketing.useCases.saas.title'),
    scenario: t('solutions.salesMarketing.useCases.saas.challenge'),
    solution: t('solutions.salesMarketing.useCases.saas.solution')
  },
  {
    title: t('solutions.salesMarketing.useCases.ecommerce.title'),
    scenario: t('solutions.salesMarketing.useCases.ecommerce.challenge'),
    solution: t('solutions.salesMarketing.useCases.ecommerce.solution')
  },
  {
    title: t('solutions.salesMarketing.useCases.realEstate.title'),
    scenario: t('solutions.salesMarketing.useCases.realEstate.challenge'),
    solution: t('solutions.salesMarketing.useCases.realEstate.solution')
  },
  {
    title: t('solutions.salesMarketing.useCases.professionalServices.title'),
    scenario: t('solutions.salesMarketing.useCases.professionalServices.challenge'),
    solution: t('solutions.salesMarketing.useCases.professionalServices.solution')
  }
];

const metrics = [
  {
    metric: '300%',
    description: t('solutions.salesMarketing.metrics.responseRate'),
    icon: 'TrendingUp'
  },
  {
    metric: '45%',
    description: t('solutions.salesMarketing.metrics.conversionRate'),
    icon: 'Target'
  },
  {
    metric: '24/7',
    description: t('solutions.salesMarketing.metrics.availability'),
    icon: 'Zap'
  },
  {
    metric: '5x',
    description: t('solutions.salesMarketing.metrics.qualifiedLeads'),
    icon: 'Star'
  }
];
---

<Layout 
  title={seoTitle}
  description={seoDescription}
  canonical={canonicalUrl}
  lang={currentLang}
  keywords={seoKeywords}
  type="service"
  breadcrumbs={breadcrumbs}
  image="https://seasalt.ai/seasalt-ai-og-image.png"
  article={{
    publishedTime: '2024-01-01T00:00:00Z',
    modifiedTime: '2024-01-15T00:00:00Z',
    author: 'Seasalt.ai Team',
    section: 'Solutions'
  }}
>
  <main>
    <!-- Hero Section -->
    <section class="bg-gradient-to-br from-green-50 via-white to-blue-50 py-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="lg:grid lg:grid-cols-2 lg:gap-12 items-center">
          <div>
<a 
href={currentLang === 'en' ? '/' : `/${currentLang}/`}
              class="inline-flex items-center text-gray-600 hover:text-green-600 transition-colors duration-200 mb-8"
            >
              <ArrowLeft size={20} class="mr-2" />
              {t('solutions.salesMarketing.navigation.backToHome')}
            </a>
            
            <h1 class="text-4xl lg:text-6xl font-bold text-gray-900 mb-6">
              {t('solutions.salesMarketing.hero.title1')}{' '}
              <span class="bg-gradient-to-r from-green-600 to-blue-600 bg-clip-text text-transparent">
                {t('solutions.salesMarketing.hero.titleGradient')}
              </span>
            </h1>
            
            <h2 class="text-2xl lg:text-3xl font-semibold text-gray-700 mb-8">
              {t('solutions.salesMarketing.hero.subtitle')}
            </h2>
            
            <p class="text-xl text-gray-600 mb-8">
              {t('solutions.salesMarketing.hero.description')}
            </p>
            
            <div class="flex flex-col sm:flex-row gap-4">
              <a
                href="https://seax.seasalt.ai/signup"
                class="bg-green-600 hover:bg-green-700 text-white px-8 py-4 rounded-lg text-lg font-semibold transition-all duration-200"
              >
                {t('solutions.salesMarketing.hero.cta.primary')}
              </a>
              <a
                href={getMeetingUrl(currentLang)}
                class="border-2 border-green-600 text-green-600 hover:bg-green-600 hover:text-white px-8 py-4 rounded-lg text-lg font-semibold transition-all duration-200"
              >
                {t('solutions.salesMarketing.hero.cta.secondary')}
              </a>
            </div>
          </div>
          
          <div class="mt-12 lg:mt-0">
            <div class="relative">
              <div class="bg-white rounded-2xl shadow-2xl p-6">
                <div class="flex items-center mb-4">
                  <TrendingUp size={32} class="text-green-600 mr-3" />
                  <h3 class="text-lg font-semibold">{t('solutions.salesMarketing.hero.dashboard.title')}</h3>
                </div>
                <div class="space-y-3">
                  <div class="bg-green-50 p-3 rounded-lg border-l-4 border-green-500">
                    <p class="text-sm font-medium text-green-800">{t('solutions.salesMarketing.hero.dashboard.leads')}</p>
                    <p class="text-xs text-green-600">{t('solutions.salesMarketing.hero.dashboard.leadsQualified')}</p>
                  </div>
                  <div class="bg-blue-50 p-3 rounded-lg border-l-4 border-blue-500">
                    <p class="text-sm font-medium text-blue-800">{t('solutions.salesMarketing.hero.dashboard.responseTime')}</p>
                    <p class="text-xs text-blue-600">{t('solutions.salesMarketing.hero.dashboard.responseTimeBenefit')}</p>
                  </div>
                  <div class="bg-purple-50 p-3 rounded-lg border-l-4 border-purple-500">
                    <p class="text-sm font-medium text-purple-800">{t('solutions.salesMarketing.hero.dashboard.demos')}</p>
                    <p class="text-xs text-purple-600">{t('solutions.salesMarketing.hero.dashboard.demosNote')}</p>
                  </div>
                  <div class="bg-orange-50 p-3 rounded-lg border-l-4 border-orange-500">
                    <p class="text-sm font-medium text-orange-800">{t('solutions.salesMarketing.hero.dashboard.pipeline')}</p>
                    <p class="text-xs text-orange-600">{t('solutions.salesMarketing.hero.dashboard.conversion')}</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Challenges Section -->
    <section class="py-20 bg-gray-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="text-3xl lg:text-4xl font-bold text-gray-900 mb-4">
            {t('solutions.salesMarketing.challenges.title')}
          </h2>
          <p class="text-xl text-gray-600 max-w-3xl mx-auto">
            {t('solutions.salesMarketing.challenges.description')}
          </p>
        </div>

        <div class="grid md:grid-cols-3 gap-8">
          {challenges.map((challenge, index) => {
            let IconComponent;
            if (challenge.icon === 'Target') IconComponent = Target;
            else if (challenge.icon === 'TrendingUp') IconComponent = TrendingUp;
            else if (challenge.icon === 'Megaphone') IconComponent = Megaphone;
            
            return (
            <div key={index} class={`p-8 rounded-2xl ${challenge.bgColor} border border-gray-200 hover:shadow-lg transition-all duration-300 text-center`}>
              <div class={`${challenge.color} mb-6 mx-auto w-fit`}>
                {IconComponent && <IconComponent size={32} />}
              </div>
              <h3 class="text-xl font-semibold text-gray-900 mb-4">
                {challenge.title}
              </h3>
              <p class="text-gray-600">
                {challenge.description}
              </p>
            </div>
          )})}
        </div>
      </div>
    </section>

    <!-- Solutions Section -->
    <section class="py-20 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="text-3xl lg:text-4xl font-bold text-gray-900 mb-4">
            {t('solutions.salesMarketing.solutions.title')}
          </h2>
          <p class="text-xl text-gray-600 max-w-3xl mx-auto">
            {t('solutions.salesMarketing.solutions.description')}
          </p>
        </div>

        <div class="space-y-12">
          {solutions.map((solution, index) => {
            let IconComponent;
            if (solution.icon === 'Target') IconComponent = Target;
            else if (solution.icon === 'Zap') IconComponent = Zap;
            else if (solution.icon === 'Megaphone') IconComponent = Megaphone;
            
            return (
            <div key={index} class={`p-8 rounded-2xl border-2 ${solution.borderColor} ${solution.bgColor} hover:shadow-lg transition-all duration-300`}>
              <div class="grid lg:grid-cols-2 gap-8 items-start">
                <div>
                  <div class={`${solution.color} mb-6`}>
                    {IconComponent && <IconComponent size={32} />}
                  </div>
                  <h3 class="text-2xl font-bold text-gray-900 mb-4">
                    {solution.title}
                  </h3>
                  <p class="text-lg text-gray-700 leading-relaxed">
                    {solution.description}
                  </p>
                </div>
                <div>
                  <h4 class="text-lg font-semibold text-gray-900 mb-4">{t('solutions.salesMarketing.solutions.keyBenefits')}</h4>
                  <ul class="space-y-3">
                    {solution.benefits.map((benefit, benefitIndex) => (
                      <li key={benefitIndex} class="flex items-start">
                        <Check size={20} class={`${solution.color} mr-3 mt-0.5 flex-shrink-0`} />
                        <span class="text-gray-700">{benefit}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            </div>
          )})}
        </div>
      </div>
    </section>

    <!-- Use Cases -->
    <section class="py-20 bg-gray-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="text-3xl lg:text-4xl font-bold text-gray-900 mb-4">
            {t('solutions.salesMarketing.useCases.title')}
          </h2>
          <p class="text-xl text-gray-600 max-w-3xl mx-auto">
            {t('solutions.salesMarketing.useCases.description')}
          </p>
        </div>

        <div class="grid md:grid-cols-2 gap-8">
          {useCases.map((useCase, index) => (
            <div key={index} class="bg-white p-8 rounded-2xl shadow-lg hover:shadow-xl transition-all duration-300">
              <h3 class="text-xl font-bold text-gray-900 mb-4">
                {useCase.title}
              </h3>
              <div class="mb-4">
                <h4 class="text-sm font-semibold text-gray-600 mb-2">{t('solutions.salesMarketing.useCases.challengeLabel')}</h4>
                <p class="text-gray-700 mb-4">{useCase.scenario}</p>
              </div>
              <div>
                <h4 class="text-sm font-semibold text-green-600 mb-2">{t('solutions.salesMarketing.useCases.solutionLabel')}</h4>
                <p class="text-gray-700">{useCase.solution}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Metrics Section -->
    <section class="py-20 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="text-3xl lg:text-4xl font-bold text-gray-900 mb-4">
            {t('solutions.salesMarketing.metrics.title')}
          </h2>
          <p class="text-xl text-gray-600 max-w-3xl mx-auto">
            {t('solutions.salesMarketing.metrics.description')}
          </p>
        </div>

        <div class="grid md:grid-cols-4 gap-8">
          {metrics.map((item, index) => {
            let IconComponent;
            if (item.icon === 'TrendingUp') IconComponent = TrendingUp;
            else if (item.icon === 'Target') IconComponent = Target;
            else if (item.icon === 'Zap') IconComponent = Zap;
            else if (item.icon === 'Star') IconComponent = Star;
            
            return (
            <div key={index} class="bg-gradient-to-br from-green-50 to-blue-50 p-8 rounded-2xl text-center hover:shadow-lg transition-all duration-300">
              <div class="text-green-600 mb-4 mx-auto w-fit">
                {IconComponent && <IconComponent size={24} />}
              </div>
              <div class="text-3xl font-bold text-green-600 mb-2">
                {item.metric}
              </div>
              <p class="text-gray-700 text-sm">
                {item.description}
              </p>
            </div>
          )})}
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="py-20 bg-gradient-to-r from-green-600 to-blue-600">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-3xl lg:text-4xl font-bold text-white mb-6">
          {t('solutions.salesMarketing.cta.title')}
        </h2>
        <p class="text-xl text-white opacity-90 mb-8 max-w-2xl mx-auto">
          {t('solutions.salesMarketing.cta.description')}
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="https://seax.seasalt.ai/signup"
            class="bg-white text-green-600 hover:bg-gray-50 px-8 py-4 rounded-lg text-lg font-semibold transition-all duration-200"
          >
            {t('solutions.salesMarketing.cta.primary')}
          </a>
          <a
            href={getMeetingUrl(currentLang)}
            class="border-2 border-white text-white hover:bg-white hover:text-green-600 px-8 py-4 rounded-lg text-lg font-semibold transition-all duration-200"
          >
            {t('solutions.salesMarketing.cta.secondary')}
          </a>
        </div>
        <p class="text-white opacity-75 mt-6 text-sm">
          {t('solutions.salesMarketing.cta.disclaimer')}
        </p>
      </div>
    </section>
  </main>
</Layout>
