---
import Layout from '../../../layouts/Layout.astro';
import { getTranslationHelpers, type SupportedLanguage } from '../../../i18n/helpers';
import { ArrowLeft, Check, Star, Bot, Zap, Cog, Brain, Clock, BarChart3, Shield, Workflow } from 'lucide-react';

// 為所有支持的語言生成靜態路徑
export async function getStaticPaths() {
  const supportedLocales = [
    'en', 'es', 'zh-tw', 'zh-cn', 'ja', 'ko', 'fr', 'de', 'ar', 'fa',
    'fil', 'hi', 'id', 'ms', 'pl', 'pt', 'ru', 'ta', 'th', 'vi'
  ];
  
  return supportedLocales.map((lang) => ({
    params: { lang }
  }));
}

// Get language and i18n functions
const { lang } = Astro.params;
const currentLang = (lang as SupportedLanguage) || 'en';
const { t } = await getTranslationHelpers(currentLang);

// SEO data
const seoTitle = t('solutions.aiAutomation.seo.title') || 'AI Automation Solutions - Seasalt.ai';
const seoDescription = t('solutions.aiAutomation.seo.description') || 'Transform business operations with intelligent AI automation.';
const seoKeywords = 'AI automation, business automation, customer service automation, voice automation, chat automation, workflow automation';
const canonicalUrl = currentLang === 'en' ? 'https://seasalt.ai/solutions/ai-automation' : `https://seasalt.ai/${currentLang}/solutions/ai-automation`;

// 麻包屑導航
const breadcrumbs = [
  { name: 'Home', url: `/${currentLang}/` },
  { name: 'Solutions', url: `/${currentLang}/solutions/` },
  { name: 'AI Automation' }
];

// Page data
const challenges = [
  {
    icon: 'Clock',
    title: t('solutions.aiAutomation.challenges.manualTasks.title'),
    description: t('solutions.aiAutomation.challenges.manualTasks.description'),
    color: 'text-purple-600',
    bgColor: 'bg-purple-50'
  },
  {
    icon: 'BarChart3',
    title: t('solutions.aiAutomation.challenges.scaling.title'),
    description: t('solutions.aiAutomation.challenges.scaling.description'),
    color: 'text-blue-600',
    bgColor: 'bg-blue-50'
  },
  {
    icon: 'Brain',
    title: t('solutions.aiAutomation.challenges.inconsistent.title'),
    description: t('solutions.aiAutomation.challenges.inconsistent.description'),
    color: 'text-green-600',
    bgColor: 'bg-green-50'
  }
];

const solutions = [
  {
    icon: 'Bot',
    title: t('solutions.aiAutomation.solutions.voiceChat.title'),
    description: t('solutions.aiAutomation.solutions.voiceChat.description'),
    benefits: [
      t('solutions.aiAutomation.solutions.voiceChat.benefits.nlp'),
      t('solutions.aiAutomation.solutions.voiceChat.benefits.channels'),
      t('solutions.aiAutomation.solutions.voiceChat.benefits.contextAware'),
      t('solutions.aiAutomation.solutions.voiceChat.benefits.handoff')
    ],
    color: 'text-purple-600',
    bgColor: 'bg-purple-50',
    borderColor: 'border-purple-200'
  },
  {
    icon: 'Workflow',
    title: t('solutions.aiAutomation.solutions.workflow.title'),
    description: t('solutions.aiAutomation.solutions.workflow.description'),
    benefits: [
      t('solutions.aiAutomation.solutions.workflow.benefits.leadQualification'),
      t('solutions.aiAutomation.solutions.workflow.benefits.scheduling'),
      t('solutions.aiAutomation.solutions.workflow.benefits.pricing'),
      t('solutions.aiAutomation.solutions.workflow.benefits.followUp')
    ],
    color: 'text-blue-600',
    bgColor: 'bg-blue-50',
    borderColor: 'border-blue-200'
  },
  {
    icon: 'Brain',
    title: t('solutions.aiAutomation.solutions.learning.title'),
    description: t('solutions.aiAutomation.solutions.learning.description'),
    benefits: [
      t('solutions.aiAutomation.solutions.learning.benefits.machineLearning'),
      t('solutions.aiAutomation.solutions.learning.benefits.optimization'),
      t('solutions.aiAutomation.solutions.learning.benefits.predictive'),
      t('solutions.aiAutomation.solutions.learning.benefits.monitoring')
    ],
    color: 'text-green-600',
    bgColor: 'bg-green-50',
    borderColor: 'border-green-200'
  }
];

const automationTypes = [
  {
    title: t('solutions.aiAutomation.automationTypes.customerService.title'),
    description: t('solutions.aiAutomation.automationTypes.customerService.description'),
    examples: [
      t('solutions.aiAutomation.automationTypes.customerService.examples.orderStatus'),
      t('solutions.aiAutomation.automationTypes.customerService.examples.faq'),
      t('solutions.aiAutomation.automationTypes.customerService.examples.troubleshooting'),
      t('solutions.aiAutomation.automationTypes.customerService.examples.account')
    ]
  },
  {
    title: t('solutions.aiAutomation.automationTypes.sales.title'),
    description: t('solutions.aiAutomation.automationTypes.sales.description'),
    examples: [
      t('solutions.aiAutomation.automationTypes.sales.examples.leadScoring'),
      t('solutions.aiAutomation.automationTypes.sales.examples.demoBooking'),
      t('solutions.aiAutomation.automationTypes.sales.examples.proposals'),
      t('solutions.aiAutomation.automationTypes.sales.examples.followUp')
    ]
  },
  {
    title: t('solutions.aiAutomation.automationTypes.marketing.title'),
    description: t('solutions.aiAutomation.automationTypes.marketing.description'),
    examples: [
      t('solutions.aiAutomation.automationTypes.marketing.examples.personalized'),
      t('solutions.aiAutomation.automationTypes.marketing.examples.timing'),
      t('solutions.aiAutomation.automationTypes.marketing.examples.testing'),
      t('solutions.aiAutomation.automationTypes.marketing.examples.optimization')
    ]
  },
  {
    title: t('solutions.aiAutomation.automationTypes.operational.title'),
    description: t('solutions.aiAutomation.automationTypes.operational.description'),
    examples: [
      t('solutions.aiAutomation.automationTypes.operational.examples.dataEntry'),
      t('solutions.aiAutomation.automationTypes.operational.examples.reports'),
      t('solutions.aiAutomation.automationTypes.operational.examples.taskAssignment'),
      t('solutions.aiAutomation.automationTypes.operational.examples.qualityMonitoring')
    ]
  }
];

const metrics = [
  {
    metric: t('solutions.aiAutomation.metrics.reduction.value'),
    description: t('solutions.aiAutomation.metrics.reduction.label'),
    icon: 'Cog'
  },
  {
    metric: t('solutions.aiAutomation.metrics.availability.value'),
    description: t('solutions.aiAutomation.metrics.availability.label'),
    icon: 'Clock'
  },
  {
    metric: t('solutions.aiAutomation.metrics.accuracy.value'),
    description: t('solutions.aiAutomation.metrics.accuracy.label'),
    icon: 'Star'
  },
  {
    metric: t('solutions.aiAutomation.metrics.speed.value'),
    description: t('solutions.aiAutomation.metrics.speed.label'),
    icon: 'Zap'
  }
];

// Meeting URL helper
const getMeetingUrl = (language: string) => {
  return 'https://cal.com/seasalt-ai/demo';
};
---

<Layout 
  title={seoTitle}
  description={seoDescription}
  canonical={canonicalUrl}
  lang={currentLang}
  keywords={seoKeywords}
  type="service"
  breadcrumbs={breadcrumbs}
  image="https://seasalt.ai/seasalt-ai-og-image.png"
  article={{
    publishedTime: '2024-01-01T00:00:00Z',
    modifiedTime: '2024-01-15T00:00:00Z',
    author: 'Seasalt.ai Team',
    section: 'Solutions'
  }}
>
  <main>
    <!-- Hero Section -->
    <section class="bg-gradient-to-br from-purple-50 via-white to-blue-50 py-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="lg:grid lg:grid-cols-2 lg:gap-12 items-center">
          <div>
            <a 
              href={currentLang === 'en' ? '/' : `/${currentLang}/`} 
              class="inline-flex items-center text-gray-600 hover:text-purple-600 transition-colors duration-200 mb-8"
            >
              <ArrowLeft size={20} class="mr-2" />
              {t('solutions.aiAutomation.nav.backToHome')}
            </a>
            
            <h1 class="text-4xl lg:text-6xl font-bold text-gray-900 mb-6">
              {t('solutions.aiAutomation.hero.title.prefix')}{' '}
              <span class="bg-gradient-to-r from-purple-600 to-blue-600 bg-clip-text text-transparent">
                {t('solutions.aiAutomation.hero.title.highlight')}
              </span>
            </h1>
            
            <h2 class="text-2xl lg:text-3xl font-semibold text-gray-700 mb-8">
              {t('solutions.aiAutomation.hero.subtitle')}
            </h2>
            
            <p class="text-xl text-gray-600 mb-8">
              {t('solutions.aiAutomation.hero.description')}
            </p>
            
            <div class="flex flex-col sm:flex-row gap-4">
              <a
                href="https://seax.seasalt.ai/signup"
                class="bg-purple-600 hover:bg-purple-700 text-white px-8 py-4 rounded-lg text-lg font-semibold transition-all duration-200"
              >
                {t('solutions.aiAutomation.hero.cta.primary')}
              </a>
              <a
                href={getMeetingUrl(currentLang)}
                class="border-2 border-purple-600 text-purple-600 hover:bg-purple-600 hover:text-white px-8 py-4 rounded-lg text-lg font-semibold transition-all duration-200"
              >
                {t('solutions.aiAutomation.hero.cta.secondary')}
              </a>
            </div>
          </div>
          
          <div class="mt-12 lg:mt-0">
            <div class="relative">
              <div class="bg-white rounded-2xl shadow-2xl p-6">
                <div class="flex items-center mb-4">
                  <Bot size={32} class="text-purple-600 mr-3" />
                  <h3 class="text-lg font-semibold">{t('solutions.aiAutomation.hero.dashboard.title')}</h3>
                </div>
                <div class="space-y-3">
                  <div class="bg-purple-50 p-3 rounded-lg border-l-4 border-purple-500">
                    <p class="text-sm font-medium text-purple-800">{t('solutions.aiAutomation.hero.dashboard.stats.tasks')}</p>
                    <p class="text-xs text-purple-600">{t('solutions.aiAutomation.hero.dashboard.stats.tasksSaved')}</p>
                  </div>
                  <div class="bg-blue-50 p-3 rounded-lg border-l-4 border-blue-500">
                    <p class="text-sm font-medium text-blue-800">{t('solutions.aiAutomation.hero.dashboard.stats.workflows')}</p>
                    <p class="text-xs text-blue-600">{t('solutions.aiAutomation.hero.dashboard.stats.workflowsDescription')}</p>
                  </div>
                  <div class="bg-green-50 p-3 rounded-lg border-l-4 border-green-500">
                    <p class="text-sm font-medium text-green-800">{t('solutions.aiAutomation.hero.dashboard.stats.accuracy')}</p>
                    <p class="text-xs text-green-600">{t('solutions.aiAutomation.hero.dashboard.stats.accuracyDescription')}</p>
                  </div>
                  <div class="bg-orange-50 p-3 rounded-lg border-l-4 border-orange-500">
                    <p class="text-sm font-medium text-orange-800">{t('solutions.aiAutomation.hero.dashboard.stats.savings')}</p>
                    <p class="text-xs text-orange-600">{t('solutions.aiAutomation.hero.dashboard.stats.savingsDescription')}</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Challenges Section -->
    <section class="py-20 bg-gray-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="text-3xl lg:text-4xl font-bold text-gray-900 mb-4">
            {t('solutions.aiAutomation.challenges.title')}
          </h2>
          <p class="text-xl text-gray-600 max-w-3xl mx-auto">
            {t('solutions.aiAutomation.challenges.description')}
          </p>
        </div>

        <div class="grid md:grid-cols-3 gap-8">
          {challenges.map((challenge, index) => {
            let IconComponent;
            if (challenge.icon === 'Clock') IconComponent = Clock;
            else if (challenge.icon === 'BarChart3') IconComponent = BarChart3;
            else if (challenge.icon === 'Brain') IconComponent = Brain;
            
            return (
            <div key={index} class={`p-8 rounded-2xl ${challenge.bgColor} border border-gray-200 hover:shadow-lg transition-all duration-300 text-center`}>
              <div class={`${challenge.color} mb-6 mx-auto w-fit`}>
                {IconComponent && <IconComponent size={32} />}
              </div>
              <h3 class="text-xl font-semibold text-gray-900 mb-4">
                {challenge.title}
              </h3>
              <p class="text-gray-600">
                {challenge.description}
              </p>
            </div>
          )})}
        </div>
      </div>
    </section>

    <!-- Solutions Section -->
    <section class="py-20 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="text-3xl lg:text-4xl font-bold text-gray-900 mb-4">
            {t('solutions.aiAutomation.solutions.title')}
          </h2>
          <p class="text-xl text-gray-600 max-w-3xl mx-auto">
            {t('solutions.aiAutomation.solutions.description')}
          </p>
        </div>

        <div class="space-y-12">
          {solutions.map((solution, index) => {
            let IconComponent;
            if (solution.icon === 'Bot') IconComponent = Bot;
            else if (solution.icon === 'Workflow') IconComponent = Workflow;
            else if (solution.icon === 'Brain') IconComponent = Brain;
            
            return (
            <div key={index} class={`p-8 rounded-2xl border-2 ${solution.borderColor} ${solution.bgColor} hover:shadow-lg transition-all duration-300`}>
              <div class="grid lg:grid-cols-2 gap-8 items-start">
                <div>
                  <div class={`${solution.color} mb-6`}>
                    {IconComponent && <IconComponent size={32} />}
                  </div>
                  <h3 class="text-2xl font-bold text-gray-900 mb-4">
                    {solution.title}
                  </h3>
                  <p class="text-lg text-gray-700 leading-relaxed">
                    {solution.description}
                  </p>
                </div>
                <div>
                  <h4 class="text-lg font-semibold text-gray-900 mb-4">{t('solutions.aiAutomation.solutions.capabilities')}</h4>
                  <ul class="space-y-3">
                    {solution.benefits.map((benefit, benefitIndex) => (
                      <li key={benefitIndex} class="flex items-start">
                        <Check size={20} class={`${solution.color} mr-3 mt-0.5 flex-shrink-0`} />
                        <span class="text-gray-700">{benefit}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            </div>
          )})}
        </div>
      </div>
    </section>

    <!-- Automation Types -->
    <section class="py-20 bg-gray-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="text-3xl lg:text-4xl font-bold text-gray-900 mb-4">
            {t('solutions.aiAutomation.automationTypes.title')}
          </h2>
          <p class="text-xl text-gray-600 max-w-3xl mx-auto">
            {t('solutions.aiAutomation.automationTypes.description')}
          </p>
        </div>

        <div class="grid md:grid-cols-2 gap-8">
          {automationTypes.map((type, index) => (
            <div key={index} class="bg-white p-8 rounded-2xl shadow-lg hover:shadow-xl transition-all duration-300">
              <h3 class="text-xl font-bold text-gray-900 mb-4">
                {type.title}
              </h3>
              <p class="text-gray-600 mb-6">
                {type.description}
              </p>
              <div>
                <h4 class="text-sm font-semibold text-purple-600 mb-3">{t('solutions.aiAutomation.automationTypes.examples')}</h4>
                <div class="grid grid-cols-2 gap-2">
                  {type.examples.map((example, exampleIndex) => (
                    <div key={exampleIndex} class="bg-purple-50 px-3 py-2 rounded-lg text-sm text-purple-800">
                      {example}
                    </div>
                  ))}
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Metrics Section -->
    <section class="py-20 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="text-3xl lg:text-4xl font-bold text-gray-900 mb-4">
            {t('solutions.aiAutomation.metrics.title')}
          </h2>
          <p class="text-xl text-gray-600 max-w-3xl mx-auto">
            {t('solutions.aiAutomation.metrics.description')}
          </p>
        </div>

        <div class="grid md:grid-cols-4 gap-8">
          {metrics.map((item, index) => {
            let IconComponent;
            if (item.icon === 'Cog') IconComponent = Cog;
            else if (item.icon === 'Clock') IconComponent = Clock;
            else if (item.icon === 'Star') IconComponent = Star;
            else if (item.icon === 'Zap') IconComponent = Zap;
            
            return (
            <div key={index} class="bg-gradient-to-br from-purple-50 to-blue-50 p-8 rounded-2xl text-center hover:shadow-lg transition-all duration-300">
              <div class="text-purple-600 mb-4 mx-auto w-fit">
                {IconComponent && <IconComponent size={24} />}
              </div>
              <div class="text-3xl font-bold text-purple-600 mb-2">
                {item.metric}
              </div>
              <p class="text-gray-700 text-sm">
                {item.description}
              </p>
            </div>
          )})}
        </div>
      </div>
    </section>

    <!-- Security & Compliance -->
    <section class="py-20 bg-gray-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="bg-white rounded-2xl p-12 shadow-xl">
          <div class="text-center mb-12">
            <div class="flex justify-center mb-6">
              <Shield size={64} class="text-purple-600" />
            </div>
            <h2 class="text-3xl lg:text-4xl font-bold text-gray-900 mb-4">
              {t('solutions.aiAutomation.security.title')}
            </h2>
            <p class="text-xl text-gray-600 max-w-2xl mx-auto">
              {t('solutions.aiAutomation.security.description')}
            </p>
          </div>

          <div class="grid md:grid-cols-3 gap-8">
            <div class="text-center">
              <div class="bg-purple-100 p-4 rounded-2xl w-fit mx-auto mb-4">
                <Shield size={32} class="text-purple-600" />
              </div>
              <h3 class="text-lg font-semibold text-gray-900 mb-2">{t('solutions.aiAutomation.security.dataProtection.title')}</h3>
              <p class="text-gray-600 text-sm">{t('solutions.aiAutomation.security.dataProtection.description')}</p>
            </div>
            <div class="text-center">
              <div class="bg-blue-100 p-4 rounded-2xl w-fit mx-auto mb-4">
                <Check size={32} class="text-blue-600" />
              </div>
              <h3 class="text-lg font-semibold text-gray-900 mb-2">{t('solutions.aiAutomation.security.compliance.title')}</h3>
              <p class="text-gray-600 text-sm">{t('solutions.aiAutomation.security.compliance.description')}</p>
            </div>
            <div class="text-center">
              <div class="bg-green-100 p-4 rounded-2xl w-fit mx-auto mb-4">
                <BarChart3 size={32} class="text-green-600" />
              </div>
              <h3 class="text-lg font-semibold text-gray-900 mb-2">{t('solutions.aiAutomation.security.auditTrail.title')}</h3>
              <p class="text-gray-600 text-sm">{t('solutions.aiAutomation.security.auditTrail.description')}</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="py-20 bg-gradient-to-r from-purple-600 to-blue-600">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-3xl lg:text-4xl font-bold text-white mb-6">
          {t('solutions.aiAutomation.cta.title')}
        </h2>
        <p class="text-xl text-white opacity-90 mb-8 max-w-2xl mx-auto">
          {t('solutions.aiAutomation.cta.description')}
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="https://seax.seasalt.ai/signup"
            class="bg-white text-purple-600 hover:bg-gray-50 px-8 py-4 rounded-lg text-lg font-semibold transition-all duration-200"
          >
            {t('solutions.aiAutomation.cta.primary')}
          </a>
          <a
            href={getMeetingUrl(currentLang)}
            class="border-2 border-white text-white hover:bg-white hover:text-purple-600 px-8 py-4 rounded-lg text-lg font-semibold transition-all duration-200"
          >
            {t('solutions.aiAutomation.cta.secondary')}
          </a>
        </div>
        <p class="text-white opacity-75 mt-6 text-sm">
          {t('solutions.aiAutomation.cta.disclaimer')}
        </p>
      </div>
    </section>
  </main>
</Layout>
