---
import Layout from '../../../../layouts/Layout.astro';
import { getTranslationHelpers, supportedLocales, type SupportedLanguage } from '../../../../i18n/helpers';
import curatedAppsData from '../../../../../zapier/data/curated-apps.json';
import actionsData from '../../../../../zapier/data/actions.json';
import BentoGrid from '../../../../components/integrations/BentoGrid';
import HowItWorks from '../../../../components/integrations/HowItWorks';
import TrustBar from '../../../../components/integrations/TrustBar';

export async function getStaticPaths() {
  const paths = [];
  const apps = (curatedAppsData as any).apps;
  
  // Only build English version - integrations are English-only
  for (const app of apps) {
    paths.push({
      params: { 
        lang: 'en', 
        app: app.slug 
      },
      props: { 
        app 
      }
    });
  }
  
  return paths;
}

const { app } = Astro.props;
const { lang } = Astro.params;
const currentLang = (lang as SupportedLanguage) || 'en';
const { t } = await getTranslationHelpers(currentLang);

// SEO metadata
const title = t('integrations.hub.metaTitle')
  .replaceAll('{appName}', app.name)
  .replaceAll('{category}', app.category);
const description = t('integrations.hub.metaDescription')
  .replaceAll('{appName}', app.name)
  .replaceAll('{description}', app.description);
const keywords = t('integrations.hub.keywords')
  .replaceAll('{appName}', app.name)
  .replaceAll('{category}', app.category);

// Canonical path for this page (with trailing slash for consistency)
const canonicalPath = `/${currentLang}/integrations/${app.slug}/`;

// Breadcrumbs
const breadcrumbs = [
  { name: t('integrations.breadcrumb.home'), url: `/${currentLang}/` },
  { name: t('integrations.breadcrumb.integrations'), url: `/${currentLang}/integrations/` },
  { name: app.name, url: canonicalPath }
];

// JSON-LD Product Schema for Agentic Send
const productSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": `Seasalt.ai ${app.name} Integration`,
  "applicationCategory": "BusinessApplication",
  "description": `Automate ${app.name} workflows with Seasalt.ai's AI-powered Agentic Send. Send SMS, WhatsApp messages, and phone calls automatically.`,
  "operatingSystem": "Web",
  "provider": {
    "@type": "Organization",
    "name": "Seasalt.ai",
    "url": "https://seasalt.ai"
  },
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD",
    "availability": "https://schema.org/InStock"
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.8",
    "ratingCount": "127"
  }
};

// HowTo Schema
const howToSchema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": t('integrations.hub.howToTitle').replace('{appName}', app.name),
  "description": t('integrations.hub.howToDescription').replace('{appName}', app.name),
  "step": [
    {
      "@type": "HowToStep",
      "name": t('integrations.hub.step1.title'),
      "text": t('integrations.hub.step1.description').replace('{appName}', app.name)
    },
    {
      "@type": "HowToStep",
      "name": t('integrations.hub.step2.title'),
      "text": t('integrations.hub.step2.description')
    },
    {
      "@type": "HowToStep",
      "name": t('integrations.hub.step3.title'),
      "text": t('integrations.hub.step3.description')
    },
    {
      "@type": "HowToStep",
      "name": t('integrations.hub.step4.title'),
      "text": t('integrations.hub.step4.description')
    }
  ]
};

const customJsonLd = [productSchema, howToSchema];
const actionsList = (actionsData as any).actions;

// Prepare translations object for React components
const translations = {
  bento: {
    simplicity_title: t('integrations.spoke.bento.simplicity_title'),
    simplicity_old: t('integrations.spoke.bento.simplicity_old'),
    simplicity_new: t('integrations.spoke.bento.simplicity_new'),
    ai_cleaning_title: t('integrations.spoke.bento.ai_cleaning_title'),
    ai_cleaning_desc: t('integrations.spoke.bento.ai_cleaning_desc'),
    open_rates_title: t('integrations.spoke.bento.open_rates_title'),
    global_reach_title: t('integrations.spoke.bento.global_reach_title'),
  },
  how_it_works: {
    title: t('integrations.spoke.how_it_works.title'),
    step1_title: t('integrations.spoke.how_it_works.step1_title'),
    step1_desc: t('integrations.spoke.how_it_works.step1_desc').replaceAll('{appName}', app.name),
    step2_title: t('integrations.spoke.how_it_works.step2_title'),
    step2_desc: t('integrations.spoke.how_it_works.step2_desc'),
    step3_title: t('integrations.spoke.how_it_works.step3_title'),
    step3_desc: t('integrations.spoke.how_it_works.step3_desc'),
  },
  trust: {
    heading: t('integrations.spoke.trust.heading'),
    stat_prefix: t('integrations.spoke.trust.stat_prefix'),
    stat_number: t('integrations.spoke.trust.stat_number'),
    stat_suffix: t('integrations.spoke.trust.stat_suffix'),
  },
};
---

<Layout 
  title={title}
  description={description}
  lang={currentLang}
  keywords={keywords}
  type="software"
  breadcrumbs={breadcrumbs}
  customJsonLd={customJsonLd}
  headerVersion="default"
  footerVersion="default"
  alternateUrls={{ [currentLang]: canonicalPath }}
>
  <div class="bg-gradient-to-b from-blue-50 via-white to-gray-50 min-h-screen">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <!-- Hero Section -->
      <div class="text-center mb-16">
        <h1 class="text-4xl md:text-6xl font-bold mb-6">
          <span class="text-gray-900">Automate </span>
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-cyan-500">{app.name}</span>
          <span class="text-gray-900"> with Intelligent Messaging & Calling</span>
        </h1>
        <p class="text-xl md:text-2xl text-gray-600 mb-8 max-w-4xl mx-auto">
          {t('integrations.hub.subheadline').replaceAll('{appName}', app.name).replaceAll('{description}', app.description)}
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a 
            href={`https://zapier.com/apps/${app.slug}/integrations/seasaltai`}
            class="inline-flex items-center justify-center px-8 py-4 text-lg font-semibold rounded-full text-white bg-gradient-to-r from-blue-500 to-blue-600 hover:from-blue-600 hover:to-blue-700 transition shadow-lg hover:shadow-xl transform hover:scale-105"
            target="_blank"
            rel="noopener noreferrer"
          >
            {t('integrations.hub.cta.primary')}
          </a>
          <a 
            href="https://calendar.app.google/GcdRQv1DVoiDaoCT6/"
            class="inline-flex items-center justify-center px-8 py-4 text-lg font-semibold rounded-full text-blue-600 bg-white hover:bg-gray-50 transition shadow-md border-2 border-blue-200"
            target="_blank"
            rel="noopener noreferrer"
          >
            {t('integrations.hub.cta.secondary')}
          </a>
        </div>
      </div>

    <!-- What is Agentic Send -->
    <div class="mb-16 bg-gradient-to-r from-blue-50 to-indigo-50 rounded-2xl p-8">
      <h2 class="text-3xl font-bold text-gray-900 mb-4">
        {t('integrations.hub.agenticSend.title')}
      </h2>
      <p class="text-lg text-gray-700 mb-6">
        {t('integrations.hub.agenticSend.description')}
      </p>
      <div class="grid md:grid-cols-2 gap-6">
        <div class="bg-white rounded-lg p-6 shadow-sm">
          <h3 class="font-semibold text-gray-900 mb-2">{t('integrations.hub.agenticSend.traditional.title')}</h3>
          <p class="text-gray-600 mb-3">{t('integrations.hub.agenticSend.traditional.steps')}</p>
          <ul class="space-y-2 text-sm text-gray-600">
            <li>• {t('integrations.hub.agenticSend.traditional.step1')}</li>
            <li>• {t('integrations.hub.agenticSend.traditional.step2')}</li>
            <li>• {t('integrations.hub.agenticSend.traditional.step3')}</li>
            <li>• {t('integrations.hub.agenticSend.traditional.step4')}</li>
            <li>• {t('integrations.hub.agenticSend.traditional.step5')}</li>
          </ul>
        </div>
        <div class="bg-gradient-to-br from-green-50 to-emerald-50 rounded-lg p-6 shadow-sm border-2 border-green-300">
          <h3 class="font-semibold text-gray-900 mb-2">{t('integrations.hub.agenticSend.agentic.title')} ✨</h3>
          <p class="text-gray-600 mb-3">{t('integrations.hub.agenticSend.agentic.steps')}</p>
          <ul class="space-y-2 text-sm text-gray-700 font-medium">
            <li>• {t('integrations.hub.agenticSend.agentic.step1')}</li>
            <li>• {t('integrations.hub.agenticSend.agentic.step2')}</li>
          </ul>
        </div>
      </div>
    </div>

    <!-- Choose Your Channel -->
    <div class="mb-24">
      <h2 class="text-3xl font-bold text-gray-900 mb-8 text-center">
        Ways to Use {app.name}
      </h2>
      <div class="grid md:grid-cols-3 gap-6">
        {actionsList.map((action: any) => (
          <a 
            href={`/${currentLang}/integrations/${app.slug}/${action.slug}/`}
            class="block bg-white rounded-2xl shadow-md hover:shadow-xl transition-all duration-300 p-6 group border border-gray-100 hover:border-blue-200"
          >
            <div class="flex items-center gap-4 mb-3">
              <!-- App Icon -->
              <img src={app.image ? app.image.replace('./app_images/', '/app_images/') : '/seasalt-ai-icon.png'} alt={app.name} class="w-12 h-12 rounded-lg" />
              
              <!-- Plus sign -->
              <span class="text-2xl text-gray-300 font-light">+</span>
              
              <!-- Action Logo -->
              <img src={action.logo} alt={action.name} class="w-12 h-12" />
            </div>
            <h3 class="text-xl font-semibold text-gray-900 group-hover:text-blue-600 transition mb-2">
              {app.name} + {action.name}
            </h3>
            <p class="text-gray-600 text-sm">{action.description}</p>
          </a>
        ))}
      </div>
    </div>

    <!-- Bento Grid Section -->
    <div class="mb-24">
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4 text-center">
        Why Agentic Send?
      </h2>
      <p class="text-lg text-gray-600 mb-12 text-center max-w-3xl mx-auto">
        Transform your {app.name} workflows into intelligent messaging with zero complexity
      </p>
      <BentoGrid 
        lang={currentLang}
        translations={translations}
        actionType="sms"
        client:load
      />
    </div>

    <!-- How It Works Section -->
    <div class="mb-24">
      <HowItWorks 
        lang={currentLang}
        translations={translations}
        appName={app.name}
        client:load
      />
    </div>

    <!-- Use Cases -->
    <div class="mb-24">
      <h2 class="text-3xl font-bold text-gray-900 mb-8">
        {t('integrations.hub.useCases.title').replaceAll('{appName}', app.name)}
      </h2>
      <div class="grid md:grid-cols-3 gap-6">
        {app.useCases.map((useCase: string) => (
          <div class="bg-gradient-to-br from-blue-50 to-indigo-50 rounded-lg p-6">
            <h3 class="font-semibold text-gray-900 mb-2">{useCase}</h3>
          </div>
        ))}
      </div>
    </div>

    <!-- Example Triggers -->
    <div class="mb-24 bg-gray-50 rounded-2xl p-8">
      <h2 class="text-2xl font-bold text-gray-900 mb-4">
        {t('integrations.hub.triggers.title').replaceAll('{appName}', app.name)}
      </h2>
      <div class="flex flex-wrap gap-3">
        {app.triggerExamples.map((trigger: string) => (
          <span class="inline-flex items-center px-4 py-2 rounded-full text-sm font-medium bg-white text-gray-700 shadow-sm">
            {trigger}
          </span>
        ))}
      </div>
    </div>

    <!-- CTA Section -->
    <div class="bg-gradient-to-r from-blue-600 via-blue-500 to-indigo-600 rounded-3xl p-12 md:p-16 text-white shadow-2xl text-center">
      <h2 class="text-3xl md:text-4xl font-bold mb-4">
        {t('integrations.hub.finalCta.title').replaceAll('{appName}', app.name)}
      </h2>
      <p class="text-xl mb-8 opacity-90">
        {t('integrations.hub.finalCta.description')}
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a 
          href={`https://zapier.com/apps/${app.slug}/integrations/seasaltai`}
          class="inline-flex items-center justify-center px-8 py-4 text-lg font-semibold rounded-full text-blue-600 bg-white hover:bg-gray-50 transition shadow-lg hover:shadow-xl transform hover:scale-105"
          target="_blank"
          rel="noopener noreferrer"
        >
          {t('integrations.hub.finalCta.zapier')}
        </a>
        <a 
          href="https://calendar.app.google/GcdRQv1DVoiDaoCT6/"
          class="inline-flex items-center justify-center px-8 py-4 text-lg font-semibold rounded-full text-white hover:bg-white hover:text-blue-600 transition border-2 border-white"
          target="_blank"
          rel="noopener noreferrer"
        >
          {t('integrations.hub.finalCta.contact')}
        </a>
      </div>
    </div>
    </div>
  </div>
</Layout>
