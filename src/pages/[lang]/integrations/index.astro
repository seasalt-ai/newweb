---
import Layout from '../../../layouts/Layout.astro';
import { getSupportedLanguages, getTranslationHelpers, type SupportedLanguage } from '../../../i18n/helpers';
import curatedApps from '../../../../zapier/data/curated-apps.json';

export async function getStaticPaths() {
  // Only build English version - integrations are English-only
  return [
    {
      params: { lang: 'en' },
    }
  ];
}

const { lang } = Astro.params;
const currentLang = lang as SupportedLanguage;
const t = (key: string) => getTranslation(currentLang, key);

// Group apps by category
const appsByCategory = curatedApps.apps.reduce((acc, app) => {
  const category = app.category || 'Other';
  if (!acc[category]) {
    acc[category] = [];
  }
  acc[category].push(app);
  return acc;
}, {} as Record<string, typeof curatedApps.apps>);

// Sort categories alphabetically
const sortedCategories = Object.keys(appsByCategory).sort();

const totalApps = curatedApps.apps.length;
const totalCategories = sortedCategories.length;
---

<Layout 
  title={`Integrations - Connect with 8000+ Apps | Seasalt.ai`}
  description={`Connect Seasalt.ai with ${totalApps}+ apps across ${totalCategories} categories. Automate your workflows with SMS, WhatsApp, and Phone Call integrations.`}
  lang={currentLang}
>
  <!-- Hero Section -->
  <section class="relative bg-gradient-to-br from-blue-50 via-purple-50 to-pink-50 py-20 md:py-32 overflow-hidden">
    <div class="container mx-auto px-4">
      <div class="max-w-5xl mx-auto text-center">
        <!-- Badge -->
        <div class="inline-flex items-center gap-2 bg-white/80 backdrop-blur-sm px-4 py-2 rounded-full border border-gray-200 mb-8">
          <span class="w-2 h-2 bg-green-500 rounded-full animate-pulse"></span>
          <span class="text-sm font-medium text-gray-700">8000+ Apps Connected</span>
        </div>

        <!-- Headline -->
        <h1 class="text-5xl md:text-7xl font-bold mb-6">
          <span class="text-gray-900">Connect Your Apps with</span>
          <br />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 via-purple-600 to-pink-600">
            Agentic Send
          </span>
        </h1>

        <!-- Subheadline -->
        <p class="text-xl md:text-2xl text-gray-600 mb-12 max-w-3xl mx-auto">
          Transform any app trigger into personalized SMS, WhatsApp, or Phone Call with AI-powered automation
        </p>

        <!-- CTA -->
        <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
          <a 
            href="https://zapier.com/apps/seasaltai/integrations"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 bg-gradient-to-r from-blue-600 to-purple-600 text-white px-8 py-4 rounded-full font-semibold text-lg hover:shadow-xl transition-all duration-300 hover:scale-105"
          >
            <span>Try Seasalt.ai Integrations</span>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>

        <!-- Stats -->
        <div class="grid grid-cols-3 gap-8 max-w-2xl mx-auto mt-16">
          <div class="text-center">
            <div class="text-4xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-cyan-500">
              8000+
            </div>
            <div class="text-sm text-gray-600 mt-2">Apps</div>
          </div>
          <div class="text-center">
            <div class="text-4xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-purple-600 to-pink-500">
              100+
            </div>
            <div class="text-sm text-gray-600 mt-2">Categories</div>
          </div>
          <div class="text-center">
            <div class="text-4xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-green-600 to-emerald-500">
              30,000+
            </div>
            <div class="text-sm text-gray-600 mt-2">Actions</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Video Section -->
  <section class="video-section">
    <div class="container-agentic">
      <span class="section-label">See It In Action</span>
      <h2 class="section-title">Watch How It Works</h2>
      <div class="video-container-agentic">
        <iframe width="560" height="315" src="https://www.youtube.com/embed/DM7azkUFpNw?si=ri55FNCz4oA7Thj6" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
      </div>
    </div>
  </section>

  <!-- Hero Section: The End of the Multi-Step Zap -->
  <section class="hero-agentic">
    <div class="container-agentic">
      <div class="hero-content-agentic">
        <div class="hero-diagram">
          <img src="/agentic-send-images/5-step-to-agentic-node.jpg" alt="Fragile 5-Step Maze to Agentic Node comparison" />
        </div>

        <div class="hero-text">
          <h1>The End of the Multi-Step Zap</h1>
          <p>Replace brittle 5-Step workflows with One Intelligent Action. Connect Google Calendar, Forms, or 8,000+ apps to SMS instantly.</p>
          <div class="cta-group">
            <a href="https://seax.seasalt.ai/signup" class="btn btn-primary" target="_blank" rel="noopener noreferrer">Try Agentic Send on Seasalt.ai</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Reality Check Section -->
  <section class="reality-check">
    <div class="container-agentic">
      <span class="section-label">Reality Check</span>
      <h2 class="section-title">Why Your Simple Reminder is Actually a Nightmare</h2>
      
      <div class="comparison-grid">
        <div class="comparison-item">
          <div class="flow-diagram">
            <img src="/agentic-send-images/brittle-error-prune-zaps.png" alt="Brittle and Error-Prone workflow diagram" />
          </div>
        </div>

        <div class="comparison-item">
          <div class="warning-tiles">
            <div class="warning-tile">
              <div class="warning-icon">⚠</div>
              <div class="warning-content">
                <h4>Manual Data Mapping</h4>
                <p>Manual static data, multimapping, enumeration and three-legged connectors.</p>
              </div>
            </div>
            <div class="warning-tile">
              <div class="warning-icon">⚠</div>
              <div class="warning-content">
                <h4>Parsing Phone Numbers</h4>
                <p>Parsing area parameters/prepositions, stable as an upside on Jenga.</p>
              </div>
            </div>
            <div class="warning-tile">
              <div class="warning-icon">⚠</div>
              <div class="warning-content">
                <h4>Handling Missing Country Codes</h4>
                <p>Handling missing, capitals, miss-spelling, and intelligence maths smoothing hassle.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Solution Section -->
  <section class="solution">
    <div class="container-agentic">
      <span class="section-label">The Solution</span>
      <h2 class="section-title">One Trigger. One Action. Zero Mapping.</h2>
      <p style="max-width: 800px; margin: 0 auto 2rem; color: var(--color-text-secondary); font-size: 1.1rem;">
        Don't hope fields Just dump the data. AI parses, cleans, and maps what it needs. No formatter. No code. No fragile AI.
      </p>

      <div class="solution-diagram">
        <img src="/agentic-send-images/data-flow-diagram.png" alt="Data flow: Raw JSON to AI Brain to SMS" />
      </div>
    </div>
  </section>

  <!-- Interface Section -->
  <section class="interface">
    <div class="container-agentic">
      <span class="section-label">The Interface</span>
      
      <div class="interface-preview">
        <img src="/agentic-send-images/agentic-send-interface.jpeg" alt="Agentic Send Interface" class="interface-screenshot" />
        
        <div class="interface-text">
          <h2>You Configure with Sentences, Not Clicks</h2>
          <p>
            You are no longer a programmer.<br/>
            You are a strategic director.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Ecosystem Section -->
  <section class="ecosystem">
    <div class="container-agentic">
      <span class="section-label">The Ecosystem</span>
      
      <div class="ecosystem-content">
        <div class="ecosystem-text">
          <h2>The Universal Adapter for the Zapier Ecosystem</h2>
          <p>One sentence. One Action. Connects seamlessly into the 8,000+ apps within that Zapier Ecosystem.</p>
          
          <div class="use-cases">
            <img src="/agentic-send-images/3-use-cases-with-agentic-send.png" alt="Three use cases with Agentic Send" />
          </div>
        </div>

        <div class="ecosystem-diagram">
          <img src="/agentic-send-images/agentic-send-integrations-diagram.png" alt="Agentic Send Integrations Ecosystem" />
        </div>
      </div>
    </div>
  </section>

  <!-- Categories Section -->
  <section id="categories" class="py-20 bg-gradient-to-b from-gray-50 to-white">
    <div class="container mx-auto px-4">
      <div class="text-center mb-16">
        <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4">Browse by Category</h2>
        <p class="text-xl text-gray-600">Explore 100+ categories with 8000+ apps</p>
      </div>

      <!-- Search Bar -->
      <div class="max-w-2xl mx-auto mb-12">
        <div class="relative">
          <input 
            type="text" 
            id="app-search"
            placeholder="Search apps or categories..."
            class="w-full px-6 py-4 rounded-full border border-gray-300 focus:border-blue-500 focus:ring-2 focus:ring-blue-200 outline-none text-lg"
          />
          <svg class="absolute right-6 top-1/2 -translate-y-1/2 w-6 h-6 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
      </div>

      <!-- Categories Grid -->
      <div class="space-y-12 max-w-7xl mx-auto">
        {sortedCategories.map((category) => {
          const apps = appsByCategory[category]; // Show all apps
          
          return (
            <div class="category-section" data-category={category.toLowerCase()}>
              <div class="flex items-center justify-between mb-6">
                <h3 class="text-2xl font-bold text-gray-900">
                  {category}
                  <span class="text-lg font-normal text-gray-500 ml-2">
                    ({appsByCategory[category].length})
                  </span>
                </h3>
              </div>
              
              <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                {apps.map((app) => (
                  <div 
                    class="app-card bg-white p-4 rounded-xl border border-gray-200 hover:border-blue-400 hover:shadow-lg transition-all duration-300"
                    data-app-name={app.name.toLowerCase()}
                  >
                    <div class="flex items-center gap-3 mb-3">
                      <img 
                        src={app.image ? app.image.replace('./app_images/', '/app_images/') : '/seasalt-ai-icon.png'} 
                        alt={app.name}
                        class="w-12 h-12 object-contain flex-shrink-0"
                      />
                      <div class="flex-1 min-w-0">
                        <a 
                          href={`/${currentLang}/integrations/${app.slug}/`}
                          class="font-semibold text-gray-900 text-sm truncate hover:text-blue-600 hover:underline transition-colors block"
                        >
                          {app.name}
                        </a>
                        <div class="text-xs text-gray-500 truncate">
                          {app.category}
                        </div>
                      </div>
                    </div>
                    
                    {/* Action Links */}
                    <div class="flex gap-2">
                      <a 
                        href={`/${currentLang}/integrations/${app.slug}/sms/`}
                        class="flex-1 flex items-center justify-center gap-1 px-3 py-2 bg-blue-50 hover:bg-blue-100 text-blue-600 rounded-lg text-xs font-medium transition-colors"
                      >
                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" />
                        </svg>
                        <span>SMS</span>
                      </a>
                      <a 
                        href={`/${currentLang}/integrations/${app.slug}/whatsapp/`}
                        class="flex-1 flex items-center justify-center gap-1 px-3 py-2 bg-green-50 hover:bg-green-100 text-green-600 rounded-lg text-xs font-medium transition-colors"
                      >
                        <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 24 24">
                          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
                        </svg>
                        <span>WhatsApp</span>
                      </a>
                      <a 
                        href={`/${currentLang}/integrations/${app.slug}/phone-call/`}
                        class="flex-1 flex items-center justify-center gap-1 px-3 py-2 bg-purple-50 hover:bg-purple-100 text-purple-600 rounded-lg text-xs font-medium transition-colors"
                      >
                        <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 24 24">
                          <path d="M20.01 15.38c-1.23 0-2.42-.2-3.53-.56a.977.977 0 00-1.01.24l-1.57 1.97c-2.83-1.35-5.48-3.9-6.89-6.83l1.95-1.66c.27-.28.35-.67.24-1.02-.37-1.11-.56-2.3-.56-3.53 0-.54-.45-.99-.99-.99H4.19C3.65 3 3 3.24 3 3.99 3 13.28 10.73 21 20.01 21c.71 0 .99-.63.99-1.18v-3.45c0-.54-.45-.99-.99-.99z"/>
                        </svg>
                        <span>Call</span>
                      </a>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-20 bg-gradient-to-br from-blue-600 via-purple-600 to-pink-600 text-white">
    <div class="container mx-auto px-4 text-center">
      <h2 class="text-4xl md:text-5xl font-bold mb-6">Ready to Get Started?</h2>
      <p class="text-xl mb-8 max-w-2xl mx-auto opacity-90">
        Connect Seasalt.ai with your favorite apps and start automating intelligent conversations today
      </p>
      <a 
        href="https://zapier.com/apps/seasaltai/integrations"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 bg-white text-blue-600 px-8 py-4 rounded-full font-semibold text-lg hover:shadow-2xl transition-all duration-300 hover:scale-105"
      >
        <span>Explore on Zapier</span>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>
    </div>
  </section>

  <!-- Agentic Send Styles -->
  <style>
    :root {
      --color-bg: #faf8f5;
      --color-text: #1a1a1a;
      --color-text-secondary: #666;
      --color-accent: #4a90e2;
      --color-accent-light: #6ba3e8;
      --color-teal: #2dd4bf;
      --color-purple: #a855f7;
      --gradient-blue: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      --gradient-glow: radial-gradient(circle at center, rgba(106, 163, 232, 0.3), transparent 70%);
      --card-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
      --radius: 16px;
    }

    .container-agentic {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 2rem;
    }

    .section-label {
      display: inline-block;
      padding: 0.75rem 2rem;
      background: rgba(74, 144, 226, 0.1);
      color: var(--color-accent);
      border-radius: 50px;
      font-size: 1.25rem;
      font-weight: 700;
      text-transform: uppercase;
      margin-bottom: 2rem;
      letter-spacing: 0.5px;
    }

    /* Hero Section */
    .hero-agentic {
      padding: 4rem 0 6rem;
      text-align: center;
      background: var(--color-bg);
    }

    .hero-content-agentic {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 3rem;
      margin-bottom: 2rem;
      flex-wrap: wrap;
    }

    .hero-text {
      flex: 1;
      min-width: 320px;
      max-width: 500px;
      text-align: left;
    }

    .hero-text h1 {
      font-size: 3rem;
      font-weight: 800;
      line-height: 1.2;
      margin-bottom: 1.5rem;
      color: var(--color-text);
    }

    .hero-text p {
      font-size: 1.1rem;
      color: var(--color-text-secondary);
      margin-bottom: 2rem;
      line-height: 1.7;
    }

    .cta-group {
      display: flex;
      gap: 1rem;
      flex-wrap: wrap;
    }

    .btn {
      padding: 0.875rem 2rem;
      border-radius: 50px;
      font-weight: 600;
      font-size: 1rem;
      border: none;
      cursor: pointer;
      transition: all 0.3s ease;
      text-decoration: none;
      display: inline-block;
    }

    .btn-primary {
      background: var(--color-accent);
      color: white;
      box-shadow: 0 4px 16px rgba(74, 144, 226, 0.3);
    }

    .btn-primary:hover {
      background: var(--color-accent-light);
      transform: translateY(-2px);
      box-shadow: 0 6px 20px rgba(74, 144, 226, 0.4);
    }

    .hero-diagram {
      flex: 1;
      max-width: 750px;
    }

    .hero-diagram img {
      width: 100%;
      height: auto;
      border-radius: var(--radius);
      box-shadow: var(--card-shadow);
    }

    /* Video Section */
    .video-section {
      padding: 4rem 0;
      text-align: center;
      background: white;
    }

    .video-container-agentic {
      margin-top: 3rem;
      max-width: 900px;
      margin-left: auto;
      margin-right: auto;
      position: relative;
      padding-bottom: 56.25%;
      height: 0;
      overflow: hidden;
      border-radius: var(--radius);
      box-shadow: var(--card-shadow);
    }

    .video-container-agentic iframe {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      border: none;
      border-radius: var(--radius);
    }

    /* Reality Check Section */
    .reality-check {
      padding: 4rem 0;
      text-align: center;
      background: var(--color-bg);
    }

    .section-title {
      font-size: 2.25rem;
      font-weight: 800;
      margin-bottom: 3rem;
      color: var(--color-text);
    }

    .comparison-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
      margin-top: 3rem;
      align-items: start;
    }

    .flow-diagram {
      background: white;
      padding: 2rem;
      border-radius: var(--radius);
      box-shadow: var(--card-shadow);
    }

    .flow-diagram img {
      width: 100%;
      height: auto;
      border-radius: 12px;
    }

    /* Warning Tiles */
    .warning-tiles {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .warning-tile {
      display: flex;
      align-items: flex-start;
      gap: 1rem;
      padding: 1.25rem 1.5rem;
      background: linear-gradient(135deg, rgba(224, 242, 254, 0.8), rgba(239, 246, 255, 0.9));
      border-radius: 12px;
      border: 1px solid rgba(147, 197, 253, 0.3);
      transition: all 0.3s ease;
    }

    .warning-tile:hover {
      transform: translateX(4px);
      box-shadow: 0 4px 12px rgba(147, 197, 253, 0.2);
    }

    .warning-icon {
      font-size: 1.5rem;
      color: #f59e0b;
      flex-shrink: 0;
      line-height: 1;
    }

    .warning-content {
      flex: 1;
      text-align: left;
    }

    .warning-content h4 {
      font-size: 1rem;
      font-weight: 700;
      margin-bottom: 0.5rem;
      color: var(--color-text);
    }

    .warning-content p {
      font-size: 0.875rem;
      color: var(--color-text-secondary);
      line-height: 1.6;
      margin: 0;
    }

    /* Solution Section */
    .solution {
      padding: 4rem 0;
      text-align: center;
      background: white;
    }

    .solution-diagram {
      margin-top: 3rem;
      max-width: 1000px;
      margin-left: auto;
      margin-right: auto;
    }

    .solution-diagram img {
      width: 100%;
      height: auto;
      border-radius: var(--radius);
      box-shadow: var(--card-shadow);
    }

    /* Interface Section */
    .interface {
      padding: 4rem 0;
      text-align: center;
      background: var(--color-bg);
    }

    .interface-preview {
      margin-top: 3rem;
      background: white;
      padding: 2rem;
      border-radius: var(--radius);
      box-shadow: var(--card-shadow);
      max-width: 900px;
      margin-left: auto;
      margin-right: auto;
    }

    .interface-text {
      text-align: left;
      margin-top: 2rem;
    }

    .interface-text h2 {
      font-size: 2rem;
      font-weight: 800;
      margin-bottom: 1rem;
      color: var(--color-text);
    }

    .interface-text p {
      font-size: 1.1rem;
      color: var(--color-text-secondary);
      line-height: 1.7;
    }

    .interface-screenshot {
