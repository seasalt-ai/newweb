---
import { getTranslationHelpers, supportedLocales, type SupportedLanguage } from '../../../i18n/helpers';
import { getMeetingUrl } from "../../../constants/urls";
import Layout from '../../../layouts/Layout.astro';

export async function getStaticPaths() {
  return supportedLocales.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const { t } = await getTranslationHelpers(lang as SupportedLanguage);

const seoTitle = t('channels.instagram.seo.title');
const seoDescription = t('channels.instagram.seo.description');
const canonicalUrl = `https://seasalt.ai/${lang}/channels/instagram`;
const breadcrumbs = [
{ name: t('breadcrumbs.home'), url: `/${lang}/` },
{ name: t('breadcrumbs.channels'), url: `/${lang}/channels/` },
  { name: 'Instagram' }
];

const features = [
  {
    iconName: 'Image',
    title: t('channels.instagram.features.imageRecognition.title'),
    description: t('channels.instagram.features.imageRecognition.description')
  },
  {
    iconName: 'Play',
    title: t('channels.instagram.features.storyIntegration.title'),
    description: t('channels.instagram.features.storyIntegration.description')
  },
  {
    iconName: 'Star',
    title: t('channels.instagram.features.influencerSupport.title'),
    description: t('channels.instagram.features.influencerSupport.description')
  },
  {
    iconName: 'Zap',
    title: t('channels.instagram.features.smartAutomation.title'),
    description: t('channels.instagram.features.smartAutomation.description')
  }
];

const useCases = [
  {
    title: t('channels.instagram.useCases.ecommerce.title'),
    description: t('channels.instagram.useCases.ecommerce.description'),
    metric: t('channels.instagram.useCases.ecommerce.metric')
  },
  {
    title: t('channels.instagram.useCases.influencers.title'),
    description: t('channels.instagram.useCases.influencers.description'),
    metric: t('channels.instagram.useCases.influencers.metric')
  },
  {
    title: t('channels.instagram.useCases.localBusiness.title'),
    description: t('channels.instagram.useCases.localBusiness.description'),
    metric: t('channels.instagram.useCases.localBusiness.metric')
  },
  {
    title: t('channels.instagram.useCases.contentCreators.title'),
    description: t('channels.instagram.useCases.contentCreators.description'),
    metric: t('channels.instagram.useCases.contentCreators.metric')
  }
];
---

<Layout
  title={seoTitle}
  description={seoDescription}
  canonical={canonicalUrl}
  lang={lang}
  type="software"
  breadcrumbs={breadcrumbs}
>
  <section class="bg-gradient-to-br from-pink-50 via-white to-purple-100 py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="lg:grid lg:grid-cols-2 lg:gap-12 items-center">
        <div>
<a href={`/${lang}/channels`} class="inline-flex items-center text-gray-600 hover:text-pink-600 transition-colors duration-200 mb-8">
            <svg class="h-5 w-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
            {t('channels.instagram.navigation.backToChannels')}
          </a>
          <h1 class="text-4xl lg:text-6xl font-bold text-gray-900 mb-6">
            {t('channels.instagram.hero.title.prefix')}{' '}
            <span class="bg-gradient-to-r from-pink-600 to-purple-600 bg-clip-text text-transparent">
              {t('channels.instagram.hero.title.highlight')}
            </span>
          </h1>
          <p class="text-xl text-gray-600 mb-8">{t('channels.instagram.hero.subtitle')}</p>
          <div class="flex flex-col sm:flex-row gap-4">
            <a href="https://chat.seasalt.ai/gpt/signup" class="bg-gradient-to-r from-pink-600 to-purple-600 hover:from-pink-700 hover:to-purple-700 text-white px-8 py-4 rounded-lg text-lg font-semibold transition-all duration-200">
              {t('channels.instagram.hero.cta.primary')}
            </a>
            <a href={getMeetingUrl(lang)} class="border-2 border-pink-600 text-pink-600 hover:bg-pink-600 hover:text-white px-8 py-4 rounded-lg text-lg font-semibold transition-all duration-200">
              {t('channels.instagram.hero.cta.secondary')}
            </a>
          </div>
        </div>
        <div class="mt-12 lg:mt-0">
          <div class="bg-white rounded-2xl shadow-2xl p-6">
            <div class="flex items-center mb-4">
              <svg class="h-8 w-8 text-pink-600 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><rect x="4" y="4" width="16" height="16" rx="4"/><circle cx="12" cy="12" r="3"/></svg>
              <h3 class="text-lg font-semibold">{t('channels.instagram.hero.demo.title')}</h3>
            </div>
            <div class="space-y-3">
              <div class="bg-pink-50 p-3 rounded-lg flex items-center">
                <div class="w-8 h-8 bg-pink-200 rounded-full mr-3"></div>
                <div>
                  <p class="text-sm font-medium text-pink-800">{t('channels.instagram.hero.demo.user1.handle')}</p>
                  <p class="text-xs text-pink-600">{t('channels.instagram.hero.demo.user1.message')}</p>
                </div>
              </div>
              <div class="bg-blue-50 p-3 rounded-lg">
                <p class="text-sm text-blue-700">{t('channels.instagram.hero.demo.ai1.response')}</p>
              </div>
              <div class="bg-green-50 p-3 rounded-lg flex items-center">
                <div class="w-8 h-8 bg-green-200 rounded-full mr-3"></div>
                <div>
                  <p class="text-sm font-medium text-green-800">{t('channels.instagram.hero.demo.user2.handle')}</p>
                  <p class="text-xs text-green-600">{t('channels.instagram.hero.demo.user2.message')}</p>
                </div>
              </div>
              <div class="bg-gray-50 p-3 rounded-lg">
                <p class="text-sm text-gray-700">{t('channels.instagram.hero.demo.ai2.response')}</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Visual-First Approach -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl lg:text-4xl font-bold text-gray-900 mb-4">
          {t('channels.instagram.visualFirst.title')}
        </h2>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
          {t('channels.instagram.visualFirst.subtitle')}
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-8">
        {features.map((feature, index) => (
          <div key={index} class="p-6 rounded-2xl border border-gray-200 hover:shadow-lg transition-all duration-300">
            <div class="text-pink-600 mb-4">
              {feature.iconName === 'Image' && (
                <svg class="h-8 w-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                  <circle cx="8.5" cy="8.5" r="1.5"></circle>
                  <polyline points="21,15 16,10 5,21"></polyline>
                </svg>
              )}
              {feature.iconName === 'Play' && (
                <svg class="h-8 w-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <polygon points="5,3 19,12 5,21"></polygon>
                </svg>
              )}
              {feature.iconName === 'Star' && (
                <svg class="h-8 w-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <polygon points="12,2 15.09,8.26 22,9.27 17,14.14 18.18,21.02 12,17.77 5.82,21.02 7,14.14 2,9.27 8.91,8.26"></polygon>
                </svg>
              )}
              {feature.iconName === 'Zap' && (
                <svg class="h-8 w-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <polygon points="13,2 3,14 12,14 11,22 21,10 12,10"></polygon>
                </svg>
              )}
            </div>
            <h3 class="text-xl font-semibold text-gray-900 mb-3">
              {feature.title}
            </h3>
            <p class="text-gray-600">
              {feature.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Use Cases -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl lg:text-4xl font-bold text-gray-900 mb-4">
          {t('channels.instagram.useCases.title')}
        </h2>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
          {t('channels.instagram.useCases.subtitle')}
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
        {useCases.map((useCase, index) => (
          <div key={index} class="bg-gradient-to-br from-pink-50 to-purple-50 p-6 rounded-xl border border-pink-200 hover:shadow-lg transition-all duration-300">
            <h3 class="text-lg font-semibold text-gray-900 mb-3">
              {useCase.title}
            </h3>
            <p class="text-gray-600 text-sm mb-4">
              {useCase.description}
            </p>
            <div class="bg-gradient-to-r from-pink-500 to-purple-500 text-white p-3 rounded-lg text-center">
              <p class="font-semibold text-sm">{useCase.metric}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Instagram Business Features -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-gradient-to-r from-pink-600 to-purple-600 rounded-2xl p-12 text-white">
        <div class="text-center mb-12">
          <h2 class="text-3xl lg:text-4xl font-bold mb-4">
            {t('channels.instagram.businessIntegration.title')}
          </h2>
          <p class="text-xl opacity-90 max-w-2xl mx-auto">
            {t('channels.instagram.businessIntegration.subtitle')}
          </p>
        </div>

        <div class="grid md:grid-cols-3 gap-8">
          <div class="bg-white/10 backdrop-blur-sm p-6 rounded-xl border border-white/20">
            <svg class="h-8 w-8 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
            </svg>
            <h3 class="text-lg font-semibold mb-2 text-white">{t('channels.instagram.businessIntegration.analyticsIntegration.title')}</h3>
            <p class="text-sm text-white/90">{t('channels.instagram.businessIntegration.analyticsIntegration.description')}</p>
          </div>
          <div class="bg-white/10 backdrop-blur-sm p-6 rounded-xl border border-white/20">
            <svg class="h-8 w-8 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197m13.5-9a2.5 2.5 0 11-5 0 2.5 2.5 0 015 0z"></path>
            </svg>
            <h3 class="text-lg font-semibold mb-2 text-white">{t('channels.instagram.businessIntegration.audienceInsights.title')}</h3>
            <p class="text-sm text-white/90">{t('channels.instagram.businessIntegration.audienceInsights.description')}</p>
          </div>
          <div class="bg-white/10 backdrop-blur-sm p-6 rounded-xl border border-white/20">
            <svg class="h-8 w-8 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
            </svg>
            <h3 class="text-lg font-semibold mb-2 text-white">{t('channels.instagram.businessIntegration.engagementTracking.title')}</h3>
            <p class="text-sm text-white/90">{t('channels.instagram.businessIntegration.engagementTracking.description')}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-20 bg-gradient-to-r from-pink-600 to-purple-700">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl lg:text-4xl font-bold text-white mb-6">
        {t('channels.instagram.cta.title')}
      </h2>
      <p class="text-xl text-white opacity-90 mb-8 max-w-2xl mx-auto">
        {t('channels.instagram.cta.subtitle')}
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="https://chat.seasalt.ai/gpt/signup"
          class="bg-white text-pink-600 hover:bg-gray-50 px-8 py-4 rounded-lg text-lg font-semibold transition-all duration-200"
        >
          {t('channels.instagram.cta.primary')}
        </a>
        <a
          href={getMeetingUrl(lang)}
          class="border-2 border-white text-white hover:bg-white hover:text-pink-600 px-8 py-4 rounded-lg text-lg font-semibold transition-all duration-200"
        >
          {t('channels.instagram.cta.secondary')}
        </a>
      </div>
    </div>
  </section>
</Layout>

