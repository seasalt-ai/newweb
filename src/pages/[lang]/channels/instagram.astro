---
import { getTranslationHelpers, languages } from '../../../i18n/helpers';
import Layout from '../../../layouts/Layout.astro';

export async function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const { t } = await getTranslationHelpers(lang as keyof typeof languages);

const seoTitle = t('channels.instagram.seo.title');
const seoDescription = t('channels.instagram.seo.description');
const canonicalUrl = `https://seasalt.ai/${lang}/channels/instagram`;
const breadcrumbs = [
  { name: t('breadcrumbs.home'), url: `/${lang}/` },
  { name: t('breadcrumbs.channels'), url: `/${lang}/channels/` },
  { name: 'Instagram' }
];

const getMeetingUrl = (lang: string) => 'https://calendly.com/seasaltai/demo';
---

<Layout
  title={seoTitle}
  description={seoDescription}
  canonical={canonicalUrl}
  lang={lang}
  type="software"
  breadcrumbs={breadcrumbs}
>
  <section class="bg-gradient-to-br from-pink-50 via-white to-purple-100 py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="lg:grid lg:grid-cols-2 lg:gap-12 items-center">
        <div>
          <a href={`/${lang}/channels`} class="inline-flex items-center text-gray-600 hover:text-pink-600 transition-colors duration-200 mb-8">
            <svg class="h-5 w-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
            {t('channels.instagram.navigation.backToChannels')}
          </a>
          <h1 class="text-4xl lg:text-6xl font-bold text-gray-900 mb-6">
            {t('channels.instagram.hero.title.prefix')}{' '}
            <span class="bg-gradient-to-r from-pink-600 to-purple-600 bg-clip-text text-transparent">
              {t('channels.instagram.hero.title.highlight')}
            </span>
          </h1>
          <p class="text-xl text-gray-600 mb-8">{t('channels.instagram.hero.subtitle')}</p>
          <div class="flex flex-col sm:flex-row gap-4">
            <a href="https://chat.seasalt.ai/gpt/signup" class="bg-gradient-to-r from-pink-600 to-purple-600 hover:from-pink-700 hover:to-purple-700 text-white px-8 py-4 rounded-lg text-lg font-semibold transition-all duration-200">
              {t('channels.instagram.hero.cta.primary')}
            </a>
            <a href={getMeetingUrl(lang)} class="border-2 border-pink-600 text-pink-600 hover:bg-pink-600 hover:text-white px-8 py-4 rounded-lg text-lg font-semibold transition-all duration-200">
              {t('channels.instagram.hero.cta.secondary')}
            </a>
          </div>
        </div>
        <div class="mt-12 lg:mt-0">
          <div class="bg-white rounded-2xl shadow-2xl p-6">
            <div class="flex items-center mb-4">
              <svg class="h-8 w-8 text-pink-600 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><rect x="4" y="4" width="16" height="16" rx="4"/><circle cx="12" cy="12" r="3"/></svg>
              <h3 class="text-lg font-semibold">{t('channels.instagram.hero.demo.title')}</h3>
            </div>
            <div class="space-y-3">
              <div class="bg-pink-50 p-3 rounded-lg">
                <p class="text-sm font-medium text-pink-800">{t('channels.instagram.hero.demo.user1.handle')}</p>
                <p class="text-xs text-pink-600">{t('channels.instagram.hero.demo.user1.message')}</p>
              </div>
              <div class="bg-blue-50 p-3 rounded-lg">
                <p class="text-sm text-blue-700">{t('channels.instagram.hero.demo.ai1.response')}</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

