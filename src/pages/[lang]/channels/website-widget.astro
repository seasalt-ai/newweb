---
import { getTranslationHelpers, languages } from '../../../i18n/helpers';
import Layout from '../../../layouts/Layout.astro';

export async function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const { t } = await getTranslationHelpers(lang as keyof typeof languages);

const seoTitle = t('channels.websiteWidget.seo.title');
const seoDescription = t('channels.websiteWidget.seo.description');
const canonicalUrl = `https://seasalt.ai/${lang}/channels/website-widget`;
const breadcrumbs = [
  { name: t('breadcrumbs.home'), url: `/${lang}/` },
  { name: t('breadcrumbs.channels'), url: `/${lang}/channels/` },
  { name: 'Website Widget' }
];

const getMeetingUrl = (lang: string) => 'https://calendly.com/seasaltai/demo';

const platforms = [
  { name: t('channels.websiteWidget.platforms.wordpress.name'), description: t('channels.websiteWidget.platforms.wordpress.description'), icon: '🔌' },
  { name: t('channels.websiteWidget.platforms.shopify.name'), description: t('channels.websiteWidget.platforms.shopify.description'), icon: '🛍️' },
  { name: t('channels.websiteWidget.platforms.squarespace.name'), description: t('channels.websiteWidget.platforms.squarespace.description'), icon: '📐' },
  { name: t('channels.websiteWidget.platforms.wix.name'), description: t('channels.websiteWidget.platforms.wix.description'), icon: '🎨' },
  { name: t('channels.websiteWidget.platforms.mailerlite.name'), description: t('channels.websiteWidget.platforms.mailerlite.description'), icon: '📧' },
  { name: t('channels.websiteWidget.platforms.custom.name'), description: t('channels.websiteWidget.platforms.custom.description'), icon: '💻' }
];

const features = [
  { icon: 'Palette', title: t('channels.websiteWidget.features.design.title'), description: t('channels.websiteWidget.features.design.description') },
  { icon: 'Smartphone', title: t('channels.websiteWidget.features.mobile.title'), description: t('channels.websiteWidget.features.mobile.description') },
  { icon: 'Code', title: t('channels.websiteWidget.features.nocode.title'), description: t('channels.websiteWidget.features.nocode.description') },
  { icon: 'BarChart3', title: t('channels.websiteWidget.features.analytics.title'), description: t('channels.websiteWidget.features.analytics.description') }
];

const widgetStyles = [
  { name: t('channels.websiteWidget.styles.chatBubble.name'), description: t('channels.websiteWidget.styles.chatBubble.description'), color: 'bg-blue-500' },
  { name: t('channels.websiteWidget.styles.slidePanel.name'), description: t('channels.websiteWidget.styles.slidePanel.description'), color: 'bg-green-500' },
  { name: t('channels.websiteWidget.styles.embeddedForm.name'), description: t('channels.websiteWidget.styles.embeddedForm.description'), color: 'bg-purple-500' },
  { name: t('channels.websiteWidget.styles.fullModal.name'), description: t('channels.websiteWidget.styles.fullModal.description'), color: 'bg-orange-500' }
];
---

<Layout
  title={seoTitle}
  description={seoDescription}
  canonical={canonicalUrl}
  lang={lang}
  type="software"
  breadcrumbs={breadcrumbs}
>
  <!-- Hero Section -->
  <section class="bg-gradient-to-br from-orange-50 via-white to-orange-100 py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="lg:grid lg:grid-cols-2 lg:gap-12 items-center">
        <div>
          <a href={`/${lang}/channels`} class="inline-flex items-center text-gray-600 hover:text-orange-600 transition-colors duration-200 mb-8">
            <svg class="h-5 w-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
            {t('channels.websiteWidget.navigation.backToChannels')}
          </a>
          <h1 class="text-4xl lg:text-6xl font-bold text-gray-900 mb-6">
            {t('channels.websiteWidget.hero.title')}{' '}
            <span class="bg-gradient-to-r from-orange-600 to-orange-700 bg-clip-text text-transparent">
              {t('channels.websiteWidget.hero.titleHighlight')}
            </span>
          </h1>
          <p class="text-xl text-gray-600 mb-8">{t('channels.websiteWidget.hero.subtitle')}</p>
          <div class="flex flex-col sm:flex-row gap-4">
            <a href="https://seax.seasalt.ai/signup" class="bg-orange-600 hover:bg-orange-700 text-white px-8 py-4 rounded-lg text-lg font-semibold transition-all duration-200">
              {t('channels.websiteWidget.hero.cta.deploy')}
            </a>
            <a href={getMeetingUrl(lang)} class="border-2 border-orange-600 text-orange-600 hover:bg-orange-600 hover:text-white px-8 py-4 rounded-lg text-lg font-semibold transition-all duration-200">
              {t('channels.websiteWidget.hero.cta.demo')}
            </a>
          </div>
        </div>
        <div class="mt-12 lg:mt-0">
          <div class="bg-white rounded-2xl shadow-2xl p-6">
            <div class="flex items-center mb-4">
              <svg class="h-8 w-8 text-orange-600 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/></svg>
              <h3 class="text-lg font-semibold">{t('channels.websiteWidget.hero.widget.title')}</h3>
            </div>
            <div class="space-y-3">
              <div class="bg-orange-50 p-3 rounded-lg border-l-4 border-orange-500">
                <p class="text-sm font-medium text-orange-800">{t('channels.websiteWidget.hero.widget.chat.label')}</p>
                <p class="text-xs text-orange-600">{t('channels.websiteWidget.hero.widget.chat.description')}</p>
              </div>
              <div class="bg-blue-50 p-3 rounded-lg border-l-4 border-blue-500">
                <p class="text-sm font-medium text-blue-800">{t('channels.websiteWidget.hero.widget.voice.label')}</p>
                <p class="text-xs text-blue-600">{t('channels.websiteWidget.hero.widget.voice.description')}</p>
              </div>
              <div class="bg-green-50 p-3 rounded-lg border-l-4 border-green-500">
                <p class="text-sm font-medium text-green-800">{t('channels.websiteWidget.hero.widget.whatsapp.label')}</p>
                <p class="text-xs text-green-600">{t('channels.websiteWidget.hero.widget.whatsapp.description')}</p>
              </div>
              <div class="bg-purple-50 p-3 rounded-lg border-l-4 border-purple-500">
                <p class="text-sm font-medium text-purple-800">{t('channels.websiteWidget.hero.widget.email.label')}</p>
                <p class="text-xs text-purple-600">{t('channels.websiteWidget.hero.widget.email.description')}</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Platform Support -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl lg:text-4xl font-bold text-gray-900 mb-4">
          {t('channels.websiteWidget.platforms.title')}
        </h2>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
          {t('channels.websiteWidget.platforms.subtitle')}
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {platforms.map((platform, index) => (
          <div key={index} class="bg-gray-50 p-6 rounded-2xl hover:shadow-lg transition-all duration-300 group">
            <div class="text-4xl mb-4 group-hover:scale-110 transition-transform duration-300">
              {platform.icon}
            </div>
            <h3 class="text-xl font-semibold text-gray-900 mb-3">
              {platform.name}
            </h3>
            <p class="text-gray-600">
              {platform.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Advanced Features -->
  <section class="py-20 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl lg:text-4xl font-bold text-gray-900 mb-4">
          {t('channels.websiteWidget.features.title')}
        </h2>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
          {t('channels.websiteWidget.features.subtitle')}
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-8">
        {features.map((feature, index) => (
          <div key={index} class="bg-white p-6 rounded-2xl shadow-lg hover:shadow-xl transition-all duration-300">
            <div class="text-orange-600 mb-4">
              {feature.icon === 'Palette' && (<svg class="h-8 w-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zM21 5a2 2 0 00-2-2h-4a2 2 0 00-2 2v12a4 4 0 004 4h4a2 2 0 002-2V5z"/></svg>)}
              {feature.icon === 'Smartphone' && (<svg class="h-8 w-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>)}
              {feature.icon === 'Code' && (<svg class="h-8 w-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>)}
              {feature.icon === 'BarChart3' && (<svg class="h-8 w-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 20h18M7 10v7m5-11v11m5-6v6"/></svg>)}
            </div>
            <h3 class="text-xl font-semibold text-gray-900 mb-3">
              {feature.title}
            </h3>
            <p class="text-gray-600">
              {feature.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Widget Styles -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl lg:text-4xl font-bold text-gray-900 mb-4">
          {t('channels.websiteWidget.styles.title')}
        </h2>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
          {t('channels.websiteWidget.styles.subtitle')}
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
        {widgetStyles.map((style, index) => (
          <div key={index} class="bg-gray-50 p-6 rounded-xl hover:shadow-lg transition-all duration-300 group">
            <div class={`w-12 h-12 ${style.color} rounded-lg mb-4 group-hover:scale-110 transition-transform duration-300`}></div>
            <h3 class="text-lg font-semibold text-gray-900 mb-2">
              {style.name}
            </h3>
            <p class="text-gray-600 text-sm">
              {style.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Integration Benefits -->
  <section class="py-20 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-white rounded-2xl p-12 shadow-xl">
        <div class="text-center mb-12">
          <h2 class="text-3xl lg:text-4xl font-bold text-gray-900 mb-4">
            {t('channels.websiteWidget.benefits.title')}
          </h2>
        </div>

        <div class="grid md:grid-cols-3 gap-8">
          <div class="text-center">
            <svg class="h-12 w-12 text-orange-600 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            <h3 class="text-xl font-semibold text-gray-900 mb-3">
              {t('channels.websiteWidget.benefits.switching.title')}
            </h3>
            <p class="text-gray-600">
              {t('channels.websiteWidget.benefits.switching.description')}
            </p>
          </div>
          <div class="text-center">
            <svg class="h-12 w-12 text-orange-600 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 20h18M7 10v7m5-11v11m5-6v6"/></svg>
            <h3 class="text-xl font-semibold text-gray-900 mb-3">
              {t('channels.websiteWidget.benefits.queue.title')}
            </h3>
            <p class="text-gray-600">
              {t('channels.websiteWidget.benefits.queue.description')}
            </p>
          </div>
          <div class="text-center">
            <svg class="h-12 w-12 text-orange-600 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9 3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/></svg>
            <h3 class="text-xl font-semibold text-gray-900 mb-3">
              {t('channels.websiteWidget.benefits.global.title')}
            </h3>
            <p class="text-gray-600">
              {t('channels.websiteWidget.benefits.global.description')}
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-20 bg-gradient-to-r from-orange-600 to-orange-700">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl lg:text-4xl font-bold text-white mb-6">
        {t('channels.websiteWidget.cta.title')}
      </h2>
      <p class="text-xl text-white opacity-90 mb-8 max-w-2xl mx-auto">
        {t('channels.websiteWidget.cta.subtitle')}
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="https://seax.seasalt.ai/signup"
          class="bg-white text-orange-600 hover:bg-gray-50 px-8 py-4 rounded-lg text-lg font-semibold transition-all duration-200"
        >
          {t('channels.websiteWidget.cta.getWidget')}
        </a>
      </div>
    </div>
  </section>
</Layout>
