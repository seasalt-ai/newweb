---
import { getTranslationHelpers, languages } from '../../../i18n/helpers';
import { getMeetingUrl } from "../../../constants/urls";
import Layout from '../../../layouts/Layout.astro';

export async function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const { t } = await getTranslationHelpers(lang as keyof typeof languages);

const seoTitle = t('channels.facebookMessenger.seo.title');
const seoDescription = t('channels.facebookMessenger.seo.description');
const canonicalUrl = `https://seasalt.ai/${lang}/channels/facebook-messenger`;
const breadcrumbs = [
  { name: t('breadcrumbs.home'), url: `/${lang}/` },
  { name: t('breadcrumbs.channels'), url: `/${lang}/channels/` },
  { name: 'Facebook Messenger' }
];

const features = [
  {
    title: t('channels.facebookMessenger.features.shopIntegration.title'),
    description: t('channels.facebookMessenger.features.shopIntegration.description'),
    icon: 'Shop'
  },
  {
    title: t('channels.facebookMessenger.features.leadGeneration.title'), 
    description: t('channels.facebookMessenger.features.leadGeneration.description'),
    icon: 'Users'
  },
  {
    title: t('channels.facebookMessenger.features.socialProof.title'),
    description: t('channels.facebookMessenger.features.socialProof.description'), 
    icon: 'Star'
  },
  {
    title: t('channels.facebookMessenger.features.instantResponses.title'),
    description: t('channels.facebookMessenger.features.instantResponses.description'),
    icon: 'Zap'
  }
];
---

<Layout
  title={seoTitle}
  description={seoDescription}
  canonical={canonicalUrl}
  lang={lang}
  type="software"
  breadcrumbs={breadcrumbs}
>
  <section class="bg-gradient-to-br from-blue-50 via-white to-blue-100 py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="lg:grid lg:grid-cols-2 lg:gap-12 items-center">
        <div>
          <a href={`/${lang}/channels`} class="inline-flex items-center text-gray-600 hover:text-blue-600 transition-colors duration-200 mb-8">
            <svg class="h-5 w-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
            {t('channels.facebookMessenger.navigation.backToChannels')}
          </a>
          <h1 class="text-4xl lg:text-6xl font-bold text-gray-900 mb-6">
            {t('channels.facebookMessenger.hero.title')}{' '}
            <span class="bg-gradient-to-r from-blue-600 to-blue-700 bg-clip-text text-transparent">
              {t('channels.facebookMessenger.hero.titleHighlight')}
            </span>
          </h1>
          <p class="text-xl text-gray-600 mb-8">{t('channels.facebookMessenger.hero.subtitle')}</p>
          <div class="flex flex-col sm:flex-row gap-4">
            <a href="https://chat.seasalt.ai/gpt/signup" class="bg-blue-600 hover:bg-blue-700 text-white px-8 py-4 rounded-lg text-lg font-semibold transition-all duration-200">
              {t('channels.facebookMessenger.hero.cta.primary')}
            </a>
            <a href={getMeetingUrl(lang)} class="border-2 border-blue-600 text-blue-600 hover:bg-blue-600 hover:text-white px-8 py-4 rounded-lg text-lg font-semibold transition-all duration-200">
              {t('channels.facebookMessenger.hero.cta.secondary')}
            </a>
          </div>
        </div>
        <div class="mt-12 lg:mt-0">
          <div class="bg-white rounded-2xl shadow-2xl p-6">
            <div class="flex items-center mb-4">
              <svg class="h-8 w-8 text-blue-600 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M12 20h9l-9-9h9V9H12v2h7.5L12 18.5z"/></svg>
              <h3 class="text-lg font-semibold">{t('channels.facebookMessenger.hero.demo.title')}</h3>
            </div>
            <div class="space-y-3">
              <div class="bg-blue-50 p-3 rounded-lg">
                <p class="text-sm font-medium text-blue-800">{t('channels.facebookMessenger.hero.demo.customerQuery')}</p>
              </div>
              <div class="bg-gray-50 p-3 rounded-lg">
                <p class="text-sm text-gray-700">{t('channels.facebookMessenger.hero.demo.aiResponse1')}</p>
              </div>
              <div class="bg-white p-3 rounded-lg border border-gray-200">
                <div class="text-xs text-gray-500 mb-1">{t('channels.facebookMessenger.hero.demo.productName')}</div>
                <div class="font-semibold text-sm text-gray-900">{t('channels.facebookMessenger.hero.demo.productPrice')}</div>
              </div>
              <div class="bg-green-50 p-3 rounded-lg">
                <p class="text-sm font-medium text-green-800">{t('channels.facebookMessenger.hero.demo.customerQuery2')}</p>
              </div>
              <div class="bg-blue-50 p-3 rounded-lg">
                <p class="text-sm text-blue-700">{t('channels.facebookMessenger.hero.demo.aiResponse2')}</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Complete Social Commerce Solution -->
  <section class="py-20 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl lg:text-4xl font-bold text-gray-900 mb-4">
          {t('channels.facebookMessenger.socialCommerce.title')}
        </h2>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
          {t('channels.facebookMessenger.socialCommerce.subtitle')}
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-8">
        <div class="bg-white p-6 rounded-xl shadow-lg">
          <div class="text-blue-600 mb-4">
            <svg class="h-8 w-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 7a2 2 0 012-2h10a2 2 0 012 2v2M7 7h10"></path>
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-gray-900 mb-2">
            {t('channels.facebookMessenger.socialCommerce.productCatalog.title')}
          </h3>
          <p class="text-gray-600 text-sm">
            {t('channels.facebookMessenger.socialCommerce.productCatalog.description')}
          </p>
        </div>
        <div class="bg-white p-6 rounded-xl shadow-lg">
          <div class="text-green-600 mb-4">
            <svg class="h-8 w-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4m0 0L7 13m0 0l-2.5 5M7 13l2.5 5M17 13v6a2 2 0 01-2 2H9a2 2 0 01-2-2v-6"></path>
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-gray-900 mb-2">
            {t('channels.facebookMessenger.socialCommerce.cartRecovery.title')}
          </h3>
          <p class="text-gray-600 text-sm">
            {t('channels.facebookMessenger.socialCommerce.cartRecovery.description')}
          </p>
        </div>
        <div class="bg-white p-6 rounded-xl shadow-lg">
          <div class="text-orange-600 mb-4">
            <svg class="h-8 w-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"></path>
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-gray-900 mb-2">
            {t('channels.facebookMessenger.socialCommerce.orderTracking.title')}
          </h3>
          <p class="text-gray-600 text-sm">
            {t('channels.facebookMessenger.socialCommerce.orderTracking.description')}
          </p>
        </div>
        <div class="bg-white p-6 rounded-xl shadow-lg">
          <div class="text-purple-600 mb-4">
            <svg class="h-8 w-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"></path>
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-gray-900 mb-2">
            {t('channels.facebookMessenger.socialCommerce.customerReviews.title')}
          </h3>
          <p class="text-gray-600 text-sm">
            {t('channels.facebookMessenger.socialCommerce.customerReviews.description')}
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Social Commerce Features -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl lg:text-4xl font-bold text-gray-900 mb-4">
          {t('channels.facebookMessenger.features.title')}
        </h2>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
          {t('channels.facebookMessenger.features.subtitle')}
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
        {features.map((feature, index) => (
          <div key={index} class="p-6 rounded-2xl border border-gray-200 hover:shadow-lg transition-all duration-300">
            <div class="text-blue-600 mb-4">
              {feature.icon === 'Shop' && (
                <svg class="h-8 w-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path>
                </svg>
              )}
              {feature.icon === 'Users' && (
                <svg class="h-8 w-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197m13.5-9a2.5 2.5 0 11-5 0 2.5 2.5 0 015 0z"></path>
                </svg>
              )}
              {feature.icon === 'Star' && (
                <svg class="h-8 w-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"></path>
                </svg>
              )}
              {feature.icon === 'Zap' && (
                <svg class="h-8 w-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                </svg>
              )}
            </div>
            <h3 class="text-xl font-semibold text-gray-900 mb-3">
              {feature.title}
            </h3>
            <p class="text-gray-600">
              {feature.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Business Ecosystem Integration -->
  <section class="py-20 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl lg:text-4xl font-bold text-gray-900 mb-4">
          {t('channels.facebookMessenger.businessEcosystem.title')}
        </h2>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
          {t('channels.facebookMessenger.businessEcosystem.subtitle')}
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        <div class="bg-white p-8 rounded-xl shadow-lg text-center">
          <div class="w-16 h-16 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="h-8 w-8 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-gray-900 mb-2">
            {t('channels.facebookMessenger.businessEcosystem.shop.title')}
          </h3>
          <p class="text-gray-600">
            {t('channels.facebookMessenger.businessEcosystem.shop.description')}
          </p>
        </div>

        <div class="bg-white p-8 rounded-xl shadow-lg text-center">
          <div class="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="h-8 w-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 4V2a1 1 0 011-1h8a1 1 0 011 1v2h4a1 1 0 110 2h-1v12a2 2 0 01-2 2H6a2 2 0 01-2-2V6H3a1 1 0 010-2h4z"></path>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-gray-900 mb-2">
            {t('channels.facebookMessenger.businessEcosystem.ads.title')}
          </h3>
          <p class="text-gray-600">
            {t('channels.facebookMessenger.businessEcosystem.ads.description')}
          </p>
        </div>

        <div class="bg-white p-8 rounded-xl shadow-lg text-center">
          <div class="w-16 h-16 bg-purple-100 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="h-8 w-8 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-gray-900 mb-2">
            {t('channels.facebookMessenger.businessEcosystem.pages.title')}
          </h3>
          <p class="text-gray-600">
            {t('channels.facebookMessenger.businessEcosystem.pages.description')}
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Results Section -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl lg:text-4xl font-bold text-gray-900 mb-4">
          {t('channels.facebookMessenger.results.title')}
        </h2>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
          {t('channels.facebookMessenger.results.subtitle')}
        </p>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
        <div class="text-center">
          <div class="text-4xl font-bold text-blue-600 mb-2">{t('channels.facebookMessenger.results.engagement.value')}</div>
          <div class="text-gray-600">{t('channels.facebookMessenger.results.engagement.description')}</div>
        </div>
        <div class="text-center">
          <div class="text-4xl font-bold text-green-600 mb-2">{t('channels.facebookMessenger.results.conversion.value')}</div>
          <div class="text-gray-600">{t('channels.facebookMessenger.results.conversion.description')}</div>
        </div>
        <div class="text-center">
          <div class="text-4xl font-bold text-purple-600 mb-2">{t('channels.facebookMessenger.results.costReduction.value')}</div>
          <div class="text-gray-600">{t('channels.facebookMessenger.results.costReduction.description')}</div>
        </div>
        <div class="text-center">
          <div class="text-4xl font-bold text-orange-600 mb-2">{t('channels.facebookMessenger.results.availability.value')}</div>
          <div class="text-gray-600">{t('channels.facebookMessenger.results.availability.description')}</div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-20 bg-gradient-to-r from-blue-600 to-blue-700">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl lg:text-4xl font-bold text-white mb-6">
        {t('channels.facebookMessenger.cta.title')}
      </h2>
      <p class="text-xl text-white opacity-90 mb-8 max-w-2xl mx-auto">
        {t('channels.facebookMessenger.cta.subtitle')}
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="https://chat.seasalt.ai/gpt/signup"
          class="bg-white text-blue-600 hover:bg-gray-50 px-8 py-4 rounded-lg text-lg font-semibold transition-all duration-200"
        >
          {t('channels.facebookMessenger.cta.primary')}
        </a>
        <a
          href={getMeetingUrl(lang)}
          class="border-2 border-white text-white hover:bg-white hover:text-blue-600 px-8 py-4 rounded-lg text-lg font-semibold transition-all duration-200"
        >
          {t('channels.facebookMessenger.cta.secondary')}
        </a>
      </div>
    </div>
  </section>
</Layout>

<script>
  // 頁面載入時捲動到頂端
  window.scrollTo(0, 0);
</script>
