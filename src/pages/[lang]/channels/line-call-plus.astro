---
import Layout from '../../../layouts/Layout.astro';
import { getMeetingUrl } from "../../../constants/urls";
import Lucide from 'lucide-react';
const { MicOff, Volume2, Grid3X3, PhoneOff, PhoneCall, Phone, ArrowLeft, PlaySquare, ShieldCheck, Award, AlertCircle, Clock, CircleDollarSign, RefreshCcw, ListChecks, TrendingUp, PanelsTopLeft, CheckCircle, Calendar, Download, Mic, MessageCircle, Brain, Zap, Users, BarChart3, Star, Building2 } = Lucide;

// Only generate the zh-TW route for this landing page
export async function getStaticPaths() {
  return [{ params: { lang: 'zh-TW' } }];
}

const { lang } = Astro.params;

const seoTitle = 'LINE官方帳號一鍵通話，您的AI語音客服24小時自動上線';
const seoDescription = '結合LINE Call Plus，SeaVoice讓您的客服從成本中心轉型為營收引擎。由最懂台灣人語氣的SeaVoice AI語音助理，為您處理企業資訊問答、AI語音信箱，甚至整合inline完成自動訂位。';
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const isZh = lang === 'zh-TW' || lang === 'zh-CN';
const breadcrumbs = [
  { name: '首頁', url: `/${lang}/` },
  { name: '渠道', url: `/${lang}/channels/` },
  { name: 'LINE Call Plus' }
];

// Features data
const businessScenarios = [
  {
    icon: '🍽️',
    title: '餐飲零售業：24小時不打烊的超級店員',
    features: [
      '全天候自動訂位：透過與 inline.app 的完美整合',
      '分店資訊即時答：AI助理化身萬事通',
      '最新優惠活動語音推播：主動告知折扣活動'
    ]
  },
  {
    icon: '🛒',
    title: '電商與網拍：永不疲倦的訂單處理專家',
    features: [
      '訂單狀態與物流追蹤：即時查詢訂單狀態',
      '退換貨政策自動說明：清晰解釋流程與條款',
      '產品規格與庫存問答：提供最準確的答覆'
    ]
  },
  {
    icon: '👩‍⚕️',
    title: '診所、沙龍、服務業：您的智慧預約秘書',
    features: [
      '24小時預約排程與查詢：不受櫃檯服務時間限制',
      '服務項目與價格介紹：幫助顧客做出最佳選擇',
      '行前提醒與注意事項：大幅降低顧客失約率'
    ]
  },
  {
    icon: '🏢',
    title: '品牌企業與B2B：第一線的智慧資訊總機',
    features: [
      '潛在客戶資訊篩選與記錄：提供高質量的銷售線索',
      '取代傳統IVR：智能判斷並提供指引',
      '永不關機的品牌資訊熱線：24小時可靠管道'
    ]
  }
];

const coreFeatures = [
  {
    icon: 'Brain',
    title: '全方位知識庫，上傳即學習',
    description: '上傳Excel價目表、PDF產品型錄、公司網站網址、甚至是教學影片，AI即可在幾分鐘內學習完畢，成為該領域的專家。'
  },
  {
    icon: 'Zap',
    title: '10分鐘極速上線，無需任何程式背景',
    description: '直覺化的後台介面，讓您像編輯文件一樣簡單地設定AI助理。從建立對話流程到上傳知識，全程無需編寫任何程式碼。'
  },
  {
    icon: 'Users',
    title: 'AI與真人的完美協作',
    description: '當遇到AI無法處理的複雜問題時，系統可設定無縫轉接真人客服。真人客服可看到完整的AI對話紀錄。'
  },
  {
    icon: 'Mic',
    title: '有溫度的台灣口音，自然流暢',
    description: '採用 Seasalt.ai 獨家 SeaVoice 語音技術，專為台灣市場優化，提供最接近真人的語氣與腔調。'
  },
  {
    icon: 'BarChart3',
    title: '數據洞察儀表板',
    description: '輕鬆追蹤來電數量、熱門問題、對話長度等關鍵數據，幫助您不斷優化AI助理的表現。'
  },
  {
    icon: 'ShieldCheck',
    title: '企業級安全與權限控管',
    description: '支援角色權限、審核流程與稽核記錄，保障資料安全與法規合規。'
  }
];
---

<Layout
  title={seoTitle}
  description={seoDescription}
  canonical={canonicalUrl}
  lang={lang}
  type="software"
  breadcrumbs={breadcrumbs}
>
  <!-- Hero Section -->
  <section class="bg-gradient-to-br from-green-50 via-white to-green-100 py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="lg:grid lg:grid-cols-2 lg:gap-12 items-center">
        <div>
          <a href={`/${lang}/channels`} class="inline-flex items-center text-gray-600 hover:text-green-600 transition-colors duration-200 mb-8">
            <ArrowLeft className="h-5 w-5 mr-2" />
            返回所有渠道
          </a>
          
          <h1 class="text-4xl lg:text-6xl font-bold text-gray-900 mb-6">
            LINE官方帳號一鍵通話，您的{' '}
            <span class="bg-gradient-to-r from-green-600 to-green-700 bg-clip-text text-transparent">
              AI語音客服
            </span>
            24小時自動上線
          </h1>
          
          <p class="text-xl text-gray-600 mb-8">
            結合LINE官方雙認證技術，SeaVoice讓您的客服從「成本中心」轉型為「營收引擎」。從餐廳訂位、電商問答到售後服務，不錯過任何一通潛在商機。
          </p>
          
          <div class="flex flex-col sm:flex-row gap-4 mb-6">
            <a
              href={getMeetingUrl(lang)}
              class="bg-green-600 hover:bg-green-700 text-white px-8 py-4 rounded-lg text-lg font-semibold transition-all duration-200"
            >
              預約演示
            </a>
          </div>
          
        </div>
        
        <div class="mt-12 lg:mt-0">
          <div class="relative">
            <div id="line-call-demo" data-state="incoming" data-speaker="ai" class="bg-white rounded-2xl shadow-2xl p-6">
              <div class="flex items-center justify-between mb-4">
                <div class="flex items-center">
                  <div class="w-8 h-8 rounded-full bg-green-500 text-white flex items-center justify-center mr-3 font-bold">L</div>
                  <div>
                    <h3 class="text-lg font-semibold">商家客服（SeaVoice）</h3>
                    <p class="text-xs text-gray-500">LINE 來電 · 通話中 00:12</p>
                  </div>
                </div>
                <span class="inline-flex items-center text-xs px-2 py-1 rounded-full bg-green-50 text-green-700 border border-green-200">
                  <PhoneCall className="h-4 w-4 mr-1" />
                  從 LINE 撥打給商家
                </span>
              </div>

              <div class="relative rounded-xl bg-gray-50 border border-gray-200 p-5 overflow-hidden mb-4">
                <div class="flex items-end justify-center h-28 gap-1">
                  <div class="eq-bar w-1.5 rounded-sm" style="--h:18; --d:1100ms; --delay:0ms"></div>
                  <div class="eq-bar w-1.5 rounded-sm" style="--h:28; --d:900ms; --delay:120ms"></div>
                  <div class="eq-bar w-1.5 rounded-sm" style="--h:22; --d:1000ms; --delay:240ms"></div>
                  <div class="eq-bar w-1.5 rounded-sm" style="--h:34; --d:800ms; --delay:360ms"></div>
                  <div class="eq-bar w-1.5 rounded-sm" style="--h:40; --d:950ms; --delay:480ms"></div>
                  <div class="eq-bar w-1.5 rounded-sm" style="--h:26; --d:1050ms; --delay:600ms"></div>
                  <div class="eq-bar w-1.5 rounded-sm" style="--h:38; --d:870ms; --delay:720ms"></div>
                  <div class="eq-bar w-1.5 rounded-sm" style="--h:20; --d:980ms; --delay:840ms"></div>
                  <div class="eq-bar w-1.5 rounded-sm" style="--h:30; --d:920ms; --delay:960ms"></div>
                  <div class="eq-bar w-1.5 rounded-sm" style="--h:16; --d:1020ms; --delay:1080ms"></div>
                </div>
                <div class="absolute top-3 right-3 flex items-center gap-2">
                  <div class="indicator-ai items-center hidden">
                    <span class="w-2 h-2 bg-green-500 rounded-full mr-2"></span>
                    <span class="text-xs text-green-700">AI 說話中</span>
                  </div>
                  <div class="indicator-user items-center hidden">
                    <span class="w-2 h-2 bg-blue-500 rounded-full mr-2"></span>
                    <span class="text-xs text-blue-700">客戶說話中</span>
                  </div>
                </div>

                <style>
                  @keyframes equalize {
                    0%   { height: 8px;    opacity: .7; transform: translateY(10px); }
                    25%  { height: calc(var(--h, 20) * 1px); opacity: 1; transform: translateY(0); }
                    50%  { height: 12px;   opacity: .85; transform: translateY(6px); }
                    75%  { height: calc(var(--h, 20) * .7px); opacity: .95; transform: translateY(3px); }
                    100% { height: 8px;    opacity: .7; transform: translateY(10px); }
                  }
                  #line-call-demo .eq-bar {
                    animation: equalize var(--d, 1000ms) ease-in-out var(--delay, 0ms) infinite;
                  }
                  /* Waveform color by active speaker */
                  #line-call-demo[data-speaker="ai"] .eq-bar { background-color: #22c55e; } /* green-500 */
                  #line-call-demo[data-speaker="user"] .eq-bar { background-color: #3b82f6; } /* blue-500 */
                  /* Indicator toggle */
                  #line-call-demo .indicator-ai,
                  #line-call-demo .indicator-user { display: none; }
                  #line-call-demo[data-speaker="ai"] .indicator-ai { display: inline-flex; }
                  #line-call-demo[data-speaker="user"] .indicator-user { display: inline-flex; }
                  /* Transcript line coloring by active speaker */
                  #line-call-demo[data-speaker="ai"] .ai-line { color: #166534; }   /* green-800 */
                  #line-call-demo[data-speaker="ai"] .user-line { color: #4b5563; } /* gray-600 */
                  #line-call-demo[data-speaker="user"] .user-line { color: #1d4ed8; } /* blue-700 */
                  #line-call-demo[data-speaker="user"] .ai-line { color: #4b5563; }  /* gray-600 */
                </style>
              </div>

              <div class="flex items-center justify-center gap-4 mb-4">
                <button class="w-12 h-12 rounded-full bg-gray-100 text-gray-700 flex items-center justify-center hover:bg-gray-200 ring-1 ring-gray-200" aria-label="靜音">
                  <MicOff className="h-6 w-6" />
                </button>
                <button class="w-12 h-12 rounded-full bg-gray-100 text-gray-700 flex items-center justify-center hover:bg-gray-200 ring-1 ring-gray-200" aria-label="擴音">
                  <Volume2 className="h-6 w-6" />
                </button>
                <button class="w-12 h-12 rounded-full bg-gray-100 text-gray-400 flex items-center justify-center ring-1 ring-gray-200 cursor-not-allowed" aria-label="數字鍵盤">
                  <Grid3X3 className="h-6 w-6" />
                </button>
                <button class="w-12 h-12 rounded-full bg-red-500 text-white flex items-center justify-center hover:bg-red-600 shadow-sm" aria-label="結束通話">
                  <PhoneOff className="h-6 w-6" />
                </button>
              </div>

              <div class="bg-white/80 backdrop-blur-sm border border-gray-200 rounded-lg p-3">
                <div class="inline-flex items-center text-[10px] uppercase tracking-wide text-gray-600 mb-1">
                  <PlaySquare className="h-3 w-3 mr-1 text-gray-400" />
                  即時語音字幕
                </div>
                <div class="space-y-1.5 bg-gray-50 rounded-md p-3">
                  <p class="text-sm user-line">客戶：「我想預約明天下午的用餐」</p>
                  <p class="text-sm ai-line">AI：「好的！讓我為您查看明天下午的空位。請問幾位用餐呢？」</p>
                  <p class="text-sm user-line">客戶：「4個人」</p>
                  <p class="text-sm ai-line">AI：「明天下午2點和5點都有空位，請問您偏好哪個時段？」</p>
                </div>
              </div>
            </div>
            <script>
              (() => {
                const el = document.getElementById('line-call-demo');
                if (!el) return;
                let speaker = 'ai';
                el.setAttribute('data-speaker', speaker);
                setInterval(() => {
                  speaker = speaker === 'ai' ? 'user' : 'ai';
                  el.setAttribute('data-speaker', speaker);
                }, 2500);
              })();
            </script>
            <!-- 自動切換 AI/客戶 說話中（僅示意動畫） -->
          </div>
        </div>
      </div>




    </div>
  </section>

  <!-- LINE Certification Section -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl lg:text-4xl font-bold text-gray-900 mb-6">
          LINE官方雙重認證，技術實力最強保證
        </h2>
        <p class="text-xl text-gray-600 max-w-4xl mx-auto">
          Seasalt.ai 很榮幸成為 LINE 官方認證的 <strong>「Authorized AI Partner」</strong> 與 <strong>「Certified Provider」</strong>。我們在 AI 整合能力與技術服務穩定性上，擁有 LINE 官方認可的最高標準，是您最值得信賴的合作夥伴。
        </p>
      </div>

      <div class="flex justify-center mb-8">
        <img
          src="/products/Line-AI-Partner.png"
          alt="LINE AI Partner"
          class="max-h-[320px] md:max-h-[360px] w-auto max-w-full object-contain rounded-xl border border-gray-200 shadow-sm"
          loading="lazy"
        />
      </div>
      
      <div class="grid md:grid-cols-2 gap-8 max-w-4xl mx-auto">
        <div class="bg-gradient-to-br from-green-50 to-white p-8 rounded-2xl border-2 border-green-100 text-center hover:shadow-lg transition-all duration-300">
          <div class="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-4">
            <ShieldCheck className="h-8 w-8 text-green-600" />
          </div>
          <h3 class="text-xl font-semibold text-gray-900 mb-2">
            LINE Authorized AI Partner
          </h3>
          <p class="text-gray-600">LINE官方認證AI夥伴</p>
        </div>
        
        <div class="bg-gradient-to-br from-green-50 to-white p-8 rounded-2xl border-2 border-green-100 text-center hover:shadow-lg transition-all duration-300">
          <div class="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-4">
            <Award className="h-8 w-8 text-green-600" />
          </div>
          <h3 class="text-xl font-semibold text-gray-900 mb-2">
            LINE Certified Provider
          </h3>
          <p class="text-gray-600">LINE認證技術服務供應商</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Problem Section -->
  <section class="py-20 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl lg:text-4xl font-bold text-gray-900 mb-6">
          您的客服是否正陷入一場無聲的危機？
        </h2>
        <p class="text-xl text-gray-600">
          您的顧客正在流失，而您可能毫無察覺。
        </p>
      </div>
      
      <div class="grid md:grid-cols-2 gap-8">
        <div class="bg-white p-8 rounded-2xl shadow-lg hover:shadow-xl transition-all duration-300">
          <div class="flex items-center mb-4">
            <div class="w-12 h-12 bg-red-100 rounded-full flex items-center justify-center mr-4">
              <AlertCircle className="h-6 w-6 text-red-600" />
            </div>
            <h3 class="text-xl font-semibold text-gray-900">無盡的等待音...然後掛斷</h3>
          </div>
          <p class="text-gray-600">尖峰時段電話永遠佔線，顧客的耐心在等待中消磨殆盡，商機也隨之而去。</p>
        </div>
        
        <div class="bg-white p-8 rounded-2xl shadow-lg hover:shadow-xl transition-all duration-300">
          <div class="flex items-center mb-4">
            <div class="w-12 h-12 bg-red-100 rounded-full flex items-center justify-center mr-4">
              <Clock className="h-6 w-6 text-red-600" />
            </div>
            <h3 class="text-xl font-semibold text-gray-900">「非營業時間，請稍後再撥」</h3>
          </div>
          <p class="text-gray-600">顧客的需求從不打烊，但您的服務卻有。下班後、假日的潛在客戶，都成了錯過的遺憾。</p>
        </div>
        
        <div class="bg-white p-8 rounded-2xl shadow-lg hover:shadow-xl transition-all duration-300">
          <div class="flex items-center mb-4">
            <div class="w-12 h-12 bg-red-100 rounded-full flex items-center justify-center mr-4">
              <CircleDollarSign className="h-6 w-6 text-red-600" />
            </div>
            <h3 class="text-xl font-semibold text-gray-900">高昂的人力與時間成本</h3>
          </div>
          <p class="text-gray-600">建立與維持一個真人客服團隊，不僅薪資成本高昂，更要投入大量時間進行訓練與管理。</p>
        </div>
        
        <div class="bg-white p-8 rounded-2xl shadow-lg hover:shadow-xl transition-all duration-300">
          <div class="flex items-center mb-4">
            <div class="w-12 h-12 bg-red-100 rounded-full flex items-center justify-center mr-4">
              <RefreshCcw className="h-6 w-6 text-red-600" />
            </div>
            <h3 class="text-xl font-semibold text-gray-900">重複問題的無限迴圈</h3>
          </div>
          <p class="text-gray-600">80%的客服時間，都浪費在回答「營業到幾點？」、「地址在哪裡？」等基礎問題上，無法專注於處理更複雜的客戶需求。</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Business Scenarios Section -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl lg:text-4xl font-bold text-gray-900 mb-6">
          解鎖新商機：真實商業應用場景
        </h2>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
          Seasalt.ai 的 LINE 語音AI方案不僅是客服工具，更是各行各業的業務增長利器。
        </p>
      </div>
      
      <div class="grid lg:grid-cols-2 gap-8">
        {businessScenarios.map((scenario, index) => (
          <div class="bg-gradient-to-br from-green-50 to-white p-8 rounded-2xl border border-green-200 hover:shadow-xl transition-all duration-300">
            <div class="flex items-center mb-6">
              <div class="text-4xl mr-4">{scenario.icon}</div>
              <h3 class="text-2xl font-bold text-gray-900">{scenario.title}</h3>
            </div>
            <div class="space-y-4">
              {scenario.features.map((feature, featureIndex) => (
                <div class="flex items-start">
                  <svg class="h-5 w-5 text-green-500 mr-3 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                  </svg>
                  <p class="text-gray-700">{feature}</p>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Inline Integration Section -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <div class="flex items-center justify-center gap-3 mb-4">
          <img src="/seasalt-ai-logo.png" alt="Seasalt.ai" class="h-8 w-auto" />
          <span class="text-sm text-gray-400">x</span>
          <img src="/company_icons/inline-logo.png" alt="inline" class="h-8 w-auto" />
        </div>
        <h2 class="text-3xl lg:text-4xl font-bold text-gray-900 mb-3">
          集成 inline.app，讓訂位全自動化
        </h2>
        <p class="text-lg text-gray-600">
          通過 Seasalt.ai 與 inline 隨時電話預約訂位
        </p>
      </div>

      <div class="bg-gradient-to-br from-green-50 to-white p-6 md:p-10 rounded-2xl border border-green-200 mb-8">
        <div class="grid md:grid-cols-2 gap-8 items-start">
          <div>
            <h3 class="text-xl font-semibold text-gray-900 mb-2">Seasalt.ai x inline：電話訂位一氣呵成</h3>
            <p class="text-gray-700 mb-4">
              透過 Seasalt.ai 的 SeaVoice 語音助理，顧客從 LINE Call Plus 撥入後即可口頭完成訂位需求。系統即時查詢 inline 的可用時段、座位配置，並以語音引導完成確認，過程無需人工介入。
            </p>
