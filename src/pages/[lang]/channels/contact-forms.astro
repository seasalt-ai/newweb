---
import { getTranslationHelpers, languages } from '../../../i18n/helpers';
import Layout from '../../../layouts/Layout.astro';

export async function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const { t } = await getTranslationHelpers(lang as keyof typeof languages);

const seoTitle = t('channels.contactForms.seo.title');
const seoDescription = t('channels.contactForms.seo.description');
const canonicalUrl = `https://seasalt.ai/${lang}/channels/contact-forms`;
const breadcrumbs = [
  { name: t('breadcrumbs.home'), url: `/${lang}/` },
  { name: t('breadcrumbs.channels'), url: `/${lang}/channels/` },
  { name: 'Contact Forms' }
];

const getMeetingUrl = (lang: string) => 'https://calendly.com/seasaltai/demo';
---

<Layout
  title={seoTitle}
  description={seoDescription}
  canonical={canonicalUrl}
  lang={lang}
  type="software"
  breadcrumbs={breadcrumbs}
>
  <section class="bg-gradient-to-br from-gray-50 via-white to-gray-100 py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="lg:grid lg:grid-cols-2 lg:gap-12 items-center">
        <div>
          <a href={`/${lang}/channels`} class="inline-flex items-center text-gray-600 hover:text-gray-700 transition-colors duration-200 mb-8">
            <svg class="h-5 w-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
            {t('channels.contactForms.nav.backToChannels')}
          </a>
          <h1 class="text-4xl lg:text-6xl font-bold text-gray-900 mb-6">
            {t('channels.contactForms.hero.title.part1')}{' '}
            <span class="bg-gradient-to-r from-gray-700 to-gray-900 bg-clip-text text-transparent">
              {t('channels.contactForms.hero.title.part2')}
            </span>
          </h1>
          <p class="text-xl text-gray-600 mb-8">{t('channels.contactForms.hero.subtitle')}</p>
          <div class="flex flex-col sm:flex-row gap-4">
            <a href="https://chat.seasalt.ai/gpt/signup" class="bg-gray-800 hover:bg-gray-900 text-white px-8 py-4 rounded-lg text-lg font-semibold transition-all duration-200">
              {t('channels.contactForms.hero.ctaPrimary')}
            </a>
            <a href={getMeetingUrl(lang)} class="border-2 border-gray-800 text-gray-800 hover:bg-gray-800 hover:text-white px-8 py-4 rounded-lg text-lg font-semibold transition-all duration-200">
              {t('channels.contactForms.hero.ctaSecondary')}
            </a>
          </div>
        </div>
        <div class="mt-12 lg:mt-0">
          <div class="bg-white rounded-2xl shadow-2xl p-6">
            <div class="flex items-center mb-4">
              <svg class="h-8 w-8 text-gray-600 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
              <h3 class="text-lg font-semibold">{t('channels.contactForms.hero.demo.title')}</h3>
            </div>
            <div class="space-y-3">
              <div class="bg-gray-50 p-3 rounded-lg border-l-4 border-gray-500">
                <p class="text-sm font-medium text-gray-800">{t('channels.contactForms.hero.demo.submission')}</p>
                <p class="text-xs text-gray-600">{t('channels.contactForms.hero.demo.submitter')}</p>
              </div>
              <div class="bg-blue-50 p-3 rounded-lg">
                <p class="text-sm text-blue-700">{t('channels.contactForms.hero.demo.aiGreeting')}</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
