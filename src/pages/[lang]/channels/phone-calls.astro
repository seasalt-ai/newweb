---
import { getTranslationHelpers, supportedLocales, type SupportedLanguage } from '../../../i18n/helpers';
import { getMeetingUrl } from "../../../constants/urls";
import Layout from '../../../layouts/Layout.astro';

// 生成所有語言的靜態路徑
export async function getStaticPaths() {
const paths = supportedLocales.map((lang) => ({
    params: { lang }
  }));
  return paths;
}

// 從 params 取得語言
const { lang } = Astro.params;
const { t } = await getTranslationHelpers(lang as SupportedLanguage);

// SEO 資料
const seoTitle = t('channels.phoneCalls.seo.title') || 'Phone Calls & Voice Support - Seasalt.ai';
const seoDescription = t('channels.phoneCalls.seo.description') || 'Professional phone system with AI voice agents and human support. Handle calls, route intelligently, and provide 24/7 voice assistance with Twilio partnership.';
const seoKeywords = 'phone calls, voice support, AI voice agents, call center, phone system, Twilio integration, voice automation';
const canonicalUrl = lang === 'en' ? 'https://seasalt.ai/channels/phone-calls' : `https://seasalt.ai/${lang}/channels/phone-calls`;

// 麵包屑導航
const breadcrumbs = [
{ name: 'Home', url: `/${lang}/` },
{ name: 'Channels', url: `/${lang}/channels/` },
  { name: 'Phone Calls' }
];

// 功能列表
const features = [
  {
    iconName: 'Phone',
    title: t('channels.phoneCalls.features.humanDialpad.title'),
    description: t('channels.phoneCalls.features.humanDialpad.description')
  },
  {
    iconName: 'Bot',
    title: t('channels.phoneCalls.features.aiVoiceBot.title'),
    description: t('channels.phoneCalls.features.aiVoiceBot.description')
  },
  {
    iconName: 'Users',
    title: t('channels.phoneCalls.features.multiAgent.title'),
    description: t('channels.phoneCalls.features.multiAgent.description')
  },
  {
    iconName: 'BarChart3',
    title: t('channels.phoneCalls.features.analytics.title'),
    description: t('channels.phoneCalls.features.analytics.description')
  }
];

// Twilio 合作夥伴優勢
const benefits = [
  t('channels.phoneCalls.partnership.goldPartner.benefit1'),
  t('channels.phoneCalls.partnership.goldPartner.benefit2'),
  t('channels.phoneCalls.partnership.goldPartner.benefit3'),
  t('channels.phoneCalls.partnership.goldPartner.benefit4')
];

// 使用案例
const useCases = [
  {
    title: t('channels.phoneCalls.useCases.sales.title'),
    description: t('channels.phoneCalls.useCases.sales.description')
  },
  {
    title: t('channels.phoneCalls.useCases.support.title'),
    description: t('channels.phoneCalls.useCases.support.description')
  },
  {
    title: t('channels.phoneCalls.useCases.appointments.title'),
    description: t('channels.phoneCalls.useCases.appointments.description')
  },
  {
    title: t('channels.phoneCalls.useCases.followup.title'),
    description: t('channels.phoneCalls.useCases.followup.description')
  }
];
---

<Layout 
  title={seoTitle}
  description={seoDescription}
  canonical={canonicalUrl}
  lang={lang}
  keywords={seoKeywords}
  type="software"
  breadcrumbs={breadcrumbs}
>
  <!-- Hero Section -->
  <section class="bg-gradient-to-br from-blue-50 via-white to-blue-100 py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="lg:grid lg:grid-cols-2 lg:gap-12 items-center">
        <div>
<a href={`/${lang}/channels`} class="inline-flex items-center text-gray-600 hover:text-blue-600 transition-colors duration-200 mb-8">
            <svg class="h-5 w-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
            </svg>
            {t('channels.phoneCalls.nav.backToChannels')}
          </a>
          
          <h1 class="text-4xl lg:text-6xl font-bold text-gray-900 mb-6">
            {t('channels.phoneCalls.hero.title.prefix')}{' '}
            <span class="bg-gradient-to-r from-blue-600 to-blue-700 bg-clip-text text-transparent">
              {t('channels.phoneCalls.hero.title.highlight')}
            </span>
          </h1>
          
          <p class="text-xl text-gray-600 mb-8">
            {t('channels.phoneCalls.hero.description')}
          </p>
          
          <div class="flex flex-col sm:flex-row gap-4">
            <a
              href="https://seax.seasalt.ai/signup"
              class="bg-blue-600 hover:bg-blue-700 text-white px-8 py-4 rounded-lg text-lg font-semibold transition-all duration-200"
            >
              {t('channels.phoneCalls.hero.primaryCta')}
            </a>
            <a
              href={getMeetingUrl(lang)}
              class="border-2 border-blue-600 text-blue-600 hover:bg-blue-600 hover:text-white px-8 py-4 rounded-lg text-lg font-semibold transition-all duration-200"
            >
              {t('channels.phoneCalls.hero.secondaryCta')}
            </a>
          </div>
        </div>
        
        <div class="mt-12 lg:mt-0">
          <div class="relative">
            <div class="bg-white rounded-2xl shadow-2xl p-6">
              <div class="flex items-center mb-4">
                <svg class="h-8 w-8 text-blue-600 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
                </svg>
                <h3 class="text-lg font-semibold">{t('channels.phoneCalls.hero.dialpad.title')}</h3>
              </div>
              <div class="grid grid-cols-3 gap-2 mb-4">
                {[1,2,3,4,5,6,7,8,9,'*',0,'#'].map((num, index) => (
                  <button key={index} class="bg-gray-100 hover:bg-gray-200 p-3 rounded-lg text-center font-semibold">
                    {num}
                  </button>
                ))}
              </div>
              <div class="space-y-2">
                <button class="w-full bg-green-600 text-white py-2 rounded-lg">{t('channels.phoneCalls.hero.dialpad.callButton')}</button>
                <button class="w-full bg-red-600 text-white py-2 rounded-lg">{t('channels.phoneCalls.hero.dialpad.endCallButton')}</button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Key Features -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl lg:text-4xl font-bold text-gray-900 mb-4">
          {t('channels.phoneCalls.features.title')}
        </h2>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
          {t('channels.phoneCalls.features.description')}
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-8">
        {features.map((feature, index) => (
          <div key={index} class="p-6 rounded-2xl border border-gray-200 hover:shadow-lg transition-all duration-300">
            <div class="text-blue-600 mb-4">
              {feature.iconName === 'Phone' && (
                <svg class="h-8 w-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
                </svg>
              )}
              {feature.iconName === 'Bot' && (
                <svg class="h-8 w-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                </svg>
              )}
              {feature.iconName === 'Users' && (
                <svg class="h-8 w-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197m13.5-9a2.5 2.5 0 11-5 0 2.5 2.5 0 015 0z"></path>
                </svg>
              )}
              {feature.iconName === 'BarChart3' && (
                <svg class="h-8 w-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
                </svg>
              )}
            </div>
            <h3 class="text-xl font-semibold text-gray-900 mb-3">
              {feature.title}
            </h3>
            <p class="text-gray-600">
              {feature.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Twilio Partnership -->
  <section class="py-20 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl lg:text-4xl font-bold text-gray-900 mb-4">
          {t('channels.phoneCalls.partnership.title')}
        </h2>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
          {t('channels.phoneCalls.partnership.description')}
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-8">
        <div class="bg-white p-8 rounded-2xl shadow-lg">
          <svg class="h-12 w-12 text-blue-600 mb-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
          </svg>
          <h3 class="text-2xl font-bold text-gray-900 mb-4">{t('channels.phoneCalls.partnership.goldPartner.title')}</h3>
          <ul class="space-y-3">
            {benefits.map((benefit, index) => (
              <li key={index} class="flex items-start">
                <div class="w-2 h-2 bg-blue-600 rounded-full mt-2 mr-3 flex-shrink-0"></div>
                <span class="text-gray-700">{benefit}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="bg-white p-8 rounded-2xl shadow-lg">
          <svg class="h-12 w-12 text-green-600 mb-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <h3 class="text-2xl font-bold text-gray-900 mb-4">{t('channels.phoneCalls.partnership.global.title')}</h3>
          <div class="space-y-4">
            <div class="bg-green-50 p-4 rounded-lg">
              <h4 class="font-semibold text-green-800">{t('channels.phoneCalls.partnership.global.countries.title')}</h4>
              <p class="text-green-700 text-sm">{t('channels.phoneCalls.partnership.global.countries.description')}</p>
            </div>
            <div class="bg-blue-50 p-4 rounded-lg">
              <h4 class="font-semibold text-blue-800">{t('channels.phoneCalls.partnership.global.uptime.title')}</h4>
              <p class="text-blue-700 text-sm">{t('channels.phoneCalls.partnership.global.uptime.description')}</p>
            </div>
            <div class="bg-purple-50 p-4 rounded-lg">
              <h4 class="font-semibold text-purple-800">{t('channels.phoneCalls.partnership.global.setup.title')}</h4>
              <p class="text-purple-700 text-sm">{t('channels.phoneCalls.partnership.global.setup.description')}</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Use Cases -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl lg:text-4xl font-bold text-gray-900 mb-4">
          {t('channels.phoneCalls.useCases.title')}
        </h2>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
          {t('channels.phoneCalls.useCases.description')}
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
        {useCases.map((useCase, index) => (
          <div key={index} class="bg-gray-50 p-6 rounded-xl hover:shadow-lg transition-all duration-300">
            <h3 class="text-lg font-semibold text-gray-900 mb-3">
              {useCase.title}
            </h3>
            <p class="text-gray-600 text-sm">
              {useCase.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-20 bg-gradient-to-r from-blue-600 to-blue-700">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl lg:text-4xl font-bold text-white mb-6">
        {t('channels.phoneCalls.cta.title')}
      </h2>
      <p class="text-xl text-white opacity-90 mb-8 max-w-2xl mx-auto">
        {t('channels.phoneCalls.cta.description')}
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="https://seax.seasalt.ai/signup"
          class="bg-white text-blue-600 hover:bg-gray-50 px-8 py-4 rounded-lg text-lg font-semibold transition-all duration-200"
        >
          {t('channels.phoneCalls.cta.button')}
        </a>
      </div>
    </div>
  </section>
</Layout>

<script>
  // 頁面載入時捲動到頂端
  window.scrollTo(0, 0);
</script>
