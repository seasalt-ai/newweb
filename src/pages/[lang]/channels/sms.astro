---
import { getTranslationHelpers, extractLangFromPath, languages } from '../../../i18n/helpers';
import Layout from '../../../layouts/Layout.astro';

// 生成所有語言的靜態路徑
export async function getStaticPaths() {
  const paths = Object.keys(languages).map((lang) => ({
    params: { lang }
  }));
  return paths;
}

// 從 params 取得語言
const { lang } = Astro.params;
const { t } = await getTranslationHelpers(lang as keyof typeof languages);

// SEO 資料
const seoTitle = t('channels.sms.seo.title');
const seoDescription = t('channels.sms.seo.description');
const seoKeywords = 'SMS marketing, text message marketing, bulk SMS, SMS campaigns, customer engagement, mobile marketing';
const canonicalUrl = lang === 'en' ? 'https://seasalt.ai/channels/sms' : `https://seasalt.ai/${lang}/channels/sms`;

// 麵包屑導航
const breadcrumbs = [
  { name: 'Home', url: `/${lang}/` },
  { name: 'Channels', url: `/${lang}/channels/` },
  { name: 'SMS' }
];

// 功能列表
const features = [
  {
    iconName: 'Globe',
    title: t('channels.sms.features.globalReach.title'),
    description: t('channels.sms.features.globalReach.description')
  },
  {
    iconName: 'Shield',
    title: t('channels.sms.features.compliance.title'),
    description: t('channels.sms.features.compliance.description')
  },
  {
    iconName: 'BarChart3',
    title: t('channels.sms.features.analytics.title'),
    description: t('channels.sms.features.analytics.description')
  },
  {
    iconName: 'Clock',
    title: t('channels.sms.features.scheduling.title'),
    description: t('channels.sms.features.scheduling.description')
  }
];

// 使用案例
const useCases = [
  {
    title: t('channels.sms.useCases.marketing.title'),
    description: t('channels.sms.useCases.marketing.description'),
    stats: t('channels.sms.useCases.marketing.stats')
  },
  {
    title: t('channels.sms.useCases.appointments.title'),
    description: t('channels.sms.useCases.appointments.description'),
    stats: t('channels.sms.useCases.appointments.stats')
  },
  {
    title: t('channels.sms.useCases.orders.title'),
    description: t('channels.sms.useCases.orders.description'),
    stats: t('channels.sms.useCases.orders.stats')
  },
  {
    title: t('channels.sms.useCases.support.title'),
    description: t('channels.sms.useCases.support.description'),
    stats: t('channels.sms.useCases.support.stats')
  }
];

// 會議 URL
const getMeetingUrl = (lang: string) => {
  return 'https://calendly.com/seasaltai/demo';
};
---

<Layout 
  title={seoTitle}
  description={seoDescription}
  canonical={canonicalUrl}
  lang={lang}
  keywords={seoKeywords}
  type="software"
  breadcrumbs={breadcrumbs}
>
  <!-- Hero Section -->
  <section class="bg-gradient-to-br from-purple-50 via-white to-purple-100 py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="lg:grid lg:grid-cols-2 lg:gap-12 items-center">
        <div>
          <a href={`/${lang}/channels`} class="inline-flex items-center text-gray-600 hover:text-purple-600 transition-colors duration-200 mb-8">
            <svg class="h-5 w-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
            </svg>
            {t('channels.sms.nav.backToChannels')}
          </a>
          
          <h1 class="text-4xl lg:text-6xl font-bold text-gray-900 mb-6">
            {t('channels.sms.hero.title')}{' '}
            <span class="bg-gradient-to-r from-purple-600 to-purple-700 bg-clip-text text-transparent">
              {t('channels.sms.hero.titleHighlight')}
            </span>
          </h1>
          
          <p class="text-xl text-gray-600 mb-8">
            {t('channels.sms.hero.description')}
          </p>
          
          <div class="flex flex-col sm:flex-row gap-4">
            <a
              href="https://seax.seasalt.ai/signup"
              class="bg-purple-600 hover:bg-purple-700 text-white px-8 py-4 rounded-lg text-lg font-semibold transition-all duration-200"
            >
              {t('channels.sms.hero.cta.primary')}
            </a>
            <a
              href={getMeetingUrl(lang)}
              class="border-2 border-purple-600 text-purple-600 hover:bg-purple-600 hover:text-white px-8 py-4 rounded-lg text-lg font-semibold transition-all duration-200"
            >
              {t('channels.sms.hero.cta.secondary')}
            </a>
          </div>
        </div>
        
        <div class="mt-12 lg:mt-0">
          <div class="relative">
            <div class="bg-white rounded-2xl shadow-2xl p-6">
              <div class="flex items-center mb-4">
                <svg class="h-8 w-8 text-purple-600 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"></path>
                </svg>
                <h3 class="text-lg font-semibold">{t('channels.sms.hero.dashboard.title')}</h3>
              </div>
              <div class="space-y-3">
                <div class="bg-purple-50 p-3 rounded-lg">
                  <p class="text-sm font-medium text-purple-800">{t('channels.sms.hero.dashboard.campaign')}</p>
                  <p class="text-xs text-purple-600">{t('channels.sms.hero.dashboard.campaignSent')}</p>
                </div>
                <div class="bg-green-50 p-3 rounded-lg">
                  <p class="text-sm font-medium text-green-800">{t('channels.sms.hero.dashboard.delivered')}</p>
                  <p class="text-xs text-green-600">{t('channels.sms.hero.dashboard.deliveryRate')}</p>
                </div>
                <div class="bg-blue-50 p-3 rounded-lg">
                  <p class="text-sm font-medium text-blue-800">{t('channels.sms.hero.dashboard.replies')}</p>
                  <p class="text-xs text-blue-600">{t('channels.sms.hero.dashboard.responseRate')}</p>
                </div>
                <div class="bg-orange-50 p-3 rounded-lg">
                  <p class="text-sm font-medium text-orange-800">{t('channels.sms.hero.dashboard.conversions')}</p>
                  <p class="text-xs text-orange-600">{t('channels.sms.hero.dashboard.revenue')}</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Key Features -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl lg:text-4xl font-bold text-gray-900 mb-4">
          {t('channels.sms.features.title')}
        </h2>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
          {t('channels.sms.features.description')}
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-8">
        {features.map((feature, index) => (
          <div key={index} class="p-6 rounded-2xl border border-gray-200 hover:shadow-lg transition-all duration-300">
            <div class="text-purple-600 mb-4">
              {feature.iconName === 'Globe' && (
                <svg class="h-8 w-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
              )}
              {feature.iconName === 'Shield' && (
                <svg class="h-8 w-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
                </svg>
              )}
              {feature.iconName === 'BarChart3' && (
                <svg class="h-8 w-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
                </svg>
              )}
              {feature.iconName === 'Clock' && (
                <svg class="h-8 w-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
              )}
            </div>
            <h3 class="text-xl font-semibold text-gray-900 mb-3">
              {feature.title}
            </h3>
            <p class="text-gray-600">
              {feature.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Use Cases -->
  <section class="py-20 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl lg:text-4xl font-bold text-gray-900 mb-4">
          {t('channels.sms.useCases.title')}
        </h2>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
          {t('channels.sms.useCases.description')}
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
        {useCases.map((useCase, index) => (
          <div key={index} class="bg-white p-6 rounded-xl shadow-lg hover:shadow-xl transition-all duration-300">
            <h3 class="text-lg font-semibold text-gray-900 mb-3">
              {useCase.title}
            </h3>
            <p class="text-gray-600 text-sm mb-4">
              {useCase.description}
            </p>
            <div class="bg-purple-50 p-3 rounded-lg">
              <p class="text-purple-800 font-semibold text-sm">{useCase.stats}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Campaign Builder -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-gradient-to-r from-purple-600 to-purple-700 rounded-2xl p-12 text-white">
        <div class="text-center mb-12">
          <h2 class="text-3xl lg:text-4xl font-bold mb-4">
            {t('channels.sms.builder.title')}
          </h2>
          <p class="text-xl opacity-90 max-w-2xl mx-auto">
            {t('channels.sms.builder.description')}
          </p>
        </div>

        <div class="grid md:grid-cols-3 gap-8">
          <div class="bg-gradient-to-br from-blue-500 to-blue-600 bg-opacity-90 p-6 rounded-xl">
            <svg class="h-8 w-8 mb-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197m13.5-9a2.5 2.5 0 11-5 0 2.5 2.5 0 015 0z"></path>
            </svg>
            <h3 class="text-lg font-semibold mb-2 text-white">{t('channels.sms.builder.segmentation.title')}</h3>
            <p class="text-sm opacity-90 text-white">{t('channels.sms.builder.segmentation.description')}</p>
          </div>
          <div class="bg-gradient-to-br from-emerald-500 to-emerald-600 bg-opacity-90 p-6 rounded-xl">
            <svg class="h-8 w-8 mb-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <h3 class="text-lg font-semibold mb-2 text-white">{t('channels.sms.builder.timing.title')}</h3>
            <p class="text-sm opacity-90 text-white">{t('channels.sms.builder.timing.description')}</p>
          </div>
          <div class="bg-gradient-to-br from-orange-500 to-orange-600 bg-opacity-90 p-6 rounded-xl">
            <svg class="h-8 w-8 mb-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
            </svg>
            <h3 class="text-lg font-semibold mb-2 text-white">{t('channels.sms.builder.analytics.title')}</h3>
            <p class="text-sm opacity-90 text-white">{t('channels.sms.builder.analytics.description')}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-20 bg-gradient-to-r from-purple-600 to-purple-700">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl lg:text-4xl font-bold text-white mb-6">
        {t('channels.sms.cta.title')}
      </h2>
      <p class="text-xl text-white opacity-90 mb-8 max-w-2xl mx-auto">
        {t('channels.sms.cta.description')}
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="https://seax.seasalt.ai/signup"
          class="bg-white text-purple-600 hover:bg-gray-50 px-8 py-4 rounded-lg text-lg font-semibold transition-all duration-200"
        >
          {t('channels.sms.cta.button')}
        </a>
      </div>
    </div>
  </section>
</Layout>

<script>
  // 頁面載入時捲動到頂端
  window.scrollTo(0, 0);
</script>
