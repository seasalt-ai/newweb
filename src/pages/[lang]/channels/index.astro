---
import { getTranslationHelpers, languages } from '../../../i18n/helpers';
import { getMeetingUrl } from "../../../constants/urls";
import Layout from '../../../layouts/Layout.astro';

export async function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const { t } = await getTranslationHelpers(lang as keyof typeof languages);

const seoTitle = t('channelsOverview.seo.title');
const seoDescription = t('channelsOverview.seo.description');
const canonicalUrl = `https://seasalt.ai/${lang}/channels`;

const breadcrumbs = [
  { name: t('breadcrumbs.home'), url: `/${lang}/` },
  { name: t('breadcrumbs.channels') }
];

const channels = [
  {
    name: t('channelsOverview.channels.whatsappBusiness.name'),
    link: '/channels/whatsapp',
    color: 'text-green-600',
    bgColor: 'bg-green-50',
    icon: 'MessageCircle'
  },
  {
    name: t('channelsOverview.channels.voicePhoneCalls.name'),
    link: '/channels/phone-calls',
    color: 'text-blue-600', 
    bgColor: 'bg-blue-50',
    icon: 'Phone'
  },
  {
    name: t('channelsOverview.channels.smsMessaging.name'),
    link: '/channels/sms',
    color: 'text-purple-600',
    bgColor: 'bg-purple-50',
    icon: 'MessageSquare'
  },
  {
    name: t('channelsOverview.channels.websiteChatWidget.name'),
    link: '/channels/website-chat',
    color: 'text-indigo-600',
    bgColor: 'bg-indigo-50',
    icon: 'Monitor'
  },
  {
    name: t('channelsOverview.channels.instagramDMs.name'),
    link: '/channels/instagram',
    color: 'text-pink-600',
    bgColor: 'bg-pink-50',
    icon: 'Instagram'
  },
  {
    name: t('channelsOverview.channels.facebookMessenger.name'),
    link: '/channels/facebook-messenger',
    color: 'text-blue-700',
    bgColor: 'bg-blue-50',
    icon: 'Mail'
  },
  {
    name: t('channelsOverview.channels.contactForms.name'),
    link: '/channels/contact-forms',
    color: 'text-gray-600',
    bgColor: 'bg-gray-50',
    icon: 'FileText'
  },
  {
    name: t('channelsOverview.channels.lineBusiness.name'),
    link: '/channels/line',
    color: 'text-green-500',
    bgColor: 'bg-green-50',
    icon: 'Smartphone'
  },
  {
    name: t('channelsOverview.channels.websiteWidget.name'),
    link: '/channels/website-widget',
    color: 'text-orange-600',
    bgColor: 'bg-orange-50',
    icon: 'Globe'
  }
];
---

<Layout
  title={seoTitle}
  description={seoDescription}
  canonical={canonicalUrl}
  lang={lang}
  type="software"
  breadcrumbs={breadcrumbs}
>
  <!-- Hero Section -->
  <section class="bg-gradient-to-br from-blue-50 via-white to-indigo-50 py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <a href={`/${lang}/`} class="inline-flex items-center text-gray-600 hover:text-blue-600 transition-colors duration-200 mb-8">
          <svg class="h-5 w-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
          {t('channelsOverview.hero.backToHome')}
        </a>
        <h1 class="text-4xl lg:text-6xl font-bold text-gray-900 mb-6">
          {t('channelsOverview.hero.title')}{' '}
          <span class="bg-gradient-to-r from-blue-600 to-indigo-600 bg-clip-text text-transparent">
            {t('channelsOverview.hero.titleHighlight')}
          </span>
        </h1>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
          {t('channelsOverview.hero.subtitle')}
        </p>
      </div>

      <div class="relative max-w-4xl mx-auto">
        <div class="bg-white rounded-2xl shadow-2xl p-8 text-center">
          <div class="bg-gradient-to-r from-blue-600 to-indigo-600 text-white p-6 rounded-xl mb-6">
            <h3 class="text-2xl font-bold">{t('channelsOverview.hero.hubTitle')}</h3>
            <p class="opacity-90">{t('channelsOverview.hero.hubSubtitle')}</p>
          </div>
          <div class="grid grid-cols-3 md:grid-cols-5 gap-4">
            {channels.slice(0, 5).map((channel) => (
              <div class={`${channel.bgColor} ${channel.color} p-3 rounded-lg`}>
                <svg class="h-8 w-8 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  {channel.icon === 'MessageCircle' && <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>}
                  {channel.icon === 'Phone' && <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>}
                  {channel.icon === 'MessageSquare' && <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8h2a2 2 0 012 2v6a2 2 0 01-2 2h-2v4l-4-4H9a2 2 0 01-2-2v-6a2 2 0 012-2h8z"/>}
                  {channel.icon === 'Monitor' && <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>}
                  {channel.icon === 'Instagram' && <rect x="4" y="4" width="16" height="16" rx="4"></rect>}
                </svg>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Channels Grid -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl lg:text-4xl font-bold text-gray-900 mb-4">
          {t('channelsOverview.channelsSection.title')}
        </h2>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
          {t('channelsOverview.channelsSection.subtitle')}
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {channels.map((channel, index) => (
          <div class="p-6 rounded-2xl border-2 border-gray-200 hover:border-gray-300 hover:shadow-lg transition-all duration-300 group">
            <div class="flex items-start justify-between mb-4">
              <div class={`${channel.bgColor} ${channel.color} p-3 rounded-xl group-hover:scale-110 transition-transform duration-300`}>
                <svg class="h-8 w-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  {channel.icon === 'MessageCircle' && <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>}
                  {channel.icon === 'Phone' && <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>}
                  {channel.icon === 'MessageSquare' && <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8h2a2 2 0 012 2v6a2 2 0 01-2 2h-2v4l-4-4H9a2 2 0 01-2-2v-6a2 2 0 012-2h8z"/>}
                  {channel.icon === 'Monitor' && <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>}
                  {channel.icon === 'Instagram' && <rect x="4" y="4" width="16" height="16" rx="4"></rect>}
                  {channel.icon === 'Mail' && <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>}
                  {channel.icon === 'FileText' && <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>}
                  {channel.icon === 'Smartphone' && <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/>}
                  {channel.icon === 'Globe' && <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9 3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/>}
                </svg>
              </div>
            </div>
            
            <h3 class="text-xl font-semibold text-gray-900 mb-4">
              {channel.name}
            </h3>
            
            <a
              href={`/${lang}${channel.link}`}
              class="block w-full text-center bg-gray-100 hover:bg-gray-200 text-gray-800 py-3 rounded-lg font-medium transition-colors duration-200"
            >
              {t('channelsOverview.labels.learnMore')}
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-20 bg-gradient-to-r from-blue-600 to-indigo-600">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl lg:text-4xl font-bold text-white mb-6">
        {t('channelsOverview.cta.title')}
      </h2>
      <p class="text-xl text-white opacity-90 mb-8 max-w-2xl mx-auto">
        {t('channelsOverview.cta.subtitle')}
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="https://seax.seasalt.ai/signup"
          class="bg-white text-blue-600 hover:bg-gray-50 px-8 py-4 rounded-lg text-lg font-semibold transition-all duration-200"
        >
          {t('channelsOverview.cta.signUp')}
        </a>
        <a
          href={getMeetingUrl(lang)}
          class="border-2 border-white text-white hover:bg-white hover:text-blue-600 px-8 py-4 rounded-lg text-lg font-semibold transition-all duration-200"
        >
          {t('channelsOverview.cta.bookDemo')}
        </a>
      </div>
    </div>
  </section>
</Layout>
