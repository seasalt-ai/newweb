---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="SeaSalt.ai - AI-Powered Contact Center Solutions">
	<Header />
	<main>
		<div class="max-w-7xl mx-auto py-16 px-4 sm:px-6 lg:px-8">
			<div class="text-center">
				<h1 class="text-4xl font-bold text-gray-900 sm:text-5xl md:text-6xl">
					Welcome to <span class="text-blue-600">SeaSalt.ai</span>
				</h1>
				<p class="mt-3 max-w-md mx-auto text-base text-gray-500 sm:text-lg md:mt-5 md:text-xl md:max-w-3xl">
					AI-Powered Contact Center Solutions for the Modern Enterprise
				</p>
				<div class="mt-5 max-w-md mx-auto sm:flex sm:justify-center md:mt-8">
					<div class="rounded-md shadow">
						<a href="/products" class="w-full flex items-center justify-center px-8 py-3 border border-transparent text-base font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700 md:py-4 md:text-lg md:px-10">
							Explore Products
						</a>
					</div>
				</div>
			</div>
		</div>
	</main>
	<Footer />
</Layout>
