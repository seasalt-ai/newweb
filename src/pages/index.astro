---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ProblemSolution from '../components/ProblemSolution.astro';
import Features from '../components/Features.astro';

const lang = 'en'; // Default language for root page
const title = 'SeaSalt.ai - AI-Powered Contact Center Solutions';
const description = 'Transform your customer communications with SeaSalt.ai\'s AI-powered omnichannel platform. Unify WhatsApp, SMS, voice calls, and chat in one intelligent solution.';
---

<Layout title={title} description={description} lang={lang}>
	<Hero lang={lang} />
	<ProblemSolution lang={lang} />
	<Features lang={lang} />
</Layout>
