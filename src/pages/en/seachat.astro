---
import Layout from '../../layouts/Layout.astro';

// SEO 設定
const title = 'SeaChat - AI-Powered Chatbot Platform | SeaSalt.ai';
const description = 'Transform your customer support with SeaChat\'s AI-powered chatbot platform. Automate conversations across WhatsApp, SMS, webchat, and voice calls.';
const keywords = 'AI chatbot, customer service automation, WhatsApp business, conversational AI, chatbot platform, customer support';
---

<Layout 
  title={title} 
  description={description} 
  lang="en"
  keywords={keywords}
  type="website"
  headerVersion="seachat"
  footerVersion="seachat"
>
  <!-- Hero Section -->
  <section class="bg-gradient-to-br from-blue-50 to-indigo-100 py-16 lg:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <div class="flex justify-center mb-8">
          <img 
            src="/seachat-logo.png" 
            alt="SeaChat Logo" 
            class="h-16 w-auto"
          />
        </div>
        <h1 class="text-4xl md:text-6xl font-bold text-gray-900 mb-6">
          AI-Powered Customer Support
        </h1>
        <p class="text-xl text-gray-600 mb-8 max-w-3xl mx-auto">
          Transform your customer conversations with SeaChat's intelligent chatbot platform. 
          Automate support across all channels while maintaining a human touch.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="https://chat.seasalt.ai/gpt/signup"
            class="bg-teal-500 hover:bg-teal-600 text-white px-8 py-4 rounded-lg font-semibold text-lg transition-all transform hover:scale-105 shadow-lg"
          >
            Start Free Trial
          </a>
          <a
            href="https://calendly.com/seasalt-ai/seasalt-ai-demo"
            target="_blank"
            rel="noopener noreferrer"
            class="border-2 border-teal-500 text-teal-500 hover:bg-teal-500 hover:text-white px-8 py-4 rounded-lg font-semibold text-lg transition-all"
          >
            Schedule Demo
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Test Content Section -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-gray-900 mb-4">
          Header & Footer Test Page
        </h2>
        <p class="text-lg text-gray-600">
          This is a test page to verify the SeaChat header and footer functionality.
        </p>
      </div>

      <!-- Navigation Test Section -->
      <div class="bg-gray-100 rounded-lg p-8">
        <h3 class="text-2xl font-bold text-gray-900 mb-6 text-center">
          Component Status Check
        </h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <h4 class="text-lg font-semibold text-gray-900 mb-4">Header Features:</h4>
            <ul class="space-y-2 text-gray-600">
              <li>✅ PhoneBanner with close functionality</li>
              <li>✅ ProductLogoDropdown for product navigation</li>
              <li>✅ Complete navigation dropdowns (Features, Integrations, Solutions)</li>
              <li>✅ Wiki button with gradient styling</li>
              <li>✅ Sign In / Get Started buttons</li>
              <li>✅ Language switcher (20 languages)</li>
              <li>✅ Mobile responsive menu</li>
            </ul>
          </div>
          <div>
            <h4 class="text-lg font-semibold text-gray-900 mb-4">Footer Features:</h4>
            <ul class="space-y-2 text-gray-600">
              <li>✅ Complete 5-column layout</li>
              <li>✅ Social media links</li>
              <li>✅ Collapsible mobile sections</li>
              <li>✅ Statistics display</li>
              <li>✅ CTA banner</li>
              <li>✅ Legal links</li>
              <li>✅ Company information</li>
            </ul>
          </div>
        </div>

        <!-- Test Links -->
        <div class="mt-8 text-center">
          <h4 class="text-lg font-semibold text-gray-900 mb-4">Quick Test Links:</h4>
          <div class="flex flex-wrap gap-3 justify-center">
            <a href="/en/" class="bg-blue-100 text-blue-800 px-3 py-1 rounded text-sm hover:bg-blue-200">Main Site</a>
            <a href="/en/seachat/" class="bg-teal-100 text-teal-800 px-3 py-1 rounded text-sm hover:bg-teal-200 font-semibold">SeaChat (Dynamic)</a>
            <a href="/en/seachat" class="bg-teal-100 text-teal-800 px-3 py-1 rounded text-sm hover:bg-teal-200">SeaChat (Static)</a>
            <a href="/zh-tw/seachat/" class="bg-purple-100 text-purple-800 px-3 py-1 rounded text-sm hover:bg-purple-200">繁體中文</a>
            <a href="/zh-cn/seachat/" class="bg-purple-100 text-purple-800 px-3 py-1 rounded text-sm hover:bg-purple-200">简体中文</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Spacer Section -->
  <section class="py-32 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-bold text-gray-900 mb-4">
        Scroll down to see the footer
      </h2>
      <p class="text-lg text-gray-600">
        This section provides space to test the complete page layout and footer visibility.
      </p>
      <div class="mt-8">
        <div class="inline-flex items-center justify-center w-16 h-16 bg-teal-100 rounded-full">
          <svg class="w-8 h-8 text-teal-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
          </svg>
        </div>
      </div>
    </div>
  </section>
</Layout>