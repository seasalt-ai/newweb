---
import { getTranslationHelpers, extractLangFromPath } from '../i18n/helpers';

const currentLang = extractLangFromPath(Astro.url.pathname);
const { t } = await getTranslationHelpers(currentLang);

// Products data exactly from old version
const products = [
  {
    title: t('productsData.seachat.title'),
    href: '/seachat',
    description: t('productsData.seachat.description'),
    icon: 'MessageSquare'
  },
  {
    title: t('productsData.seax.title'),
    href: '/seax',
    description: t('productsData.seax.description'),
    icon: 'Users'
  },
  {
    title: t('productsData.seameet.title'),
    href: 'https://seameet.ai/',
    description: t('productsData.seameet.description'),
    icon: 'Video'
  },
  {
    title: t('productsData.seavoice.title'),
    href: '/seavoice',
    description: t('productsData.seavoice.description'),
    icon: 'Mic',
    subProducts: [
      {
        title: t('productsData.seavoice.subProducts.tts'),
        href: 'https://suite.seasalt.ai/tts/'
      },
      {
        title: t('productsData.seavoice.subProducts.stt'),
        href: 'https://suite.seasalt.ai/stt/'
      },
      {
        title: t('productsData.seavoice.subProducts.discord'),
        href: 'https://voice.seasalt.ai/discord/'
      }
    ]
  }
];

// Solutions data exactly from old version
const solutions = [
  {
    title: t('solutionsData.salesMarketing.title'),
    path: '/solutions/sales-marketing',
    slug: 'sales-marketing',
    icon: 'TrendingUp'
  },
  {
    title: t('solutionsData.customerSupport.title'),
    path: '/solutions/customer-support',
    slug: 'customer-support',
    icon: 'Headphones'
  },
  {
    title: t('solutionsData.aiAutomation.title'),
    path: '/solutions/ai-automation',
    slug: 'ai-automation',
    icon: 'Bot'
  },
  {
    title: t('solutionsData.smeOwners.title'),
    path: '/solutions/sme-owners',
    slug: 'sme-owners',
    icon: 'Building2'
  }
];

// Industries data exactly from old version
const industries = [
  {
    icon: 'ShoppingCart',
    title: t('industriesData.ecommerce.title'),
    slug: 'e-commerce'
  },
  {
    icon: 'Heart',
    title: t('industriesData.healthcare.title'),
    slug: 'healthcare'
  },
  {
    icon: 'Home',
    title: t('industriesData.realEstate.title'),
    slug: 'real-estate'
  },
  {
    icon: 'Utensils',
    title: t('industriesData.restaurants.title'),
    slug: 'restaurants-hospitality'
  },
  {
    icon: 'GraduationCap',
    title: t('industriesData.education.title'),
    slug: 'education-training'
  },
  {
    icon: 'Car',
    title: t('industriesData.automotive.title'),
    slug: 'automotive-services'
  },
  {
    icon: 'Briefcase',
    title: t('industriesData.professional.title'),
    slug: 'professional-services'
  },
  {
    icon: 'Building',
    title: t('industriesData.financial.title'),
    slug: 'financial-services'
  }
];

// Helper function to get Wiki URL
const getWikiUrl = () => {
  const wikiLanguage = (currentLang === 'zh-TW' || currentLang === 'zh-CN') ? 'zh' : 'en';
  return `https://wiki.seasalt.ai/${wikiLanguage}`;
};

// Helper function to get meeting URL
const getMeetingUrl = (lang: string) => {
  return 'https://cal.com/seasalt-ai/demo';
};

const currentYear = new Date().getFullYear();
---

<footer class="bg-gray-900 text-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-2 sm:gap-3 lg:gap-4">
      
      {/* Company Info */}
      <div class="lg:col-span-1">
        <div class="flex items-center mb-6">
          <img 
            src="/seasalt-ai-logo.png" 
            alt="Seasalt.ai" 
            class="h-8 w-auto brightness-0 invert"
          />
        </div>
        <p class="text-gray-300 mb-4 sm:mb-6 text-sm sm:text-base">
          {t('footer.tagline')}
