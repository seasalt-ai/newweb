<script>
  // Mobile collapsible sections for footer
  document.addEventListener('DOMContentLoaded', function() {
    // Initialize collapsed state (mobile starts collapsed)
    const collapsedSections = {
      products: true,
      solutions: true,
      industries: true,
      company: true
    };
    
    // Handle mobile section toggles
    document.querySelectorAll('.mobile-section-toggle').forEach(toggle => {
      const button = toggle as HTMLElement;
      const sectionName = button.getAttribute('data-section');
      
      if (sectionName) {
        button.addEventListener('click', () => {
          const content = document.querySelector(`[data-section-content="${sectionName}"]`);
          const chevron = button.querySelector('.mobile-chevron');
          
          if (content && chevron) {
            const isCollapsed = collapsedSections[sectionName as keyof typeof collapsedSections];
            
            if (isCollapsed) {
              // Expand
              content.classList.remove('hidden');
              content.classList.add('block');
              chevron.classList.add('rotate-180');
            } else {
              // Collapse
              content.classList.add('hidden');
              content.classList.remove('block');
              chevron.classList.remove('rotate-180');
            }
            
            collapsedSections[sectionName as keyof typeof collapsedSections] = !isCollapsed;
          }
        });
      }
    });
  });
</script>
