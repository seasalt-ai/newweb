---
import { getTranslationHelpers, extractLangFromPath, type SupportedLanguage } from '../i18n/helpers';

const currentLang = extractLangFromPath(Astro.url.pathname);
const { t } = await getTranslationHelpers(currentLang);

// Use Taiwan phone number for zh-TW, US toll-free for others
const phoneHref = currentLang === 'zh-tw' 
  ? 'tel:+886-2-77443577'  // Taiwan number
  : 'tel:+1-762-242-4368'; // US toll-free number
---

<div class="bg-gradient-to-r from-blue-600 via-blue-700 to-indigo-800 text-white py-3 px-4 shadow-lg border-b-2 border-blue-500">
  <div class="max-w-7xl mx-auto flex items-center justify-center">
    <div class="flex items-center space-x-2 text-center">
      <svg class="w-5 h-5 animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
      </svg>
      <span class="font-semibold text-lg">
        {t('phoneBanner.callText')} <a 
          href={phoneHref}
          class="text-yellow-300 hover:text-yellow-200 underline decoration-2 underline-offset-2"
        >
          {t('phoneBanner.phoneNumber')}
        </a> {t('phoneBanner.bookingText')}
      </span>
      <div class="flex items-center space-x-1 text-yellow-300">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        <span class="text-sm font-medium">{t('phoneBanner.availability')}</span>
      </div>
    </div>
  </div>
</div>
