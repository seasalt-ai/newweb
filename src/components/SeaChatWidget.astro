---
// Channel Widget Component
// 右下角渠道按鈕（LINE / Instagram / Messenger / WhatsApp / Voice）+ Omniocto 聊天 widget
// 與 ngChat frontend/seachat/public/index.html 的 widget 同步
---

<!-- Channel Widget -->
<button id="sui-widget-btn" aria-label="Contact channels"></button>
<button id="sui-Line-btn" class="chat-button" aria-label="LINE"></button>
<button id="sui-Instagram-btn" class="chat-button" aria-label="Instagram"></button>
<button id="sui-Messenger-btn" class="chat-button" aria-label="Messenger"></button>
<button id="sui-WhatsApp-btn" class="chat-button" aria-label="WhatsApp"></button>
<button id="sui-Voice-btn" class="chat-button" aria-label="Call us"></button>

<!-- Omniocto Widget -->
<script
  is:inline
  src="https://agent.omniocto.com/widget.js"
  data-deployment-id="a41cae24-2086-4788-9d0a-98e9d75ee92a"
  async
></script>

<!--
  is:global: #sui-call-form is created at runtime, so scoped styles would not reach it.
  Omniocto's launcher sits at 20–70px from the bottom, so our stack starts right above it at 82px.
  Its greeting bubble (82–136px, above every z-index we can set) covers the first slot until the
  visitor dismisses it; Omniocto has no option to turn the bubble off.
-->
<style is:global>
  .chat-button,
  #sui-widget-btn {
    position: fixed;
    right: 16px;
    width: 56px;
    height: 56px;
    padding: 0;
    border: none;
    border-radius: 50%;
    box-shadow: 1px 2px 8px 0px #000;
    background-color: transparent;
    background-position: 50%;
    background-repeat: no-repeat;
    background-size: cover;
    z-index: 9997;
    cursor: pointer;
  }
  .chat-button {
    display: block;
  }
  /* Initial slots; initChannelWidgets() recalculates these on load and resize */
  #sui-Line-btn {
    bottom: 82px;
    background-image: url(https://seasalt-cdn.s3.us-west-2.amazonaws.com/f2e/icon-line.svg);
  }
  #sui-Instagram-btn {
    bottom: 150px;
    background-image: url(https://seasalt-cdn.s3.us-west-2.amazonaws.com/f2e/icon-instagram.svg);
  }
  #sui-Messenger-btn {
    bottom: 218px;
    background-image: url(https://seasalt-cdn.s3.us-west-2.amazonaws.com/f2e/icon-facebook.svg);
  }
  #sui-WhatsApp-btn {
    bottom: 286px;
    background-image: url(https://seasalt-cdn.s3.us-west-2.amazonaws.com/f2e/icon-whatsapp.svg);
  }
  #sui-Voice-btn {
    bottom: 354px;
    background-image: url(https://seasalt-cdn.s3.us-west-2.amazonaws.com/f2e/icon-voice.svg);
  }
  #sui-widget-btn {
    display: none;
    bottom: 82px;
    background-image: url(https://seasalt-cdn.s3.us-west-2.amazonaws.com/f2e/icon-widget.svg);
  }
  #sui-widget-btn.close {
    background-image: url(https://seasalt-cdn.s3.us-west-2.amazonaws.com/f2e/icon-close.svg);
  }
  #sui-call-form {
    position: fixed;
    display: none;
    /* Clear of the Omniocto greeting bubble so it cannot cover the form */
    bottom: 148px;
    right: 80px;
    border: none;
    border-radius: 10px;
    box-shadow: 0 0 6px 0 rgba(0, 0, 0, 0.9);
    background: #fff;
    z-index: 9998;
  }
  @media only screen and (max-width: 460px) {
    #sui-widget-btn {
      display: block;
    }
    .chat-button {
      display: none;
    }
    .chat-button.show {
      display: block;
    }
    #sui-call-form {
      right: 50%;
      transform: translate(50%, -12%);
    }
  }
</style>

<script>
  // Keep in sync with the 82px slots in the styles above.
  var FIRST_SLOT = 82;
  var SLOT_HEIGHT = 68;

  function initChannelWidgets() {
    var isMobile = window.innerWidth <= 460;
    var expanded = false;
    var widgetButton = document.querySelector('#sui-widget-btn');

    var channels = [
      { channel_type: 'Line', channel_url: 'https://lin.ee/fFNydh0a' },
      { channel_type: 'Instagram', channel_url: 'https://www.instagram.com/seasalt.ai/' },
      { channel_type: 'Messenger', channel_url: 'https://mobile.facebook.com/profile.php?id=106953261045343' },
      { channel_type: 'WhatsApp', channel_url: 'https://api.whatsapp.com/send/?phone=%2B14252987474&text&type=phone_number&app_absent=0' },
      {
        channel_type: 'Voice',
        channel_url:
          '<iframe src="https://docs.google.com/forms/d/e/1FAIpQLSe1Z3Yq1u4w-eMZvCYdLoexkFRiJNirN7Ksr6I_et15DJBobA/viewform?embedded=true" width="600" height="500" frameborder="0" marginheight="0" marginwidth="0">Loading…</iframe>',
      },
    ];

    function calc() {
      // On mobile the toggle button takes the first slot, so channels start one slot higher.
      var first = isMobile ? FIRST_SLOT + SLOT_HEIGHT : FIRST_SLOT;
      document.querySelectorAll('.chat-button').forEach(function (button, index) {
        button.style.bottom = first + index * SLOT_HEIGHT + 'px';
      });
    }

    function updateButtonClasses() {
      document.querySelectorAll('.chat-button').forEach(function (button) {
        button.className = 'chat-button';
        if (isMobile && expanded) {
          button.classList.add('show');
        }
      });
      widgetButton.classList.toggle('close', isMobile && expanded);
      calc();
    }

    function toggleCallForm(card) {
      var iframeContainer = document.querySelector('#sui-call-form');
      if (!iframeContainer) {
        iframeContainer = document.createElement('div');
        iframeContainer.id = 'sui-call-form';
        iframeContainer.innerHTML = card.channel_url;
        document.body.appendChild(iframeContainer);
      }
      iframeContainer.style.display = iframeContainer.style.display === 'block' ? 'none' : 'block';
    }

    window.addEventListener('resize', function () {
      var currentIsMobile = window.innerWidth <= 460;
      if (currentIsMobile !== isMobile) {
        isMobile = currentIsMobile;
        expanded = false;
        updateButtonClasses();
      }
    });

    widgetButton.addEventListener('click', function () {
      expanded = !expanded;
      updateButtonClasses();
    });

    channels.forEach(function (card) {
      var button = document.querySelector('#sui-' + card.channel_type + '-btn');
      if (!button) {
        return;
      }
      button.addEventListener('click', function () {
        if (card.channel_url.startsWith('<iframe')) {
          toggleCallForm(card);
        } else {
          window.open(card.channel_url, '_blank', 'noopener');
        }
      });
    });

    updateButtonClasses();
  }

  if (document.readyState !== 'loading') {
    initChannelWidgets();
  } else {
    document.addEventListener('DOMContentLoaded', initChannelWidgets);
  }
</script>
