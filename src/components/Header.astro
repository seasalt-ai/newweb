---
import LanguageSwitcher from './LanguageSwitcher.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

// Header component props
export interface Props {
	currentPath?: string;
}

const { currentPath = '/' } = Astro.props;
const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);

// Navigation data - can be moved to separate data file later
const solutions = [
  { title: 'AI Automation', path: '/solutions/ai-automation' },
  { title: 'Customer Support', path: '/solutions/customer-support' },
  { title: 'Sales Marketing', path: '/solutions/sales-marketing' },
  { title: 'SME Owners', path: '/solutions/sme-owners' }
];

const industries = [
  { title: 'Healthcare', path: '/industries/healthcare' },
  { title: 'E-commerce', path: '/industries/ecommerce' },
  { title: 'Real Estate', path: '/industries/real-estate' },
  { title: 'Financial Services', path: '/industries/financial-services' },
  { title: 'Professional Services', path: '/industries/professional-services' },
  { title: 'Restaurants & Hospitality', path: '/industries/restaurants-hospitality' }
];

const channels = [
  { title: 'WhatsApp', path: '/channels/whatsapp' },
  { title: 'Phone Calls', path: '/channels/phone-calls' },
  { title: 'SMS', path: '/channels/sms' },
  { title: 'Website Chat', path: '/channels/website-chat' },
  { title: 'Instagram', path: '/channels/instagram' },
  { title: 'Facebook Messenger', path: '/channels/facebook-messenger' }
];

const competitors = [
  { title: 'vs. Aircall', path: '/compare/aircall-alternative' },
  { title: 'vs. RingCentral', path: '/compare/ringcentral-alternative' },
  { title: 'vs. Genesys', path: '/compare/genesys-alternative' },
  { title: 'vs. Five9', path: '/compare/five9-alternative' },
  { title: 'vs. Intercom', path: '/compare/intercom-alternative' }
];

const products = [
  { title: 'SeaChat', href: 'https://seachat.seasalt.ai' },
  { title: 'SeaMeet', href: 'https://seameet.seasalt.ai' },
  { title: 'SeaVoice', href: 'https://seavoice.seasalt.ai' },
  { title: 'SeaX', href: 'https://seax.seasalt.ai' }
];
---

<header class="bg-white shadow-sm border-b border-gray-100 sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-3 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-16">
      <!-- Logo Section -->
      <div class="relative flex items-center">
        <a 
          href={`/${currentLang}`} 
          class="hover:opacity-80 transition-opacity flex items-center"
        >
          <img 
            src="/seasalt-ai-logo.png" 
            alt="Seasalt.ai" 
            class="h-6 sm:h-8 w-auto flex-shrink-0"
          />
        </a>
        
        <!-- Product Dropdown Trigger -->
        <button 
          class="ml-1 p-1 text-gray-700 hover:text-blue-600 transition-colors duration-200 dropdown-trigger"
          data-dropdown="products"
        >
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
          </svg>
        </button>
        
        <!-- Products Dropdown -->
        <div 
          class="absolute top-full left-0 mt-2 w-64 bg-white rounded-lg shadow-lg border border-gray-200 py-2 z-50 hidden dropdown-menu"
          data-dropdown-menu="products"
        >
          {products.map((product) => (
            <a 
              href={product.href}
              target="_blank"
              rel="noopener noreferrer"
              class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50"
            >
              {product.title}
            </a>
          ))}
        </div>
      </div>

      <!-- Desktop Navigation -->
      <nav class="hidden lg:flex items-center space-x-8">
        
        <!-- Solutions Dropdown -->
        <div class="relative dropdown">
          <button 
            class="flex items-center text-gray-700 hover:text-blue-600 transition-colors duration-200 dropdown-trigger"
            data-dropdown="solutions"
          >
            解決方案
            <svg class="ml-1 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </button>
          
          <div 
            class="absolute top-full left-0 mt-2 w-64 bg-white rounded-lg shadow-lg border border-gray-200 py-2 z-50 hidden dropdown-menu"
            data-dropdown-menu="solutions"
          >
            {solutions.map((solution) => (
              <a 
                href={`/${currentLang}${solution.path}`}
                class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50"
              >
                {solution.title}
              </a>
            ))}
          </div>
        </div>
        
        <!-- Industries Dropdown -->
        <div class="relative dropdown">
          <button 
            class="flex items-center text-gray-700 hover:text-blue-600 transition-colors duration-200 dropdown-trigger"
            data-dropdown="industries"
          >
            行業
            <svg class="ml-1 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </button>
          
          <div 
            class="absolute top-full left-0 mt-2 w-64 bg-white rounded-lg shadow-lg border border-gray-200 py-2 max-h-80 overflow-y-auto z-50 hidden dropdown-menu"
            data-dropdown-menu="industries"
          >
            {industries.map((industry) => (
              <a 
                href={`/${currentLang}${industry.path}`}
                class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50"
              >
                {industry.title}
              </a>
            ))}
          </div>
        </div>
        
        <!-- Channels Dropdown -->
        <div class="relative dropdown">
          <button 
            class="flex items-center text-gray-700 hover:text-blue-600 transition-colors duration-200 dropdown-trigger"
            data-dropdown="channels"
          >
            頻道
            <svg class="ml-1 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </button>
          
          <div 
            class="absolute top-full left-0 mt-2 w-64 bg-white rounded-lg shadow-lg border border-gray-200 py-2 z-50 hidden dropdown-menu"
            data-dropdown-menu="channels"
          >
            <a 
              href={`/${currentLang}/channels-overview`} 
              class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50 font-medium border-b border-gray-100"
            >
              所有頻道概覽
            </a>
            {channels.map((channel) => (
              <a 
                href={`/${currentLang}${channel.path}`}
                class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50"
              >
                {channel.title}
              </a>
            ))}
          </div>
        </div>
        
        <!-- Pricing Link -->
        <a 
          href={`/${currentLang}/pricing`} 
          class="text-gray-700 hover:text-blue-600 transition-colors duration-200"
        >
          定價
        </a>
        
        <!-- Compare Dropdown -->
        <div class="relative dropdown">
          <button 
            class="flex items-center text-gray-700 hover:text-blue-600 transition-colors duration-200 dropdown-trigger"
            data-dropdown="compare"
          >
            比較
            <svg class="ml-1 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </button>
          
          <div 
            class="absolute top-full left-0 mt-2 w-64 bg-white rounded-lg shadow-lg border border-gray-200 py-2 max-h-80 overflow-y-auto z-50 hidden dropdown-menu"
            data-dropdown-menu="compare"
          >
            <a 
              href={`/${currentLang}/compare-us-overview`} 
              class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50 font-medium border-b border-gray-100"
            >
              所有比較概覽
            </a>
            {competitors.map((competitor) => (
              <a 
                href={`/${currentLang}${competitor.path}`}
                class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50"
              >
                {competitor.title}
              </a>
            ))}
          </div>
        </div>
        
        <!-- Blog Link -->
        <a 
          href={`/${currentLang}/blog`} 
          class="text-gray-700 hover:text-blue-600 transition-colors duration-200"
        >
          部落格
        </a>
      </nav>

      <!-- CTA Buttons (Desktop) -->
      <div class="hidden lg:flex items-center space-x-4">
        <LanguageSwitcher currentPath={currentPath} />
        <a
          href="https://seax.seasalt.ai/signin"
          class="text-gray-700 hover:text-blue-600 font-medium transition-colors"
        >
          登入
        </a>
        <a
          href="https://seax.seasalt.ai/signup"
          class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg transition-colors duration-200 font-medium"
        >
          免費開始
        </a>
      </div>

      <!-- Mobile Menu Button -->
      <button
        class="lg:hidden p-2 mobile-menu-toggle"
      >
        <svg class="w-6 h-6 menu-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
        <svg class="w-6 h-6 close-icon hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    <!-- Mobile Navigation -->
    <div class="lg:hidden border-t border-gray-200 hidden mobile-menu">
      <div class="px-2 pt-2 pb-3 space-y-1 max-h-[calc(100vh-4rem)] overflow-y-auto">
        
        <!-- CTA Buttons (Mobile) -->
        <div class="px-3 py-2 border-b border-gray-200 mb-2">
          <div class="flex flex-col space-y-2">
            <a 
              href="https://seax.seasalt.ai/signin" 
              class="block w-full text-center text-gray-700 hover:text-blue-600 font-medium py-2 border border-gray-300 rounded-lg transition-colors"
            >
              登入
            </a>
            <a 
              href="https://seax.seasalt.ai/signup" 
              class="block px-4 py-3 bg-blue-600 text-white rounded-lg text-center font-medium hover:bg-blue-700 transition-colors"
            >
              免費開始
            </a>
          </div>
        </div>
        
        <!-- Mobile Navigation Items -->
        <div class="space-y-1">
          <a href={`/${currentLang}/solutions/ai-automation`} class="block px-3 py-2 text-gray-700 hover:bg-gray-50 rounded-md">解決方案</a>
          <a href={`/${currentLang}/industries/healthcare`} class="block px-3 py-2 text-gray-700 hover:bg-gray-50 rounded-md">行業</a>
          <a href={`/${currentLang}/channels-overview`} class="block px-3 py-2 text-gray-700 hover:bg-gray-50 rounded-md">頻道</a>
          <a href={`/${currentLang}/pricing`} class="block px-3 py-2 text-gray-700 hover:bg-gray-50 rounded-md">定價</a>
          <a href={`/${currentLang}/compare-us-overview`} class="block px-3 py-2 text-gray-700 hover:bg-gray-50 rounded-md">比較</a>
          <a href={`/${currentLang}/blog`} class="block px-3 py-2 text-gray-700 hover:bg-gray-50 rounded-md">部落格</a>
        </div>
        
        <!-- Mobile Language Selector -->
        <div class="px-3 py-2 border-t border-gray-200 mt-4 pt-4">
          <LanguageSwitcher currentPath={currentPath} />
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  // Dropdown functionality
  document.addEventListener('DOMContentLoaded', function() {
    let currentDropdown: string | null = null;
    
    // Handle dropdown toggles
    document.querySelectorAll('.dropdown-trigger').forEach(trigger => {
      const button = trigger as HTMLElement;
      const dropdownName = button.getAttribute('data-dropdown');
      
      button.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        
        if (currentDropdown === dropdownName) {
          closeAllDropdowns();
          currentDropdown = null;
        } else {
          closeAllDropdowns();
          if (dropdownName) {
            openDropdown(dropdownName);
            currentDropdown = dropdownName;
          }
        }
      });
      
      // Handle hover for desktop
      const dropdown = button.closest('.dropdown');
      if (dropdown) {
        dropdown.addEventListener('mouseenter', () => {
          closeAllDropdowns();
          if (dropdownName) {
            openDropdown(dropdownName);
            currentDropdown = dropdownName;
          }
        });
        
        dropdown.addEventListener('mouseleave', () => {
          closeAllDropdowns();
          currentDropdown = null;
        });
      }
    });
    
    // Handle mobile menu
    const mobileMenuToggle = document.querySelector('.mobile-menu-toggle');
    const mobileMenu = document.querySelector('.mobile-menu');
    const menuIcon = document.querySelector('.menu-icon');
    const closeIcon = document.querySelector('.close-icon');
    
    if (mobileMenuToggle && mobileMenu && menuIcon && closeIcon) {
      mobileMenuToggle.addEventListener('click', () => {
        mobileMenu.classList.toggle('hidden');
        menuIcon.classList.toggle('hidden');
        closeIcon.classList.toggle('hidden');
      });
    }
    
    // Close dropdowns when clicking outside
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (!target.closest('.dropdown')) {
        closeAllDropdowns();
        currentDropdown = null;
      }
    });
    
    function openDropdown(name: string) {
      const dropdown = document.querySelector(`[data-dropdown-menu="${name}"]`);
      if (dropdown) {
        dropdown.classList.remove('hidden');
      }
    }
    
    function closeAllDropdowns() {
      document.querySelectorAll('.dropdown-menu').forEach(menu => {
        menu.classList.add('hidden');
      });
    }
  });
</script>
