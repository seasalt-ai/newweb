---
import { useTranslations } from '../i18n/utils';

export interface Props {
  lang?: string;
}

const { lang = 'en' } = Astro.props;
const t = useTranslations(lang as keyof typeof import('../i18n/utils').languages);

// 獲取多語言 meeting URL
const getMeetingUrl = (language: string) => {
  const meetingUrls: { [key: string]: string } = {
    'en': 'https://calendly.com/seasaltai/en',
    'zh-TW': 'https://calendly.com/seasaltai/zh-tw',
    'ja': 'https://calendly.com/seasaltai/ja',
    'ko': 'https://calendly.com/seasaltai/ko',
    'th': 'https://calendly.com/seasaltai/th',
    'vi': 'https://calendly.com/seasaltai/vi',
    'id': 'https://calendly.com/seasaltai/id',
    'ms': 'https://calendly.com/seasaltai/ms',
    'zh-CN': 'https://calendly.com/seasaltai/zh-cn',
    'hi': 'https://calendly.com/seasaltai/hi',
    'pt': 'https://calendly.com/seasaltai/pt',
    'es': 'https://calendly.com/seasaltai/es',
    'fr': 'https://calendly.com/seasaltai/fr'
  };
  return meetingUrls[language] || meetingUrls['en'];
};

const meetingUrl = getMeetingUrl(lang);

const appIcons = [
  { name: 'WhatsApp', color: 'text-green-500', bgColor: 'bg-green-100' },
  { name: 'SMS', color: 'text-blue-500', bgColor: 'bg-blue-100' },
  { name: 'Phone', color: 'text-purple-500', bgColor: 'bg-purple-100' },
  { name: 'Chat', color: 'text-orange-500', bgColor: 'bg-orange-100' }
];
---

<section class="bg-gradient-to-br from-blue-50 via-white to-indigo-50 pt-16 pb-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 overflow-hidden">
    <div class="lg:grid lg:grid-cols-2 lg:gap-12 items-center space-y-12 lg:space-y-0">
      <!-- Left Column - Content -->
      <div class="lg:pr-8 w-full">
        <div class="text-center lg:text-left w-full">
          <h1 class="text-3xl sm:text-4xl lg:text-6xl font-bold text-gray-900 leading-tight mb-6">
            {t('hero.title')} <span class="bg-gradient-to-r from-blue-600 to-indigo-600 bg-clip-text text-transparent">{t('hero.highlightText')}</span>
          </h1>
          
          <p class="text-xl text-gray-600 mb-8 max-w-2xl mx-auto lg:mx-0">
            {t('hero.description')}
          </p>
          
          <!-- CTAs -->
          <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start mb-8 sm:mb-12">
            <a
              href="https://seax.seasalt.ai/signup"
              class="bg-blue-600 hover:bg-blue-700 text-white px-6 sm:px-8 py-3 sm:py-4 rounded-lg text-base sm:text-lg font-semibold transition-all duration-200"
            >
              {t('hero.signUp')}
            </a>
            <a
              href={meetingUrl}
              class="border-2 border-gray-300 hover:border-blue-600 text-gray-700 hover:text-blue-600 px-8 py-4 rounded-lg text-lg font-semibold transition-all duration-200"
            >
              {t('hero.seeDemo')}
            </a>
          </div>

          <!-- Social Proof -->
          <div class="border-t border-gray-200 pt-6 sm:pt-8">
            <p class="text-sm text-gray-500 mb-4">
              {t('hero.developerMessage')}
            </p>
            <div class="flex flex-wrap items-center justify-center lg:justify-start gap-3 sm:gap-4">
              <code class="text-sm font-mono bg-red-50 text-red-800 px-3 py-1.5 rounded-md border border-red-200 font-semibold whitespace-nowrap">
                {t('hero.developerTools.phoneUse')}
              </code>
              <code class="text-sm font-mono bg-red-50 text-red-800 px-3 py-1.5 rounded-md border border-red-200 font-semibold whitespace-nowrap">
                {t('hero.developerTools.messageUse')}
              </code>
              <code class="text-sm font-mono bg-red-50 text-red-800 px-3 py-1.5 rounded-md border border-red-200 font-semibold whitespace-nowrap">
                {t('hero.developerTools.emailUse')}
              </code>
              <code class="text-sm font-mono bg-red-50 text-red-800 px-3 py-1.5 rounded-md border border-red-200 font-semibold whitespace-nowrap">
                {t('hero.developerTools.meetingUse')}
              </code>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column - Hero Animation -->
      <div class="mt-8 lg:mt-0">
        <!-- Animation Container -->
        <div 
          id="hero-animation"
          class="relative h-96 mb-16 flex items-center justify-center cursor-pointer"
        >
          <!-- Scattered App Icons -->
          {appIcons.map((app, index) => (
            <div
              class={`hero-app-icon absolute transition-all duration-1000 ease-in-out opacity-100 scale-100`}
              style={`transform: translate(${Math.cos(index * Math.PI / 2) * 150}px, ${Math.sin(index * Math.PI / 2) * 150}px)`}
              data-index={index}
            >
              <div class="w-20 h-20 bg-white rounded-2xl shadow-lg flex items-center justify-center hover:shadow-xl transition-shadow duration-300">
                <!-- Icons will be rendered by JavaScript -->
                <div class={`h-8 w-8 ${app.color} app-icon`} data-type={app.name.toLowerCase()}></div>
              </div>
              <div class="text-center mt-2">
                <span class="text-sm font-medium text-gray-600">{t(`hero.appNames.${app.name.toLowerCase()}`)}</span>
              </div>
            </div>
          ))}

          <!-- Central Unified Inbox -->
          <div class="hero-unified-inbox absolute transition-all duration-1000 ease-in-out opacity-0 scale-0">
            <div class="w-32 h-32 bg-gradient-to-br from-blue-500 to-indigo-600 rounded-3xl shadow-2xl flex items-center justify-center">
              <!-- Megaphone icon will be rendered by JavaScript -->
              <div class="h-12 w-12 text-white unified-inbox-icon"></div>
            </div>
            <div class="text-center mt-4">
              <span class="text-lg font-semibold text-gray-800">{t('hero.unifiedInbox')}</span>
            </div>
          </div>

          <!-- Connection Lines -->
          <div class="hero-connection-lines absolute hidden">
            {[0, 1, 2, 3].map((index) => (
              <div
                class="absolute w-px bg-gradient-to-r from-transparent via-blue-400 to-transparent opacity-60 animate-pulse"
                style={`height: 75px; transform: rotate(${index * 90}deg); transform-origin: bottom center`}
              ></div>
            ))}
          </div>

          <!-- Floating Particles -->
          <div class="hero-particles absolute hidden">
            {[...Array(8)].map((_, index) => (
              <div
                class="absolute w-2 h-2 bg-blue-400 rounded-full opacity-60 animate-bounce"
                style={`left: ${20 + index * 10}%; top: ${30 + (index % 3) * 20}%; animation-delay: ${index * 0.2}s; animation-duration: 2s`}
              ></div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Hero animation logic
  let animationPhase = 0;
  let isHovered = false;
  let interval: number | null = null;

  const appIcons = document.querySelectorAll('.hero-app-icon');
  const unifiedInbox = document.querySelector('.hero-unified-inbox');
  const connectionLines = document.querySelector('.hero-connection-lines');
  const particles = document.querySelector('.hero-particles');
  const animationContainer = document.getElementById('hero-animation');

  // Add SVG icons
  function createIcon(type: string): string {
    const icons = {
      whatsapp: `<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M8.5 14.5L9.5 15.5L15.5 9.5"/></svg>`,
      sms: `<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>`,
      phone: `<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>`,
      chat: `<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>`
    };
    return icons[type as keyof typeof icons] || icons.chat;
  }

  const megaphoneIcon = `<svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="currentColor" viewBox="0 0 24 24"><path d="M3 9v6l4-2v5c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-5l11-4v-1l-11-4V3c0-.55-.45-1-1-1H8c-.55 0-1 .45-1 1v1l-4 2z"/></svg>`;

  // Initialize icons
  document.querySelectorAll('.app-icon').forEach((icon) => {
    const type = icon.getAttribute('data-type');
    if (type) {
      icon.innerHTML = createIcon(type);
    }
  });

  document.querySelector('.unified-inbox-icon')!.innerHTML = megaphoneIcon;

  function updateAnimation() {
    if (isHovered) return;

    appIcons.forEach((icon, index) => {
      const element = icon as HTMLElement;
      
      if (animationPhase >= 2) {
        element.classList.remove('opacity-100', 'scale-100');
        element.classList.add('opacity-0', 'scale-0');
      } else {
        element.classList.remove('opacity-0', 'scale-0');
        element.classList.add('opacity-100', 'scale-100');
        
        if (animationPhase === 0) {
          element.style.transform = `translate(${Math.cos(index * Math.PI / 2) * 150}px, ${Math.sin(index * Math.PI / 2) * 150}px)`;
        } else if (animationPhase === 1) {
          element.style.transform = `translate(${Math.cos(index * Math.PI / 2) * 75}px, ${Math.sin(index * Math.PI / 2) * 75}px)`;
        } else {
          element.style.transform = 'translate(0px, 0px)';
        }
      }
    });

    // Central Unified Inbox
    if (unifiedInbox) {
      const element = unifiedInbox as HTMLElement;
      if (animationPhase >= 2) {
        element.classList.remove('opacity-0', 'scale-0');
        element.classList.add('opacity-100', 'scale-110');
      } else {
        element.classList.remove('opacity-100', 'scale-110');
        element.classList.add('opacity-0', 'scale-0');
      }
    }

    // Connection Lines
    if (connectionLines) {
      if (animationPhase === 1) {
        connectionLines.classList.remove('hidden');
      } else {
        connectionLines.classList.add('hidden');
      }
    }

    // Floating Particles
    if (particles) {
      if (animationPhase >= 2) {
        particles.classList.remove('hidden');
      } else {
        particles.classList.add('hidden');
      }
    }
  }

  function startAnimation() {
    if (interval) clearInterval(interval);
    
    interval = setInterval(() => {
      if (!isHovered) {
        animationPhase = (animationPhase + 1) % 4;
        updateAnimation();
      }
    }, 2000);
  }

  // Event listeners
  if (animationContainer) {
    animationContainer.addEventListener('mouseenter', () => {
      isHovered = true;
    });

    animationContainer.addEventListener('mouseleave', () => {
      isHovered = false;
    });
  }

  // Initialize animation
  updateAnimation();
  startAnimation();
</script>
