---
interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  image?: string;
  canonical?: string;
  lang?: string;
  type?: 'website' | 'article' | 'product' | 'software';
  noindex?: boolean;
  nofollow?: boolean;
}

const {
  title = 'SeaSalt.ai - AI-Powered Omnichannel Customer Communication Platform',
  description = 'Transform your customer communications with SeaSalt.ai\'s AI-powered omnichannel platform. Unify WhatsApp, SMS, voice calls, and chat in one intelligent solution.',
  keywords = 'AI customer service, omnichannel platform, WhatsApp business, customer support software, contact center solutions, conversational AI, customer communication',
  image = '/images/og/seasalt-ai-social-card.png',
  canonical,
  lang = 'en',
  type = 'website',
  noindex = false,
  nofollow = false
} = Astro.props;

// URL processing
const currentUrl = canonical ? new URL(canonical) : new URL(Astro.url);
const baseUrl = `${currentUrl.protocol}//${currentUrl.host}`;
const canonicalUrl = canonical || Astro.url.href;

// Safe image URL handling
const safeImage = image || '/images/og/seasalt-ai-social-card.png';
const absoluteImageUrl = (safeImage && safeImage.startsWith && safeImage.startsWith('http')) 
  ? safeImage 
  : `${baseUrl}${safeImage}`;

// Robots settings
const robotsContent = [
  noindex ? 'noindex' : 'index',
  nofollow ? 'nofollow' : 'follow'
].join(',');

// Basic structured data
const structuredData = {
  "@context": "https://schema.org",
  "@type": type === 'article' ? 'Article' : type === 'product' ? 'Product' : type === 'software' ? 'SoftwareApplication' : 'WebSite',
  "name": title,
  "description": description,
  "url": canonicalUrl,
  "image": absoluteImageUrl,
  "inLanguage": lang
};
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />

<!-- SEO Meta Tags -->
<title>{title}</title>
<meta name="description" content={description} />
{keywords && <meta name="keywords" content={keywords} />}
<meta name="author" content="SeaSalt.ai" />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalUrl} />

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={absoluteImageUrl} />
<meta property="og:site_name" content="SeaSalt.ai" />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@seasalt_ai" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={absoluteImageUrl} />

<!-- Robots -->
<meta name="robots" content={robotsContent} />

<!-- Favicon -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

<!-- Structured Data -->
<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
