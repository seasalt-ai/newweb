---
import { getTranslationHelpers, type SupportedLanguage } from '../../i18n/helpers';

export interface Props {
  lang: SupportedLanguage;
}

const { lang = 'en' } = Astro.props;
const { t } = await getTranslationHelpers(lang);

const steps = [
  { id: 'connectYourChannels', icon: 'connect', number: '1' },
  { id: 'automateRoutineWork', icon: 'automate', number: '2' },
  { id: 'unifyYourTeam', icon: 'unify', number: '3' }
];
---

<section class="py-20 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <h2 class="text-3xl font-bold text-gray-900 mb-4">
        {t('howItWorks.title')}
      </h2>
      <p class="text-lg text-gray-600 max-w-3xl mx-auto mb-2">
        {t('howItWorks.description1')}
      </p>
      <p class="text-lg text-gray-600 max-w-3xl mx-auto">
        {t('howItWorks.description2')}
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-8 mb-12">
      {steps.map((step) => (
        <div class="relative">
          {/* Connection line for desktop */}
          {step.number !== '3' && (
            <div class="hidden md:block absolute top-12 right-0 w-full">
              <div class="w-full h-0.5 bg-gradient-to-r from-teal-500 to-blue-500 opacity-30"></div>
              <div class="absolute -right-2 -top-2">
                <svg class="w-4 h-4 text-blue-500 opacity-30" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10.293 5.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L12.586 11H5a1 1 0 110-2h7.586l-2.293-2.293a1 1 0 010-1.414z" clip-rule="evenodd"></path>
                </svg>
              </div>
            </div>
          )}
          
          <div class="text-center">
            {/* Step Number */}
            <div class="inline-flex items-center justify-center w-20 h-20 bg-gradient-to-r from-teal-500 to-blue-500 text-white rounded-full text-2xl font-bold mb-4 shadow-lg">
              {step.number}
            </div>
            
            {/* Icon */}
            <div class="mb-4">
              {step.icon === 'connect' && (
                <svg class="w-12 h-12 text-teal-600 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                </svg>
              )}
              {step.icon === 'automate' && (
                <svg class="w-12 h-12 text-blue-600 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"></path>
                </svg>
              )}
              {step.icon === 'unify' && (
                <svg class="w-12 h-12 text-purple-600 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>
                </svg>
              )}
            </div>
            
            {/* Title */}
            <h3 class="text-xl font-bold text-gray-900 mb-3">
              {t(`howItWorks.${step.id}.title`)}
            </h3>
            
            {/* Description */}
            <p class="text-gray-600">
              {t(`howItWorks.${step.id}.description`)}
            </p>
          </div>
        </div>
      ))}
    </div>

    {/* Visual Demo */}
    <div class="bg-gradient-to-r from-teal-50 to-blue-50 rounded-2xl p-8 mb-12">
      <div class="grid md:grid-cols-3 gap-8">
        {/* Step 1 Visual */}
        <div class="bg-white rounded-lg p-4 shadow">
          <div class="text-sm font-medium text-gray-700 mb-3">Step 1: Connected Channels</div>
          <div class="space-y-2">
            <div class="flex items-center text-sm">
              <div class="w-2 h-2 bg-green-500 rounded-full mr-2"></div>
              <span>WhatsApp Business</span>
            </div>
            <div class="flex items-center text-sm">
              <div class="w-2 h-2 bg-green-500 rounded-full mr-2"></div>
              <span>SMS/Phone</span>
            </div>
            <div class="flex items-center text-sm">
              <div class="w-2 h-2 bg-green-500 rounded-full mr-2"></div>
              <span>Website Chat</span>
            </div>
            <div class="flex items-center text-sm">
              <div class="w-2 h-2 bg-green-500 rounded-full mr-2"></div>
              <span>Social Media</span>
            </div>
          </div>
        </div>

        {/* Step 2 Visual */}
        <div class="bg-white rounded-lg p-4 shadow">
          <div class="text-sm font-medium text-gray-700 mb-3">Step 2: AI Automation Active</div>
          <div class="space-y-2">
            <div class="bg-green-50 rounded p-2 text-xs">
              <span class="font-medium">AI:</span> "How can I help you today?"
            </div>
            <div class="bg-gray-50 rounded p-2 text-xs">
              <span class="font-medium">Customer:</span> "Order status?"
            </div>
            <div class="bg-green-50 rounded p-2 text-xs">
              <span class="font-medium">AI:</span> "Your order #12345 is..."
            </div>
          </div>
        </div>

        {/* Step 3 Visual */}
        <div class="bg-white rounded-lg p-4 shadow">
          <div class="text-sm font-medium text-gray-700 mb-3">Step 3: Team Unified</div>
          <div class="space-y-2">
            <div class="flex items-center justify-between text-xs">
              <span>Sarah (Agent)</span>
              <span class="text-green-600">● Online</span>
            </div>
            <div class="flex items-center justify-between text-xs">
              <span>Mike (Agent)</span>
              <span class="text-green-600">● Online</span>
            </div>
            <div class="flex items-center justify-between text-xs">
              <span>AI Assistant</span>
              <span class="text-blue-600">● Active</span>
            </div>
            <div class="mt-2 pt-2 border-t text-xs text-gray-600">
              All viewing same conversation history
            </div>
          </div>
        </div>
      </div>
    </div>

    {/* CTA */}
    <div class="text-center">
      <p class="text-sm text-gray-500 mb-6">
        {t('howItWorks.setupTime')}
      </p>
      <a href={`/${lang}/seachat/signup`} class="inline-flex items-center px-8 py-3 bg-gradient-to-r from-teal-600 to-blue-600 text-white font-medium rounded-lg hover:from-teal-700 hover:to-blue-700 transition-all transform hover:scale-105 shadow-lg">
        {t('howItWorks.signUpNow')}
        <svg class="ml-2 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
        </svg>
      </a>
    </div>
  </div>
</section>