---
import { getTranslationHelpers, type SupportedLanguage } from '../../i18n/helpers';

export interface Props {
  lang: SupportedLanguage;
}

const { lang = 'en' } = Astro.props;
const { t } = await getTranslationHelpers(lang);
---

<section class="py-20 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Problems Section -->
    <div class="mb-16">
      <h2 class="text-3xl font-bold text-gray-900 mb-4 text-center">
        {t('problemSolution.title')}
      </h2>
      <p class="text-lg text-gray-600 text-center max-w-3xl mx-auto mb-12">
        {t('problemSolution.description')}
      </p>
      
      <div class="grid md:grid-cols-3 gap-8">
        <!-- Fragmented Conversations -->
        <div class="bg-red-50 rounded-lg p-6 border border-red-100">
          <div class="text-red-600 mb-4">
            <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-gray-900 mb-2">
            {t('problemSolution.problems.fragmented.title')}
          </h3>
          <p class="text-gray-600">
            {t('problemSolution.problems.fragmented.description')}
          </p>
        </div>
        
        <!-- Lost Revenue -->
        <div class="bg-red-50 rounded-lg p-6 border border-red-100">
          <div class="text-red-600 mb-4">
            <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-gray-900 mb-2">
            {t('problemSolution.problems.lostRevenue.title')}
          </h3>
          <p class="text-gray-600">
            {t('problemSolution.problems.lostRevenue.description')}
          </p>
        </div>
        
        <!-- Operational Overload -->
        <div class="bg-red-50 rounded-lg p-6 border border-red-100">
          <div class="text-red-600 mb-4">
            <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-gray-900 mb-2">
            {t('problemSolution.problems.operational.title')}
          </h3>
          <p class="text-gray-600">
            {t('problemSolution.problems.operational.description')}
          </p>
        </div>
      </div>
    </div>
    
    <!-- Solution Section -->
    <div class="bg-gradient-to-r from-teal-50 to-blue-50 rounded-2xl p-12">
      <h3 class="text-2xl font-bold text-gray-900 mb-6 text-center">
        {t('problemSolution.solution.title')}
      </h3>
      
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <!-- Solution Visual -->
        <div class="relative">
          <div class="bg-white rounded-xl shadow-lg p-6">
            <div class="text-center mb-4">
              <h4 class="text-lg font-semibold text-gray-900">
                {t('problemSolution.solution.hubTitle')}
              </h4>
              <p class="text-sm text-gray-600">{t('problemSolution.solution.subtitle')}</p>
            </div>
            
            <!-- Channel Icons -->
            <div class="grid grid-cols-4 gap-4 mb-6">
              <div class="text-center">
                <div class="w-12 h-12 bg-green-100 rounded-lg flex items-center justify-center mx-auto mb-1">
                  <svg class="w-6 h-6 text-green-600" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                  </svg>
                </div>
                <span class="text-xs text-gray-600">WhatsApp</span>
              </div>
              <div class="text-center">
                <div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center mx-auto mb-1">
                  <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                  </svg>
                </div>
                <span class="text-xs text-gray-600">SMS</span>
              </div>
              <div class="text-center">
                <div class="w-12 h-12 bg-purple-100 rounded-lg flex items-center justify-center mx-auto mb-1">
                  <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
                  </svg>
                </div>
                <span class="text-xs text-gray-600">Phone</span>
              </div>
              <div class="text-center">
                <div class="w-12 h-12 bg-orange-100 rounded-lg flex items-center justify-center mx-auto mb-1">
                  <svg class="w-6 h-6 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
                  </svg>
                </div>
                <span class="text-xs text-gray-600">Chat</span>
              </div>
            </div>
            
            <!-- Unified View -->
            <div class="bg-gray-50 rounded-lg p-4">
              <div class="flex items-center justify-between mb-2">
                <span class="text-sm font-medium text-gray-700">Unified Conversations</span>
                <span class="text-xs text-green-600 bg-green-100 px-2 py-1 rounded">Active</span>
              </div>
              <div class="space-y-2">
                <div class="bg-white rounded p-2 text-xs">
                  <span class="text-gray-600">Sarah J.</span> - WhatsApp: Order inquiry
                </div>
                <div class="bg-white rounded p-2 text-xs">
                  <span class="text-gray-600">Mike C.</span> - Phone: Support call
                </div>
                <div class="bg-white rounded p-2 text-xs">
                  <span class="text-gray-600">Lisa P.</span> - Chat: Product question
                </div>
              </div>
            </div>
          </div>
        </div>
        
        <!-- Solution Features -->
        <div class="space-y-6">
          <div>
            <h4 class="text-lg font-semibold text-gray-900 mb-2">
              {t('problemSolution.solution.features.support.title')}
            </h4>
            <p class="text-gray-600">
              {t('problemSolution.solution.features.support.description')}
            </p>
          </div>
          
          <div>
            <h4 class="text-lg font-semibold text-gray-900 mb-2">
              {t('problemSolution.solution.features.marketing.title')}
            </h4>
            <p class="text-gray-600">
              {t('problemSolution.solution.features.marketing.description')}
            </p>
          </div>
          
          <div>
            <h4 class="text-lg font-semibold text-gray-900 mb-2">
              {t('problemSolution.solution.features.human.title')}
            </h4>
            <p class="text-gray-600">
              {t('problemSolution.solution.features.human.description')}
            </p>
          </div>
          
          <div class="pt-4">
            <a href={`/${lang}/seachat/pricing`} class="inline-flex items-center px-6 py-3 bg-teal-600 text-white font-medium rounded-lg hover:bg-teal-700 transition-colors">
              {t('problemSolution.solution.cta')}
              <svg class="ml-2 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>