---
import { Users, Bot, Globe, ArrowRight, Infinity, Download, MessageCircle, Clock } from 'lucide-react';
import { getTranslationHelpers, type SupportedLanguage } from '../../i18n/helpers';

export interface Props {
  lang: SupportedLanguage;
}

const { lang = 'en' } = Astro.props;
const { t } = await getTranslationHelpers(lang);

const features = [
  {
    icon: 'users',
    title: t('seachat.keyFeatures.humanAgents.title'),
    description: t('seachat.keyFeatures.humanAgents.description'),
    highlights: [
      t('seachat.keyFeatures.humanAgents.highlights.0'),
      t('seachat.keyFeatures.humanAgents.highlights.1'),
      t('seachat.keyFeatures.humanAgents.highlights.2'),
    ],
    color: 'from-green-500 to-emerald-500',
    badge: t('seachat.keyFeatures.humanAgents.badge')
  },
  {
    icon: 'bot',
    title: t('seachat.keyFeatures.aiAutomation.title'),
    description: t('seachat.keyFeatures.aiAutomation.description'),
    highlights: [
      t('seachat.keyFeatures.aiAutomation.highlights.0'),
      t('seachat.keyFeatures.aiAutomation.highlights.1'),
      t('seachat.keyFeatures.aiAutomation.highlights.2'),
    ],
    color: 'from-blue-500 to-indigo-500'
  },
  {
    icon: 'globe',
    title: t('seachat.keyFeatures.omnichannel.title'),
    description: t('seachat.keyFeatures.omnichannel.description'),
    highlights: [
      t('seachat.keyFeatures.omnichannel.highlights.0'),
      t('seachat.keyFeatures.omnichannel.highlights.1'),
      t('seachat.keyFeatures.omnichannel.highlights.2'),
    ],
    color: 'from-purple-500 to-pink-500'
  }
];

const freeFeatures = [
  {
    icon: 'message-circle',
    title: t('seachat.keyFeatures.trulyFree.freeFeatures.unlimitedChat.title'),
    description: t('seachat.keyFeatures.trulyFree.freeFeatures.unlimitedChat.description')
  },
  {
    icon: 'clock',
    title: t('seachat.keyFeatures.trulyFree.freeFeatures.unlimitedHistory.title'),
    description: t('seachat.keyFeatures.trulyFree.freeFeatures.unlimitedHistory.description')
  },
  {
    icon: 'users',
    title: t('seachat.keyFeatures.trulyFree.freeFeatures.unlimitedContacts.title'),
    description: t('seachat.keyFeatures.trulyFree.freeFeatures.unlimitedContacts.description')
  },
  {
    icon: 'download',
    title: t('seachat.keyFeatures.trulyFree.freeFeatures.freedomToExport.title'),
    description: t('seachat.keyFeatures.trulyFree.freeFeatures.freedomToExport.description')
  }
];
---

<section class="py-20 bg-gradient-to-b from-white to-gray-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4">
        {t('seachat.keyFeatures.title')}
      </h2>
      <p class="text-xl text-gray-600 max-w-3xl mx-auto">
        {t('seachat.keyFeatures.subtitle')}
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-8 mb-16">
      {features.map((feature, index) => (
        <div class="group bg-white rounded-2xl p-8 shadow-lg hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2 border border-gray-100 relative overflow-hidden">
          {feature.badge && (
            <div class="absolute top-4 right-4">
              <span class="bg-green-500 text-white px-3 py-1 rounded-full text-sm font-bold">
                {feature.badge}
              </span>
            </div>
          )}
          
          <div class={`w-16 h-16 bg-gradient-to-br ${feature.color} rounded-2xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform duration-300`}>
            {feature.icon === 'users' && (
              <Users class="w-8 h-8 text-white" />
            )}
            {feature.icon === 'bot' && (
              <Bot class="w-8 h-8 text-white" />
            )}
            {feature.icon === 'globe' && (
              <Globe class="w-8 h-8 text-white" />
            )}
          </div>
          
          <h3 class="text-2xl font-bold text-gray-900 mb-4 group-hover:text-blue-600 transition-colors">
            {feature.title}
          </h3>
          
          <p class="text-gray-600 mb-6 leading-relaxed">
            {feature.description}
          </p>
          
          <ul class="space-y-2 mb-6">
            {feature.highlights.map((highlight: string, idx: number) => (
              <li class="flex items-center text-sm text-gray-700">
                <div class="w-2 h-2 bg-teal-500 rounded-full mr-3"></div>
                {highlight}
              </li>
            ))}
          </ul>
          
          <button class="flex items-center text-teal-600 hover:text-teal-700 font-semibold group-hover:gap-2 transition-all">
            {t('seachat.common.learnMore')}
            <ArrowRight class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform" />
          </button>
        </div>
      ))}
    </div>

    <!-- Detailed Free Features Showcase -->
    <div class="bg-gradient-to-br from-green-50 via-blue-50 to-teal-50 rounded-3xl p-12 border border-green-100">
      <div class="text-center mb-12">
        <div class="flex items-center justify-center mb-4">
          <Infinity class="w-12 h-12 text-green-600 mr-4" />
          <h3 class="text-3xl md:text-4xl font-bold text-gray-900">
            {t('seachat.keyFeatures.trulyFree.title')}
          </h3>
        </div>
        <p class="text-xl text-gray-700 max-w-4xl mx-auto leading-relaxed">
          {t('seachat.keyFeatures.trulyFree.description')}
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8 mb-12">
        {freeFeatures.map((feature, index) => (
          <div class="bg-white rounded-xl p-6 shadow-md hover:shadow-lg transition-all duration-300 transform hover:-translate-y-1 text-center">
            <div class="w-12 h-12 bg-gradient-to-br from-green-500 to-teal-500 rounded-xl flex items-center justify-center mx-auto mb-4">
              {feature.icon === 'message-circle' && (
                <MessageCircle class="w-6 h-6 text-white" />
              )}
              {feature.icon === 'clock' && (
                <Clock class="w-6 h-6 text-white" />
              )}
              {feature.icon === 'users' && (
                <Users class="w-6 h-6 text-white" />
              )}
              {feature.icon === 'download' && (
                <Download class="w-6 h-6 text-white" />
              )}
            </div>
            <h4 class="text-lg font-bold text-gray-900 mb-3">{feature.title}</h4>
            <p class="text-gray-600 text-sm leading-relaxed">{feature.description}</p>
          </div>
        ))}
      </div>

      <!-- Why Choose Section -->
      <div class="text-center">
        <h4 class="text-2xl font-bold text-gray-900 mb-4">
          {t('seachat.keyFeatures.trulyFree.whyChoose')}
        </h4>
        <div class="grid md:grid-cols-2 gap-8 max-w-4xl mx-auto mb-8">
          <div class="bg-white rounded-xl p-6 shadow-md">
            <h5 class="font-bold text-green-600 mb-3">{t('seachat.keyFeatures.trulyFree.whatYouGet')}</h5>
            <ul class="text-left space-y-2 text-gray-700">
              <li class="flex items-center">
                <div class="w-2 h-2 bg-green-500 rounded-full mr-3"></div>
                {t('seachat.keyFeatures.trulyFree.freeForeverFeatures.0')}
              </li>
              <li class="flex items-center">
                <div class="w-2 h-2 bg-green-500 rounded-full mr-3"></div>
                {t('seachat.keyFeatures.trulyFree.freeForeverFeatures.1')}
              </li>
              <li class="flex items-center">
                <div class="w-2 h-2 bg-green-500 rounded-full mr-3"></div>
                {t('seachat.keyFeatures.trulyFree.freeForeverFeatures.2')}
              </li>
              <li class="flex items-center">
                <div class="w-2 h-2 bg-green-500 rounded-full mr-3"></div>
                {t('seachat.keyFeatures.trulyFree.freeForeverFeatures.3')}
              </li>
            </ul>
          </div>
          
          <div class="bg-white rounded-xl p-6 shadow-md">
            <h5 class="font-bold text-blue-600 mb-3">{t('seachat.keyFeatures.trulyFree.scaleWhenReady')}</h5>
            <ul class="text-left space-y-2 text-gray-700">
              <li class="flex items-center">
                <div class="w-2 h-2 bg-blue-500 rounded-full mr-3"></div>
                {t('seachat.keyFeatures.trulyFree.scaleFeatures.0')}
              </li>
              <li class="flex items-center">
                <div class="w-2 h-2 bg-blue-500 rounded-full mr-3"></div>
                {t('seachat.keyFeatures.trulyFree.scaleFeatures.1')}
              </li>
              <li class="flex items-center">
                <div class="w-2 h-2 bg-blue-500 rounded-full mr-3"></div>
                {t('seachat.keyFeatures.trulyFree.scaleFeatures.2')}
              </li>
              <li class="flex items-center">
                <div class="w-2 h-2 bg-blue-500 rounded-full mr-3"></div>
                {t('seachat.keyFeatures.trulyFree.scaleFeatures.3')}
              </li>
            </ul>
          </div>
        </div>

        <!-- CTA Button -->
        <a 
          href="https://chat.seasalt.ai/gpt/signup" 
          target="_blank" 
          rel="noopener noreferrer"
          class="bg-gradient-to-r from-green-500 to-teal-500 hover:from-green-600 hover:to-teal-600 text-white px-12 py-4 rounded-xl font-bold text-lg transition-all transform hover:scale-105 shadow-lg inline-block"
        >
          {t('seachat.keyFeatures.trulyFree.startButton')}
        </a>
      </div>
    </div>

    <!-- Stats Bar -->
    <div class="mt-20 bg-white rounded-2xl p-8 shadow-lg border border-gray-100">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
        <div>
          <div class="text-3xl font-bold text-green-600 mb-2">∞</div>
          <div class="text-gray-600">{t('seachat.keyFeatures.statsBar.unlimited')}</div>
        </div>
        <div>
          <div class="text-3xl font-bold text-teal-600 mb-2">30+</div>
          <div class="text-gray-600">{t('seachat.keyFeatures.statsBar.fileTypes')}</div>
        </div>
        <div>
          <div class="text-3xl font-bold text-purple-600 mb-2">2min</div>
          <div class="text-gray-600">{t('seachat.keyFeatures.statsBar.setupTime')}</div>
        </div>
        <div>
          <div class="text-3xl font-bold text-blue-600 mb-2">24/7</div>
          <div class="text-gray-600">{t('seachat.keyFeatures.statsBar.availability')}</div>
        </div>
      </div>
    </div>
  </div>
</section>