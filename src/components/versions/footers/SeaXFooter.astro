---
import { getTranslationHelpers, getLocalizedPath } from '../../../i18n/helpers';
import type { VersionConfig } from '../config';

export interface Props {
  currentPath?: string;
  lang?: string;
  versionConfig?: VersionConfig;
}

const { currentPath = '/', lang = 'en', versionConfig } = Astro.props;
const { t } = await getTranslationHelpers(lang);

// Get localized paths for SeaX
const getSeaXPath = (path: string) => getLocalizedPath(`/seax${path}`, lang);

// Helper function to get the correct Wiki URL based on language
const getWikiUrl = () => {
  const wikiLanguage = (lang === 'zh-TW' || lang === 'zh-CN') ? 'zh' : 'en';
  return `https://wiki.seasalt.ai/${wikiLanguage}/seax`;
};

// Get demo URL based on language
const getDemoUrl = () => {
  return `https://calendly.com/seasalt-ai/seasalt-ai-demo?lang=${lang}`;
};

// Channel links configuration using correct translation keys
const channelLinks = [
  { name: t('footer.links.channels.smsOverview') || 'SMS Overview', path: '/channels/sms', technical: t('footer.technical.sms') || 'SMS', isParent: true },
  { name: t('footer.links.channels.smsLocal') || 'Local Number (10DLC)', path: '/channels/sms-local', technical: t('footer.technical.tenDlc') || '10DLC', isChild: true },
  { name: t('footer.links.channels.smsTollFree') || 'Toll-Free Number', path: '/channels/sms-toll-free', technical: t('footer.technical.tollFree') || '8XX', isChild: true },
  { name: t('footer.links.channels.smsShortCode') || 'Short Code', path: '/channels/sms-short-code', technical: t('footer.technical.shortCode') || 'xxxxx', isChild: true },
  { name: t('footer.links.channels.whatsapp') || 'WhatsApp Business Platform', path: '/channels/whatsapp' },
  { name: t('footer.links.channels.voice') || 'Phone Call Voice', path: '/channels/voice' }
];

// Solution links configuration using correct translation keys
const solutionLinks = [
  { name: t('footer.links.solutions.leadGeneration') || 'Lead Generation', path: '/solutions/lead-generation' },
  { name: t('footer.links.solutions.marketingAutomation') || 'Marketing Automation', path: '/solutions/marketing-automation' },
  { name: t('footer.links.solutions.customerEngagement') || 'Customer Engagement', path: '/solutions/customer-engagement' },
  { name: t('footer.links.solutions.appointmentReminders') || 'Appointment Reminders', path: '/solutions/appointment-reminders' },
  { name: t('footer.links.solutions.emergencyAlerts') || 'Emergency Alerts', path: '/solutions/emergency-alerts' }
];

// Industry links configuration using correct translation keys
const industryLinks = [
  { name: t('footer.links.industries.ecommerceRetail') || 'E-commerce & Retail', path: '/industries/ecommerce-retail' },
  { name: t('footer.links.industries.realEstate') || 'Real Estate', path: '/industries/real-estate' },
  { name: t('footer.links.industries.politicalCampaigns') || 'Political Campaigns', path: '/industries/political-campaigns' },
  { name: t('footer.links.industries.healthcare') || 'Healthcare', path: '/industries/healthcare' },
  { name: t('footer.links.industries.financialServices') || 'Financial Services', path: '/industries/financial-services' }
];

// Company links configuration using correct translation keys
const companyLinks = [
  { name: t('footer.links.company.features') || 'Features', path: '/features' },
  { name: t('header.pricing') || 'Pricing', path: '/pricing' },
  { name: t('footer.links.company.productWiki') || 'Product Wiki', href: getWikiUrl(), external: true },
  { name: t('footer.links.company.apiReferences') || 'API References', href: 'https://api.seasalt.ai', external: true },
  { name: t('header.blog') || 'Blog', href: getLocalizedPath('/blog', lang) },
  { name: t('header.compareUs') || 'Compare Us', href: getLocalizedPath('/compare-us-overview', lang) },
  { name: t('footer.company.about') || 'About', href: getLocalizedPath('/company', lang) },
  { name: t('footer.links.company.careers') || 'Careers', href: getLocalizedPath('/careers', lang) }
];
---

<footer class="bg-gray-900 text-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-6 lg:gap-8">
      <!-- Company Info -->
      <div class="lg:col-span-1">
        <div class="flex items-center mb-6">
          <img 
            src={versionConfig?.logo || '/seax-logo.png'} 
            alt={t('footer.logo.alt') || 'SeaX'}
            class="h-8 w-auto brightness-0 invert"
          />
        </div>
        <p class="text-gray-300 mb-4 sm:mb-6 text-sm sm:text-base">
          {t('footer.description.company') || 'Reach millions instantly. The ultimate platform for sending millions of SMS, WhatsApp messages, and automated phone calls. Fill your pipeline, drive revenue, and scale your business.'}
        </p>
        <div class="space-y-2 sm:space-y-3">
          <div class="flex items-center text-gray-300">
            <svg class="h-4 w-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
            <span class="text-sm">{t('footer.contact.phone') || '+1 (SMB)-AI-AGENT'}</span>
          </div>
          <div class="flex items-center text-gray-300">
            <svg class="h-4 w-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
            <span class="text-sm">{t('footer.contact.email') || 'info@seasalt.ai'}</span>
          </div>
          <div class="flex items-center text-gray-300">
            <svg class="h-4 w-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            <span class="text-sm">{t('footer.contact.location') || 'Seattle, WA'}</span>
          </div>
        </div>
        
        <!-- Social Links -->
        <div class="flex space-x-4 mt-6">
          <a href="https://www.linkedin.com/company/seasalt-ai/" target="_blank" rel="noopener noreferrer" 
             class="text-gray-300 hover:text-white transition-colors duration-200">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
          </a>
          <a href="https://www.youtube.com/@seasaltai" target="_blank" rel="noopener noreferrer" 
             class="text-gray-300 hover:text-white transition-colors duration-200">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
            </svg>
          </a>
          <a href="https://twitter.com/SeasaltAI" target="_blank" rel="noopener noreferrer" 
             class="text-gray-300 hover:text-white transition-colors duration-200">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/>
            </svg>
          </a>
          <a href="https://discord.gg/VgAWg3c7rU" target="_blank" rel="noopener noreferrer" 
             class="text-gray-300 hover:text-white transition-colors duration-200">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M20.317 4.3698a19.7913 19.7913 0 00-4.8851-1.5152.0741.0741 0 00-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 00-.0785-.037 19.7363 19.7363 0 00-4.8852 1.515.0699.0699 0 00-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 00.0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 00.0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 00-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 01-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 01.0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 01.0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 01-.0066.1276 12.2986 12.2986 0 01-1.873.8914.0766.0766 0 00-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 00.0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 00.0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 00-.0312-.0286zM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419-.0189 1.3332-.9555 2.4189-2.1569 2.4189zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.1568 2.4189Z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Channels -->
      <div>
        <h3 class="text-base sm:text-lg font-semibold mb-4 sm:mb-6">{t('footer.section.channels') || 'Channels'}</h3>
        <ul class="space-y-2 sm:space-y-3">
          {channelLinks.map((link, index) => (
            <li key={index}>
              <a 
                href={getSeaXPath(link.path)}
                class={`text-gray-300 hover:text-white transition-colors duration-200 text-sm flex items-center ${
                  link.isChild ? 'pl-4 text-gray-400' : link.isParent ? 'font-medium border-b border-gray-700 pb-1 mb-1' : ''
                }`}
              >
                {link.technical ? (
                  <span class="text-xs font-mono font-bold text-blue-400 mr-2 w-8 text-center">
                    {link.technical}
                  </span>
                ) : (
                  <div class="flex items-center justify-center w-4 h-4 mr-2 flex-shrink-0">
                    {link.path === '/channels/sms' && (
                      <svg class="w-3 h-3 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
                      </svg>
                    )}
                    {link.path === '/channels/whatsapp' && (
                      <svg class="w-3 h-3 text-blue-400" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893A11.821 11.821 0 0020.465 3.516"/>
                      </svg>
                    )}
                    {link.path === '/channels/voice' && (
                      <svg class="w-3 h-3 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
                      </svg>
                    )}
                  </div>
                )}
                {link.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Solutions -->
      <div>
        <h3 class="text-base sm:text-lg font-semibold mb-4 sm:mb-6">{t('footer.section.solutions') || 'Solutions'}</h3>
        <ul class="space-y-2 sm:space-y-3">
          {solutionLinks.map((link, index) => (
            <li key={index}>
              <a 
                href={getSeaXPath(link.path)}
                class="text-gray-300 hover:text-white transition-colors duration-200 text-sm flex items-center"
              >
                {link.path === '/solutions/lead-generation' && (
                  <svg class="h-3 w-3 mr-2 text-blue-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                  </svg>
                )}
                {link.path === '/solutions/marketing-automation' && (
                  <svg class="h-3 w-3 mr-2 text-blue-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                  </svg>
                )}
                {link.path === '/solutions/customer-engagement' && (
                  <svg class="h-3 w-3 mr-2 text-blue-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
                  </svg>
                )}
                {link.path === '/solutions/appointment-reminders' && (
                  <svg class="h-3 w-3 mr-2 text-blue-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                  </svg>
                )}
                {link.path === '/solutions/emergency-alerts' && (
                  <svg class="h-3 w-3 mr-2 text-blue-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                  </svg>
                )}
                {link.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Industries -->
      <div>
        <h3 class="text-base sm:text-lg font-semibold mb-4 sm:mb-6">{t('footer.section.industries') || 'Industries'}</h3>
        <ul class="space-y-2 sm:space-y-3">
          {industryLinks.map((link, index) => (
            <li key={index}>
              <a 
                href={getSeaXPath(link.path)}
                class="text-gray-300 hover:text-white transition-colors duration-200 text-sm flex items-center"
              >
                {link.path === '/industries/ecommerce-retail' && (
                  <svg class="h-3 w-3 mr-2 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4m0 0L7 13m0 0l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17M17 13v4a2 2 0 01-2 2H9a2 2 0 01-2-2v-4m8 0V9a2 2 0 00-2-2H9a2 2 0 00-2 2v4.01"></path>
                  </svg>
                )}
                {link.path === '/industries/real-estate' && (
                  <svg class="h-3 w-3 mr-2 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
                  </svg>
                )}
                {link.path === '/industries/political-campaigns' && (
                  <svg class="h-3 w-3 mr-2 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"></path>
                  </svg>
                )}
                {link.path === '/industries/healthcare' && (
                  <svg class="h-3 w-3 mr-2 text-blue-400" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" clip-rule="evenodd"></path>
                  </svg>
                )}
                {link.path === '/industries/financial-services' && (
                  <svg class="h-3 w-3 mr-2 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                  </svg>
                )}
                {link.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Company -->
      <div>
        <h3 class="text-base sm:text-lg font-semibold mb-4 sm:mb-6">{t('footer.company.title') || 'Company'}</h3>
        <ul class="space-y-2 sm:space-y-3">
          {companyLinks.map((link, index) => (
            <li key={index}>
              {link.external ? (
                <a 
                  href={link.href}
                  target="_blank"
                  rel="noopener noreferrer"
