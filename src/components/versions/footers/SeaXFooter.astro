---
import {
  getTranslationHelpers,
  getLocalizedPath,
  type SupportedLanguage,
} from "../../../i18n/helpers";
import type { VersionConfig } from "../config";

export interface Props {
  currentPath?: string;
  lang?: SupportedLanguage;
  versionConfig?: VersionConfig;
}

const { currentPath = "/", lang = "en", versionConfig } = Astro.props;
const { t } = await getTranslationHelpers(lang);

// Get localized paths for SeaX
const getSeaXPath = (path: string) => getLocalizedPath(`/seax${path}`, lang);

// Helper function to get the correct Wiki URL based on language
const getWikiUrl = () => {
  const wikiLanguage = lang === "zh-TW" || lang === "zh-CN" ? "zh" : "en";
  return `https://wiki.seasalt.ai/${wikiLanguage}/seax`;
};

// Get demo URL based on language
const getDemoUrl = () => {
  return `https://calendar.app.google/FLjCxzbYLqG6CkNs9?lang=${lang}`;
};

// Channel links configuration using correct translation keys
const channelLinks = [
  {
    name: t("footer.links.channels.smsOverview") || "SMS Overview",
    path: "/channels/sms",
    technical: t("footer.technical.sms") || "SMS",
    isParent: true,
  },
  {
    name: t("footer.links.channels.smsLocal") || "Local Number (10DLC)",
    path: "/channels/sms-local",
    technical: t("footer.technical.tenDlc") || "10DLC",
    isChild: true,
  },
  {
    name: t("footer.links.channels.smsTollFree") || "Toll-Free Number",
    path: "/channels/sms-toll-free",
    technical: t("footer.technical.tollFree") || "8XX",
    isChild: true,
  },
  {
    name: t("footer.links.channels.smsShortCode") || "Short Code",
    path: "/channels/sms-short-code",
    technical: t("footer.technical.shortCode") || "xxxxx",
    isChild: true,
  },
  {
    name: t("footer.links.channels.whatsapp") || "WhatsApp Business Platform",
    path: "/channels/whatsapp",
  },
  {
    name: t("footer.links.channels.voice") || "Phone Call Voice",
    path: "/channels/voice",
  },
];

// Solution links configuration using correct translation keys
const solutionLinks = [
  {
    name: t("footer.links.solutions.leadGeneration") || "Lead Generation",
    path: "/solutions/lead-generation",
  },
  {
    name:
      t("footer.links.solutions.marketingAutomation") || "Marketing Automation",
    path: "/solutions/marketing-automation",
  },
  {
    name:
      t("footer.links.solutions.customerEngagement") || "Customer Engagement",
    path: "/solutions/customer-engagement",
  },
  {
    name:
      t("footer.links.solutions.appointmentReminders") ||
      "Appointment Reminders",
    path: "/solutions/appointment-reminders",
  },
  {
    name: t("footer.links.solutions.emergencyAlerts") || "Emergency Alerts",
    path: "/solutions/emergency-alerts",
  },
];

// Industry links configuration using correct translation keys
const industryLinks = [
  {
    name: t("footer.links.industries.ecommerceRetail") || "E-commerce & Retail",
    path: "/industries/ecommerce-retail",
  },
  {
    name: t("footer.links.industries.realEstate") || "Real Estate",
    path: "/industries/real-estate",
  },
  {
    name:
      t("footer.links.industries.politicalCampaigns") || "Political Campaigns",
    path: "/industries/political-campaigns",
  },
  {
    name: t("footer.links.industries.healthcare") || "Healthcare",
    path: "/industries/healthcare",
  },
  {
    name:
      t("footer.links.industries.financialServices") || "Financial Services",
    path: "/industries/financial-services",
  },
];

// Company links configuration using correct translation keys
const companyLinks = [
  {
    name: t("footer.links.company.features") || "Features",
    path: "/features",
    icon: "⚙️",
  },
  {
    name: t("header.pricing") || "Pricing",
    path: "/pricing",
    icon: "💲",
  },
  {
    name: t("footer.links.company.productWiki") || "Product Wiki",
    href: getWikiUrl(),
    external: true,
    icon: "📚",
  },
  {
    name: t("footer.links.company.apiReferences") || "API References",
    href: "https://api.seasalt.ai",
    external: true,
    icon: "🔌",
  },
  {
    name: t("header.blog") || "Blog",
    href: getLocalizedPath("/blog", lang),
    icon: "📰",
  },
  {
    name: t("header.compareUs") || "Compare Us",
    href: getLocalizedPath("/compare-us-overview", lang),
    icon: "📊",
  },
  {
    name: t("footer.company.about") || "About",
    href: getLocalizedPath("/company", lang),
    icon: "🏢",
  },
  {
    name: t("footer.links.company.careers") || "Careers",
    href: getLocalizedPath("/careers", lang),
    icon: "💼",
  },
];
---

<footer class="bg-gray-900 text-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-6 lg:gap-8">
      <!-- Company Info -->
      <div class="lg:col-span-1">
        <div class="flex items-center mb-6">
          <img
            src={versionConfig?.logo || "/seax-logo.png"}
            alt={t("footer.logo.alt") || "SeaX"}
            class="h-8 w-auto brightness-0 invert"
          />
        </div>
        <p class="text-gray-300 mb-4 sm:mb-6 text-sm sm:text-base">
          {
            t("footer.description.company") ||
              "Reach millions instantly. The ultimate platform for sending millions of SMS, WhatsApp messages, and automated phone calls. Fill your pipeline, drive revenue, and scale your business."
          }
        </p>
        <div class="space-y-2 sm:space-y-3">
          <div class="flex items-center text-gray-300">
            <span class="mr-2" aria-hidden="true">📞</span>
            <span class="text-sm"
              >{t("footer.contact.phone") || "+1 (SMB)-AI-AGENT"}</span
            >
          </div>
          <div class="flex items-center text-gray-300">
            <span class="mr-2" aria-hidden="true">📧</span>
            <span class="text-sm"
              >{t("footer.contact.email") || "info@seasalt.ai"}</span
            >
          </div>
          <div class="flex items-center text-gray-300">
            <span class="mr-2" aria-hidden="true">📍</span>
            <span class="text-sm"
              >{t("footer.contact.location") || "Seattle, WA"}</span
            >
          </div>
        </div>

        <!-- Social Links -->
        <div class="flex space-x-4 mt-6">
          <a
            href="https://www.linkedin.com/company/seasalt-ai/"
            target="_blank"
            rel="noopener noreferrer"
            class="text-gray-300 hover:text-white transition-colors duration-200"
          >
            <img
              src="https://upload.wikimedia.org/wikipedia/commons/c/ca/LinkedIn_logo_initials.png"
              alt="LinkedIn"
              class="w-5 h-5"
            />
          </a>
          <a
            href="https://www.youtube.com/@seasaltai"
            target="_blank"
            rel="noopener noreferrer"
            class="text-gray-300 hover:text-white transition-colors duration-200"
          >
            <img
              src="https://cdn.simpleicons.org/youtube/ffffff"
              alt="YouTube"
              class="w-5 h-5"
            />
          </a>
          <a
            href="https://twitter.com/SeasaltAI"
            target="_blank"
            rel="noopener noreferrer"
            class="text-gray-300 hover:text-white transition-colors duration-200"
          >
            <img
              src="https://cdn.simpleicons.org/x/ffffff"
              alt="Twitter"
              class="w-5 h-5"
            />
          </a>
          <a
            href="https://discord.gg/VgAWg3c7rU"
            target="_blank"
            rel="noopener noreferrer"
            class="text-gray-300 hover:text-white transition-colors duration-200"
          >
            <img
              src="https://cdn.simpleicons.org/discord/ffffff"
              alt="Discord"
              class="w-5 h-5"
            />
          </a>
        </div>
      </div>

      <!-- Channels -->
      <div>
        <h3 class="text-base sm:text-lg font-semibold mb-4 sm:mb-6">
          {t("footer.section.channels") || "Channels"}
        </h3>
        <ul class="space-y-2 sm:space-y-3">
          {
            channelLinks.map((link) => (
              <li>
                <a
                  href={getSeaXPath(link.path)}
                  class={`text-gray-300 hover:text-white transition-colors duration-200 text-sm flex items-center ${
                    link.isChild
                      ? "pl-4 text-gray-400"
                      : link.isParent
                        ? "font-medium border-b border-gray-700 pb-1 mb-1"
                        : ""
                  }`}
                >
                  {link.technical ? (
                    <span class="text-xs font-mono font-bold text-blue-400 mr-2 w-8 text-center">
                      {link.technical}
                    </span>
                  ) : (
                    <div class="flex items-center justify-center w-4 h-4 mr-2 flex-shrink-0">
                      {link.path === "/channels/sms" && (
                        <span class="text-blue-400" aria-hidden="true">
                          💬
                        </span>
                      )}
                      {link.path === "/channels/whatsapp" && (
                        <img
                          src="https://cdn.simpleicons.org/whatsapp/25D366"
                          alt="WhatsApp"
                          class="w-3 h-3"
                        />
                      )}
                      {link.path === "/channels/voice" && (
                        <span class="text-blue-400" aria-hidden="true">
                          📞
                        </span>
                      )}
                    </div>
                  )}
                  {link.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Solutions -->
      <div>
        <h3 class="text-base sm:text-lg font-semibold mb-4 sm:mb-6">
          {t("footer.section.solutions") || "Solutions"}
        </h3>
        <ul class="space-y-2 sm:space-y-3">
          {
            solutionLinks.map((link) => (
              <li>
                <a
                  href={getSeaXPath(link.path)}
                  class="text-gray-300 hover:text-white transition-colors duration-200 text-sm flex items-center"
                >
                  {link.path === "/solutions/lead-generation" && (
                    <span
                      class="inline-flex items-center justify-center w-4 h-4 mr-2 shrink-0 align-middle text-blue-400"
                      aria-hidden="true"
                    >
                      🎯
                    </span>
                  )}
                  {link.path === "/solutions/marketing-automation" && (
                    <span
                      class="inline-flex items-center justify-center w-4 h-4 mr-2 shrink-0 align-middle text-blue-400"
                      aria-hidden="true"
                    >
                      ⚡
                    </span>
                  )}
                  {link.path === "/solutions/customer-engagement" && (
                    <span
                      class="inline-flex items-center justify-center w-4 h-4 mr-2 shrink-0 align-middle text-blue-400"
                      aria-hidden="true"
                    >
                      👥
                    </span>
                  )}
                  {link.path === "/solutions/appointment-reminders" && (
                    <span
                      class="inline-flex items-center justify-center w-4 h-4 mr-2 shrink-0 align-middle text-blue-400"
                      aria-hidden="true"
                    >
                      📅
                    </span>
                  )}
                  {link.path === "/solutions/emergency-alerts" && (
                    <span
                      class="inline-flex items-center justify-center w-4 h-4 mr-2 shrink-0 align-middle text-blue-400"
                      aria-hidden="true"
                    >
                      ⚠️
                    </span>
                  )}
                  {link.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Industries -->
      <div>
        <h3 class="text-base sm:text-lg font-semibold mb-4 sm:mb-6">
          {t("footer.section.industries") || "Industries"}
        </h3>
        <ul class="space-y-2 sm:space-y-3">
          {
            industryLinks.map((link) => (
              <li>
                <a
                  href={getSeaXPath(link.path)}
                  class="text-gray-300 hover:text-white transition-colors duration-200 text-sm flex items-center"
                >
                  {link.path === "/industries/ecommerce-retail" && (
                    <span
                      class="inline-flex items-center justify-center w-4 h-4 mr-2 shrink-0 align-middle text-blue-400"
                      aria-hidden="true"
                    >
                      🛒
                    </span>
                  )}
                  {link.path === "/industries/real-estate" && (
                    <span
                      class="inline-flex items-center justify-center w-4 h-4 mr-2 shrink-0 align-middle text-blue-400"
                      aria-hidden="true"
                    >
                      🏠
                    </span>
                  )}
                  {link.path === "/industries/political-campaigns" && (
                    <span
                      class="inline-flex items-center justify-center w-4 h-4 mr-2 shrink-0 align-middle text-blue-400"
                      aria-hidden="true"
                    >
                      🗳️
                    </span>
                  )}
                  {link.path === "/industries/healthcare" && (
                    <span
                      class="inline-flex items-center justify-center w-4 h-4 mr-2 shrink-0 align-middle text-blue-400"
                      aria-hidden="true"
                    >
                      ❤️
                    </span>
                  )}
                  {link.path === "/industries/financial-services" && (
                    <span
                      class="inline-flex items-center justify-center w-4 h-4 mr-2 shrink-0 align-middle text-blue-400"
                      aria-hidden="true"
                    >
                      💰
                    </span>
                  )}
                  {link.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Company -->
      <div>
        <h3 class="text-base sm:text-lg font-semibold mb-4 sm:mb-6">
          {t("footer.company.title") || "Company"}
        </h3>
        <ul class="space-y-2 sm:space-y-3">
          {
            companyLinks.map((link) => {
              const href = link.path ? getSeaXPath(link.path) : link.href;
              return (
                <li>
                  <a
                    href={href}
                    {...(link.external && {
                      target: "_blank",
                      rel: "noopener noreferrer",
                    })}
                    class="text-gray-300 hover:text-white transition-colors duration-200 text-sm flex items-center"
                  >
                    {link.icon && (
                      <span
                        class="inline-flex items-center justify-center w-4 h-4 mr-2 shrink-0 align-middle text-blue-400"
                        aria-hidden="true"
                      >
                        {link.icon}
                      </span>
                    )}
                    {link.name}
                  </a>
                </li>
              );
            })
          }
        </ul>
      </div>
    </div>

    <!-- Bottom Section -->
    <div class="border-t border-gray-800 mt-8 sm:mt-12 pt-6 sm:pt-8">
      <div
        class="flex flex-col lg:flex-row justify-between items-center space-y-4 lg:space-y-0"
      >
        <div
          class="flex flex-col sm:flex-row items-center space-y-2 sm:space-y-0 sm:space-x-4 md:space-x-6 mb-2 lg:mb-0"
        >
          <p class="text-gray-300 text-sm">
            {
              t("footer.copyright", { year: new Date().getFullYear() }) ||
                `© ${new Date().getFullYear()} Seasalt.ai. All rights reserved.`
            }
          </p>
          <div class="flex space-x-3 sm:space-x-4 text-xs sm:text-sm">
            <a
              href="/privacy"
              class="text-gray-300 hover:text-white transition-colors duration-200"
            >
              {t("footer.legal.privacyPolicy") || "Privacy Policy"}
            </a>
            <a
              href="/terms"
              class="text-gray-300 hover:text-white transition-colors duration-200"
            >
              {t("footer.legal.termsOfService") || "Terms of Service"}
            </a>
          </div>
        </div>

        <!-- Stats -->
        <div
          class="flex flex-wrap items-center justify-center gap-3 sm:gap-4 text-xs sm:text-sm text-gray-300"
        >
          <span class="flex items-center">
            <span
              class="inline-flex items-center justify-center w-4 h-4 mr-2 shrink-0 align-middle"
              aria-hidden="true">💬</span
            >
            {t("footer.stats.messagesDaily") || "10M+ Messages Daily"}
          </span>
          <span class="flex items-center">
            <span
              class="inline-flex items-center justify-center w-4 h-4 mr-2 shrink-0 align-middle"
              aria-hidden="true">👥</span
            >
            {t("footer.stats.activeUsers") || "500K+ Active Users"}
          </span>
          <span class="flex items-center">
            <span
              class="inline-flex items-center justify-center w-4 h-4 mr-2 shrink-0 align-middle"
              aria-hidden="true">⚡</span
            >
            {t("footer.stats.uptime") || "99.9% Uptime"}
          </span>
        </div>
      </div>

      <div class="text-center mt-4">
        <p class="text-gray-300 text-sm flex items-center justify-center">
          Made with
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="lucide lucide-heart inline w-4 h-4 text-red-500"
            ><path
              d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"
            ></path></svg
          >
          in the city of{" "}
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="lucide lucide-coffee inline w-4 h-4 text-amber-700"
            ><path d="M17 8h1a4 4 0 1 1 0 8h-1"></path><path
              d="M3 8h14v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4Z"></path><line
              x1="6"
              x2="6"
              y1="2"
              y2="4"></line><line x1="10" x2="10" y1="2" y2="4"></line><line
              x1="14"
              x2="14"
              y1="2"
              y2="4"></line></svg
          >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="lucide lucide-umbrella inline w-4 h-4 text-blue-400"
            ><path d="M22 12a10.06 10.06 1 0 0-20 0Z"></path><path
              d="M12 12v8a2 2 0 0 0 4 0"></path><path d="M12 2v1"></path></svg
          >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="lucide lucide-plane inline w-4 h-4 text-gray-500"
            ><path
              d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z"
            ></path></svg
          >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="lucide lucide-gem inline w-4 h-4 text-fuchsia-500"
            ><path d="M6 3h12l4 6-10 13L2 9Z"></path><path
              d="M11 3 8 9l4 13 4-13-3-6"></path><path d="M2 9h20"></path></svg
          >
        </p>
      </div>
    </div>
  </div>

  <!-- CTA Banner -->
  <div class="bg-gradient-to-r from-blue-600 to-indigo-600 py-6 sm:py-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h3 class="text-xl sm:text-2xl font-bold text-white mb-3 sm:mb-4">
        {t("footer.cta.title") || "Ready to Scale Your Outreach to Millions?"}
      </h3>
      <p class="text-white opacity-90 mb-6 max-w-2xl mx-auto">
        {
          t("footer.cta.subtitle") ||
            "Join thousands of companies using SeaX to reach more customers, generate more leads, and grow faster."
        }
      </p>
      <div class="flex flex-col sm:flex-row gap-3 sm:gap-4 justify-center">
        <a
          href="https://seax.seasalt.ai/signup"
          class="bg-white text-blue-600 hover:bg-gray-50 px-6 sm:px-8 py-2.5 sm:py-3 rounded-lg font-semibold transition-all duration-200 text-sm sm:text-base"
        >
          {t("footer.cta.signUpNow") || "Sign Up Now"}
        </a>
        <a
          href={getDemoUrl()}
          class="border-2 border-white text-white hover:bg-white hover:text-blue-600 px-6 sm:px-8 py-2.5 sm:py-3 rounded-lg font-semibold transition-all duration-200 text-sm sm:text-base"
        >
          {t("footer.cta.scheduleDemo") || "Schedule Demo"}
        </a>
      </div>
    </div>
  </div>
</footer>
