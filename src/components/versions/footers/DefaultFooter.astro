---
import { getTranslationHelpers } from '../../../i18n/helpers';
import type { VersionConfig } from '../config';

export interface Props {
  currentPath?: string;
  lang?: string;
  versionConfig?: VersionConfig;
}

const { currentPath = '/', lang = 'en', versionConfig } = Astro.props;
const { t } = await getTranslationHelpers(lang);

// Products data
const products = [
  {
    title: t('productsData.seachat.title'),
    href: '/seachat',
    description: t('productsData.seachat.description'),
    icon: 'MessageSquare'
  },
  {
    title: t('productsData.seax.title'),
    href: '/seax',
    description: t('productsData.seax.description'),
    icon: 'Users'
  },
  {
    title: t('productsData.seameet.title'),
    href: 'https://seameet.ai/',
    description: t('productsData.seameet.description'),
    icon: 'Video'
  },
  {
    title: t('productsData.seavoice.title'),
    href: '/seavoice',
    description: t('productsData.seavoice.description'),
    icon: 'Mic',
    subProducts: [
      {
        title: t('productsData.seavoice.subProducts.tts'),
        href: 'https://suite.seasalt.ai/tts/'
      },
      {
        title: t('productsData.seavoice.subProducts.stt'),
        href: 'https://suite.seasalt.ai/stt/'
      },
      {
        title: t('productsData.seavoice.subProducts.discord'),
        href: 'https://voice.seasalt.ai/discord/'
      }
    ]
  }
];

// Solutions data
const solutions = [
  {
    title: t('solutionsData.salesMarketing.title'),
    path: '/solutions/sales-marketing',
    slug: 'sales-marketing',
    icon: 'TrendingUp'
  },
  {
    title: t('solutionsData.customerSupport.title'),
    path: '/solutions/customer-support',
    slug: 'customer-support',
    icon: 'Headphones'
  },
  {
    title: t('solutionsData.aiAutomation.title'),
    path: '/solutions/ai-automation',
    slug: 'ai-automation',
    icon: 'Bot'
  },
  {
    title: t('solutionsData.smeOwners.title'),
    path: '/solutions/sme-owners',
    slug: 'sme-owners',
    icon: 'Building2'
  }
];

// Industries data
const industries = [
  {
    icon: 'ShoppingCart',
    title: t('industriesData.ecommerce.title'),
    slug: 'e-commerce'
  },
  {
    icon: 'Heart',
    title: t('industriesData.healthcare.title'),
    slug: 'healthcare'
  },
  {
    icon: 'Home',
    title: t('industriesData.realEstate.title'),
    slug: 'real-estate'
  },
  {
    icon: 'Utensils',
    title: t('industriesData.restaurants.title'),
    slug: 'restaurants-hospitality'
  },
  {
    icon: 'GraduationCap',
    title: t('industriesData.education.title'),
    slug: 'education-training'
  },
  {
    icon: 'Car',
    title: t('industriesData.automotive.title'),
    slug: 'automotive-services'
  },
  {
    icon: 'Briefcase',
    title: t('industriesData.professional.title'),
    slug: 'professional-services'
  },
  {
    icon: 'Building',
    title: t('industriesData.financial.title'),
    slug: 'financial-services'
  }
];

// Helper function to get Wiki URL
const getWikiUrl = () => {
  const wikiLanguage = (lang === 'zh-TW' || lang === 'zh-CN') ? 'zh' : 'en';
  return `https://wiki.seasalt.ai/${wikiLanguage}`;
};

const currentYear = new Date().getFullYear();
const logoSrc = versionConfig?.logo || '/seasalt-ai-logo.png';
---

<footer class="bg-gray-900 text-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-2 sm:gap-3 lg:gap-4">
      
      <!-- Company Info -->
      <div class="lg:col-span-1">
        <div class="flex items-center mb-6">
          <img 
            src={logoSrc} 
            alt="Seasalt.ai" 
            class="h-8 w-auto brightness-0 invert"
          />
        </div>
        <p class="text-gray-300 mb-4 sm:mb-6 text-sm sm:text-base">
          {t('footer.tagline')}
        </p>
        <div class="space-y-2 sm:space-y-3">
          <div class="flex items-center text-gray-300">
            <svg class="h-4 w-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
            </svg>
            <span class="text-sm">+1 (SMB)-AI-AGENT</span>
          </div>
          <div class="flex items-center text-gray-300">
            <svg class="h-4 w-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
            </svg>
            <span class="text-sm">info@seasalt.ai</span>
          </div>
          <div class="flex items-center text-gray-300">
            <svg class="h-4 w-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
            <span class="text-sm">Seattle, WA</span>
          </div>
        </div>
        
        <!-- Social Media Links -->
        <div class="flex space-x-4 mt-6">
          <a href="https://www.linkedin.com/company/seasalt-ai/" target="_blank" rel="noopener noreferrer" class="text-gray-300 hover:text-white transition-colors duration-200">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
          </a>
          <a href="https://www.youtube.com/@seasaltai" target="_blank" rel="noopener noreferrer" class="text-gray-300 hover:text-white transition-colors duration-200">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
            </svg>
          </a>
          <a href="https://twitter.com/SeasaltAI" target="_blank" rel="noopener noreferrer" class="text-gray-300 hover:text-white transition-colors duration-200">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/>
            </svg>
          </a>
          <a href="https://discord.gg/VgAWg3c7rU" target="_blank" rel="noopener noreferrer" class="text-gray-300 hover:text-white transition-colors duration-200">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418Z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Products -->
      <div>
        <h3 class="text-base sm:text-lg font-semibold mb-4 sm:mb-6">{t('header.products')}</h3>
        <ul class="space-y-2 sm:space-y-3">
          {products.map((product, index) => {
            const updatedHref = product.href.startsWith('/')
              ? `/${lang}${product.href}`
              : product.href;
            return (
              <li key={index}>
                <a 
                  href={updatedHref}
                  target={product.href.startsWith('/') ? '_self' : '_blank'}
                  rel={product.href.startsWith('/') ? '' : 'noopener noreferrer'}
                  class="text-gray-300 hover:text-white transition-colors duration-200 flex items-center"
                >
                  {product.icon === 'MessageSquare' && (
                    <svg class="h-4 w-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.004 9.004 0 01-8.716-6.747M3 5a2 2 0 012-2h1.586a1 1 0 01.707.293l2.414 2.414a1 1 0 00.707.293H17a2 2 0 012 2v11a2 2 0 01-2 2H5a2 2 0 01-2-2V5z"></path>
                    </svg>
                  )}
                  {product.icon === 'Users' && (
                    <svg class="h-4 w-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197m13.5-9a4 4 0 11-8 0 4 4 0 018 0z"></path>
                    </svg>
                  )}
                  {product.icon === 'Video' && (
                    <svg class="h-4 w-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
                    </svg>
                  )}
                  {product.icon === 'Mic' && (
                    <svg class="h-4 w-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z"></path>
                    </svg>
                  )}
                  {product.title}
                </a>
                {product.subProducts && (
                  <ul class="ml-4 mt-1 sm:mt-2 space-y-1 sm:space-y-2">
                    {product.subProducts.map((subProduct, subIndex) => (
                      <li key={subIndex}>
                        <a
                          href={subProduct.href}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="text-gray-400 hover:text-gray-300 transition-colors duration-200 text-sm"
                        >
                          {subProduct.title}
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            );
          })}
        </ul>
      </div>

      <!-- Solutions -->
      <div>
        <h3 class="text-base sm:text-lg font-semibold mb-4 sm:mb-6">{t('header.solutions')}</h3>
        <ul class="space-y-2 sm:space-y-3">
          {solutions.map((solution, index) => (
            <li key={index}>
              <a 
                href={`/${lang}${solution.path}`}
                class="text-gray-300 hover:text-white transition-colors duration-200 flex items-center"
              >
                {solution.icon === 'TrendingUp' && (
                  <svg class="h-4 w-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path>
                  </svg>
                )}
                {solution.icon === 'Headphones' && (
                  <svg class="h-4 w-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8a2 2 0 012 2v5l-2 1-2-1V6a2 2 0 00-2-2H8a2 2 0 00-2 2v5l-2 1-2-1V6a2 2 0 012-2z"></path>
                  </svg>
                )}
                {solution.icon === 'Bot' && (
                  <svg class="h-4 w-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"></path>
                  </svg>
                )}
                {solution.icon === 'Building2' && (
                  <svg class="h-4 w-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
                  </svg>
                )}
                {solution.title}
              </a>
            </li>
          ))}
          <li>
            <a 
              href={`/${lang}/seahealth`}
              class="text-gray-300 hover:text-white transition-colors duration-200 flex items-center"
            >
              <svg class="h-4 w-4 mr-2" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" clip-rule="evenodd"></path>
              </svg>
              {t('footer.seahealth') || 'SeaHealth'}
            </a>
          </li>
          <li>
            <a 
              href={`/${lang}/channels-overview`} 
              class="text-gray-300 hover:text-white transition-colors duration-200"
            >
              {t('header.allChannelsOverview')}
            </a>
            <!-- Channel Icons -->
            <div class="grid grid-cols-4 sm:grid-cols-5 gap-2 mt-3">
              <a href={`/${lang}/channels/whatsapp`} class="text-green-600 hover:text-green-500 transition-colors duration-200 flex justify-center">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.004 9.004 0 01-8.716-6.747M3 5a2 2 0 012-2h1.586a1 1 0 01.707.293l2.414 2.414a1 1 0 00.707.293H17a2 2 0 012 2v11a2 2 0 01-2 2H5a2 2 0 01-2-2V5z"></path>
                </svg>
              </a>
              <a href={`/${lang}/channels/phone-calls`} class="text-blue-600 hover:text-blue-500 transition-colors duration-200 flex justify-center">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
                </svg>
              </a>
              <a href={`/${lang}/channels/sms`} class="text-purple-600 hover:text-purple-500 transition-colors duration-200 flex justify-center">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.004 9.004 0 01-8.716-6.747M3 5a2 2 0 012-2h1.586a1 1 0 01.707.293l2.414 2.414a1 1 0 00.707.293H17a2 2 0 012 2v11a2 2 0 01-2 2H5a2 2 0 01-2-2V5z"></path>
                </svg>
              </a>
              <a href={`/${lang}/channels/website-chat`} class="text-indigo-600 hover:text-indigo-500 transition-colors duration-200 flex justify-center">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                </svg>
              </a>
              <a href={`/${lang}/channels/instagram`} class="text-pink-600 hover:text-pink-500 transition-colors duration-200 flex justify-center">
                <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12.017 0C8.396 0 7.989.013 7.041.048 5.51.131 4.574.33 3.789.624 2.23.983 1.378 1.378.333 2.644-.295 3.649-.295 5.26.48 7.875c.374 1.426.923 2.634 1.649 3.635.726 1.001 1.649 1.728 2.644 2.197C6.25 14.05 7.875 14.05 12.017 14.05s5.767 0 7.144-.343c.995-.469 1.918-1.196 2.644-2.197.726-1.001 1.275-2.209 1.649-3.635.775-2.615.775-4.226.48-7.875C23.611.989 22.604.333 21.256.048 20.013.013 19.626.001 16.017.001h-4zM12.017 5.838A6.162 6.162 0 1 0 18.179 12a6.162 6.162 0 0 0-6.162-6.162zM12.017 15.838A3.838 3.838 0 1 1 15.855 12a3.838 3.838 0 0 1-3.838 3.838zM19.846 5.595a1.44 1.44 0 1 1 0-2.881 1.44 1.44 0 0 1 0 2.881z"/>
                </svg>
              </a>
              <a href={`/${lang}/channels/facebook-messenger`} class="text-blue-700 hover:text-blue-600 transition-colors duration-200 flex justify-center">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                </svg>
              </a>
              <a href={`/${lang}/channels/contact-forms`} class="text-gray-400 hover:text-gray-300 transition-colors duration-200 flex justify-center">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                </svg>
              </a>
