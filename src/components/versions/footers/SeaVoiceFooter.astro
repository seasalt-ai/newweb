const currentYear = new Date().getFullYear();

// Helper function to get SeaVoice Wiki URL based on language
const getWikiUrl = () => {
  const wikiLanguage = (lang === 'zh-TW' || lang === 'zh-CN') ? 'zh' : 'en';
  return `https://wiki.seasalt.ai/${wikiLanguage}/`;
};

// Helper function to get meeting URL based on language
const getMeetingUrl = () => {
  return `https://calendly.com/seasalt-ai/seasalt-ai-demo?utm_source=website&utm_medium=footer&utm_campaign=cta&utm_content=demo_${lang}`;
};

