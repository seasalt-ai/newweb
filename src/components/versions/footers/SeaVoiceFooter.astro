// Company links
const companyLinks = [
  { name: t('header.blog') || 'Blog', href: `/${lang}/blog`, icon: 'MessageSquare' },
  { name: t('seavoice.footer.company.pricing') || 'Pricing', href: `/${lang}/seavoice/pricing`, icon: 'DollarSign' },
  { name: t('header.compareUs') || 'Compare Us', href: `/${lang}/compare-us-overview`, icon: 'BarChart3' },
  { name: t('seavoice.footer.company.productWiki') || 'Product Wiki', href: getWikiUrl(), icon: 'Book', external: true },
  { name: t('seavoice.footer.company.apiReferences') || 'API References', href: 'https://api.seasalt.ai', icon: 'Server', external: true },
  { name: t('footer.company.careers') || 'Careers', href: `/${lang}/careers`, icon: 'Briefcase' },
  { name: t('footer.company.about') || 'About', href: `/${lang}/company`, icon: 'Building2' }
