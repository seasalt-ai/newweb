      </div>

      <!-- Integrations -->
      <div>
        <!-- Desktop: Regular heading -->
        <h3 class="hidden lg:block text-lg font-semibold mb-6">{t('seachat.header.integrations', 'Integrations')}</h3>
        
        <!-- Mobile: Collapsible heading -->
        <button 
          class="mobile-section-toggle lg:hidden flex items-center justify-between w-full text-lg font-semibold mb-4 text-left"
          data-section="integrations"
        >
          {t('seachat.header.integrations', 'Integrations')}
