---
import { getTranslationHelpers } from '../../../i18n/helpers';

export interface Props {
  lang?: string;
}

const { lang = 'en' } = Astro.props;
const { t } = await getTranslationHelpers(lang);
---

<div id="phone-banner" class="bg-gradient-to-r from-blue-600 via-blue-700 to-indigo-800 text-white py-3 px-4 shadow-lg border-b-2 border-blue-500">
	<div class="max-w-7xl mx-auto flex items-center justify-between">
		<div class="flex items-center space-x-2 text-center flex-1 justify-center">
			<svg class="w-5 h-5 animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
			</svg>
			<span class="font-semibold text-lg">
				{t('phoneBanner.callText') || 'Call us now:'} <a 
					href={lang === 'zh-TW' ? 'tel:+886-2-77443577' : 'tel:+1-762-242-4368'}
					class="text-yellow-300 hover:text-yellow-200 underline decoration-2 underline-offset-2"
				>
					{t('phoneBanner.phoneNumber') || (lang === 'zh-TW' ? '+886-2-77443577' : '+1-762-242-4368')}
				</a> {t('phoneBanner.bookingText') || 'for free consultation'}
			</span>
			<div class="flex items-center space-x-1 text-yellow-300">
				<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
				</svg>
				<span class="text-sm font-medium">{t('phoneBanner.availability') || '24/7 Available'}</span>
			</div>
		</div>
		
		<!-- Close button -->
		<button id="close-phone-banner" class="text-white/70 hover:text-white ml-4 p-1">
			<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
			</svg>
		</button>
	</div>
</div>

<script>
	document.addEventListener('DOMContentLoaded', function() {
		const banner = document.getElementById('phone-banner');
		const closeButton = document.getElementById('close-phone-banner');
		
		// Check if banner was previously closed
		if (localStorage.getItem('phoneBannerClosed') === 'true') {
			banner?.remove();
			return;
		}
		
		// Handle close button click
		closeButton?.addEventListener('click', function() {
			banner?.remove();
			localStorage.setItem('phoneBannerClosed', 'true');
		});
	});
</script>