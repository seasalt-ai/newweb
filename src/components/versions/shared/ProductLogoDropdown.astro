---
import { getLocalizedPath, getTranslationHelpers } from '../../../i18n/helpers';

export interface Props {
  lang?: string;
  currentProduct?: string; // 'seax', 'seachat', 'seavoice', 'default'
  dropdownId?: string;
  currentLanguage?: string; // for backwards compatibility
}

const { lang = 'en', currentProduct = 'default', dropdownId = 'products', currentLanguage } = Astro.props;
const actualLang = currentLanguage || lang;
const { t } = await getTranslationHelpers(actualLang);

// 統一的完整產品列表
const products = [
  { 
    title: t('productsData.seachat.title') || 'SeaChat', 
    description: t('productsData.seachat.description') || 'AI chatbot platform', 
    href: getLocalizedPath('/seachat', actualLang), 
    logo: '/seachat-icon.png',
    isCurrent: currentProduct === 'seachat'
  },
  { 
    title: t('productsData.seax.title') || 'SeaX', 
    description: t('productsData.seax.description') || 'Mass communication platform', 
    href: getLocalizedPath('/seax', actualLang),
    logo: '/seax-icon.png',
    isCurrent: currentProduct === 'seax'
  },
  { 
    title: t('productsData.seameet.title') || 'SeaMeet', 
    description: t('productsData.seameet.description') || 'AI meeting assistant', 
    href: 'https://seameet.ai/', 
    logo: '/seameet-icon.png',
    isExternal: true,
    isCurrent: false
  },
  {
    title: t('productsData.seavoice.title') || 'SeaVoice', 
    description: t('productsData.seavoice.description') || 'Voice assistant platform', 
    href: getLocalizedPath('/seavoice', actualLang),
    logo: '/seavoice-icon.png',
    isCurrent: currentProduct === 'seavoice',
    subProducts: [
      { title: t('productsData.seavoice.subProducts.tts') || 'Text to Speech', href: 'https://suite.seasalt.ai/tts/' },
      { title: t('productsData.seavoice.subProducts.stt') || 'Speech to Text', href: 'https://suite.seasalt.ai/stt/' },
      { title: t('productsData.seavoice.subProducts.discord') || 'Discord Bot', href: 'https://voice.seasalt.ai/discord/' }
    ]
  }
];
---

<!-- Product Dropdown Button -->
<button 
  class="ml-1 p-1 text-gray-700 hover:text-blue-600 transition-colors duration-200 dropdown-trigger"
  data-dropdown={dropdownId}
>
  <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
  </svg>
</button>

<!-- Products Dropdown -->
<div 
  class="absolute top-full left-0 mt-2 w-80 bg-white rounded-lg shadow-lg border border-gray-200 py-2 z-50 hidden dropdown-menu"
  data-dropdown-menu={dropdownId}
>
  <!-- Back to main site -->
  <a href={getLocalizedPath('/', actualLang)} class="flex items-center px-4 py-3 text-sm hover:bg-gray-50 border-b border-gray-100">
    <svg class="w-5 h-5 mr-3 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
    </svg>
    <div>
      <div class="font-medium text-gray-900">{t('productDropdown.mainSite.title') || 'Main Site'}</div>
      <div class="text-gray-600 text-xs mt-1">{t('productDropdown.mainSite.description') || 'All products & solutions'}</div>
    </div>
  </a>
  
  <div class="px-4 py-2 text-xs font-semibold text-gray-500 uppercase tracking-wide">
    {t('productDropdown.productsLabel') || 'Products'}
  </div>
  
  {products.map((product) => (
    <div>
      {product.isExternal ? (
        <a 
          href={product.href} 
          target="_blank" 
          rel="noopener noreferrer" 
          class={`flex items-center px-4 py-3 text-sm hover:bg-gray-50 transition-colors ${
            product.isCurrent ? 'bg-blue-50 border-l-4 border-blue-500' : ''
          }`}
        >
          <img src={product.logo} alt={product.title} class="w-5 h-5 mr-3 flex-shrink-0" />
          <div>
            <div class={`font-medium ${product.isCurrent ? 'text-blue-600' : 'text-gray-900'}`}>
              {product.title} {product.isCurrent && <span class="text-xs">(Current)</span>}
            </div>
            <div class="text-gray-600 text-xs mt-1">{product.description}</div>
          </div>
        </a>
      ) : (
        <a 
          href={product.href} 
          class={`flex items-center px-4 py-3 text-sm hover:bg-gray-50 transition-colors ${
            product.isCurrent ? 'bg-blue-50 border-l-4 border-blue-500' : ''
          }`}
        >
          <img src={product.logo} alt={product.title} class="w-5 h-5 mr-3 flex-shrink-0" />
          <div>
            <div class={`font-medium ${product.isCurrent ? 'text-blue-600' : 'text-gray-900'}`}>
              {product.title} {product.isCurrent && <span class="text-xs">(Current)</span>}
            </div>
            <div class="text-gray-600 text-xs mt-1">{product.description}</div>
          </div>
        </a>
      )}
      
      {product.subProducts && product.subProducts.length > 0 && (
        <div class="bg-gray-50 border-t border-gray-100">
          {product.subProducts.map((subProduct) => (
            <a
              href={subProduct.href}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center px-8 py-2 text-sm text-gray-600 hover:bg-gray-100 hover:text-gray-900"
            >
              <span class="text-gray-400 mr-2">→</span>
              {subProduct.title}
            </a>
          ))}
        </div>
      )}
    </div>
  ))}
</div>
