---
import { getAllVersions, getVersionConfig, type ComponentVersion } from './config.ts';

// Only show in development mode
const isDev = import.meta.env.DEV;
const versions = getAllVersions();
---

{isDev && (
  <div 
    id="version-switcher"
    class="fixed bottom-4 left-4 z-50 bg-black bg-opacity-90 text-white rounded-lg shadow-lg p-4 max-w-sm"
    style="backdrop-filter: blur(10px);"
  >
    <div class="mb-3">
      <h4 class="text-sm font-semibold text-yellow-400 mb-2">🔧 開發工具 - 版本切換器</h4>
      <p class="text-xs text-gray-300 mb-3">選擇不同的 Header 和 Footer 版本來預覽效果</p>
    </div>

    <!-- Version Selector -->
    <div class="space-y-3">
      <div>
        <label class="block text-xs font-medium text-gray-300 mb-1">Header 版本:</label>
        <select 
          id="header-version-select"
          class="w-full px-2 py-1 text-xs bg-gray-800 border border-gray-600 rounded text-white focus:border-blue-500 focus:outline-none"
        >
          {versions.map((version) => {
            const config = getVersionConfig(version);
            return (
              <option value={version}>
                {config.displayName} - {version}
              </option>
            );
          })}
        </select>
      </div>

      <div>
        <label class="block text-xs font-medium text-gray-300 mb-1">Footer 版本:</label>
        <select 
          id="footer-version-select"
          class="w-full px-2 py-1 text-xs bg-gray-800 border border-gray-600 rounded text-white focus:border-blue-500 focus:outline-none"
        >
          {versions.map((version) => {
            const config = getVersionConfig(version);
            return (
              <option value={version}>
                {config.displayName} - {version}
              </option>
            );
          })}
        </select>
      </div>
    </div>

    <!-- Apply Button -->
    <button 
      id="apply-version-btn"
      class="w-full mt-3 px-3 py-1 bg-blue-600 hover:bg-blue-700 text-white text-xs font-medium rounded transition-colors duration-200"
    >
      套用版本
    </button>

    <!-- Toggle Button -->
    <button 
      id="toggle-switcher"
      class="absolute -top-2 -right-2 w-6 h-6 bg-red-600 hover:bg-red-700 text-white text-xs rounded-full flex items-center justify-center transition-colors duration-200"
      title="隱藏版本切換器"
    >
      ×
    </button>

    <!-- Current Version Display -->
    <div class="mt-3 pt-3 border-t border-gray-700">
      <div class="text-xs text-gray-400">
        <div>目前 Header: <span id="current-header-version" class="text-green-400 font-mono">auto</span></div>
        <div>目前 Footer: <span id="current-footer-version" class="text-green-400 font-mono">auto</span></div>
      </div>
    </div>
  </div>

  <!-- Show Button (when hidden) -->
  <button 
    id="show-switcher"
    class="fixed bottom-4 left-4 z-50 w-12 h-12 bg-yellow-600 hover:bg-yellow-700 text-white rounded-full flex items-center justify-center shadow-lg transition-all duration-200 hidden"
    title="顯示版本切換器"
  >
    🔧
  </button>
)}

<script>
  if (import.meta.env.DEV) {
    document.addEventListener('DOMContentLoaded', function() {
      const switcher = document.getElementById('version-switcher');
      const toggleBtn = document.getElementById('toggle-switcher');
      const showBtn = document.getElementById('show-switcher');
      const applyBtn = document.getElementById('apply-version-btn');
      const headerSelect = document.getElementById('header-version-select');
      const footerSelect = document.getElementById('footer-version-select');
      const currentHeaderSpan = document.getElementById('current-header-version');
      const currentFooterSpan = document.getElementById('current-footer-version');

      // Detect current version from URL path
      function detectCurrentVersion() {
        const path = window.location.pathname;
        let version = 'default';
        
        if (path.includes('/seachat')) {
          version = 'seachat';
        } else if (path.includes('/seax')) {
          version = 'seax';
        } else if (path.includes('/seavoice')) {
          version = 'seavoice';
        }
        
        return version;
      }

      // Initialize selectors with current version
      function initializeSelectors() {
        const currentVersion = detectCurrentVersion();
        if (headerSelect) headerSelect.value = currentVersion;
        if (footerSelect) footerSelect.value = currentVersion;
        if (currentHeaderSpan) currentHeaderSpan.textContent = currentVersion;
        if (currentFooterSpan) currentFooterSpan.textContent = currentVersion;
      }

      // Store version preferences in localStorage for persistence
      function storeVersionPreference(headerVersion, footerVersion) {
        const prefs = {
          header: headerVersion,
          footer: footerVersion,
          timestamp: Date.now()
        };
        localStorage.setItem('seasalt-version-preferences', JSON.stringify(prefs));
      }

      // Load version preferences from localStorage
      function loadVersionPreferences() {
        try {
          const stored = localStorage.getItem('seasalt-version-preferences');
          if (stored) {
            return JSON.parse(stored);
          }
        } catch (e) {
          console.warn('Failed to load version preferences:', e);
        }
        return null;
      }

      // Apply stored preferences if they exist
      function applyStoredPreferences() {
        const prefs = loadVersionPreferences();
        if (prefs && prefs.header && prefs.footer) {
          if (headerSelect) headerSelect.value = prefs.header;
          if (footerSelect) footerSelect.value = prefs.footer;
          if (currentHeaderSpan) currentHeaderSpan.textContent = prefs.header;
          if (currentFooterSpan) currentFooterSpan.textContent = prefs.footer;
        }
      }

      // Toggle switcher visibility
      if (toggleBtn && showBtn && switcher) {
        toggleBtn.addEventListener('click', function() {
          switcher.style.display = 'none';
          showBtn.style.display = 'flex';
        });

        showBtn.addEventListener('click', function() {
          switcher.style.display = 'block';
          showBtn.style.display = 'none';
        });
      }

      // Apply version changes (this would require page reload in a real implementation)
      if (applyBtn && headerSelect && footerSelect) {
        applyBtn.addEventListener('click', function() {
          const headerVersion = headerSelect.value;
          const footerVersion = footerSelect.value;
          
          // Store preferences
          storeVersionPreference(headerVersion, footerVersion);
          
          // Update current version display
          if (currentHeaderSpan) currentHeaderSpan.textContent = headerVersion;
          if (currentFooterSpan) currentFooterSpan.textContent = footerVersion;
          
          // Show notification
          showNotification(`已套用版本 - Header: ${headerVersion}, Footer: ${footerVersion}`);
          
          // In a real implementation, you would need to:
          // 1. Update URL parameters or
          // 2. Reload page with new version settings or
          // 3. Dynamically replace components
          // For now, we'll show a message
          console.log('Version preferences saved:', { headerVersion, footerVersion });
        });
      }

      // Show notification
      function showNotification(message) {
        // Create notification element
        const notification = document.createElement('div');
        notification.className = 'fixed top-4 right-4 bg-green-600 text-white px-4 py-2 rounded-lg shadow-lg z-50 text-sm';
        notification.textContent = message;
        
        document.body.appendChild(notification);
        
        // Remove after 3 seconds
        setTimeout(() => {
          if (notification.parentNode) {
            notification.parentNode.removeChild(notification);
          }
        }, 3000);
      }

      // Initialize
      initializeSelectors();
      applyStoredPreferences();
      
      // Add keyboard shortcut (Ctrl+Shift+V) to toggle switcher
      document.addEventListener('keydown', function(e) {
        if (e.ctrlKey && e.shiftKey && e.key === 'V') {
          e.preventDefault();
          if (switcher && switcher.style.display !== 'none') {
            toggleBtn?.click();
          } else {
            showBtn?.click();
          }
        }
      });
    });
  }
</script>

<style>
  /* Custom scrollbar for selects */
  #version-switcher select {
    scrollbar-width: thin;
    scrollbar-color: #4B5563 #1F2937;
  }
  
  #version-switcher select::-webkit-scrollbar {
    width: 4px;
  }
  
  #version-switcher select::-webkit-scrollbar-track {
    background: #1F2937;
  }
  
  #version-switcher select::-webkit-scrollbar-thumb {
    background: #4B5563;
    border-radius: 2px;
  }
</style>