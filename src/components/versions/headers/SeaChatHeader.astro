---
import { getTranslationHelpers } from '../../../i18n/helpers';
import type { VersionConfig } from '../config';
import LanguageSwitcher from '../../LanguageSwitcher.astro';
import ProductLogoDropdown from '../shared/ProductLogoDropdown.astro';
import PhoneBanner from '../shared/PhoneBanner.astro';

// SeaChat Header component props
export interface Props {
  currentPath?: string;
  lang?: string;
  versionConfig?: VersionConfig;
}

const { currentPath = '/', lang = 'en', versionConfig } = Astro.props;
const { t } = await getTranslationHelpers(lang);

// SeaChat specific navigation
const featuresDropdown = [
  { 
    name: t('seachat.header.featuresDropdown.humanAgents', 'Human Agents'), 
    href: `/${lang}/seachat/features/human-agents`,
    icon: 'Users'
  },
  { 
    name: t('seachat.header.featuresDropdown.aiAutomation', 'AI Automation'), 
    href: `/${lang}/seachat/features/ai-automation`,
    icon: 'Bot'
  },
  { 
    name: t('seachat.header.featuresDropdown.advancedAI', 'Advanced AI'), 
    href: `/${lang}/seachat/features/advanced-ai`,
    icon: 'Brain'
  },
  { 
    name: t('seachat.header.featuresDropdown.knowledgeBase', 'Knowledge Base'), 
    href: `/${lang}/seachat/features/knowledge-base`,
    icon: 'Database'
  },
  { 
    name: t('seachat.header.featuresDropdown.voiceAgents', 'Voice Agents'), 
    href: `/${lang}/seachat/features/voice-agents`,
    icon: 'Phone'
  },
  { 
    name: t('seachat.header.featuresDropdown.analytics', 'Analytics'), 
    href: `/${lang}/seachat/features/analytics`,
    icon: 'BarChart3'
  },
  { 
    name: t('seachat.header.featuresDropdown.omnichannel', 'Omnichannel'), 
    href: `/${lang}/seachat/features/omnichannel`,
    icon: 'MessageSquare'
  },
  { 
    name: t('seachat.header.featuresDropdown.api', 'API'), 
    href: `/${lang}/seachat/features/api`,
    icon: 'Code'
  }
];

const integrationsDropdown = [
  { 
    name: t('seachat.header.integrationsDropdown.websites', 'Websites'), 
    href: `/${lang}/seachat/integrations/websites`,
    icon: 'Globe'
  },
  { 
    name: t('seachat.header.integrationsDropdown.crm', 'CRM'), 
    href: `/${lang}/seachat/integrations/crm`,
    icon: 'Users'
  },
  { 
    name: t('seachat.header.integrationsDropdown.ecommerce', 'E-commerce'), 
    href: `/${lang}/seachat/integrations/ecommerce`,
    icon: 'ShoppingCart'
  },
  { 
    name: t('seachat.header.integrationsDropdown.socialMedia', 'Social Media'), 
    href: `/${lang}/seachat/integrations/social-media`,
    icon: 'MessageSquare'
  },
  { 
    name: t('seachat.header.integrationsDropdown.communication', 'Communication'), 
    href: `/${lang}/seachat/integrations/communication`,
    icon: 'Phone'
  }
];

const solutionsDropdown = [
  { 
    name: t('seachat.header.solutionsDropdown.ecommerce', 'E-commerce'), 
    href: `/${lang}/seachat/solutions/ecommerce`,
    icon: 'ShoppingCart'
  },
  { 
    name: t('seachat.header.solutionsDropdown.healthcare', 'Healthcare'), 
    href: `/${lang}/seachat/solutions/healthcare`,
    icon: 'Heart'
  },
  { 
    name: t('seachat.header.solutionsDropdown.fintech', 'Fintech'), 
    href: `/${lang}/seachat/solutions/fintech`,
    icon: 'DollarSign'
  },
  { 
    name: t('seachat.header.solutionsDropdown.education', 'Education'), 
    href: `/${lang}/seachat/solutions/education`,
    icon: 'GraduationCap'
  },
  { 
    name: t('seachat.header.solutionsDropdown.realEstate', 'Real Estate'), 
    href: `/${lang}/seachat/solutions/real-estate`,
    icon: 'Building2'
  },
  { 
    name: t('seachat.header.solutionsDropdown.smallBusiness', 'Small Business'), 
    href: `/${lang}/seachat/solutions/small-business`,
    icon: 'Briefcase'
  }
];

// Helper function to render SVG icons
const getIcon = (iconName: string, className = 'w-4 h-4') => {
  const icons = {
    Users: `<svg class="${className}" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197m13.5-9a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>`,
    Bot: `<svg class="${className}" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"></path></svg>`,
    Brain: `<svg class="${className}" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path></svg>`,
    Database: `<svg class="${className}" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4"></path></svg>`,
    Phone: `<svg class="${className}" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>`,
    BarChart3: `<svg class="${className}" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path></svg>`,
    MessageSquare: `<svg class="${className}" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.004 9.004 0 01-8.716-6.747M3 5a2 2 0 012-2h1.586a1 1 0 01.707.293l2.414 2.414a1 1 0 00.707.293H17a2 2 0 012 2v11a2 2 0 01-2 2H5a2 2 0 01-2-2V5z"></path></svg>`,
    Code: `<svg class="${className}" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path></svg>`,
    Globe: `<svg class="${className}" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"></path></svg>`,
    ShoppingCart: `<svg class="${className}" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4m0 0L7 13m0 0l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17M17 13v4a2 2 0 01-2 2H9a2 2 0 01-2-2v-4m8 0V9a2 2 0 00-2-2H9a2 2 0 00-2 2v4.01"></path></svg>`,
    Heart: `<svg class="${className}" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" clip-rule="evenodd"></path></svg>`,
    DollarSign: `<svg class="${className}" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1"></path></svg>`,
    GraduationCap: `<svg class="${className}" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z M12 14l-6.16-3.422"></path></svg>`,
    Building2: `<svg class="${className}" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>`,
    Briefcase: `<svg class="${className}" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2-2v2m8 0H8m8 0v6a2 2 0 01-2 2H10a2 2 0 01-2-2V6m8 0H8"></path></svg>`
  };
  return icons[iconName] || '';
};

const logoSrc = versionConfig?.logo || '/seachat-logo.png';

// Helper function to get the correct SeaChat Wiki URL based on language
const getSeaChatWikiUrl = () => {
  const wikiLanguage = (lang === 'zh-TW' || lang === 'zh-CN') ? 'zh' : 'en';
  return `https://wiki.seasalt.ai/${wikiLanguage}/seachat`;
};

// Check if current path is active
const isActivePath = (path: string) => {
  return currentPath === path;
};

const isActiveSection = (section: string) => {
  return currentPath.startsWith(`/${lang}/${section}`);
};
---

<PhoneBanner lang={lang} />

<header class="bg-white border-b border-gray-100 sticky top-0 z-50" style={`--primary-color: ${versionConfig?.primaryColor || '#10B981'}`}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-16">
      <!-- Logo with dropdown -->
      <div class="relative flex items-center">
        <a 
          href={`/${lang}/seachat`} 
          class="hover:opacity-80 transition-opacity flex items-center"
        >
          <img 
            src={logoSrc} 
            alt="SeaChat" 
            class="h-6 sm:h-8 w-auto flex-shrink-0"
          />
        </a>
        
        <ProductLogoDropdown 
          currentLanguage={lang}
          currentProduct="seachat"
          dropdownId="logo"
        />
      </div>

      <!-- Desktop Navigation -->
      <nav class="hidden lg:flex items-center space-x-8">
        <!-- Features Dropdown -->
        <div class="relative">
          <button
            class="flex items-center text-gray-700 hover:text-teal-600 transition-colors duration-200 dropdown-trigger"
            data-dropdown="features"
          >
            {t('seachat.header.features', 'Features')}
            <svg class="ml-1 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </button>
          <div 
            class="absolute top-full left-0 mt-2 w-64 bg-white rounded-lg shadow-lg border border-gray-200 py-2 z-50 hidden dropdown-menu"
            data-dropdown-menu="features"
          >
            {featuresDropdown.map((feature) => (
              <a 
                href={feature.href}
                class="flex items-center px-4 py-3 text-sm text-gray-700 hover:bg-teal-50 hover:text-teal-600 transition-colors"
              >
                <Fragment set:html={getIcon(feature.icon, 'h-4 w-4 mr-3 text-teal-600')} />
                {feature.name}
              </a>
            ))}
          </div>
        </div>

        <!-- Integrations Dropdown -->
        <div class="relative">
          <button
            class="flex items-center text-gray-700 hover:text-teal-600 transition-colors duration-200 dropdown-trigger"
            data-dropdown="integrations"
          >
            {t('seachat.header.integrations', 'Integrations')}
            <svg class="ml-1 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </button>
          <div 
            class="absolute top-full left-0 mt-2 w-64 bg-white rounded-lg shadow-lg border border-gray-200 py-2 z-50 hidden dropdown-menu"
            data-dropdown-menu="integrations"
          >
            {integrationsDropdown.map((integration) => (
              <a 
                href={integration.href}
                class="flex items-center px-4 py-3 text-sm text-gray-700 hover:bg-teal-50 hover:text-teal-600 transition-colors"
              >
                <Fragment set:html={getIcon(integration.icon, 'h-4 w-4 mr-3 text-teal-600')} />
                {integration.name}
              </a>
            ))}
          </div>
        </div>

        <!-- Solutions Dropdown -->
        <div class="relative">
          <button
            class="flex items-center text-gray-700 hover:text-teal-600 transition-colors duration-200 dropdown-trigger"
            data-dropdown="solutions"
          >
            {t('seachat.header.solutions', 'Solutions')}
            <svg class="ml-1 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </button>
          <div 
            class="absolute top-full left-0 mt-2 w-64 bg-white rounded-lg shadow-lg border border-gray-200 py-2 z-50 hidden dropdown-menu"
            data-dropdown-menu="solutions"
          >
            {solutionsDropdown.map((solution) => (
              <a 
                href={solution.href}
                class="flex items-center px-4 py-3 text-sm text-gray-700 hover:bg-teal-50 hover:text-teal-600 transition-colors"
              >
                <Fragment set:html={getIcon(solution.icon, 'h-4 w-4 mr-3 text-teal-600')} />
                {solution.name}
              </a>
            ))}
          </div>
        </div>

        <!-- Pricing Link -->
        <a
          href={`/${lang}/seachat/pricing`}
          class="text-gray-700 hover:text-teal-600 transition-colors duration-200"
        >
          {t('header.pricing', 'Pricing')}
        </a>

        <!-- Blog -->
        <a
          href={`/${lang}/blog`}
          class={`font-medium transition-colors duration-200 ${
            isActivePath(`/${lang}/blog`) ? 'text-blue-600' : 'text-gray-700 hover:text-blue-600'
          }`}
        >
          {t('seachat.header.blog', 'Blog')}
        </a>

        <!-- Wiki (standout) -->
        <a
          href={getSeaChatWikiUrl()}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center font-semibold text-white bg-gradient-to-r from-blue-500 to-teal-500 px-4 py-2 rounded-lg shadow hover:from-blue-600 hover:to-teal-600 transition-all transform hover:scale-105 border border-blue-400 ml-4"
        >
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
          </svg>
          Wiki
        </a>
      </nav>

      <!-- Right side actions -->
      <div class="hidden lg:flex items-center space-x-4">
        <!-- Language Switcher -->
        <LanguageSwitcher currentPath={currentPath} />
        
        <!-- Sign In button -->
        <a
          href="https://chat.seasalt.ai/gpt/signin"
          class="text-gray-700 hover:text-blue-600 font-medium transition-colors"
        >
          {t('seachat.common.signIn', 'Sign In')}
        </a>
        
        <a 
          href="https://chat.seasalt.ai/gpt/signup" 
          class="bg-teal-500 hover:bg-teal-600 text-white px-6 py-2 rounded-lg font-medium transition-all transform hover:scale-105"
        >
          {t('seachat.common.getStarted', 'Get Started')}
        </a>
      </div>

      <!-- Mobile menu button -->
      <div class="lg:hidden">
        <button 
          class="mobile-menu-toggle inline-flex items-center justify-center p-2 rounded-md text-gray-700 hover:text-teal-600 focus:outline-none focus:ring-2 focus:ring-inset focus:ring-teal-500"
          aria-expanded="false"
        >
          <svg class="block h-6 w-6 menu-open" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg class="hidden h-6 w-6 menu-close" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile menu -->
    <div class="lg:hidden hidden mobile-menu bg-white border-b border-gray-100 max-h-[70vh] overflow-y-auto">
      <div class="px-4 py-6 space-y-3">
        <!-- Action Buttons at Top -->
        <div class="space-y-3">
          <a
            href="https://chat.seasalt.ai/gpt/signin"
            class="block w-full text-center text-gray-700 hover:text-blue-600 font-medium py-2 border border-gray-300 rounded-lg transition-colors"
          >
            {t('seachat.common.signIn', 'Sign In')}
          </a>
          <a
            href="https://chat.seasalt.ai/gpt/signup"
            class="w-full block text-center bg-teal-500 hover:bg-teal-600 text-white px-6 py-3 rounded-lg font-medium transition-colors"
          >
            {t('seachat.common.getStarted', 'Get Started')}
          </a>
          <a
            href={getSeaChatWikiUrl()}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full flex items-center justify-center font-semibold text-white bg-gradient-to-r from-blue-500 to-teal-500 px-4 py-2 rounded-lg shadow hover:from-blue-600 hover:to-teal-600 transition-all border border-blue-400"
          >
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
            </svg>
            Wiki
          </a>
        </div>

        <!-- Back to Main Site -->
        <div class="pt-4 pb-4 border-t border-gray-100">
          <a 
            href={`/${lang}`} 
            class="flex items-center text-gray-700 hover:text-blue-600 font-medium transition-colors"
          >
            <img src="/seasalt-ai-logo.png" alt="Seasalt.ai" class="h-6 w-auto mr-2" />
            {t('seachat.header.backToMainSite', 'Back to Main Site')}
          </a>
        </div>
        
        <!-- Features Section -->
        <div>
          <button 
            class="mobile-section-toggle flex items-center justify-between w-full font-semibold text-gray-900 mb-3 px-3 py-2"
            data-section="features"
          >
            {t('seachat.header.features', 'Features')}
            <svg class="w-4 h-4 transition-transform chevron-down" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </button>
          <div class="mobile-section-content hidden" data-section-content="features">
            <div class="space-y-1 pl-4 pb-2">
              {featuresDropdown.map((item) => (
                <a 
                  href={item.href} 
                  class={`flex items-center transition-colors ${
                    isActivePath(item.href) 
                      ? 'text-blue-600 font-medium' 
                      : 'text-gray-600 hover:text-blue-600'
                  }`}
                >
                  <Fragment set:html={getIcon(item.icon, 'w-4 h-4 mr-3 text-blue-600')} />
                  {item.name}
                </a>
              ))}
            </div>
          </div>
        </div>

        <!-- Integrations Section -->
        <div>
          <button 
            class="mobile-section-toggle flex items-center justify-between w-full font-semibold text-gray-900 mb-3 px-3 py-2"
            data-section="integrations"
          >
            {t('seachat.header.integrations', 'Integrations')}
            <svg class="w-4 h-4 transition-transform chevron-down" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </button>
          <div class="mobile-section-content hidden" data-section-content="integrations">
            <div class="space-y-1 pl-4 pb-2">
              {integrationsDropdown.slice(0, 4).map((item) => (
                <a 
                  href={item.href} 
                  class={`flex items-center transition-colors ${
                    isActivePath(item.href) 
                      ? 'text-blue-600 font-medium' 
                      : 'text-gray-600 hover:text-blue-600'
                  }`}
                >
                  <Fragment set:html={getIcon(item.icon, 'w-4 h-4 mr-3 text-blue-600')} />
                  {item.name}
                </a>
              ))}
              <a href={`/${lang}/seachat/integrations`} class="block text-blue-600 font-medium">{t('seachat.header.viewAllIntegrations', 'View All Integrations')}</a>
            </div>
          </div>
        </div>

        <!-- Solutions Section -->
        <div>
          <button 
            class="mobile-section-toggle flex items-center justify-between w-full font-semibold text-gray-900 mb-3 px-3 py-2"
            data-section="solutions"
          >
            {t('seachat.header.solutions', 'Solutions')}
            <svg class="w-4 h-4 transition-transform chevron-down" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </button>
          <div class="mobile-section-content hidden" data-section-content="solutions">
            <div class="space-y-1 pl-4 pb-2">
              {solutionsDropdown.slice(0, 4).map((item) => (
                <a 
                  href={item.href} 
                  class={`flex items-center transition-colors ${
                    isActivePath(item.href) 
                      ? 'text-blue-600 font-medium' 
                      : 'text-gray-600 hover:text-blue-600'
                  }`}
                >
                  <Fragment set:html={getIcon(item.icon, 'w-4 h-4 mr-3 text-blue-600')} />
                  {item.name}
                </a>
              ))}
              <a href={`/${lang}/seachat/solutions`} class="block text-blue-600 font-medium">{t('seachat.header.viewAllSolutions', 'View All Solutions')}</a>
            </div>
          </div>
        </div>

        <a 
          href={`/${lang}/seachat/pricing`} 
          class={`block transition-colors px-3 py-2 ${
            isActivePath(`/${lang}/seachat/pricing`) ? 'text-blue-600' : 'text-gray-700 hover:text-blue-600'
          }`}
        >
          {t('seachat.header.pricing', 'Pricing')}
        </a>
        
        <a 
          href={`/${lang}/blog`} 
          class={`block transition-colors px-3 py-2 ${
            isActivePath(`/${lang}/blog`) ? 'text-blue-600' : 'text-gray-700 hover:text-blue-600'
          }`}
        >
          {t('seachat.header.blog', 'Blog')}
        </a>
        
        <!-- Language Selector -->
        <div class="pt-4 border-t border-gray-100">
          <div class="px-3 py-2">
            <LanguageSwitcher currentPath={currentPath} />
          </div>
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  // Header dropdown functionality
  document.addEventListener('DOMContentLoaded', function() {
    const dropdownTriggers = document.querySelectorAll('.dropdown-trigger');
    const dropdownMenus = document.querySelectorAll('.dropdown-menu');
    
    dropdownTriggers.forEach(trigger => {
      trigger.addEventListener('mouseenter', function() {
        const dropdownId = this.getAttribute('data-dropdown');
        const menu = document.querySelector(`[data-dropdown-menu="${dropdownId}"]`);
        if (menu) {
          dropdownMenus.forEach(m => m.classList.add('hidden'));
          menu.classList.remove('hidden');
        }
      });
    });

    dropdownMenus.forEach(menu => {
      menu.addEventListener('mouseleave', function() {
        this.classList.add('hidden');
      });
    });

    // Close dropdowns when clicking outside
    document.addEventListener('click', function(event) {
      if (!event.target.closest('.dropdown-trigger') && !event.target.closest('.dropdown-menu')) {
        dropdownMenus.forEach(menu => menu.classList.add('hidden'));
      }
    });

    // Mobile menu toggle
    const mobileMenuToggle = document.querySelector('.mobile-menu-toggle');
    const mobileMenu = document.querySelector('.mobile-menu');
    const menuOpenIcon = document.querySelector('.menu-open');
    const menuCloseIcon = document.querySelector('.menu-close');
    
    if (mobileMenuToggle && mobileMenu) {
      mobileMenuToggle.addEventListener('click', function() {
        const isHidden = mobileMenu.classList.contains('hidden');
        mobileMenu.classList.toggle('hidden');
        
        // Toggle menu icons
        if (menuOpenIcon && menuCloseIcon) {
          if (isHidden) {
            menuOpenIcon.classList.add('hidden');
            menuCloseIcon.classList.remove('hidden');
          } else {
            menuOpenIcon.classList.remove('hidden');
            menuCloseIcon.classList.add('hidden');
          }
        }
        
        this.setAttribute('aria-expanded', isHidden ? 'true' : 'false');
      });
    }

    // Mobile section toggles
    const sectionToggles = document.querySelectorAll('.mobile-section-toggle');
    
    sectionToggles.forEach(toggle => {
      toggle.addEventListener('click', function() {
        const section = this.getAttribute('data-section');
        const content = document.querySelector(`[data-section-content="${section}"]`);
        const chevron = this.querySelector('.chevron-down');
        
        if (content) {
          const isHidden = content.classList.contains('hidden');
          content.classList.toggle('hidden');
          
          if (chevron) {
            if (isHidden) {
              chevron.classList.add('rotate-180');
            } else {
              chevron.classList.remove('rotate-180');
            }
          }
        }
      });
    });
  });
</script>
