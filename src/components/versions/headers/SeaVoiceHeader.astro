---
import { getTranslationHelpers } from '../../../i18n/helpers';
import type { VersionConfig } from '../config';
import PhoneBanner from '../shared/PhoneBanner.astro';
import ProductLogoDropdown from '../shared/ProductLogoDropdown.astro';
import LanguageSwitcher from '../../LanguageSwitcher.astro';

export interface Props {
  currentPath?: string;
  lang?: string;
  versionConfig?: VersionConfig;
}

const { currentPath = '/', lang = 'en', versionConfig } = Astro.props;
const { t } = await getTranslationHelpers(lang);

// Helper function to get SeaVoice Wiki URL based on language
const getWikiUrl = () => {
  const wikiLanguage = (lang === 'zh-TW' || lang === 'zh-CN') ? 'zh' : 'en';
  return `https://wiki.seasalt.ai/${wikiLanguage}/`;
};

// Helper function to render SVG icons
const getIcon = (iconName: string, className = 'w-4 h-4') => {
  const icons = {
    Monitor: `<svg class="${className}" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>`,
    Phone: `<svg class="${className}" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>`,
    Wifi: `<svg class="${className}" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.111 16.404a5.5 5.5 0 017.778 0M12 20h.01m-7.08-7.071c3.904-3.905 10.236-3.905 14.141 0M1.394 9.393c5.857-5.857 15.355-5.857 21.213 0"></path></svg>`,
    PhoneCall: `<svg class="${className}" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>`,
    MessageCircle: `<svg class="${className}" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.004 9.004 0 01-8.716-6.747M3 5a2 2 0 012-2h1.586a1 1 0 01.707.293l2.414 2.414a1 1 0 00.707.293H17a2 2 0 012 2v11a2 2 0 01-2 2H5a2 2 0 01-2-2V5z"></path></svg>`,
    AudioLines: `<svg class="${className}" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM21 16c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2z"></path></svg>`,
    Volume2: `<svg class="${className}" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M11 5L6 9H2v6h4l5 4V5z"></path></svg>`,
    Brain: `<svg class="${className}" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path></svg>`,
    Bot: `<svg class="${className}" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"></path></svg>`,
    ArrowRightLeft: `<svg class="${className}" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16l4-4-4-4m6 8l4-4-4-4"></path></svg>`,
    Zap: `<svg class="${className}" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>`,
    Heart: `<svg class="${className}" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" clip-rule="evenodd"></path></svg>`,
    Shield: `<svg class="${className}" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>`,
    Headphones: `<svg class="${className}" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2z"></path></svg>`,
    Package: `<svg class="${className}" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10"></path></svg>`,
    CreditCard: `<svg class="${className}" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"></path></svg>`,
    Calendar: `<svg class="${className}" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>`,
    Target: `<svg class="${className}" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M6.267 3.455a8 8 0 111.164 1.164l-1.122 1.122a6.5 6.5 0 10-.958-.958l1.122-1.122z"></path></svg>`,
    DollarSign: `<svg class="${className}" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1"></path></svg>`,
    UserCheck: `<svg class="${className}" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>`,
    Clock: `<svg class="${className}" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>`,
    Megaphone: `<svg class="${className}" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z"></path></svg>`,
    Headset: `<svg class="${className}" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2z"></path></svg>`,
    RefreshCw: `<svg class="${className}" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>`,
    FileText: `<svg class="${className}" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>`,
    AlertTriangle: `<svg class="${className}" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>`,
    Mail: `<svg class="${className}" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>`,
    PhoneIncoming: `<svg class="${className}" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>`,
    PhoneOutgoing: `<svg class="${className}" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>`
  };
  return icons[iconName] || '';
};

// Platform dropdown items
const platformItems = [
  { name: t('seavoice.header.navigation.platform.overview') || 'Platform Overview', href: `/${lang}/seavoice/platform`, icon: 'Monitor' },
  { name: t('seavoice.header.navigation.platform.landlineMobile') || 'Landline & Mobile', href: `/${lang}/seavoice/platform/landline-mobile`, icon: 'Phone' },
  { name: t('seavoice.header.navigation.platform.voipSipByoc') || 'VoIP/SIP/BYOC', href: `/${lang}/seavoice/platform/voip-sip-byoc`, icon: 'Wifi' },
  { name: t('seavoice.header.navigation.platform.lineCallPlus') || 'Line Call Plus', href: `/${lang}/seavoice/platform/line-call-plus`, icon: 'PhoneCall' },
  { name: t('seavoice.header.navigation.platform.whatsAppVoice') || 'WhatsApp Voice', href: `/${lang}/seavoice/platform/whatsapp-voice`, icon: 'MessageCircle' },
  { name: t('seavoice.header.navigation.platform.speechToText') || 'Speech to Text', href: `/${lang}/seavoice/platform/speech-to-text`, icon: 'AudioLines' },
  { name: t('seavoice.header.navigation.platform.textToSpeech') || 'Text to Speech', href: `/${lang}/seavoice/platform/text-to-speech`, icon: 'Volume2' },
  { name: t('seavoice.header.navigation.platform.endToEndLlms') || 'End-to-End LLMs', href: `/${lang}/seavoice/platform/end-to-end-llms`, icon: 'Brain' }
];

// Inbound solutions dropdown items
const inboundSolutionItems = [
  { name: t('seavoice.header.navigation.inboundSolutions.virtualAssistant') || 'Virtual Assistant', href: `/${lang}/seavoice/solutions/inbound/virtual-assistant`, icon: 'Bot' },
  { name: t('seavoice.header.navigation.inboundSolutions.callTransfer') || 'Call Transfer', href: `/${lang}/seavoice/solutions/inbound/call-transfer`, icon: 'ArrowRightLeft' },
  { name: t('seavoice.header.navigation.inboundSolutions.ivrReplacement') || 'IVR Replacement', href: `/${lang}/seavoice/solutions/inbound/ivr-replacement`, icon: 'Zap' },
  { name: t('seavoice.header.navigation.inboundSolutions.mentalHealth') || 'Mental Health', href: `/${lang}/seavoice/solutions/inbound/mental-health`, icon: 'Heart' },
  { name: t('seavoice.header.navigation.inboundSolutions.scamShield') || 'Scam Shield', href: `/${lang}/seavoice/solutions/inbound/scam-shield`, icon: 'Shield' },
  { name: t('seavoice.header.navigation.inboundSolutions.technicalSupport') || 'Technical Support', href: `/${lang}/seavoice/solutions/inbound/technical-support`, icon: 'Headphones' },
  { name: t('seavoice.header.navigation.inboundSolutions.orderTracking') || 'Order Tracking', href: `/${lang}/seavoice/solutions/inbound/order-tracking`, icon: 'Package' },
  { name: t('seavoice.header.navigation.inboundSolutions.paymentProcessing') || 'Payment Processing', href: `/${lang}/seavoice/solutions/inbound/payment-processing`, icon: 'CreditCard' },
  { name: t('seavoice.header.navigation.inboundSolutions.appointmentBooking') || 'Appointment Booking', href: `/${lang}/seavoice/solutions/inbound/appointment-booking`, icon: 'Calendar' }
];

// Outbound solutions dropdown items
const outboundSolutionItems = [
  { name: t('seavoice.header.navigation.outboundSolutions.leadGeneration') || 'Lead Generation', href: `/${lang}/seavoice/solutions/outbound/lead-generation`, icon: 'Target' },
  { name: t('seavoice.header.navigation.outboundSolutions.collections') || 'Collections', href: `/${lang}/seavoice/solutions/outbound/collections`, icon: 'DollarSign' },
  { name: t('seavoice.header.navigation.outboundSolutions.reactivation') || 'Reactivation', href: `/${lang}/seavoice/solutions/outbound/reactivation`, icon: 'UserCheck' },
  { name: t('seavoice.header.navigation.outboundSolutions.seniorChecks') || 'Senior Checks', href: `/${lang}/seavoice/solutions/outbound/senior-checks`, icon: 'Clock' },
  { name: t('seavoice.header.navigation.outboundSolutions.campaigns') || 'Campaigns', href: `/${lang}/seavoice/solutions/outbound/campaigns`, icon: 'Megaphone' },
  { name: t('seavoice.header.navigation.outboundSolutions.proactiveSupport') || 'Proactive Support', href: `/${lang}/seavoice/solutions/outbound/proactive-support`, icon: 'Headset' },
  { name: t('seavoice.header.navigation.outboundSolutions.renewals') || 'Renewals', href: `/${lang}/seavoice/solutions/outbound/renewals`, icon: 'RefreshCw' },
  { name: t('seavoice.header.navigation.outboundSolutions.surveys') || 'Surveys', href: `/${lang}/seavoice/solutions/outbound/surveys`, icon: 'FileText' },
  { name: t('seavoice.header.navigation.outboundSolutions.fraudAlerts') || 'Fraud Alerts', href: `/${lang}/seavoice/solutions/outbound/fraud-alerts`, icon: 'AlertTriangle' }
];

// Brand logos for channel-like items in SeaVoice (platform)
const getBrandLogo = (href: string) => {
  if (href.endsWith('/seavoice/platform/whatsapp-voice')) {
    return { url: 'https://cdn.simpleicons.org/whatsapp/25D366', alt: 'WhatsApp' };
  }
  if (href.endsWith('/seavoice/platform/line-call-plus')) {
    return { url: 'https://cdn.simpleicons.org/line/00C300', alt: 'LINE' };
  }
  return null;
};

// Emoji mappings
const platformEmoji: Record<string, string> = {
  Monitor: '🖥️',
  Phone: '📞',
  Wifi: '📶',
  PhoneCall: '📞',
  MessageCircle: '💬',
  AudioLines: '🎙️',
  Volume2: '🔊',
  Brain: '🧠'
};

const inboundEmoji: Record<string, string> = {
  Bot: '🤖',
  ArrowRightLeft: '🔁',
  Zap: '⚡️',
  Heart: '❤️',
  Shield: '🛡️',
  Headphones: '🎧',
  Package: '📦',
  CreditCard: '💳',
  Calendar: '🗓️'
};

const outboundEmoji: Record<string, string> = {
  Target: '🎯',
  DollarSign: '💵',
  UserCheck: '✅',
  Clock: '⏰',
  Megaphone: '📣',
  Headset: '🎧',
  RefreshCw: '🔄',
  FileText: '📄',
  AlertTriangle: '⚠️'
};

// Check if current path matches
const isActivePath = (path: string) => {
  return currentPath === path;
};

// Check if current section is active
const isActiveSection = (section: string) => {
  return currentPath.includes(`/${lang}/seavoice/${section}`);
};
---

<PhoneBanner lang={lang} />

<header class="bg-white shadow-sm sticky top-0 z-50">
  <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-16">
      <!-- Logo with dropdown -->
      <div class="flex-shrink-0">
        <div class="relative flex items-center">
          <!-- Logo - navigates to SeaVoice home -->
          <a
            href={`/${lang}/seavoice`}
            class="hover:opacity-80 transition-opacity flex items-center"
          >
            <img 
              src={versionConfig?.logo || '/seavoice-logo.png'} 
              alt="SeaVoice Logo" 
              class="h-6 sm:h-8 w-auto"
            />
          </a>
          
          <ProductLogoDropdown 
            lang={lang}
            currentProduct="seavoice"
            dropdownId="logo"
          />
        </div>
      </div>

      <!-- Desktop Navigation -->
      <div class="hidden md:flex items-center space-x-8">
        <!-- Platform Dropdown -->
        <div class="relative dropdown-container" data-dropdown="platform">
          <button
            class={`flex items-center px-3 py-2 text-sm font-medium transition-colors duration-200 dropdown-trigger ${
              isActiveSection('platform')
                ? 'text-blue-600 border-b-2 border-blue-600'
                : 'text-gray-700 hover:text-blue-600'
            }`}
            data-dropdown="platform"
          >
            {t('seavoice.header.navigation.platform.title') || 'Platform'}
            <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </button>
          
          <div class="hidden absolute top-full left-0 pt-1 w-80 z-50 dropdown-menu" data-dropdown-menu="platform">
            <div class="bg-white rounded-lg shadow-xl border border-gray-200 py-2">
              {platformItems.map((item) => (
                <a
                  href={item.href}
                  class={`flex items-center block px-4 py-3 text-sm transition-colors ${
                    isActivePath(item.href)
                      ? 'bg-blue-50 text-blue-600'
                      : 'text-gray-700 hover:bg-blue-50 hover:text-blue-600'
                  }`}
                >
{getBrandLogo(item.href) ? (
                  <img src={getBrandLogo(item.href).url} alt={getBrandLogo(item.href).alt} class="w-4 h-4 mr-2" loading="lazy" />
                ) : (
                  <span class="w-4 h-4 mr-2 flex items-center justify-center text-base" role="img" aria-label="platform-emoji">{platformEmoji[item.icon] || '⭐'}</span>
                )}
                  {item.name}
                </a>
              ))}
            </div>
          </div>
        </div>

        <!-- Inbound Solutions Dropdown -->
        <div class="relative dropdown-container" data-dropdown="inbound">
          <button
            class={`flex items-center px-3 py-2 text-sm font-medium transition-colors duration-200 dropdown-trigger ${
              isActiveSection('solutions/inbound')
                ? 'text-blue-600 border-b-2 border-blue-600'
                : 'text-gray-700 hover:text-blue-600'
            }`}
            data-dropdown="inbound"
          >
            {t('seavoice.header.navigation.inboundSolutions.title') || 'Inbound Solutions'}
            <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </button>
          
          <div class="hidden absolute top-full left-0 pt-1 w-80 z-50 dropdown-menu" data-dropdown-menu="inbound">
            <div class="bg-white rounded-lg shadow-xl border border-gray-200 py-2">
              <div class="flex items-center mb-3 pb-2 border-b border-gray-100 px-4">
                <Fragment set:html={getIcon('PhoneIncoming', 'w-4 h-4 text-blue-600 mr-2')} />
                <h3 class="text-sm font-semibold text-gray-900">{t('seavoice.header.navigation.inboundSolutions.title') || 'Inbound Solutions'}</h3>
              </div>
              {inboundSolutionItems.map((item) => (
                <a
                  href={item.href}
                  class={`flex items-center block px-4 py-3 text-sm transition-colors ${
                    isActivePath(item.href)
                      ? 'bg-blue-50 text-blue-600'
                      : 'text-gray-700 hover:bg-blue-50 hover:text-blue-600'
                  }`}
                >
