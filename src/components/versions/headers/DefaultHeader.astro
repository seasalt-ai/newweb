---
import LanguageSwitcher from '../../LanguageSwitcher.astro';
import { getTranslationHelpers } from '../../../i18n/helpers';
import type { VersionConfig } from '../config';
import ProductLogoDropdown from '../shared/ProductLogoDropdown.astro';
import PhoneBanner from '../shared/PhoneBanner.astro';
import curatedAppsData from '../../../../zapier/data/curated-apps.json';
import actionsData from '../../../../zapier/data/actions.json';

// Header component props
export interface Props {
  currentPath?: string;
  lang?: string;
  versionConfig?: VersionConfig;
}

const { currentPath = '/', lang = 'en', versionConfig } = Astro.props;
const { t } = await getTranslationHelpers(lang);

// Load integration data
const curatedApps = curatedAppsData as { apps: any[] };
const actionsJson = actionsData as { actions: any[] };

// Group apps by category
const appsByCategory = curatedApps.apps.reduce((acc: any, app: any) => {
  if (!acc[app.category]) {
    acc[app.category] = [];
  }
  acc[app.category].push(app);
  return acc;
}, {});

// Define priority order for categories (categories not in this list will appear after, alphabetically)
const priorityCategories = [
  'Ads Conversion',
  'Calendar',
  'Forms',
  'Spreadsheets',
  'Crm',
  'Contacts',
  'Ecommerce',
  'Project Management',
  'Scheduling'
];

// Sort categories: priority first, then alphabetical
const allCategories = Object.keys(appsByCategory);
const prioritizedCategories = priorityCategories.filter(cat => allCategories.includes(cat));
const remainingCategories = allCategories
  .filter(cat => !priorityCategories.includes(cat))
  .sort();
const sortedCategories = [...prioritizedCategories, ...remainingCategories];

// Navigation data using translations
const solutions = [
  { title: t('header.useCasesDropdown.salesMarketing'), path: '/solutions/sales-marketing', icon: 'TrendingUp' },
  { title: t('header.useCasesDropdown.customerSupport'), path: '/solutions/customer-support', icon: 'Headphones' },
  { title: t('header.useCasesDropdown.aiAutomation'), path: '/solutions/ai-automation', icon: 'Bot' },
  { title: t('header.useCasesDropdown.smeOwners'), path: '/solutions/sme-owners', icon: 'Building2' }
];

const industries = [
  { title: t('industriesData.ecommerce.title'), path: '/industries/ecommerce', slug: 'e-commerce', icon: 'ShoppingCart' },
  { title: t('industriesData.healthcare.title'), path: '/industries/healthcare', slug: 'healthcare', icon: 'Heart' },
  { title: t('industriesData.realEstate.title'), path: '/industries/real-estate', slug: 'real-estate', icon: 'Home' },
  { title: t('industriesData.restaurants.title'), path: '/industries/restaurants-hospitality', slug: 'restaurants-hospitality', icon: 'Utensils' },
  { title: t('industriesData.education.title'), path: '/industries/education', slug: 'education-training', icon: 'GraduationCap' },
  { title: t('industriesData.automotive.title'), path: '/industries/automotive', slug: 'automotive-services', icon: 'Car' },
  { title: t('industriesData.professional.title'), path: '/industries/professional-services', slug: 'professional-services', icon: 'Briefcase' },
  { title: t('industriesData.financial.title'), path: '/industries/financial-services', slug: 'financial-services', icon: 'Building' }
];

const channels = [
  { title: t('header.channelsDropdown.whatsapp'), path: '/channels/whatsapp', icon: 'MessageCircle' },
  { title: t('header.channelsDropdown.phoneCalls'), path: '/channels/phone-calls', icon: 'Phone' },
  { title: t('header.channelsDropdown.sms'), path: '/channels/sms', icon: 'MessageSquare' },
  { title: t('header.channelsDropdown.websiteChat'), path: '/channels/website-chat', icon: 'Bot' },
  { title: t('header.channelsDropdown.instagram'), path: '/channels/instagram', icon: 'Instagram' },
  { title: t('header.channelsDropdown.facebookMessenger'), path: '/channels/facebook-messenger', icon: 'Facebook' },
  { title: t('header.channelsDropdown.contactForms'), path: '/channels/contact-forms', icon: 'Mail' },
  { title: t('header.channelsDropdown.line'), path: '/channels/line', icon: 'MessageSquare' },
  { title: 'Line Call Plus', path: '/channels/line-call-plus', icon: 'MessageSquare', isLineCallPlus: true },
  { title: t('header.channelsDropdown.websiteWidget'), path: '/channels/website-widget', icon: 'Monitor' }
];

// Emoji mapping for default header icons
const solutionEmoji: Record<string, string> = {
  TrendingUp: '📈',
  Headphones: '🎧',
  Bot: '🤖',
  Building2: '🏢'
};

const industryEmoji: Record<string, string> = {
  ShoppingCart: '🛒',
  Heart: '❤️',
  Home: '🏠',
  Utensils: '🍽️',
  GraduationCap: '🎓',
  Car: '🚗',
  Briefcase: '💼',
  Building: '🏢'
};

// Brand logo URLs (Simple Icons CDN) for channel items
const channelLogoMap: Record<string, { url: string; alt: string }> = {
  '/channels/whatsapp': { url: 'https://cdn.simpleicons.org/whatsapp/25D366', alt: 'WhatsApp' },
  '/channels/instagram': { url: 'https://cdn.simpleicons.org/instagram/E4405F', alt: 'Instagram' },
  '/channels/facebook-messenger': { url: 'https://cdn.simpleicons.org/messenger/00B2FF', alt: 'Facebook Messenger' },
  '/channels/line': { url: 'https://cdn.simpleicons.org/line/00C300', alt: 'LINE' },
  '/channels/line-call-plus': { url: 'https://cdn.simpleicons.org/line/00C300', alt: 'LINE Call Plus' }
};

// Emoji mapping for non-brand channels
const nonBrandEmoji: Record<string, string> = {
  '/channels/phone-calls': '📞',
  '/channels/sms': '✉️',
  '/channels/website-chat': '💬',
  '/channels/website-widget': '🧩',
  '/channels/contact-forms': '📝'
};

const competitors = [
  { title: 'vs. Aircall', path: '/compare/aircall-alternative' },
  { title: 'vs. RingCentral', path: '/compare/ringcentral-alternative' },
  { title: 'vs. Genesys', path: '/compare/genesys-alternative' },
  { title: 'vs. Five9', path: '/compare/five9-alternative' },
  { title: 'vs. Avaya', path: '/compare/avaya-alternative' },
  { title: 'vs. Google Voice', path: '/compare/google-voice-alternative' },
  { title: 'vs. respond.io', path: '/compare/respond-io-alternative' },
  { title: 'vs. Intercom', path: '/compare/intercom-alternative' },
  { title: 'vs. Kustomer', path: '/compare/kustomer-alternative' },
  { title: 'vs. 3CX', path: '/compare/3cx-alternative' },
  { title: 'vs. Dialpad', path: '/compare/dialpad-alternative' },
  { title: 'vs. 8x8', path: '/compare/8x8-alternative' },
  { title: 'vs. OpenPhone', path: '/compare/openphone-alternative' }
