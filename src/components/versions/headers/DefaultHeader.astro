    <div class="flex justify-between items-center h-16">
      <!-- Logo Section -->
      <div class="relative flex items-center">
        <a 
          href={`/${lang}`} 
          class="hover:opacity-80 transition-opacity flex items-center"
        >
          <img 
            src={logoSrc} 
            alt="Seasalt.ai" 
            class="h-6 sm:h-8 w-auto flex-shrink-0"
