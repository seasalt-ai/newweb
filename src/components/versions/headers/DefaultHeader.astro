            data-dropdown-menu="solutions"
          >
            <!-- Existing Solutions -->
{solutions.map((solution) => (
              <a 
                href={`/${lang}${solution.path}`}
                class="flex items-center gap-3 px-4 py-2 text-sm text-gray-700 hover:bg-gray-50"
              >
                <span class="h-5 w-5 flex items-center justify-center text-base" role="img" aria-label="solution-icon">{solutionEmoji[solution.icon] || '✨'}</span>
                {solution.title}
