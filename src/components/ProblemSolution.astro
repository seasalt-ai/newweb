---
import { getTranslationHelpers, extractLangFromPath, type SupportedLanguage } from '../i18n/helpers';

export interface Props {
  lang?: string;
}

const { lang = 'en' } = Astro.props;
const currentLang = extractLangFromPath(Astro.url.pathname) || lang as SupportedLanguage;
const { t } = await getTranslationHelpers(currentLang);

const problems = [
  {
    title: t('problemSolution.problems.fragmented.title'),
    description: t('problemSolution.problems.fragmented.description'),
    color: 'text-red-600',
    bgColor: 'bg-red-100',
    iconType: 'warning'
  },
  {
    title: t('problemSolution.problems.lostRevenue.title'),
    description: t('problemSolution.problems.lostRevenue.description'),
    color: 'text-orange-600',
    bgColor: 'bg-orange-100',
    iconType: 'clock'
  },
  {
    title: t('problemSolution.problems.operational.title'),
    description: t('problemSolution.problems.operational.description'),
    color: 'text-purple-600',
    bgColor: 'bg-purple-100',
    iconType: 'activity'
  }
];
---

<section class="py-20 bg-gray-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 overflow-hidden">
    <div class="text-center mb-16">
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-gray-900 mb-4">
        {t('problemSolution.title')}
      </h2>
      <p class="text-lg sm:text-xl text-gray-600 max-w-3xl mx-auto">
        {t('problemSolution.description')}
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6 sm:gap-8">
      {problems.map((problem, index) => (
        <div class="bg-white p-6 sm:p-8 rounded-2xl shadow-lg hover:shadow-xl transition-all duration-300 group text-center">
          <div class={`${problem.bgColor} ${problem.color} p-4 rounded-2xl w-fit mx-auto mb-6 group-hover:scale-110 transition-transform duration-300`}>
            <div class={`h-12 w-12 problem-icon`} data-type={problem.iconType}></div>
          </div>
          <h3 class="text-lg sm:text-xl font-semibold text-gray-900 mb-3 sm:mb-4">
            {problem.title}
          </h3>
          <p class="text-sm sm:text-base text-gray-600 leading-relaxed">
            {problem.description}
          </p>
        </div>
      ))}
    </div>

    <!-- Solution CTA -->
    <div class="text-center mt-16">
      <div class="bg-gradient-to-r from-blue-600 to-indigo-600 rounded-2xl p-6 sm:p-8 text-white">
        <h3 class="text-xl sm:text-2xl font-bold mb-4 sm:mb-6">
          {t('problemSolution.solution.title')}
        </h3>
        
        <!-- Unified Omni-Channel Hub Animation -->
        <div class="bg-white rounded-2xl shadow-2xl p-4 sm:p-6 relative z-10 mb-6">
          <div class="flex items-center justify-between mb-4">
            <h3 class="text-base sm:text-lg font-semibold text-gray-900">{t('problemSolution.solution.hubTitle')}</h3>
            <div class="flex space-x-1 sm:space-x-2">
              <div class="w-3 h-3 bg-red-400 rounded-full"></div>
              <div class="w-3 h-3 bg-yellow-400 rounded-full"></div>
              <div class="w-3 h-3 bg-green-400 rounded-full"></div>
            </div>
          </div>
          
          <!-- Tab Navigation -->
          <div class="flex space-x-1 mb-3 sm:mb-4 bg-gray-100 rounded-lg p-1">
            <button
              id="support-tab"
              class="support-tab flex-1 flex items-center justify-center px-2 sm:px-3 py-1 sm:py-2 rounded-md text-xs sm:text-sm font-medium transition-all duration-200 bg-white text-blue-600 shadow-sm"
            >
              <div class="h-3 w-3 sm:h-4 sm:w-4 mr-1 sm:mr-2 tab-icon" data-type="users"></div>
              {t('problemSolution.solution.tabs.support')}
            </button>
            <button
              id="marketing-tab"
              class="marketing-tab flex-1 flex items-center justify-center px-2 sm:px-3 py-1 sm:py-2 rounded-md text-xs sm:text-sm font-medium transition-all duration-200 text-gray-600 hover:text-gray-900"
            >
              <div class="h-3 w-3 sm:h-4 sm:w-4 mr-1 sm:mr-2 tab-icon" data-type="megaphone"></div>
              {t('problemSolution.solution.tabs.marketing')}
            </button>
          </div>

          <p class="text-xs sm:text-sm text-gray-500 mb-3 sm:mb-4">{t('problemSolution.solution.subtitle')}</p>
          
          <!-- Animated Tab Content -->
          <div id="tab-content" class="transition-all duration-300 opacity-100 scale-100 shadow-[0_0_24px_4px_rgba(37,99,235,0.15)] bg-cyan-200 rounded-xl">
            <!-- Support Tab Content -->
            <div id="support-content" class="space-y-2 sm:space-y-3">
              <div class="flex items-start p-2 sm:p-3 bg-blue-50 rounded-lg border-l-4 border-blue-500">
                <div class="h-3 w-3 sm:h-4 sm:w-4 md:h-5 md:w-5 text-blue-600 mr-2 sm:mr-3 flex-shrink-0 mt-0.5 support-icon" data-type="phone"></div>
                <div class="flex-1 min-w-0">
                  <p class="text-xs sm:text-sm font-medium text-gray-900 truncate">{t('problemSolution.mockData.supportTickets.sarah.name')}</p>
                  <p class="text-xs text-gray-600 truncate">{t('problemSolution.mockData.supportTickets.sarah.description')}</p>
                </div>
                <span class="text-xs text-gray-500 ml-2 flex-shrink-0 whitespace-nowrap">{t('problemSolution.mockData.supportTickets.sarah.timeAgo')}</span>
              </div>
              <div class="flex items-start p-2 sm:p-3 bg-green-50 rounded-lg border-l-4 border-green-500">
                <div class="h-3 w-3 sm:h-4 sm:w-4 md:h-5 md:w-5 text-green-600 mr-2 sm:mr-3 flex-shrink-0 mt-0.5 support-icon" data-type="message-circle"></div>
                <div class="flex-1 min-w-0">
                  <p class="text-xs sm:text-sm font-medium text-gray-900 truncate">{t('problemSolution.mockData.supportTickets.mike.name')}</p>
                  <p class="text-xs text-gray-600 truncate">{t('problemSolution.mockData.supportTickets.mike.description')}</p>
                </div>
                <span class="text-xs text-gray-500 ml-2 flex-shrink-0 whitespace-nowrap">{t('problemSolution.mockData.supportTickets.mike.timeAgo')}</span>
              </div>
              <div class="flex items-start p-2 sm:p-3 bg-purple-50 rounded-lg border-l-4 border-purple-500">
                <div class="h-3 w-3 sm:h-4 sm:w-4 md:h-5 md:w-5 text-purple-600 mr-2 sm:mr-3 flex-shrink-0 mt-0.5 support-icon" data-type="message-square"></div>
                <div class="flex-1 min-w-0">
                  <p class="text-xs sm:text-sm font-medium text-gray-900 truncate">{t('problemSolution.mockData.supportTickets.lisa.name')}</p>
                  <p class="text-xs text-gray-600 truncate">{t('problemSolution.mockData.supportTickets.lisa.description')}</p>
                </div>
                <span class="text-xs text-gray-500 ml-2 flex-shrink-0 whitespace-nowrap">{t('problemSolution.mockData.supportTickets.lisa.timeAgo')}</span>
              </div>
              <div class="flex items-start p-2 sm:p-3 bg-indigo-50 rounded-lg border-l-4 border-indigo-500">
                <div class="h-3 w-3 sm:h-4 sm:w-4 md:h-5 md:w-5 text-indigo-600 mr-2 sm:mr-3 flex-shrink-0 mt-0.5 support-icon" data-type="phone"></div>
                <div class="flex-1 min-w-0">
                  <p class="text-xs sm:text-sm font-medium text-gray-900 truncate">{t('problemSolution.mockData.supportTickets.david.name')}</p>
                  <p class="text-xs text-gray-600 truncate">{t('problemSolution.mockData.supportTickets.david.description')}</p>
                </div>
                <span class="text-xs text-gray-500 ml-2 flex-shrink-0 whitespace-nowrap">{t('problemSolution.mockData.supportTickets.david.timeAgo')}</span>
              </div>
            </div>

            <!-- Marketing Tab Content -->
            <div id="marketing-content" class="space-y-2 sm:space-y-3 hidden">
              <div class="flex items-start p-2 sm:p-3 bg-orange-50 rounded-lg border-l-4 border-orange-500">
                <div class="h-3 w-3 sm:h-4 sm:w-4 md:h-5 md:w-5 text-orange-600 mr-2 sm:mr-3 flex-shrink-0 mt-0.5 marketing-icon" data-type="megaphone"></div>
                <div class="flex-1 min-w-0">
                  <p class="text-xs sm:text-sm font-medium text-gray-900 truncate">{t('problemSolution.mockData.campaigns.blackFriday.name')}</p>
                  <p class="text-xs text-gray-600 truncate">{t('problemSolution.mockData.campaigns.blackFriday.description')}</p>
                </div>
                <span class="text-xs text-green-600 font-medium ml-2 flex-shrink-0 whitespace-nowrap">{t('problemSolution.mockData.campaigns.blackFriday.result')}</span>
              </div>
              <div class="flex items-start p-2 sm:p-3 bg-green-50 rounded-lg border-l-4 border-green-500">
                <div class="h-3 w-3 sm:h-4 sm:w-4 md:h-5 md:w-5 text-green-600 mr-2 sm:mr-3 flex-shrink-0 mt-0.5 marketing-icon" data-type="message-circle"></div>
                <div class="flex-1 min-w-0">
                  <p class="text-xs sm:text-sm font-medium text-gray-900 truncate">{t('problemSolution.mockData.campaigns.whatsappLaunch.name')}</p>
                  <p class="text-xs text-gray-600 truncate">{t('problemSolution.mockData.campaigns.whatsappLaunch.description')}</p>
                </div>
                <span class="text-xs text-green-600 font-medium ml-2 flex-shrink-0 whitespace-nowrap">{t('problemSolution.mockData.campaigns.whatsappLaunch.result')}</span>
              </div>
              <div class="flex items-start p-2 sm:p-3 bg-blue-50 rounded-lg border-l-4 border-blue-500">
                <div class="h-3 w-3 sm:h-4 sm:w-4 md:h-5 md:w-5 text-blue-600 mr-2 sm:mr-3 flex-shrink-0 mt-0.5 marketing-icon" data-type="chart"></div>
                <div class="flex-1 min-w-0">
                  <p class="text-xs sm:text-sm font-medium text-gray-900 truncate">{t('problemSolution.mockData.campaigns.cartRecovery.name')}</p>
                  <p class="text-xs text-gray-600 truncate">{t('problemSolution.mockData.campaigns.cartRecovery.description')}</p>
                </div>
                <span class="text-xs text-green-600 font-medium ml-2 flex-shrink-0 whitespace-nowrap">{t('problemSolution.mockData.campaigns.cartRecovery.result')}</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Bottom CTA -->
        <p class="text-lg sm:text-xl mb-6">
          {t('problemSolution.solution.description')}
        </p>
        <a
          href="https://seax.seasalt.ai/signup"
          class="bg-white text-blue-600 hover:bg-gray-100 px-8 py-4 rounded-lg text-lg font-semibold transition-all duration-200 inline-block"
        >
          {t('problemSolution.solution.cta')}
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  // Add SVG icons
  function createIcon(type: string): string {
    const icons = {
      warning: `<svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><path d="M12 9v4m0 4h.01"/></svg>`,
      clock: `<svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12,6 12,12 16,14"/></svg>`,
      activity: `<svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="none" stroke="currentColor" viewBox="0 0 24 24"><polyline points="22,12 18,12 15,21 9,3 6,12 2,12"/></svg>`,
      users: `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="m22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
      megaphone: `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 24 24"><path d="M3 9v6l4-2v5c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-5l11-4v-1l-11-4V3c0-.55-.45-1-1-1H8c-.55 0-1 .45-1 1v1l-4 2z"/></svg>`,
      phone: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>`,
      'message-circle': `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="m3 21 1.9-5.7a8.5 8.5 0 1 1 3.8 3.8z"/></svg>`,
      'message-square': `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>`,
      chart: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M3 3v18h18"/><path d="m19 9l-5 5-4-4-3 3"/></svg>`
    };
    return icons[type as keyof typeof icons] || icons.warning;
  }

  // Initialize icons
  document.querySelectorAll('.problem-icon, .tab-icon, .support-icon, .marketing-icon').forEach((icon) => {
    const type = icon.getAttribute('data-type');
    if (type) {
      icon.innerHTML = createIcon(type);
    }
  });

  // Tab switching functionality
  let activeTab = 'support';
  let tabInterval: number | null = null;

  const supportTab = document.getElementById('support-tab');
  const marketingTab = document.getElementById('marketing-tab');
  const supportContent = document.getElementById('support-content');
  const marketingContent = document.getElementById('marketing-content');
  const tabContent = document.getElementById('tab-content');

  function switchTab(tab: string, isUserAction = false) {
    activeTab = tab;

    if (isUserAction && tabInterval) {
      clearInterval(tabInterval);
      tabInterval = null;
    }

    // Update tab styles
    if (tab === 'support') {
      supportTab?.classList.add('bg-white', 'text-blue-600', 'shadow-sm');
      supportTab?.classList.remove('text-gray-600', 'hover:text-gray-900');
      marketingTab?.classList.add('text-gray-600', 'hover:text-gray-900');
      marketingTab?.classList.remove('bg-white', 'text-orange-600', 'shadow-sm');
    } else {
      marketingTab?.classList.add('bg-white', 'text-orange-600', 'shadow-sm');
      marketingTab?.classList.remove('text-gray-600', 'hover:text-gray-900');
      supportTab?.classList.add('text-gray-600', 'hover:text-gray-900');
      supportTab?.classList.remove('bg-white', 'text-blue-600', 'shadow-sm');
    }

    // Update content visibility and tab container styling
    tabContent?.classList.remove('opacity-100', 'scale-100');
    tabContent?.classList.add('opacity-0', 'scale-95');

    setTimeout(() => {
      if (tab === 'support') {
        supportContent?.classList.remove('hidden');
        marketingContent?.classList.add('hidden');
        tabContent?.classList.remove('shadow-[0_0_24px_4px_rgba(251,146,60,0.15)]', 'bg-orange-50');
        tabContent?.classList.add('shadow-[0_0_24px_4px_rgba(37,99,235,0.15)]', 'bg-cyan-200');
      } else {
        marketingContent?.classList.remove('hidden');
        supportContent?.classList.add('hidden');
        tabContent?.classList.remove('shadow-[0_0_24px_4px_rgba(37,99,235,0.15)]', 'bg-cyan-200');
        tabContent?.classList.add('shadow-[0_0_24px_4px_rgba(251,146,60,0.15)]', 'bg-orange-50');
      }

      tabContent?.classList.remove('opacity-0', 'scale-95');
      tabContent?.classList.add('opacity-100', 'scale-100');
    }, 150);

    if (!isUserAction && !tabInterval) {
      startTabAnimation();
    }
  }

  function startTabAnimation() {
    tabInterval = setInterval(() => {
      switchTab(activeTab === 'support' ? 'marketing' : 'support');
    }, 3000);
  }

  // Event listeners
  supportTab?.addEventListener('click', () => switchTab('support', true));
  marketingTab?.addEventListener('click', () => switchTab('marketing', true));

  // Start automatic tab switching
  startTabAnimation();
</script>
