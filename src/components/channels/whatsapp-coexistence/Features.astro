---
import { ArrowRight, Smartphone, Users, Zap, Clock, Inbox } from 'lucide-react';
import { getTranslationHelpers } from '../../../i18n/helpers';

export interface Props {
  lang: string;
}

const { lang } = Astro.props;
const { t } = await getTranslationHelpers(lang);
---

<!-- Features Section -->
<section id="features" class="py-20 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900">
        {t('whatsappCoexistence.features.title')}
      </h2>
      <p class="text-gray-600 mt-4 max-w-3xl mx-auto">
        {t('whatsappCoexistence.features.subtitle')}
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-8">
      <!-- Feature 1: 3-Way Synchronization -->
      <div class="bg-gray-50 rounded-xl p-8 border border-gray-200 hover:shadow-lg transition-all">
        <div class="w-12 h-12 bg-green-600 rounded-lg flex items-center justify-center text-white mb-6">
          <span class="animate-bounce inline-block">
            <ArrowRight class="w-6 h-6" />
          </span>
        </div>
        <h3 class="text-xl font-bold mb-3">
          {t('whatsappCoexistence.features.items.sync.title')}
        </h3>
        <p class="text-gray-600 leading-relaxed">
          {t('whatsappCoexistence.features.items.sync.description')}
        </p>
      </div>

      <!-- Feature 2: Unlimited Agents -->
      <div class="bg-gray-50 rounded-xl p-8 border border-gray-200 hover:shadow-lg transition-all">
        <div class="w-12 h-12 bg-green-600 rounded-lg flex items-center justify-center text-white mb-6">
          <Users class="w-6 h-6" />
        </div>
        <h3 class="text-xl font-bold mb-3">
          {t('whatsappCoexistence.features.items.agents.title')}
        </h3>
        <p class="text-gray-600 leading-relaxed">
          {t('whatsappCoexistence.features.items.agents.description')}
        </p>
      </div>

      <!-- Feature 3: AI Agent Handoff -->
      <div class="bg-gray-50 rounded-xl p-8 border border-gray-200 hover:shadow-lg transition-all">
        <div class="w-12 h-12 bg-green-600 rounded-lg flex items-center justify-center text-white mb-6">
          <Zap class="w-6 h-6" />
        </div>
        <h3 class="text-xl font-bold mb-3">
          {t('whatsappCoexistence.features.items.aiHandoff.title')}
        </h3>
        <p class="text-gray-600 leading-relaxed">
          {t('whatsappCoexistence.features.items.aiHandoff.description')}
        </p>
      </div>

      <!-- Feature 4: 6-Month History Import -->
      <div class="bg-gray-50 rounded-xl p-8 border border-gray-200 hover:shadow-lg transition-all">
        <div class="w-12 h-12 bg-green-600 rounded-lg flex items-center justify-center text-white mb-6">
          <Clock class="w-6 h-6" />
        </div>
        <h3 class="text-xl font-bold mb-3">
          {t('whatsappCoexistence.features.items.history.title')}
        </h3>
        <p class="text-gray-600 leading-relaxed">
          {t('whatsappCoexistence.features.items.history.description')}
        </p>
      </div>

      <!-- Feature 5: Seasalt Mobile App -->
      <div class="bg-gray-50 rounded-xl p-8 border border-gray-200 hover:shadow-lg transition-all">
        <div class="w-12 h-12 bg-green-600 rounded-lg flex items-center justify-center text-white mb-6">
          <Smartphone class="w-6 h-6" />
        </div>
        <h3 class="text-xl font-bold mb-3">
          {t('whatsappCoexistence.features.items.mobileApp.title')}
        </h3>
        <p class="text-gray-600 leading-relaxed">
          {t('whatsappCoexistence.features.items.mobileApp.description')}
        </p>
      </div>

      <!-- Feature 6: Unified Inbox -->
      <div class="bg-gray-50 rounded-xl p-8 border border-gray-200 hover:shadow-lg transition-all">
        <div class="w-12 h-12 bg-green-600 rounded-lg flex items-center justify-center text-white mb-6">
          <Inbox class="w-6 h-6" />
        </div>
        <h3 class="text-xl font-bold mb-3">
          {t('whatsappCoexistence.features.items.unifiedInbox.title')}
        </h3>
        <p class="text-gray-600 leading-relaxed">
          {t('whatsappCoexistence.features.items.unifiedInbox.description')}
        </p>
      </div>
    </div>

    <!-- Bottom CTA -->
    <div class="text-center mt-16">
      <a
        href="https://seax.seasalt.ai/signup"
        class="inline-flex items-center justify-center px-8 py-4 bg-green-600 hover:bg-green-700 text-white font-bold rounded-lg text-lg transition-all transform hover:scale-105 shadow-xl hover:shadow-2xl"
      >
        {t('whatsappCoexistence.features.cta')}
        <ArrowRight class="ml-2 w-5 h-5" />
      </a>
    </div>
  </div>
</section>

<style>
  @keyframes bounce {
    0%, 100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-10px);
    }
  }

  .animate-bounce {
    animation: bounce 2s ease-in-out infinite;
  }
</style>
