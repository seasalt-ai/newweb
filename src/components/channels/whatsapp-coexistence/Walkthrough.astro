---
export interface Props {
  lang: string;
}

const { lang } = Astro.props;
---

<!-- Walkthrough Section -->
<section id="walkthrough" class="py-20 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2 class="text-base font-bold text-green-600 tracking-wide uppercase">
        The Setup Walkthrough
      </h2>
      <h3 class="text-3xl font-bold text-gray-900 mt-4">
        Get Started in Minutes
      </h3>
      <p class="text-gray-500 mt-2">
        No coding required. Just scan and sync.
      </p>
    </div>

    <div class="relative">
      <!-- Vertical Line -->
      <div class="hidden md:block absolute left-1/2 transform -translate-x-1/2 h-full w-1 bg-gray-100"></div>

      <!-- Step 1 -->
      <div class="flex flex-col md:flex-row items-center justify-between mb-16 relative">
        <div class="md:w-5/12 text-right md:text-right order-1 md:order-1 pr-0 md:pr-12">
          <h4 class="text-2xl font-bold text-gray-900 mb-2">1. Add New Channel</h4>
          <p class="text-gray-600">Navigate to <strong>Seasalt.ai Workspace</strong>. Select "Channels" and choose new "WhatsApp Coexistence" option.</p>
        </div>
        <div class="absolute left-1/2 transform -translate-x-1/2 w-10 h-10 bg-green-500 rounded-full flex items-center justify-center text-white font-bold z-10 border-4 border-white order-2">1</div>
        <div class="md:w-5/12 pl-0 md:pl-12 order-3 md:order-3 mt-6 md:mt-0">
          <div class="bg-green-50 rounded-xl p-4 border-2 border-green-200 shadow-sm">
            <div class="flex items-center gap-3">
              <svg class="w-10 h-10 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <rect x="6" y="3" width="12" height="18" rx="2" stroke-width="2"/>
                <line x1="10" y1="18" x2="14" y2="18" stroke-width="2"/>
              </svg>
              <div>
                <div class="font-bold text-sm text-gray-800">WhatsApp Coexistence</div>
                <div class="text-xs text-green-600">Best Offering</div>
              </div>
              <button class="ml-auto bg-green-600 hover:bg-green-700 text-white text-xs px-4 py-2 rounded transition-colors font-semibold">
                Connect
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- Step 2 -->
      <div class="flex flex-col md:flex-row items-center justify-between mb-16 relative">
        <div class="md:w-5/12 text-right md:text-left order-1 md:order-3 pl-0 md:pl-12">
          <h4 class="text-2xl font-bold text-gray-900 mb-2">2. Link Meta Account</h4>
          <p class="text-gray-600">
            Log in with your Facebook account. Select your business portfolio. Crucially, choose option <strong>"Connect a WhatsApp Business App"</strong>.
          </p>
        </div>
        <div class="absolute left-1/2 transform -translate-x-1/2 w-10 h-10 bg-green-500 rounded-full flex items-center justify-center text-white font-bold z-10 border-4 border-white order-2">2</div>
        <div class="md:w-5/12 pr-0 md:pr-12 order-1 md:order-1 mt-6 md:mt-0">
          <div class="bg-white rounded-xl shadow-lg border border-gray-200 p-6">
            <div class="space-y-4">
              <div class="h-2 w-1/3 bg-green-200 rounded"></div>
              <div class="bg-green-50 border-2 border-green-300 rounded-lg p-4">
                <div class="text-center mb-2">
                  <p class="text-sm font-medium text-green-800">
                    Connect a WhatsApp Business App
                  </p>
                </div>
              </div>
              <div class="text-center text-xs text-gray-500">Create new WABA Account</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Step 3 -->
      <div class="flex flex-col md:flex-row items-center justify-between relative">
        <div class="md:w-5/12 text-right md:text-right order-1 md:order-1 pr-0 md:pr-12">
          <h4 class="text-2xl font-bold text-gray-900 mb-2">3. Scan & Sync</h4>
          <p class="text-gray-600">
            A QR code will appear. Open <strong>Linked Devices</strong> on your phone and scan it. We instantly begin syncing up to <span class="text-green-600 font-bold">6 months</span> of chat history.
          </p>
        </div>
        <div class="absolute left-1/2 transform -translate-x-1/2 w-10 h-10 bg-green-500 rounded-full flex items-center justify-center text-white font-bold z-10 border-4 border-white order-2">3</div>
        <div class="md:w-5/12 pl-0 md:pl-12 order-3 md:order-3 mt-6 md:mt-0">
          <!-- QR Code Card -->
          <div class="bg-gradient-to-br from-gray-800 to-gray-900 rounded-2xl p-6 shadow-2xl">
            <!-- QR Code Container -->
            <div class="bg-white rounded-xl p-4 mb-4">
              <!-- QR Code Pattern -->
              <div class="relative w-32 h-32 mx-auto">
                <!-- Corner markers -->
                <div class="absolute top-0 left-0 w-8 h-8 border-l-4 border-t-4 border-gray-800"></div>
                <div class="absolute top-0 right-0 w-8 h-8 border-r-4 border-t-4 border-gray-800"></div>
                <div class="absolute bottom-0 left-0 w-8 h-8 border-l-4 border-b-4 border-gray-800"></div>
                <div class="absolute bottom-0 right-0 w-8 h-8 border-r-4 border-b-4 border-gray-800"></div>
                
                <!-- QR Pattern Grid -->
                <div class="absolute inset-2 grid grid-cols-7 grid-rows-7 gap-0.5">
                  <!-- Row 1 -->
                  <div class="col-span-2 row-span-2 bg-gray-800 rounded-sm"></div>
                  <div class="bg-gray-800"></div>
                  <div class="bg-gray-800"></div>
                  <div class="bg-gray-800"></div>
                  <div class="col-span-2 row-span-2 bg-gray-800 rounded-sm"></div>
                  
                  <!-- Row 2 (continuation of corner markers) -->
                  <div class="bg-gray-800"></div>
                  <div class="bg-white"></div>
                  <div class="bg-gray-800"></div>
                  <div class="bg-gray-800"></div>
                  <div class="bg-white"></div>
                  <div class="bg-gray-800"></div>
                  
                  <!-- Row 3 -->
                  <div class="bg-gray-800"></div>
                  <div class="bg-gray-800"></div>
                  <div class="bg-gray-800"></div>
                  <div class="bg-white"></div>
                  <div class="bg-gray-800"></div>
                  <div class="bg-gray-800"></div>
                  <div class="bg-gray-800"></div>
                  
                  <!-- Row 4 -->
                  <div class="bg-gray-800"></div>
                  <div class="bg-white"></div>
                  <div class="bg-gray-800"></div>
                  <div class="bg-gray-800"></div>
                  <div class="bg-white"></div>
                  <div class="bg-gray-800"></div>
                  <div class="bg-gray-800"></div>
                  
                  <!-- Row 5 -->
                  <div class="bg-gray-800"></div>
                  <div class="bg-gray-800"></div>
                  <div class="bg-white"></div>
                  <div class="bg-gray-800"></div>
                  <div class="bg-gray-800"></div>
                  <div class="bg-white"></div>
                  <div class="bg-gray-800"></div>
                  
                  <!-- Row 6 -->
                  <div class="bg-gray-800"></div>
                  <div class="col-span-2 row-span-2 bg-gray-800 rounded-sm"></div>
                  <div class="bg-white"></div>
                  <div class="bg-gray-800"></div>
                  <div class="bg-white"></div>
                  <div class="bg-gray-800"></div>
                  <div class="col-span-2 row-span-2 bg-gray-800 rounded-sm"></div>
                  
                  <!-- Row 7 -->
                  <div class="bg-gray-800"></div>
                  <div class="bg-gray-800"></div>
                  <div class="bg-white"></div>
                  <div class="bg-gray-800"></div>
                  <div class="bg-gray-800"></div>
                </div>
                
                <!-- WhatsApp Icon in center -->
                <div class="absolute inset-0 flex items-center justify-center">
                  <div class="bg-white p-1.5 rounded-lg shadow-md">
                    <div class="w-6 h-6 bg-green-500 rounded-full flex items-center justify-center">
                      <svg viewBox="0 0 24 24" class="w-4 h-4 text-white" fill="currentColor">
                        <path d="M12 2C6.48 2 2 6.48 2 12c0 1.82.38 3.55 1.07 5.1L2 22l5.07-1.07A9.94 9.94 0 0012 22c5.52 0 10-4.48 10-10S17.52 2 12 2zm0 18c-1.66 0-3.23-.52-4.57-1.44l-.33-.21-3.01.63.64-2.94-.21-.32A7.93 7.93 0 014 12c0-4.41 3.59-8 8-8s8 3.59 8 8-3.59 8-8 8zm4.54-6.14c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.12-.16.25-.64.81-.79.96-.14.16-.29.18-.54.06-.25-.12-1.05-.39-2-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.12-.14.16-.25.25-.41.08-.16.04-.31-.02-.43-.06-.12-.56-1.35-.77-1.84-.2-.47-.4-.41-.56-.42-.14 0-.31-.02-.48-.02-.16 0-.43.06-.66.31-.22.25-.86.84-.86 2.05 0 1.21.88 2.38 1 2.54.12.16 1.73 2.65 4.19 3.71.59.25 1.05.4 1.4.52.59.19 1.13.16 1.55.1.47-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.14-1.18-.07-.1-.22-.16-.47-.28z"/>
                      </svg>
                    </div>
                  </div>
                </div>
              </div>
              
              <!-- Scan instruction -->
              <p class="text-center text-gray-500 text-sm mt-3 flex items-center justify-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7V5a2 2 0 012-2h2m0 18H5a2 2 0 01-2-2v-2m18 0v2a2 2 0 01-2 2h-2m0-18h2a2 2 0 012 2v2"/>
                </svg>
                Scan with your phone
              </p>
            </div>
            
            <!-- Progress Bar -->
            <div class="space-y-2">
              <div class="flex justify-between text-xs text-gray-400">
                <span class="flex items-center gap-1">
                  <svg class="w-3 h-3 animate-spin" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke-width="4"/>
                    <path class="opacity-75" stroke-linecap="round" stroke-linejoin="round" stroke-width="4" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"/>
                  </svg>
                  Syncing history...
                </span>
                <span>75%</span>
              </div>
              <div class="w-full bg-gray-700 rounded-full h-2">
                <div class="bg-green-500 h-2 rounded-full transition-all duration-1000" style="width: 75%"></div>
              </div>
              <p class="text-center text-green-400 text-xs mt-2 font-medium">
                180 days of chat history
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
