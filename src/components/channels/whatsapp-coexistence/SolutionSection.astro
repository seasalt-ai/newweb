---
import { getTranslationHelpers } from '../../../i18n/helpers';

export interface Props {
  lang: string;
}

const { lang } = Astro.props;
const { t } = await getTranslationHelpers(lang);
---

<section id="solution" class="py-20 bg-white relative overflow-hidden">
  <!-- Subtle background pattern -->
  <div class="absolute inset-0 opacity-[0.03]" style="background-image: radial-gradient(circle at 2px 2px, #10b981 1px, transparent 0); background-size: 40px 40px;"></div>
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="max-w-5xl mx-auto">
      <!-- Header -->
      <div class="text-center mb-12">
        <h2 class="text-4xl md:text-5xl font-extrabold text-gray-900 mb-4">
          {t('whatsappCoexistence.solution.title')} <span class="text-transparent bg-clip-text bg-gradient-to-r from-green-500 to-emerald-500">{t('whatsappCoexistence.solution.worryNoMore')}</span>
        </h2>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
          {t('whatsappCoexistence.solution.subtitle1')} <strong class="text-gray-900">{t('whatsappCoexistence.solution.metaCoexistence')}</strong> {t('whatsappCoexistence.solution.subtitle2')}
        </p>
      </div>

      <!-- WhatsApp Coexistence Visual -->
      <div class="bg-white rounded-3xl shadow-2xl hover:shadow-3xl transition-shadow duration-500 ring-1 ring-green-100 border border-gray-100 p-8 md:p-12 mb-12">
        <!-- Section Header -->
        <div class="text-center mb-10">
          <div class="inline-flex items-center gap-2 bg-gradient-to-r from-green-500 to-emerald-500 text-white px-6 py-3 rounded-full shadow-lg mb-4">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/>
            </svg>
            <span class="text-xl font-bold">{t('whatsappCoexistence.solution.coexistenceTitle')}</span>
          </div>
          <p class="text-gray-600">{t('whatsappCoexistence.solution.tagline')}</p>
        </div>
        
        <div class="flex flex-col md:flex-row items-center justify-center gap-6 md:gap-8">
          <!-- WhatsApp Business App -->
          <div class="flex flex-col items-center text-center">
            <div class="w-24 h-24 md:w-32 md:h-32 rounded-2xl overflow-hidden shadow-lg mb-4 border-4 border-green-100">
              <img src="/logos/WhatsApp-Business-App.jpg" alt="WhatsApp Business App" class="w-full h-full object-cover"/>
            </div>
            <h3 class="font-bold text-gray-900 text-lg">{t('whatsappCoexistence.solution.businessApp.title')}</h3>
            <p class="text-sm text-gray-500">{t('whatsappCoexistence.solution.businessApp.subtitle')}</p>
          </div>

          <!-- Plus Sign -->
          <div class="flex flex-col items-center">
            <div class="w-12 h-12 md:w-16 md:h-16 rounded-full bg-gradient-to-br from-yellow-300 to-yellow-500 flex items-center justify-center shadow-lg">
              <svg class="w-6 h-6 md:w-8 md:h-8 text-green-900" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M12 4v16m8-8H4"/>
              </svg>
            </div>
          </div>

          <!-- WhatsApp Cloud API -->
          <div class="flex flex-col items-center text-center">
            <div class="w-24 h-24 md:w-32 md:h-32 rounded-2xl overflow-hidden shadow-lg mb-4 border-4 border-blue-100">
              <img src="/logos/WhatsApp-Business-Platform.jpg" alt="WhatsApp Cloud API" class="w-full h-full object-cover"/>
            </div>
            <h3 class="font-bold text-gray-900 text-lg">{t('whatsappCoexistence.solution.cloudAPI.title')}</h3>
            <p class="text-sm text-gray-500">{t('whatsappCoexistence.solution.cloudAPI.subtitle')}</p>
          </div>

          <!-- Equals Sign -->
          <div class="hidden md:flex flex-col items-center">
            <div class="text-4xl font-bold text-gray-400">=</div>
          </div>

          <!-- Coexistence Result -->
          <div class="flex flex-col items-center text-center md:ml-4">
            <div class="relative">
              <div class="w-32 h-32 md:w-40 md:h-40 rounded-2xl bg-gradient-to-br from-green-400 to-emerald-500 shadow-xl p-3 flex items-center justify-center">
                <!-- Coexistence Visual: Both Logos in Diagonal -->
                <div class="relative w-full h-full">
                  <!-- Cloud API Logo - Top Right Position -->
                  <div class="absolute top-1 right-1 w-12 h-12 md:w-14 md:h-14 rounded-xl overflow-hidden shadow-lg border-2 border-white z-10">
                    <img src="/logos/WhatsApp-Business-Platform.jpg" alt="Cloud API" class="w-full h-full object-cover"/>
                  </div>
                  
                  <!-- Diagonal Connection Line -->
                  <svg class="absolute inset-0 w-full h-full" viewBox="0 0 100 100" preserveAspectRatio="none">
                    <line x1="75" y1="25" x2="25" y2="75" stroke="white" stroke-width="2" stroke-dasharray="4 2" opacity="0.6"/>
                  </svg>
                  
                  <!-- Business App Logo - Bottom Left Position -->
                  <div class="absolute bottom-1 left-1 w-12 h-12 md:w-14 md:h-14 rounded-xl overflow-hidden shadow-lg border-2 border-white z-10">
                    <img src="/logos/WhatsApp-Business-App.jpg" alt="Business App" class="w-full h-full object-cover"/>
                  </div>
                  
                  <!-- Sync indicator in Center -->
                  <div class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-7 h-7 bg-yellow-400 rounded-full flex items-center justify-center shadow-md z-20">
                    <svg class="w-4 h-4 text-green-900" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
                    </svg>
                  </div>
                </div>
              </div>
              <div class="absolute -top-2 -right-2 bg-yellow-400 text-green-900 text-xs font-bold px-2 py-1 rounded-full shadow-md">
                {t('whatsappCoexistence.solution.bestBadge')}
              </div>
            </div>
            <h3 class="font-bold text-gray-900 text-lg mt-4">{t('whatsappCoexistence.solution.result.title')}</h3>
            <p class="text-sm text-gray-500">{t('whatsappCoexistence.solution.result.subtitle')}</p>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
