---
import { MessageSquare, Smartphone, Zap, ArrowRight } from 'lucide-react';

export interface Props {
  lang: string;
}

const { lang } = Astro.props;
const uniqueId = `hero-${crypto.randomUUID()}`;

---

<section id={uniqueId} class="relative overflow-hidden bg-gradient-to-br from-green-500 via-green-600 to-blue-600 text-white">
  <!-- Background Pattern -->
  <div class="absolute inset-0 opacity-10">
    <div class="absolute inset-0" style="background-image: radial-gradient(circle at 2px 2px, white 1px, transparent 0); background-size: 32px 32px;"></div>
  </div>

  <!-- Animated Floating Elements -->
  <div class="absolute top-20 left-10 animate-pulse">
    <MessageSquare class="w-16 h-16 text-green-200 opacity-50" />
  </div>
  <div class="absolute top-40 right-20 animate-bounce" style="animation-duration: 3s;">
    <Smartphone class="w-12 h-12 text-green-200 opacity-50" />
  </div>
  <div class="absolute bottom-20 left-1/4 animate-pulse" style="animation-delay: 1s;">
    <Zap class="w-14 h-14 text-green-200 opacity-50" />
  </div>

  <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="max-w-6xl mx-auto pt-20 pb-24">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <!-- Left Content -->
          <div class="space-y-8">
            <div class="inline-flex items-center px-4 py-2 bg-white/20 rounded-full text-sm font-medium backdrop-blur-sm">
              <Zap class="w-4 h-4 mr-2" />
              <span>New for 2026</span>
            </div>

            <h1 class="text-5xl lg:text-6xl font-bold leading-tight">
              Keep Your WhatsApp Business App <span class="block text-yellow-300">AND Scale with WhatsApp Cloud API</span>
            </h1>

            <p class="text-xl lg:text-2xl text-green-100 leading-relaxed max-w-xl">
              The end of the impossible choice. Use both simultaneously. No more trading personal touch for enterprise power.
            </p>

            <!-- Key Benefits -->
              <div class="grid sm:grid-cols-2 gap-4">
                <div class="flex items-start space-x-3">
                  <div class="w-8 h-8 bg-yellow-400 rounded-full flex items-center justify-center flex-shrink-0">
                    <span class="text-green-900 font-bold">✓</span>
                  </div>
                  <div>
                    <h3 class="font-semibold text-lg">Same Number</h3>
                    <p class="text-green-100 text-sm">Keep your trusted business number</p>
                  </div>
                </div>

                <div class="flex items-start space-x-3">
                  <div class="w-8 h-8 bg-yellow-400 rounded-full flex items-center justify-center flex-shrink-0">
                    <span class="text-green-900 font-bold">✓</span>
                  </div>
                  <div>
                    <h3 class="font-semibold text-lg">No Data Loss</h3>
                    <p class="text-green-100 text-sm">Sync 180 days of chat history</p>
                  </div>
                </div>

                <div class="flex items-start space-x-3">
                  <div class="w-8 h-8 bg-yellow-400 rounded-full flex items-center justify-center flex-shrink-0">
                    <span class="text-green-900 font-bold">✓</span>
                  </div>
                  <div>
                    <h3 class="font-semibold text-lg">Hybrid AI + Human</h3>
                    <p class="text-green-100 text-sm">Scale automation, stay personal</p>
                  </div>
                </div>

                <div class="flex items-start space-x-3">
                  <div class="w-8 h-8 bg-yellow-400 rounded-full flex items-center justify-center flex-shrink-0">
                    <span class="text-green-900 font-bold">✓</span>
                  </div>
                  <div>
                    <h3 class="font-semibold text-lg">Zero Disruption</h3>
                    <p class="text-green-100 text-sm">Seamless QR-code migration</p>
                  </div>
                </div>
              </div>

            <!-- CTAs -->
              <div class="flex flex-col sm:flex-row gap-4">
                <a
                  href={`https://seasalt.ai/${lang}/signup`}
                  class="inline-flex items-center justify-center px-8 py-4 bg-yellow-400 hover:bg-yellow-300 text-green-900 font-bold rounded-lg text-lg transition-all transform hover:scale-105 shadow-lg hover:shadow-xl"
                >
                  Get Started Free
                  <ArrowRight class="ml-2 w-5 h-5" />
                </a>
                <a
                  href={`https://wiki.seasalt.ai/${lang}/seax/seax-omni/whatsapp-coexistence/`}
                  class="inline-flex items-center justify-center px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-semibold rounded-lg text-lg transition-all border-2 border-white/30 hover:border-white/50 backdrop-blur-sm"
                >
                  Learn How It Works
                </a>
              </div>
          </div>

        <!-- Right Content - Tri-Sync Visualization -->
          <div class="relative">
            <!-- Main Visualization -->
              <div class="bg-white/10 backdrop-blur-md rounded-3xl p-8 border border-white/20 shadow-2xl">
                <div class="text-center mb-6">
                  <h3 class="text-2xl font-bold mb-2">The Tri-Sync System</h3>
                  <p class="text-green-100">Real-time synchronization across three touchpoints</p>
                </div>

                <!-- Three Device Icons with Connection Lines -->
                  <div class="mb-6">
                    <div class="grid grid-cols-3 gap-4 mb-4">
                      <!-- Phone -->
                      <div class="text-center">
                        <div class="w-16 h-16 mx-auto mb-2 bg-white rounded-2xl flex items-center justify-center relative overflow-hidden shadow-lg">
                          <img src="/logos/WhatsApp-Business-App.jpg" alt="WhatsApp Business App" class="w-full h-full object-cover"/>
                          <div class="absolute -inset-1 rounded-2xl border-2 border-yellow-300/50 animate-pulse"></div>
                        </div>
                        <p class="font-semibold text-sm">Your Phone</p>
                        <p class="text-xs text-green-100">WhatsApp Business App</p>
                      </div>

                      <!-- dashboard (center - hub) -->
                      <div class="text-center">
                        <div class="w-16 h-16 mx-auto mb-2 bg-white rounded-2xl flex items-center justify-center relative overflow-hidden shadow-lg border-2 border-yellow-300">
                          <img src="/seasalt-ai-icon.png" alt="whatsapp cloud api" class="w-full h-full object-cover"/>
                          <div class="absolute -inset-2 rounded-3xl bg-yellow-300/10 animate-ping"></div>
                        </div>
                        <p class="font-semibold text-sm">seasalt.ai dashboard</p>
                        <p class="text-xs text-green-100">central hub</p>
                      </div>

                      <!-- field app -->
                      <div class="text-center">
                        <div class="w-16 h-16 mx-auto mb-2 bg-white rounded-2xl flex items-center justify-center relative overflow-hidden shadow-lg">
                          <img src="/seax-icon.png" alt="seasalt.ai" class="w-full h-full object-cover"/>
                          <div class="absolute -inset-1 rounded-2xl border-2 border-yellow-300/50 animate-pulse" style="animation-delay: 0.5s;"></div>
                        </div>
                        <p class="font-semibold text-sm">field teams</p>
                        <p class="text-xs text-green-100">mobile app</p>
                      </div>
                    </div>

                    <!-- connection visualization - below icons -->
                    <div class="relative h-12 flex items-center justify-center">
                      <svg class="w-full max-w-[200px] h-full" viewBox="0 0 200 40">
                        <!-- left connection (phone to hub) -->
                        <line x1="20" y1="20" x2="80" y2="20" stroke="#fde047" stroke-width="2" opacity="0.6">
                          <animate attributeName="stroke-dasharray" values="4 4;8 8;4 4" dur="2s" repeatCount="indefinite" />
                        </line>
                        
                        <!-- right connection (hub to field) -->
                        <line x1="120" y1="20" x2="180" y2="20" stroke="#fde047" stroke-width="2" opacity="0.6">
                          <animate attributeName="stroke-dasharray" values="4 4;8 8;4 4" dur="2s" begin="0.5s" repeatCount="indefinite" />
                        </line>
                        
                        <!-- animated dots -->
                        <circle cx="50" cy="20" r="3" fill="#fde047">
                          <animate attributeName="opacity" values="0.2;1;0.2" dur="1.5s" repeatCount="indefinite" />
                        </circle>
                        <circle cx="150" cy="20" r="3" fill="#fde047">
                          <animate attributeName="opacity" values="0.2;1;0.2" dur="1.5s" begin="0.5s" repeatCount="indefinite" />
                        </circle>
                        
                        <!-- center hub glow -->
                        <circle cx="100" cy="20" r="6" fill="#fde047" opacity="0.8">
                          <animate attributeName="r" values="4;7;4" dur="2s" repeatCount="indefinite" />
                          <animate attributeName="opacity" values="0.8;0.4;0.8" dur="2s" repeatCount="indefinite" />
                        </circle>
                      </svg>
                      
                      <!-- sync label -->
                      <div class="absolute -bottom-1 left-1/2 transform -translate-x-1/2 whitespace-nowrap">
                        <span class="text-xs text-yellow-300 font-medium bg-green-700/50 px-2 py-0.5 rounded-full">real-time sync</span>
                      </div>
                    </div>
                  </div>

                  <!-- sync stats -->
                  <div class="flex items-center justify-center gap-4 text-xs">
                    <div class="flex items-center gap-1.5">
                      <span class="w-1.5 h-1.5 bg-green-400 rounded-full animate-pulse"></span>
                      <span class="text-green-100">live</span>
                    </div>
                    <div class="flex items-center gap-1.5">
                      <svg class="w-3 h-3 text-yellow-300" fill="none" stroke="currentcolor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                      </svg>
                      <span class="text-green-100">&lt;100ms</span>
                    </div>
                    <div class="flex items-center gap-1.5">
                      <svg class="w-3 h-3 text-yellow-300" fill="none" stroke="currentcolor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m4 4v5h.582m15.356 2a8.001 8.001 0 004.582 9m0 0h9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2h15"/>
                      </svg>
                      <span class="text-green-100">real-time</span>
                    </div>
                  </div>

                <!-- stats -->
                  <div class="grid grid-cols-3 gap-4 mt-6 pt-6 border-t border-white/20">
                    <div class="text-center">
                      <p class="text-3xl font-bold text-yellow-300">Unlimited</p>
                      <p class="text-sm text-green-100">synced devices</p>
                    </div>
                    <div class="text-center">
                      <p class="text-3xl font-bold text-yellow-300">Unlimited</p>
                      <p class="text-sm text-green-100">human users</p>
                    </div>
                    <div class="text-center">
                      <p class="text-3xl font-bold text-yellow-300">180 Days</p>
                      <p class="text-sm text-green-100">Chat History Sync</p>
                    </div>
                  </div>
              </div>
          </div>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes ping {
    75%, 100% {
      transform: scale(2);
      opacity: 0;
    }
  }

  .animate-ping {
    animation: ping 1s cubic-bezier(0, 0, 0.2, 1) infinite;
  }
</style>
