---
import { Check, X, ChevronRight } from 'lucide-react';
import { getTranslationHelpers } from '../../../i18n/helpers';

export interface Props {
  lang: string;
}

const { lang } = Astro.props;
const { t } = await getTranslationHelpers(lang);
const uniqueId = `comparison-${crypto.randomUUID()}`;
---

<section id={uniqueId} class="py-20 bg-white">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto">
      <!-- Section Header -->
      <div class="text-center mb-16">
        <h2 class="text-4xl font-bold text-gray-900 mb-4">
          {t('whatsappCoexistence.comparison.title')}
        </h2>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
          {t('whatsappCoexistence.comparison.subtitle')}
        </p>
      </div>

      <!-- Feature Comparison Table -->
      <div class="overflow-x-auto rounded-2xl border-2 border-gray-200 shadow-xl">
        <table class="w-full min-w-[800px]">
          <thead>
            <tr class="bg-gradient-to-r from-green-500 to-green-600 text-white">
              <th class="px-6 py-4 text-left font-semibold">
                {t('whatsappCoexistence.comparison.table.feature')}
              </th>
              <th class="px-6 py-4 text-center font-semibold">
                <div class="flex flex-col items-center gap-2">
                  <img src="/logos/WhatsApp-Business-App.jpg" alt="WhatsApp Business App" class="w-8 h-8 rounded-lg shadow-sm"/>
                  <span>{t('whatsappCoexistence.comparison.table.businessApp')}</span>
                </div>
              </th>
              <th class="px-6 py-4 text-center font-semibold">
                <div class="flex flex-col items-center gap-2">
                  <img src="/logos/WhatsApp-Business-App.jpg" alt="WhatsApp Business Premium" class="w-8 h-8 rounded-lg shadow-sm"/>
                  <span>{t('whatsappCoexistence.comparison.table.premium')}</span>
                </div>
              </th>
              <th class="px-6 py-4 text-center font-semibold">
                <div class="flex flex-col items-center gap-2">
                  <img src="/logos/WhatsApp-Business-Platform.jpg" alt="WhatsApp Cloud API" class="w-8 h-8 rounded-lg shadow-sm"/>
                  <span>{t('whatsappCoexistence.comparison.table.cloudAPI')}</span>
                </div>
              </th>
              <th class="px-6 py-4 text-center font-semibold bg-gradient-to-b from-yellow-300 to-yellow-500 text-green-900 border-4 border-yellow-300 shadow-lg transform scale-105">
                <div class="flex flex-col items-center gap-1">
                  <div class="flex items-center gap-1">
                    <img src="/logos/WhatsApp-Business-App.jpg" alt="" class="w-5 h-5 rounded"/>
                    <span class="text-lg">+</span>
                    <img src="/logos/WhatsApp-Business-Platform.jpg" alt="" class="w-5 h-5 rounded"/>
                  </div>
                  <span>{t('whatsappCoexistence.comparison.table.coexistence')}</span>
                  <span class="inline-block bg-green-600 text-white text-[10px] px-2 py-0.5 rounded-full font-bold">{t('whatsappCoexistence.comparison.table.recommended')}</span>
                </div>
              </th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200" style="vertical-align: middle;">
            <!-- Row 1: Pricing -->
            <tr class="hover:bg-gray-50 transition-colors">
              <td class="px-6 py-4 font-medium text-gray-900">
                {t('whatsappCoexistence.comparison.features.cost.name')}
              </td>
              <td class="px-6 py-4 text-center text-green-600 font-semibold">
                {t('whatsappCoexistence.comparison.features.cost.free')}
              </td>
              <td class="px-6 py-4 text-center text-gray-600">
                {t('whatsappCoexistence.comparison.features.cost.premiumRange')}
              </td>
              <td class="px-6 py-4 text-center text-gray-600">
                {t('whatsappCoexistence.comparison.features.cost.perMessage')}
              </td>
              <td class="px-6 py-4 text-center bg-green-50 font-semibold text-green-700">
                {t('whatsappCoexistence.comparison.features.cost.hybrid')}
              </td>
            </tr>

            <!-- Row 2: Phone Number -->
            <tr class="hover:bg-gray-50 transition-colors">
              <td class="px-6 py-4 font-medium text-gray-900">
                {t('whatsappCoexistence.comparison.features.sameNumber')}
              </td>
              <td class="px-6 py-4 text-center">
                <Check class="w-6 h-6 text-green-600 mx-auto" />
              </td>
              <td class="px-6 py-4 text-center">
                <Check class="w-6 h-6 text-green-600 mx-auto" />
              </td>
              <td class="px-6 py-4 text-center">
                <X class="w-6 h-6 text-red-500 mx-auto" />
              </td>
              <td class="px-6 py-4 text-center bg-green-50">
                <Check class="w-6 h-6 text-green-700 mx-auto" />
              </td>
            </tr>

            <!-- Row 3: Chat History -->
            <tr class="hover:bg-gray-50 transition-colors">
              <td class="px-6 py-4 font-medium text-gray-900">
                {t('whatsappCoexistence.comparison.features.chatHistory')}
              </td>
              <td class="px-6 py-4 text-center">
                <Check class="w-6 h-6 text-green-600 mx-auto" />
              </td>
              <td class="px-6 py-4 text-center">
                <Check class="w-6 h-6 text-green-600 mx-auto" />
              </td>
              <td class="px-6 py-4 text-center">
                <X class="w-6 h-6 text-red-500 mx-auto" />
              </td>
              <td class="px-6 py-4 text-center bg-green-50">
                <Check class="w-6 h-6 text-green-700 mx-auto" />
                <span class="block text-xs text-green-600">{t('whatsappCoexistence.comparison.days180')}</span>
              </td>
            </tr>

            <!-- Row 4: Multi-User Support -->
            <tr class="hover:bg-gray-50 transition-colors">
              <td class="px-6 py-4 font-medium text-gray-900">
                {t('whatsappCoexistence.comparison.features.multiUser.name')}
              </td>
              <td class="px-6 py-4 text-center text-gray-500 text-sm">
                {t('whatsappCoexistence.comparison.features.multiUser.fiveDevices')}
              </td>
              <td class="px-6 py-4 text-center">
                {t('whatsappCoexistence.comparison.features.multiUser.tenDevices')}
              </td>
              <td class="px-6 py-4 text-center">
                <Check class="w-6 h-6 text-green-600 mx-auto" />
                <span class="block text-xs text-gray-500">{t('whatsappCoexistence.comparison.features.multiUser.unlimited')}</span>
              </td>
              <td class="px-6 py-4 text-center bg-green-50">
                <Check class="w-6 h-6 text-green-700 mx-auto" />
                <span class="block text-xs text-green-600">{t('whatsappCoexistence.comparison.features.multiUser.unlimited')}</span>
              </td>
            </tr>

            <!-- Row 5: Automation -->
            <tr class="hover:bg-gray-50 transition-colors">
              <td class="px-6 py-4 font-medium text-gray-900">
                {t('whatsappCoexistence.comparison.features.automation.name')}
              </td>
              <td class="px-6 py-4 text-center text-gray-500 text-sm">
                {t('whatsappCoexistence.comparison.features.automation.basic')}
              </td>
              <td class="px-6 py-4 text-center text-gray-500 text-sm">
                {t('whatsappCoexistence.comparison.features.automation.basic')}
              </td>
              <td class="px-6 py-4 text-center">
                <Check class="w-6 h-6 text-green-600 mx-auto" />
                <span class="block text-xs text-gray-500">{t('whatsappCoexistence.comparison.features.automation.advancedAI')}</span>
              </td>
              <td class="px-6 py-4 text-center bg-green-50">
                <Check class="w-6 h-6 text-green-700 mx-auto" />
                <span class="block text-xs text-green-600">{t('whatsappCoexistence.comparison.features.automation.aiHuman')}</span>
              </td>
            </tr>

            <!-- Row 6: Broadcast Limit -->
            <tr class="hover:bg-gray-50 transition-colors">
              <td class="px-6 py-4 font-medium text-gray-900">
                {t('whatsappCoexistence.comparison.features.broadcastLimit.name')}
              </td>
              <td class="px-6 py-4 text-center text-gray-500 text-sm">
                {t('whatsappCoexistence.comparison.features.broadcastLimit.contacts256')}
              </td>
              <td class="px-6 py-4 text-center text-gray-500 text-sm">
                {t('whatsappCoexistence.comparison.features.broadcastLimit.contacts256')}
              </td>
              <td class="px-6 py-4 text-center">
                <Check class="w-6 h-6 text-green-600 mx-auto" />
                <span class="block text-xs text-gray-500">{t('whatsappCoexistence.comparison.features.broadcastLimit.unlimited')}</span>
              </td>
              <td class="px-6 py-4 text-center bg-green-50">
                <Check class="w-6 h-6 text-green-700 mx-auto" />
                <span class="block text-xs text-green-600">{t('whatsappCoexistence.comparison.features.broadcastLimit.unlimited')}</span>
              </td>
            </tr>

            <!-- Row 7: CRM Integration -->
            <tr class="hover:bg-gray-50 transition-colors">
              <td class="px-6 py-4 font-medium text-gray-900">
                {t('whatsappCoexistence.comparison.features.crmIntegration')}
              </td>
              <td class="px-6 py-4 text-center">
                <X class="w-6 h-6 text-red-500 mx-auto" />
              </td>
              <td class="px-6 py-4 text-center">
                <X class="w-6 h-6 text-red-500 mx-auto" />
              </td>
              <td class="px-6 py-4 text-center">
                <Check class="w-6 h-6 text-green-600 mx-auto" />
              </td>
              <td class="px-6 py-4 text-center bg-green-50">
                <Check class="w-6 h-6 text-green-700 mx-auto" />
              </td>
            </tr>

            <!-- Row 8: Verification Badge -->
            <tr class="hover:bg-gray-50 transition-colors">
              <td class="px-6 py-4 font-medium text-gray-900">
                {t('whatsappCoexistence.comparison.features.verification')}
              </td>
              <td class="px-6 py-4 text-center">
                <X class="w-6 h-6 text-red-500 mx-auto" />
              </td>
              <td class="px-6 py-4 text-center">
                <Check class="w-6 h-6 text-green-600 mx-auto" />
              </td>
              <td class="px-6 py-4 text-center">
                <Check class="w-6 h-6 text-green-600 mx-auto" />
              </td>
              <td class="px-6 py-4 text-center bg-green-50">
                <Check class="w-6 h-6 text-green-700 mx-auto" />
              </td>
            </tr>

            <!-- Row 9: Group Chats -->
            <tr class="hover:bg-gray-50 transition-colors">
              <td class="px-6 py-4 font-medium text-gray-900">
                {t('whatsappCoexistence.comparison.features.groupChats.name')}
              </td>
              <td class="px-6 py-4 text-center">
                <Check class="w-6 h-6 text-green-600 mx-auto" />
              </td>
              <td class="px-6 py-4 text-center">
                <Check class="w-6 h-6 text-green-600 mx-auto" />
              </td>
              <td class="px-6 py-4 text-center">
                <X class="w-6 h-6 text-red-500 mx-auto" />
              </td>
              <td class="px-6 py-4 text-center bg-green-50">
                <Check class="w-6 h-6 text-green-700 mx-auto" />
                <span class="block text-xs text-green-600">{t('whatsappCoexistence.comparison.features.groupChats.appOnly')}</span>
              </td>
            </tr>

            <!-- Row 10: Analytics -->
            <tr class="hover:bg-gray-50 transition-colors">
              <td class="px-6 py-4 font-medium text-gray-900">
                {t('whatsappCoexistence.comparison.features.analytics.name')}
              </td>
              <td class="px-6 py-4 text-center text-gray-500 text-sm">
                {t('whatsappCoexistence.comparison.features.analytics.basic')}
              </td>
              <td class="px-6 py-4 text-center">
                <Check class="w-6 h-6 text-green-600 mx-auto" />
              </td>
              <td class="px-6 py-4 text-center">
                <Check class="w-6 h-6 text-green-600 mx-auto" />
              </td>
              <td class="px-6 py-4 text-center bg-green-50">
                <Check class="w-6 h-6 text-green-700 mx-auto" />
              </td>
            </tr>

            <!-- Row 11: Throughput -->
            <tr class="hover:bg-gray-50 transition-colors">
              <td class="px-6 py-4 font-medium text-gray-900">
                {t('whatsappCoexistence.comparison.features.maxThroughput.name')}
              </td>
              <td class="px-6 py-4 text-center text-gray-500 text-sm">
                {t('whatsappCoexistence.comparison.features.maxThroughput.manual')}
              </td>
              <td class="px-6 py-4 text-center text-gray-500 text-sm">
                {t('whatsappCoexistence.comparison.features.maxThroughput.manual')}
              </td>
              <td class="px-6 py-4 text-center">
                <Check class="w-6 h-6 text-green-600 mx-auto" />
                <span class="block text-xs text-gray-500">{t('whatsappCoexistence.comparison.features.maxThroughput.mps80')}</span>
              </td>
              <td class="px-6 py-4 text-center bg-green-50">
                <Check class="w-6 h-6 text-green-700 mx-auto" />
                <span class="block text-xs text-green-600">{t('whatsappCoexistence.comparison.features.maxThroughput.mps20')}</span>
              </td>
            </tr>

            <!-- Row 12: Migration -->
            <tr class="hover:bg-gray-50 transition-colors">
              <td class="px-6 py-4 font-medium text-gray-900">
                {t('whatsappCoexistence.comparison.features.migration.name')}
              </td>
              <td class="px-6 py-4 text-center">
                <span class="text-gray-400 text-sm">{t('whatsappCoexistence.comparison.features.migration.na')}</span>
              </td>
              <td class="px-6 py-4 text-center">
                <span class="text-gray-400 text-sm">{t('whatsappCoexistence.comparison.features.migration.na')}</span>
              </td>
              <td class="px-6 py-4 text-center text-red-600 text-sm font-medium">
                {t('whatsappCoexistence.comparison.features.migration.disruptive')}
              </td>
              <td class="px-6 py-4 text-center bg-green-50 text-green-700 font-semibold">
                {t('whatsappCoexistence.comparison.features.migration.seamless')}
              </td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- Mobile: Accordion Version -->
      <div class="md:hidden mt-12 space-y-4">
        <!-- Business App -->
        <details class="bg-gray-50 rounded-xl">
          <summary class="px-6 py-4 font-semibold text-gray-900 cursor-pointer flex items-center justify-between">
            <div class="flex items-center gap-3">
              <img src="/logos/WhatsApp-Business-App.jpg" alt="WhatsApp Business App" class="w-8 h-8 rounded-lg shadow-sm"/>
              <span>{t('whatsappCoexistence.comparison.mobile.businessAppTitle')}</span>
            </div>
            <ChevronRight class="w-5 h-5 text-gray-500 transition-transform" />
          </summary>
          <div class="px-6 pb-4 text-gray-600 space-y-2">
            <p><strong>{t('whatsappCoexistence.comparison.features.cost.name')}:</strong> {t('whatsappCoexistence.comparison.features.cost.free')}</p>
            <p><strong>{t('whatsappCoexistence.comparison.features.multiUser.name')}:</strong> {t('whatsappCoexistence.comparison.features.multiUser.fiveDevices')}</p>
            <p><strong>{t('whatsappCoexistence.comparison.features.automation.name')}:</strong> {t('whatsappCoexistence.comparison.features.automation.basic')}</p>
            <p><strong>{t('whatsappCoexistence.comparison.features.broadcastLimit.name')}:</strong> {t('whatsappCoexistence.comparison.features.broadcastLimit.contacts256')}</p>
          </div>
        </details>

        <!-- Premium -->
        <details class="bg-gray-50 rounded-xl">
          <summary class="px-6 py-4 font-semibold text-gray-900 cursor-pointer flex items-center justify-between">
            {t('whatsappCoexistence.comparison.mobile.premiumTitle')}
            <ChevronRight class="w-5 h-5 text-gray-500 transition-transform" />
          </summary>
          <div class="px-6 pb-4 text-gray-600 space-y-2">
            <p><strong>{t('whatsappCoexistence.comparison.features.cost.name')}:</strong> {t('whatsappCoexistence.comparison.features.cost.premiumRange')}</p>
            <p><strong>{t('whatsappCoexistence.comparison.features.multiUser.name')}:</strong> {t('whatsappCoexistence.comparison.features.multiUser.tenDevices')}</p>
            <p><strong>{t('whatsappCoexistence.comparison.features.automation.name')}:</strong> {t('whatsappCoexistence.comparison.features.automation.basic')}</p>
            <p><strong>{t('whatsappCoexistence.comparison.features.broadcastLimit.name')}:</strong> {t('whatsappCoexistence.comparison.features.broadcastLimit.contacts256')}</p>
          </div>
        </details>

        <!-- API -->
        <details class="bg-gray-50 rounded-xl">
          <summary class="px-6 py-4 font-semibold text-gray-900 cursor-pointer flex items-center justify-between">
            {t('whatsappCoexistence.comparison.mobile.apiTitle')}
            <ChevronRight class="w-5 h-5 text-gray-500 transition-transform" />
          </summary>
          <div class="px-6 pb-4 text-gray-600 space-y-2">
            <p><strong>{t('whatsappCoexistence.comparison.features.cost.name')}:</strong> {t('whatsappCoexistence.comparison.features.cost.perMessage')}</p>
            <p><strong>{t('whatsappCoexistence.comparison.features.multiUser.name')}:</strong> {t('whatsappCoexistence.comparison.features.multiUser.unlimited')}</p>
            <p><strong>{t('whatsappCoexistence.comparison.features.automation.name')}:</strong> {t('whatsappCoexistence.comparison.features.automation.advancedAI')}</p>
            <p><strong>{t('whatsappCoexistence.comparison.features.maxThroughput.name')}:</strong> {t('whatsappCoexistence.comparison.features.maxThroughput.mps80')}</p>
          </div>
        </details>

        <!-- Coexistence -->
        <details class="bg-green-50 rounded-xl border-2 border-green-300">
          <summary class="px-6 py-4 font-semibold text-green-900 cursor-pointer flex items-center justify-between">
            {t('whatsappCoexistence.comparison.mobile.coexistenceTitle')}
            <span class="bg-yellow-400 px-3 py-1 rounded-full text-xs font-semibold text-green-900 ml-2">
              {t('whatsappCoexistence.comparison.table.recommended')}
            </span>
            <ChevronRight class="w-5 h-5 text-green-600 transition-transform" />
          </summary>
          <div class="px-6 pb-4 text-green-800 space-y-2">
            <p><strong>{t('whatsappCoexistence.comparison.features.cost.name')}:</strong> {t('whatsappCoexistence.comparison.features.cost.hybrid')}</p>
            <p><strong>{t('whatsappCoexistence.comparison.features.multiUser.name')}:</strong> {t('whatsappCoexistence.comparison.features.multiUser.unlimited')}</p>
            <p><strong>{t('whatsappCoexistence.comparison.features.automation.name')}:</strong> {t('whatsappCoexistence.comparison.features.automation.aiHuman')}</p>
            <p><strong>{t('whatsappCoexistence.comparison.features.maxThroughput.name')}:</strong> {t('whatsappCoexistence.comparison.features.maxThroughput.mps20')}</p>
