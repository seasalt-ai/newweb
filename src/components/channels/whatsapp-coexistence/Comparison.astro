      </div>

      <!-- Bottom CTA -->
      <div class="mt-16 text-center">
        <p class="text-lg text-gray-600 mb-6">
          {t('whatsappCoexistence.comparison.cta.title')}
        </p>
        <a
          href="https://seax.seasalt.ai/signup"
          class="inline-flex items-center justify-center px-8 py-4 bg-green-600 hover:bg-green-700 text-white font-bold rounded-lg text-lg transition-all transform hover:scale-105 shadow-lg hover:shadow-xl"
        >
          {t('whatsappCoexistence.comparison.cta.button')}
          <ChevronRight class="ml-2 w-5 h-5" />
        </a>
      </div>
    </div>
  </div>
</section>

<script define:vars={{ uniqueId }}>
  // Accordion toggle for mobile - scoped to component root
  const root = document.getElementById(uniqueId);
  if (root) {
    root.querySelectorAll('details').forEach(detail => {
      detail.addEventListener('toggle', () => {
        const icon = detail.querySelector('summary svg');
        if (icon) {
          if (detail.open) {
            icon.style.transform = 'rotate(90deg)';
          } else {
            icon.style.transform = 'rotate(0deg)';
          }
        }
      });
    });
  }
</script>

<style>
  details[open] summary svg {
    transform: rotate(90deg);
  }

  /* Ensure table cells are vertically centered */
  tbody td {
    vertical-align: middle;
  }
  
  /* Center-align all content in text-center cells */
  tbody td.text-center {
    text-align: center;
  }
  
  /* Ensure inline elements and block elements are centered */
  tbody td.text-center svg,
  tbody td.text-center span,
  tbody td.text-center div {
    margin-left: auto;
    margin-right: auto;
  }
  
  /* For block elements like spans, also ensure text is centered */
  tbody td.text-center span {
    display: block;
    text-align: center;
  }
</style>
