---
import { Check, X, ChevronRight } from 'lucide-react';

export interface Props {
  lang: string;
}

const { lang } = Astro.props;
---

<section id="comparison" class="py-20 bg-white">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto">
      <!-- Section Header -->
      <div class="text-center mb-16">
        <h2 class="text-4xl font-bold text-gray-900 mb-4">
          Compare WhatsApp Solutions
        </h2>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
          See how WhatsApp Coexistence stacks up against alternatives
        </p>
      </div>

      <!-- Feature Comparison Table -->
      <div class="overflow-x-auto rounded-2xl border-2 border-gray-200 shadow-xl">
        <table class="w-full min-w-[800px]">
          <thead>
            <tr class="bg-gradient-to-r from-green-500 to-green-600 text-white">
              <th class="px-6 py-4 text-left font-semibold">
                Feature
              </th>
              <th class="px-6 py-4 text-center font-semibold">
                <div class="flex flex-col items-center gap-2">
                  <img src="/logos/WhatsApp-Business-App.jpg" alt="WhatsApp Business App" class="w-8 h-8 rounded-lg shadow-sm"/>
                  <span>Business App</span>
                </div>
              </th>
              <th class="px-6 py-4 text-center font-semibold">
                <div class="flex flex-col items-center gap-2">
                  <img src="/logos/WhatsApp-Business-App.jpg" alt="WhatsApp Business Premium" class="w-8 h-8 rounded-lg shadow-sm"/>
                  <span>Premium</span>
                </div>
              </th>
              <th class="px-6 py-4 text-center font-semibold">
                <div class="flex flex-col items-center gap-2">
                  <img src="/logos/WhatsApp-Business-Platform.jpg" alt="WhatsApp Cloud API" class="w-8 h-8 rounded-lg shadow-sm"/>
                  <span>Cloud API</span>
                </div>
              </th>
              <th class="px-6 py-4 text-center font-semibold bg-gradient-to-b from-yellow-300 to-yellow-500 text-green-900 border-4 border-yellow-300 shadow-lg transform scale-105">
                <div class="flex flex-col items-center gap-1">
                  <div class="flex items-center gap-1">
                    <img src="/logos/WhatsApp-Business-App.jpg" alt="" class="w-5 h-5 rounded"/>
                    <span class="text-lg">+</span>
                    <img src="/logos/WhatsApp-Business-Platform.jpg" alt="" class="w-5 h-5 rounded"/>
                  </div>
                  <span>Coexistence</span>
                  <span class="inline-block bg-green-600 text-white text-[10px] px-2 py-0.5 rounded-full font-bold">RECOMMENDED</span>
                </div>
              </th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200">
            <!-- Row 1: Pricing -->
            <tr class="hover:bg-gray-50 transition-colors">
              <td class="px-6 py-4 font-medium text-gray-900">
                Cost
              </td>
              <td class="px-6 py-4 text-center text-green-600 font-semibold">
                Free
              </td>
              <td class="px-6 py-4 text-center text-gray-600">
                €5-10/month
              </td>
              <td class="px-6 py-4 text-center text-gray-600">
                Per message
              </td>
              <td class="px-6 py-4 text-center bg-green-50 font-semibold text-green-700">
                Hybrid model
              </td>
            </tr>

            <!-- Row 2: Phone Number -->
            <tr class="hover:bg-gray-50 transition-colors">
              <td class="px-6 py-4 font-medium text-gray-900">
                Same Number
              </td>
              <td class="px-6 py-4 text-center">
                <Check class="w-6 h-6 text-green-600 mx-auto" />
              </td>
              <td class="px-6 py-4 text-center">
                <Check class="w-6 h-6 text-green-600 mx-auto" />
              </td>
              <td class="px-6 py-4 text-center">
                <X class="w-6 h-6 text-red-500 mx-auto" />
              </td>
              <td class="px-6 py-4 text-center bg-green-50">
                <Check class="w-6 h-6 text-green-700 mx-auto" />
              </td>
            </tr>

            <!-- Row 3: Chat History -->
            <tr class="hover:bg-gray-50 transition-colors">
              <td class="px-6 py-4 font-medium text-gray-900">
                Chat History
              </td>
              <td class="px-6 py-4 text-center">
                <Check class="w-6 h-6 text-green-600 mx-auto" />
              </td>
              <td class="px-6 py-4 text-center">
                <Check class="w-6 h-6 text-green-600 mx-auto" />
              </td>
              <td class="px-6 py-4 text-center">
                <X class="w-6 h-6 text-red-500 mx-auto" />
              </td>
              <td class="px-6 py-4 text-center bg-green-50">
                <Check class="w-6 h-6 text-green-700 mx-auto" />
                <span class="block text-xs text-green-600">180 days</span>
              </td>
            </tr>

            <!-- Row 4: Multi-User Support -->
            <tr class="hover:bg-gray-50 transition-colors">
              <td class="px-6 py-4 font-medium text-gray-900">
                Multi-User
              </td>
              <td class="px-6 py-4 text-center text-gray-500 text-sm">
                5 devices
              </td>
              <td class="px-6 py-4 text-center">
                10 devices
              </td>
              <td class="px-6 py-4 text-center">
                <Check class="w-6 h-6 text-green-600 mx-auto" />
                <span class="block text-xs text-gray-500">Unlimited</span>
              </td>
              <td class="px-6 py-4 text-center bg-green-50">
                <Check class="w-6 h-6 text-green-700 mx-auto" />
                <span class="block text-xs text-green-600">Unlimited</span>
              </td>
            </tr>

            <!-- Row 5: Automation -->
            <tr class="hover:bg-gray-50 transition-colors">
              <td class="px-6 py-4 font-medium text-gray-900">
                Automation
              </td>
              <td class="px-6 py-4 text-center text-gray-500 text-sm">
                Basic
              </td>
              <td class="px-6 py-4 text-center text-gray-500 text-sm">
                Basic
              </td>
              <td class="px-6 py-4 text-center">
                <Check class="w-6 h-6 text-green-600 mx-auto" />
                <span class="block text-xs text-gray-500">Advanced AI</span>
              </td>
              <td class="px-6 py-4 text-center bg-green-50">
                <Check class="w-6 h-6 text-green-700 mx-auto" />
                <span class="block text-xs text-green-600">AI + Human</span>
              </td>
            </tr>

            <!-- Row 6: Broadcast Limit -->
            <tr class="hover:bg-gray-50 transition-colors">
              <td class="px-6 py-4 font-medium text-gray-900">
                Broadcast Limit
              </td>
              <td class="px-6 py-4 text-center text-gray-500 text-sm">
                256 contacts
              </td>
              <td class="px-6 py-4 text-center text-gray-500 text-sm">
                256 contacts
              </td>
              <td class="px-6 py-4 text-center">
                <Check class="w-6 h-6 text-green-600 mx-auto" />
                <span class="block text-xs text-gray-500">Unlimited</span>
              </td>
              <td class="px-6 py-4 text-center bg-green-50">
                <Check class="w-6 h-6 text-green-700 mx-auto" />
                <span class="block text-xs text-green-600">Unlimited</span>
              </td>
            </tr>

            <!-- Row 7: CRM Integration -->
            <tr class="hover:bg-gray-50 transition-colors">
              <td class="px-6 py-4 font-medium text-gray-900">
                CRM Integration
              </td>
              <td class="px-6 py-4 text-center">
                <X class="w-6 h-6 text-red-500 mx-auto" />
              </td>
              <td class="px-6 py-4 text-center">
                <X class="w-6 h-6 text-red-500 mx-auto" />
              </td>
              <td class="px-6 py-4 text-center">
                <Check class="w-6 h-6 text-green-600 mx-auto" />
              </td>
              <td class="px-6 py-4 text-center bg-green-50">
                <Check class="w-6 h-6 text-green-700 mx-auto" />
              </td>
            </tr>

            <!-- Row 8: Verification Badge -->
            <tr class="hover:bg-gray-50 transition-colors">
              <td class="px-6 py-4 font-medium text-gray-900">
                Verification
              </td>
              <td class="px-6 py-4 text-center">
                <X class="w-6 h-6 text-red-500 mx-auto" />
              </td>
              <td class="px-6 py-4 text-center">
                <Check class="w-6 h-6 text-green-600 mx-auto" />
              </td>
              <td class="px-6 py-4 text-center">
                <Check class="w-6 h-6 text-green-600 mx-auto" />
              </td>
              <td class="px-6 py-4 text-center bg-green-50">
                <Check class="w-6 h-6 text-green-700 mx-auto" />
              </td>
            </tr>

            <!-- Row 9: Group Chats -->
            <tr class="hover:bg-gray-50 transition-colors">
              <td class="px-6 py-4 font-medium text-gray-900">
                Group Chats
              </td>
              <td class="px-6 py-4 text-center">
                <Check class="w-6 h-6 text-green-600 mx-auto" />
              </td>
              <td class="px-6 py-4 text-center">
                <Check class="w-6 h-6 text-green-600 mx-auto" />
              </td>
              <td class="px-6 py-4 text-center">
                <X class="w-6 h-6 text-red-500 mx-auto" />
              </td>
              <td class="px-6 py-4 text-center bg-green-50">
                <Check class="w-6 h-6 text-green-700 mx-auto" />
                <span class="block text-xs text-green-600">App only</span>
              </td>
            </tr>

            <!-- Row 10: Analytics -->
            <tr class="hover:bg-gray-50 transition-colors">
              <td class="px-6 py-4 font-medium text-gray-900">
                Analytics
              </td>
              <td class="px-6 py-4 text-center text-gray-500 text-sm">
                Basic
              </td>
              <td class="px-6 py-4 text-center">
                <Check class="w-6 h-6 text-green-600 mx-auto" />
              </td>
              <td class="px-6 py-4 text-center">
                <Check class="w-6 h-6 text-green-600 mx-auto" />
              </td>
              <td class="px-6 py-4 text-center bg-green-50">
                <Check class="w-6 h-6 text-green-700 mx-auto" />
              </td>
            </tr>

            <!-- Row 11: Throughput -->
            <tr class="hover:bg-gray-50 transition-colors">
              <td class="px-6 py-4 font-medium text-gray-900">
                Max Throughput
              </td>
              <td class="px-6 py-4 text-center text-gray-500 text-sm">
                Manual
              </td>
              <td class="px-6 py-4 text-center text-gray-500 text-sm">
                Manual
              </td>
              <td class="px-6 py-4 text-center">
                <Check class="w-6 h-6 text-green-600 mx-auto" />
                <span class="block text-xs text-gray-500">80+ MPS</span>
              </td>
              <td class="px-6 py-4 text-center bg-green-50">
                <Check class="w-6 h-6 text-green-700 mx-auto" />
                <span class="block text-xs text-green-600">20 MPS</span>
              </td>
            </tr>

            <!-- Row 12: Migration -->
            <tr class="hover:bg-gray-50 transition-colors">
              <td class="px-6 py-4 font-medium text-gray-900">
                Migration
              </td>
              <td class="px-6 py-4 text-center">
                <span class="text-gray-400 text-sm">N/A</span>
              </td>
              <td class="px-6 py-4 text-center">
                <span class="text-gray-400 text-sm">N/A</span>
              </td>
              <td class="px-6 py-4 text-center text-red-600 text-sm font-medium">
                Disruptive
              </td>
              <td class="px-6 py-4 text-center bg-green-50 text-green-700 font-semibold">
                Seamless
              </td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- Mobile: Accordion Version -->
      <div class="md:hidden mt-12 space-y-4">
        <!-- Business App -->
        <details class="bg-gray-50 rounded-xl">
          <summary class="px-6 py-4 font-semibold text-gray-900 cursor-pointer flex items-center justify-between">
            <div class="flex items-center gap-3">
              <img src="/logos/WhatsApp-Business-App.jpg" alt="WhatsApp Business App" class="w-8 h-8 rounded-lg shadow-sm"/>
              <span>WhatsApp Business App</span>
            </div>
            <ChevronRight class="w-5 h-5 text-gray-500 transition-transform" />
          </summary>
          <div class="px-6 pb-4 text-gray-600 space-y-2">
            <p><strong>Cost:</strong> Free</p>
            <p><strong>Multi-User:</strong> 5 devices</p>
            <p><strong>Automation:</strong> Basic</p>
            <p><strong>Limit:</strong> 256 broadcast contacts</p>
          </div>
        </details>

        <!-- Premium -->
        <details class="bg-gray-50 rounded-xl">
          <summary class="px-6 py-4 font-semibold text-gray-900 cursor-pointer flex items-center justify-between">
            WhatsApp Business Premium
            <ChevronRight class="w-5 h-5 text-gray-500 transition-transform" />
          </summary>
          <div class="px-6 pb-4 text-gray-600 space-y-2">
            <p><strong>Cost:</strong> €5-10/month</p>
            <p><strong>Multi-User:</strong> 10 devices</p>
            <p><strong>Automation:</strong> Basic</p>
            <p><strong>Limit:</strong> 256 broadcast contacts</p>
          </div>
        </details>

        <!-- API -->
        <details class="bg-gray-50 rounded-xl">
          <summary class="px-6 py-4 font-semibold text-gray-900 cursor-pointer flex items-center justify-between">
            WhatsApp Business API
            <ChevronRight class="w-5 h-5 text-gray-500 transition-transform" />
          </summary>
          <div class="px-6 pb-4 text-gray-600 space-y-2">
            <p><strong>Cost:</strong> Per message</p>
            <p><strong>Multi-User:</strong> Unlimited agents</p>
            <p><strong>Automation:</strong> Advanced AI</p>
            <p><strong>Throughput:</strong> 80+ MPS</p>
          </div>
        </details>

        <!-- Coexistence -->
        <details class="bg-green-50 rounded-xl border-2 border-green-300">
          <summary class="px-6 py-4 font-semibold text-green-900 cursor-pointer flex items-center justify-between">
            WhatsApp Coexistence
            <span class="bg-yellow-400 px-3 py-1 rounded-full text-xs font-semibold text-green-900 ml-2">
              Recommended
            </span>
            <ChevronRight class="w-5 h-5 text-green-600 transition-transform" />
          </summary>
          <div class="px-6 pb-4 text-green-800 space-y-2">
            <p><strong>Cost:</strong> Hybrid model (free app + paid API)</p>
            <p><strong>Multi-User:</strong> Unlimited agents + mobile app</p>
            <p><strong>Automation:</strong> AI + Human-in-the-loop</p>
            <p><strong>Throughput:</strong> 20 MPS</p>
            <p><strong>Migration:</strong> Seamless, 180-day history sync</p>
          </div>
        </details>
      </div>

      <!-- Bottom CTA -->
      <div class="mt-16 text-center">
        <p class="text-lg text-gray-600 mb-6">
          Ready to upgrade to WhatsApp Coexistence?
        </p>
        <a
          href="https://seax.seasalt.ai/signup"
          class="inline-flex items-center justify-center px-8 py-4 bg-green-600 hover:bg-green-700 text-white font-bold rounded-lg text-lg transition-all transform hover:scale-105 shadow-lg hover:shadow-xl"
        >
          Sign Up Now
          <ChevronRight class="ml-2 w-5 h-5" />
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  // Accordion toggle for mobile
  document.querySelectorAll('details').forEach(detail => {
    detail.addEventListener('toggle', () => {
      const icon = detail.querySelector('svg');
      if (detail.open) {
        icon.style.transform = 'rotate(90deg)';
      } else {
        icon.style.transform = 'rotate(0deg)';
      }
    });
  });
</script>

<style>
  details[open] summary svg {
    transform: rotate(90deg);
  }
</style>
