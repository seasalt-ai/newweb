---
import { getTranslationHelpers } from '../../../i18n/helpers';

export interface Props {
  lang: string;
}

const { lang } = Astro.props;
const { t } = await getTranslationHelpers(lang);
---

<section id="what-is-coexistence" class="py-20 bg-emerald-50/30 relative overflow-hidden">
  <!-- Subtle background pattern -->
  <div class="absolute inset-0 opacity-[0.03]" style="background-image: radial-gradient(circle at 2px 2px, #10b981 1px, transparent 0); background-size: 40px 40px;"></div>
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="max-w-6xl mx-auto">
      <!-- Section Header -->
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">{t('whatsappCoexistence.whatIs.title')}</h2>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto leading-relaxed">
          {t('whatsappCoexistence.whatIs.description')} <span class="text-green-600 font-semibold">{t('whatsappCoexistence.whatIs.simultaneously')}</span>.
        </p>
      </div>

      <!-- Before/After Comparison -->
      <div class="grid md:grid-cols-2 gap-6 mb-16">
        <div class="bg-gray-50 rounded-xl p-6 border-2 border-gray-200 shadow-md hover:shadow-lg transition-all duration-300">
          <h4 class="text-xl font-bold text-gray-900 mb-4 flex items-center">
            <span class="w-8 h-8 bg-red-500 text-white rounded-full flex items-center justify-center mr-3 text-sm">✗</span>
            {t('whatsappCoexistence.whatIs.before.title')}
          </h4>
          <ul class="space-y-3 text-gray-600">
            <li class="flex items-start">
              <span class="text-red-500 mr-2">•</span>
              {t('whatsappCoexistence.whatIs.before.point1')}
            </li>
            <li class="flex items-start">
              <span class="text-red-500 mr-2">•</span>
              {t('whatsappCoexistence.whatIs.before.point2')}
            </li>
            <li class="flex items-start">
              <span class="text-red-500 mr-2">•</span>
              {t('whatsappCoexistence.whatIs.before.point3')}
            </li>
            <li class="flex items-start">
              <span class="text-red-500 mr-2">•</span>
              {t('whatsappCoexistence.whatIs.before.point4')}
            </li>
          </ul>
        </div>

        <div class="bg-green-50 rounded-xl p-6 border-2 border-green-300 shadow-md hover:shadow-lg transition-all duration-300">
          <h4 class="text-xl font-bold text-gray-900 mb-4 flex items-center">
            <span class="w-8 h-8 bg-green-500 text-white rounded-full flex items-center justify-center mr-3 text-sm">✓</span>
            {t('whatsappCoexistence.whatIs.after.title')}
          </h4>
          <ul class="space-y-3 text-gray-600">
            <li class="flex items-start">
              <span class="text-green-500 mr-2">✓</span>
              {t('whatsappCoexistence.whatIs.after.point1')}
            </li>
            <li class="flex items-start">
              <span class="text-green-500 mr-2">✓</span>
              {t('whatsappCoexistence.whatIs.after.point2')}
            </li>
            <li class="flex items-start">
              <span class="text-green-500 mr-2">✓</span>
              {t('whatsappCoexistence.whatIs.after.point3')}
            </li>
            <li class="flex items-start">
              <span class="text-green-500 mr-2">✓</span>
              {t('whatsappCoexistence.whatIs.after.point4')}
            </li>
          </ul>
        </div>
      </div>

      <!-- A Unified Omni-Channel Engine Subsection -->
      <div class="border-t border-gray-200 pt-16">
        <div class="text-center mb-12">
          <h3 class="text-2xl md:text-3xl font-bold text-gray-900 mb-3">{t('whatsappCoexistence.whatIs.omnichannel.title')}</h3>
          <p class="text-gray-600 max-w-3xl mx-auto">
            {t('whatsappCoexistence.whatIs.omnichannel.subtitle')}
          </p>
        </div>

        <div class="grid md:grid-cols-3 gap-6">
          <!-- Feature 1: 3-Way Synchronization -->
          <div class="bg-gray-50 rounded-xl p-6 border border-gray-200 hover:shadow-lg transition-all">
            <div class="w-10 h-10 bg-green-600 rounded-lg flex items-center justify-center text-white mb-4">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
              </svg>
            </div>
            <h4 class="text-lg font-bold mb-2">{t('whatsappCoexistence.whatIs.features.sync.title')}</h4>
            <p class="text-sm text-gray-600 leading-relaxed">
              {t('whatsappCoexistence.whatIs.features.sync.description')}
            </p>
          </div>

          <!-- Feature 2: Unlimited Agents -->
          <div class="bg-gray-50 rounded-xl p-6 border border-gray-200 hover:shadow-lg transition-all">
            <div class="w-10 h-10 bg-green-600 rounded-lg flex items-center justify-center text-white mb-4">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/>
              </svg>
            </div>
            <h4 class="text-lg font-bold mb-2">{t('whatsappCoexistence.whatIs.features.agents.title')}</h4>
            <p class="text-sm text-gray-600 leading-relaxed">
              {t('whatsappCoexistence.whatIs.features.agents.description')}
            </p>
          </div>

          <!-- Feature 3: AI Agent Handoff -->
          <div class="bg-gray-50 rounded-xl p-6 border border-gray-200 hover:shadow-lg transition-all">
            <div class="w-10 h-10 bg-green-600 rounded-lg flex items-center justify-center text-white mb-4">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
              </svg>
            </div>
            <h4 class="text-lg font-bold mb-2">{t('whatsappCoexistence.whatIs.features.aiHandoff.title')}</h4>
            <p class="text-sm text-gray-600 leading-relaxed">
              {t('whatsappCoexistence.whatIs.features.aiHandoff.description')}
            </p>
          </div>

          <!-- Feature 4: 6-Month History Import -->
          <div class="bg-gray-50 rounded-xl p-6 border border-gray-200 hover:shadow-lg transition-all">
            <div class="w-10 h-10 bg-green-600 rounded-lg flex items-center justify-center text-white mb-4">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
            </div>
            <h4 class="text-lg font-bold mb-2">{t('whatsappCoexistence.whatIs.features.history.title')}</h4>
            <p class="text-sm text-gray-600 leading-relaxed">
              {t('whatsappCoexistence.whatIs.features.history.description')}
            </p>
          </div>

          <!-- Feature 5: Seasalt Mobile App -->
          <div class="bg-gray-50 rounded-xl p-6 border border-gray-200 hover:shadow-lg transition-all">
            <div class="w-10 h-10 bg-green-600 rounded-lg flex items-center justify-center text-white mb-4">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <rect x="6" y="3" width="12" height="18" rx="2" stroke-width="2"/>
                <line x1="10" y1="18" x2="14" y2="18" stroke-width="2"/>
              </svg>
            </div>
            <h4 class="text-lg font-bold mb-2">{t('whatsappCoexistence.whatIs.features.mobileApp.title')}</h4>
            <p class="text-sm text-gray-600 leading-relaxed">
              {t('whatsappCoexistence.whatIs.features.mobileApp.description')}
            </p>
          </div>

          <!-- Feature 6: Unified Inbox -->
          <div class="bg-gray-50 rounded-xl p-6 border border-gray-200 hover:shadow-lg transition-all">
            <div class="w-10 h-10 bg-green-600 rounded-lg flex items-center justify-center text-white mb-4">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"/>
              </svg>
            </div>
            <h4 class="text-lg font-bold mb-2">{t('whatsappCoexistence.whatIs.features.unifiedInbox.title')}</h4>
            <p class="text-sm text-gray-600 leading-relaxed">
              {t('whatsappCoexistence.whatIs.features.unifiedInbox.description')}
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
