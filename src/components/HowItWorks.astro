---
import { getTranslationHelpers, extractLangFromPath, type SupportedLanguage } from '../i18n/helpers';

export interface Props {
  lang?: string;
}

const { lang = 'en' } = Astro.props;
const currentLang = extractLangFromPath(Astro.url.pathname) || lang as SupportedLanguage;
const { t } = await getTranslationHelpers(currentLang);

const steps = [
  {
    iconType: 'link',
    title: t('howItWorks.connectYourChannels.title'),
    description: t('howItWorks.connectYourChannels.description'),
    color: 'text-blue-600',
    bgColor: 'bg-blue-100'
  },
  {
    iconType: 'bot',
    title: t('howItWorks.automateRoutineWork.title'),
    description: t('howItWorks.automateRoutineWork.description'),
    color: 'text-green-600',
    bgColor: 'bg-green-100'
  },
  {
    iconType: 'users',
    title: t('howItWorks.unifyYourTeam.title'),
    description: t('howItWorks.unifyYourTeam.description'),
    color: 'text-purple-600',
    bgColor: 'bg-purple-100'
  }
];
---

<section class="py-20 bg-gray-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 overflow-hidden">
    <div class="text-center mb-16">
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-gray-900 mb-4">
        {t('howItWorks.title')}
      </h2>
      <p class="text-lg sm:text-xl text-gray-600 max-w-2xl mx-auto">
        {t('howItWorks.description1')}
        {t('howItWorks.description2')}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-10 md:gap-8 lg:gap-12">
      {steps.map((step, index) => (
        <div class="relative">
          <!-- Step Number -->
          <div class="text-center mb-6 sm:mb-8">
            <div class="inline-flex items-center justify-center w-12 h-12 sm:w-16 sm:h-16 bg-white rounded-full shadow-lg mb-3 sm:mb-4">
              <span class="text-xl sm:text-2xl font-bold text-gray-900">{index + 1}</span>
            </div>
            {index < steps.length - 1 && (
              <div class="hidden md:block absolute top-6 sm:top-8 left-1/2 w-full h-0.5 bg-gray-200 transform translate-x-8"></div>
            )}
          </div>

          <!-- Step Content -->
          <div class="text-center">
            <div class={`${step.bgColor} ${step.color} p-3 sm:p-4 rounded-2xl w-fit mx-auto mb-4 sm:mb-6`}>
              <div class="h-12 w-12 step-icon" data-type={step.iconType}></div>
            </div>
            <h3 class="text-lg sm:text-xl font-semibold text-gray-900 mb-3 sm:mb-4">
              {step.title}
            </h3>
            <p class="text-sm sm:text-base text-gray-600 leading-relaxed">
              {step.description}
            </p>
          </div>
        </div>
      ))}
    </div>

    <!-- CTA -->
    <div class="text-center mt-16">
      <a
        href="https://seax.seasalt.ai/signup"
        class="inline-flex items-center bg-blue-600 hover:bg-blue-700 text-white px-6 sm:px-8 py-3 sm:py-4 rounded-lg text-base sm:text-lg font-semibold transition-all duration-200 shadow-lg hover:shadow-xl transform hover:-translate-y-0.5"
      >
        {t('howItWorks.signUpNow')}
      </a>
      <p class="text-xs sm:text-sm text-gray-500 mt-3 sm:mt-4">{t('howItWorks.setupTime')}</p>
    </div>
  </div>
</section>

<script>
  // Add SVG icons
  function createStepIcon(type: string): string {
    const icons = {
      link: `<svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>`,
      bot: `<svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="none" stroke="currentColor" viewBox="0 0 24 24"><rect x="3" y="11" width="18" height="10" rx="2" ry="2"/><circle cx="12" cy="5" r="2"/><path d="M12 7v4"/><line x1="8" y1="16" x2="8" y2="16"/><line x1="16" y1="16" x2="16" y2="16"/></svg>`,
      users: `<svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="m22 21-3.4-3.4M13.26 13.26a4 4 0 1 0-2.44-2.44"/></svg>`
    };
    return icons[type as keyof typeof icons] || icons.link;
  }

  // Initialize icons
  document.addEventListener('DOMContentLoaded', function() {
    const icons = document.querySelectorAll('.step-icon');
    icons.forEach((icon) => {
      const type = icon.getAttribute('data-type');
      if (type && icon instanceof HTMLElement) {
        icon.innerHTML = createStepIcon(type);
      }
    });
  });
</script>
