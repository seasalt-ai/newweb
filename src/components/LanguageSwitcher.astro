---
import { languages } from '../i18n/helpers';
import { extractLangFromPath, getLocalizedPath } from '../i18n/helpers';

export interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;
// 使用傳入的 currentPath，如果沒有則使用實際的 URL 路徑
const actualCurrentPath = currentPath !== '/' ? currentPath : Astro.url.pathname;
const currentLang = extractLangFromPath(actualCurrentPath);
---

<div class="relative inline-block text-left">
  <button class="language-switcher-btn flex items-center text-gray-700 hover:text-blue-600 transition-colors duration-200">
    <span class="mr-1">{languages[currentLang]?.shortCode || 'EN'}</span>
    <svg class="w-4 h-4 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
    </svg>
  </button>
  
  <div class="language-menu hidden absolute right-0 z-[9999] mt-2 w-64 origin-top-right bg-white rounded-lg shadow-lg border border-gray-200 py-2 max-h-96 overflow-y-auto">
    <div class="py-1">
      {Object.entries(languages).map(([lang, info]) => (
        <a 
          href={getLocalizedPath(actualCurrentPath, lang as keyof typeof languages)}
          class={`block w-full text-left px-4 py-2 text-sm hover:bg-gray-50 ${
            currentLang === lang ? 'font-semibold text-blue-600 bg-blue-50' : 'text-gray-700'
          }`}
        >
          <div class="flex justify-between items-center">
            <span class="font-medium">{info.name}</span>
            <span class="text-xs text-gray-500 ml-2">{info.englishName}</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</div>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function() {
    // Initialize language switchers after DOM is loaded
    function initLanguageSwitchers() {
      const buttons = document.querySelectorAll('.language-switcher-btn');
      
      buttons.forEach(button => {
        // Skip if already initialized
        if (button.hasAttribute('data-initialized')) {
          return;
        }
        
        button.setAttribute('data-initialized', 'true');
        const container = button.closest('.relative');
        const menu = container ? container.querySelector('.language-menu') : null;
        
        if (button && menu) {
          // Add data attribute to track state
          button.setAttribute('data-open', 'false');
          
          // Remove existing event listeners if any
          button.replaceWith(button.cloneNode(true));
          const newButton = container.querySelector('.language-switcher-btn');
          newButton.setAttribute('data-initialized', 'true');
          
          newButton.addEventListener('click', function(e) {
            e.preventDefault();
            e.stopPropagation();
            
            console.log('Language switcher clicked'); // Debug log
            
            const isOpen = this.getAttribute('data-open') === 'true';
            
            // Close all other language menus first
            document.querySelectorAll('.language-switcher-btn').forEach(otherButton => {
              if (otherButton !== this) {
                otherButton.setAttribute('data-open', 'false');
                const otherContainer = otherButton.closest('.relative');
                const otherMenu = otherContainer ? otherContainer.querySelector('.language-menu') : null;
                if (otherMenu) {
                  otherMenu.classList.add('hidden');
                  otherMenu.style.display = 'none';
                }
                const otherChevron = otherButton.querySelector('svg');
                if (otherChevron) {
                  otherChevron.style.transform = 'rotate(0deg)';
                }
              }
            });
            
            // Toggle current menu
            if (isOpen) {
              // Close current menu
              menu.classList.add('hidden');
              menu.style.display = 'none';
              this.setAttribute('data-open', 'false');
              console.log('Menu closed'); // Debug log
            } else {
              // Open current menu
              menu.classList.remove('hidden');
              menu.style.display = 'block';
              this.setAttribute('data-open', 'true');
              console.log('Menu opened'); // Debug log
            }
            
            // Rotate chevron
            const chevron = this.querySelector('svg');
            if (chevron) {
              chevron.style.transform = isOpen ? 'rotate(0deg)' : 'rotate(180deg)';
              chevron.style.transition = 'transform 0.2s ease';
            }
          });
          
          // Initialize as hidden
          menu.classList.add('hidden');
          menu.style.display = 'none';
        }
      });
    }
    
    // Initialize immediately and also after a short delay
    initLanguageSwitchers();
    setTimeout(initLanguageSwitchers, 200);
      
    // Close menus when clicking outside (with higher priority)
    document.addEventListener('click', function(e) {
      const clickedButton = e.target.closest('.language-switcher-btn');
      const clickedMenu = e.target.closest('.language-menu');
      
      if (!clickedButton && !clickedMenu) {
        document.querySelectorAll('.language-switcher-btn').forEach(button => {
          button.setAttribute('data-open', 'false');
          const container = button.closest('.relative');
          const menu = container ? container.querySelector('.language-menu') : null;
          if (menu) {
            menu.classList.add('hidden');
            menu.style.display = 'none';
          }
          const chevron = button.querySelector('svg');
          if (chevron) {
            chevron.style.transform = 'rotate(0deg)';
            chevron.style.transition = 'transform 0.2s ease';
          }
        });
      }
    }, true); // Use capture phase for higher priority
  });
</script>
