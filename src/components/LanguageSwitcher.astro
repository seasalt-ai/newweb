---
import { languages } from '../i18n/helpers';
import { extractLangFromPath, getLocalizedPath } from '../i18n/helpers';

export interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;
const currentLang = extractLangFromPath(Astro.url.pathname);
// 使用實際的 URL 路徑而不是傳入的 currentPath
const actualCurrentPath = Astro.url.pathname;
---

<div class="relative inline-block text-left">
  <button id="language-switcher" class="flex items-center text-gray-700 hover:text-blue-600 transition-colors duration-200">
    <span class="mr-1">{languages[currentLang]?.shortCode || 'EN'}</span>
    <svg class="w-4 h-4 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
    </svg>
  </button>
  
  <div id="language-menu" class="hidden absolute right-0 z-10 mt-2 w-64 origin-top-right bg-white rounded-lg shadow-lg border border-gray-200 py-2 max-h-96 overflow-y-auto z-[9999]">
    <div class="py-1">
      {Object.entries(languages).map(([lang, info]) => (
        <a 
          href={getLocalizedPath(actualCurrentPath, lang as keyof typeof languages)}
          class={`block w-full text-left px-4 py-2 text-sm hover:bg-gray-50 ${
            currentLang === lang ? 'font-semibold text-blue-600 bg-blue-50' : 'text-gray-700'
          }`}
        >
          <div class="flex justify-between items-center">
            <span class="font-medium">{info.name}</span>
            <span class="text-xs text-gray-500 ml-2">{info.englishName}</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</div>

<script>
  const button = document.getElementById('language-switcher');
  const menu = document.getElementById('language-menu');
  
  if (button && menu) {
    button.addEventListener('click', () => {
      const isHidden = menu.classList.contains('hidden');
      menu.classList.toggle('hidden');
      
      // Toggle chevron rotation
      const chevron = button.querySelector('svg');
      if (chevron) {
        if (isHidden) {
          chevron.classList.add('rotate-180');
        } else {
          chevron.classList.remove('rotate-180');
        }
      }
    });
    
    // Close menu when clicking outside
    document.addEventListener('click', (e) => {
      if (!button.contains(e.target as Node) && !menu.contains(e.target as Node)) {
        menu.classList.add('hidden');
        const chevron = button.querySelector('svg');
        if (chevron) {
          chevron.classList.remove('rotate-180');
        }
      }
    });
  }
</script>
